/.lake
.DS_Store

# Working notes, spikes and process files: kept on disk and synced between machines
# directly, not through git (docs/research/2026-09-04-prod-cleanup-inventory.md, D6).
/docs/research/
/workshop/
/output/
/COORDINATION.md
/PLAN.md
/misty-frolicking-naur.md

# Claude Code per-machine settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# Harness spikes: per-machine scratch under harness/ stays on disk, not in git.
# The 23 files already tracked here are unaffected — six gates read them
# (check-schema-annotations, check-schema-effectful-field,
# check-schema-typescript-generation, check-internal-citations and their two
# gate tests) — so this hides only new, untracked harness work such as
# harness/trace/. `harness/truth/` (the Lean-vs-rc.112 exit differential, 2026-09-04)
# is tracked; its bun install and its copy of the archived trace lane are not.
/harness/*
!/harness/truth/
/harness/truth/node_modules/
/harness/truth/archive/
/harness/truth/lean.out.log
/harness/truth/lean.err.log

# The TypeScript estate (`ts/`) is tracked; its installs are not.
/ts/**/node_modules/

# The OCaml estate (`ocaml/`, one dune workspace) is tracked; dune's build directories,
# the per-machine generated link flags (absolute paths of this machine's Lean install,
# written by ocaml/link/tools/lean-flags.sh) and any node install are not.
/ocaml/**/_build/
/ocaml/**/node_modules/
/ocaml/link/c_flags.sexp
/ocaml/link/lean_flags.sexp
