/.lake
# the passed checks every worktree shares (scripts/lib/gate_cache.py: beside the git common directory)
/.git-checks
.DS_Store
__pycache__/
# wrangler's local state from `make deploy-site`
/.wrangler/

# Working notes, spikes and process files: kept on disk and synced between machines
# directly, not through git (docs/research/2026-09-04-prod-cleanup-inventory.md, D6).
/docs/research/
/workshop/
/output/
/COORDINATION*.md
/PLAN.md
/misty-frolicking-naur.md

# Reference repositories (2026-10-04): shallow clones of outside Lean projects, pinned by
# `vendor/refs/MANIFEST.tsv`, for reading only. Never built, imported or synced.
/vendor/refs/*
!/vendor/refs/MANIFEST.tsv

# Vendored papers (2026-10-06): the originals stay on disk, for reading and citation. Git
# tracks each folder's index and provenance files only (README, manifest, hashes, audits).
/vendor/papers/**/*.pdf

# Agent skills and local tooling
.claude/
.agents/
.vscode/
/scratch/
skills-lock.json

# The TypeScript estate (`ts/`) is tracked; its installs are not, and neither is the prelude's
# link to the one install (`ts/prelude/node_modules`).
/ts/**/node_modules

# The truth corpus (`Test/Corpus/`) is tracked; its link to the one install is not.
/Test/Corpus/node_modules

# The OCaml estate (`ocaml/`, one dune workspace) is tracked; dune's build directories
# and any node install are not.
/ocaml/**/_build/
/ocaml/**/node_modules

# The codec lane's work folder: the values its producer writes fresh for its check.
/ts/eff/test/codec/.work/

