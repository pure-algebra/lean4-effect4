; The LCNF route's output and its smoke check. From ocaml/: dune build gen && dune test gen.
; `closure_gen.ml` (Effect4.Api.run / Effect4.Api.replay and their whole closure, run by
; api_check, with the machine's own functions as coverage roots) and `api_gen.ml`, the facade
; over it, are GENERATED; their headers carry the regenerating command, and `make gen-lcnf` runs
; it (ocaml/gen/roots.json). Their join points are `let[@local always]`, and `-w @55` makes
; warning 55 an error in every profile: ocamlopt refuses a join point it cannot compile to a
; static jump. Every stanza that compiles the route's output carries the flag (engine/, and
; engine/test/ lanes, todo, ctors, modeled and rocq).
;
; The one compiled closure (D1): every node the api artifact's roots reach, lowered and compiled
; once. A package-private library of effect4_gen (`package`, no `public_name`): it installs with
; effect4_gen, which links it, but an installed client names none of its modules
; (engine/test/install, the red_closure_* controls). Inside this project the test lanes'
; unit engine/test/lanes/lanes_gen.ml includes it, so the records Api_gen seals are concrete
; there. Its interface (closure_gen.mli) keeps every type and the values its two scopes call.

(library
 (name effect4_closure)
 (package effect4_gen)
 (wrapped false)
 (modules closure_gen)
 (flags
  (:standard -w @55))
 (libraries zarith effect4_eff effect4_lcnf))

; The installed face of the closure: Api_gen is `include Closure_gen`, and its interface
; (api_gen.mli, read off the closure's typed tree) keeps the public and linkage roots, declares
; the closure's types as its own and seals the recipe's packages.

(library
 (name effect4_gen)
 (public_name effect4_gen)
 (modules api_gen)
 (flags
  (:standard -w @55))
 (libraries effect4_closure zarith effect4_eff effect4_lcnf))

(executable
 (name api_check)
 (modules api_check)
 (libraries effect4_gen))

(rule
 (alias runtest)
 (action
  (run %{exe:api_check.exe})))

; The flag's red control: join_escape.ml's [@local always] function escapes, so it is no static
; jump. The rule compiles it as the native build does, with ocamlopt and -w @55 (ocamlc -g never
; runs the check), and `dune test` passes only on the refusal: exit 2 and the message of
; join_escape.expected. The sandbox drops the .cmi that ocamlopt writes before it refuses.

(rule
 (targets join_escape.stderr)
 (deps
  (sandbox always))
 (action
  (with-stderr-to
   %{targets}
   (with-accepted-exit-codes
    2
    (run %{ocamlopt} -color never -w @55 -c %{dep:join_escape.ml})))))

(rule
 (alias runtest)
 (action
  (diff join_escape.expected join_escape.stderr)))

(test
 (name test_native_boundary)
 (modules test_native_boundary)
 (libraries effect4_gen effect4_eff))

(test
 (name test_checker_native)
 (modules test_checker_native)
 (libraries effect4_gen effect4_eff))
