; The LCNF route's output and its smoke check. Build standalone from this directory:
;   dune build --root . && dune test --root .
; `machine_gen.ml` (the nine target functions), `fibers_gen.ml` (every top-level function
; of Fibers.lean, type-checked only) and `api_gen.ml` (Effect4.Api.run / Effect4.Api.replay
; and their whole closure, run by api_check) are GENERATED; each header carries the
; regenerating command, and `make gen-lcnf` runs all of them. The former `gen_check`, which
; compared the generated dispatcher against a hand copy of the archived avatar, was removed
; on 2026-09-13 with that copy.

(library
 (name effect4_gen)
 (public_name effect4_gen)
 (modules machine_gen fibers_gen api_gen)
 (libraries effect4_clock)
 (flags
  (:standard -warn-error -a)))

(executable
 (name api_check)
 (modules api_check)
 (libraries effect4_gen)
 (flags
  (:standard -warn-error -a)))

(rule
 (alias runtest)
 (action
  (run %{exe:api_check.exe})))
