(library
 (name lcnf_interface)
 (wrapped false)
 (modules lcnf_interface)
 (libraries compiler-libs.common))

; Rule 7 of ocaml/STANDARDS.md over this library's typed tree (ocaml/tools/typed_lint).

(rule
 (alias runtest)
 (deps
  (sandbox none)
  (:cmt
   (glob_files .lcnf_interface.objs/byte/*.cmt)))
 (action
  (chdir
   %{workspace_root}
   (run %{exe:../../tools/typed_lint/main.exe} %{cmt}))))

(executable
 (name main)
 (modules main)
 (libraries lcnf_interface))

(rule
 (targets fixture.cmo fixture.cmi fixture.cmt)
 (deps fixture.ml)
 (action
  (run %{ocamlc} -bin-annot -w -32 -c %{dep:fixture.ml})))

; A consumer's facade over the fixture, compiled against fixture.cmi as a facade is compiled
; against the unit it includes.

(rule
 (targets fixture_facade.cmo fixture_facade.cmi fixture_facade.cmt)
 (deps fixture_facade.ml fixture.cmi)
 (action
  (run %{ocamlc} -bin-annot -I . -c %{dep:fixture_facade.ml})))

(test
 (name test_interface)
 (modules test_interface)
 (libraries lcnf_interface)
 (deps fixture.cmt fixture_prelude.ml fixture_facade.cmt)
 (action
  (run
   %{test}
   %{dep:fixture.cmt}
   %{dep:fixture_prelude.ml}
   %{dep:fixture_facade.cmt})))
