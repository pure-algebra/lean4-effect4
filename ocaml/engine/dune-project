(lang dune 3.0)
; The engine's dune project: the host engine (dune), the byte layer (bytes/), the disk store
; (cas/) and the native kit with its command line `eff` (kit/, kit/bin/). Each library is its own
; package, as effect4_eff, effect4_gen, effect4_lcnf and effect4_clock are; `eff` installs with
; the kit. Test libraries (e4_gen_instance, effect4_disk_test_support) stay private.
;
; Install metadata (plan E1, docs/research/2026-10-18-slices/README.md, ruling 4): dune writes
; one opam file per package from the fields below (`generate_opam_files`). The packages are
; unstable: no release is published, and their names may change when the generated name
; manifest lands. ocaml/engine/test/install checks the installed packages from a project
; outside ocaml/. Zarith links the system's GMP, and `eff` links it too, so the packages that
; reach Zarith declare conf-gmp beside it.
(generate_opam_files true)
(source (github pure-algebra/lean4-effect4))
(license MIT)
(authors "The Fold Lab")
(maintainers "The Fold Lab")

(package
 (name effect4_bytes)
 (synopsis "Unstable: Effect4's byte layer: framing, hexadecimal and SHA-256")
 (description
  "The byte layer below Effect4's engine and disk store: big-endian framing over Eff_frame, hexadecimal, the host profile's 63-bit naturals and SHA-256. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  effect4_eff))

(package
 (name effect4_engine)
 (synopsis "Unstable: Effect4's host engine under the lowered machine")
 (description
  "The host engine under Effect4's machine lowered from Lean: the carriers, the host drive, and the scheduler over domains with its mailbox, inbox and admission. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  effect4_eff
  effect4_clock
  effect4_bytes
  effect4_lcnf))

(package
 (name effect4_engine_cas)
 (synopsis "Unstable: Effect4's on-disk content-addressed store")
 (description
  "Effect4's content-addressed store on disk: the node envelope, packs, the index, the log, checkpoints, and the owned disk writer. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (zarith (>= 1.14))
  conf-gmp
  effect4_bytes
  effect4_engine
  effect4_eff))

(package
 (name effect4_kit)
 (synopsis "Unstable: Effect4's native kit and the eff command line")
 (description
  "Check, run and explore Effect4 programs natively with Lean's lowered checker and call tree, and serve the authoring tool over JSON lines and MCP. Installs the eff command line. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (yojson (>= 2.2.2))
  conf-gmp
  effect4_eff
  effect4_clock
  effect4_gen
  effect4_engine))
