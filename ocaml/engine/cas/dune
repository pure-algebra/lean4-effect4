; effect4_engine_cas — the on-disk CAS: the byte layer (crc, kinds, addresses, the node
; envelope), then the pack, the index, the control file, the WAL, checkpoints and the caches
; (docs/research/2026-09-08-engine-a2-persistence.md §3; lanes P0-P10).  Flat: one e4_*.ml per
; module with its .mli and a Behaviours list at its head (ocaml/STANDARDS.md §2); tests in
; test/.  A library of the estate's one dune project (ocaml/dune-project), in its own
; package.
;
; Dependencies: the stdlib, unix (the file classes lanes P1/P3/P5 land), effect4_bytes for
; E4_sha256 / E4_hex (never a second hash -- brief §2.2), effect4_eff for Eff_frame, the one
; framing kernel (its tags, its UTF-8 rule and its whole-string face; never a second writer), and
; effect4_engine for E4_checkpoint alone, which images the engine's machine.

(library
 (name effect4_engine_cas)
 (public_name effect4_engine_cas)
 (libraries unix zarith effect4_bytes effect4_engine effect4_eff)
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70)))

; Rule 7 of ocaml/STANDARDS.md over this library's typed tree (ocaml/tools/typed_lint).

(rule
 (alias runtest)
 (deps
  (sandbox none)
  (:cmt
   (glob_files .effect4_engine_cas.objs/byte/*.cmt)))
 (action
  (chdir
   %{workspace_root}
   (run %{exe:../../tools/typed_lint/main.exe} %{cmt}))))
