opam-version: "2.0"
synopsis: "Unstable: Effect4's host engine under the lowered machine"
description:
  "The host engine under Effect4's machine lowered from Lean: the carriers, the host drive, and the scheduler over domains with its mailbox, inbox and admission. Unstable: no release is published, and names may change."
maintainer: ["The Fold Lab"]
authors: ["The Fold Lab"]
license: "MIT"
homepage: "https://github.com/pure-algebra/lean4-effect4"
bug-reports: "https://github.com/pure-algebra/lean4-effect4/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1.1"}
  "effect4_eff"
  "effect4_clock"
  "effect4_bytes"
  "effect4_lcnf"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/pure-algebra/lean4-effect4.git"
