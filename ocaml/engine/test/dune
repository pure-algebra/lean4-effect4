; The engine's tests: one binary per lane, each with an explicit `(modules ...)` so lanes
; can add a stanza without claiming another lane's module (docs/research/
; 2026-09-08-engine-a3-queue-query.md §3, lanes Q1-Q6 and the math lane).
;
;   test_host  lane Q4 — E4_mailbox, E4_inbox, E4_ring, E4_quiescence, E4_reply,
;              E4_trigger, E4_admit; also prints the B-Q4a contention measurement.
;   test_math  lane M — E4_nat, E4_sha256, E4_hex, E4_be; also prints the SHA-256
;              throughput on a 64 MiB buffer.

(test
 (name test_host)
 (modules test_host)
 (libraries effect4_engine threads.posix))

(test
 (name test_math)
 (modules test_math)
 (libraries effect4_engine))

