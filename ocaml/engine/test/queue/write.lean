import Test.Program.QueueScenarios
import Effect4.Store.Domain.ProgramWire

/-!
The writer of the Queue's engine fixture. Run it from the repository's root, after a build of
`Test.Program.QueueScenarios`:

    lake env lean --run ocaml/engine/test/queue/write.lean

It writes `queue.txt` beside this file: for the scenarios R1 and R4 of
`Test/Program/QueueScenarios.lean`, the fuel, the program's canonical bytes
(`Effect4.Program.Wire.hexOf`) and the root's exit of Lean's machine, in the spelling of the
engine's `show_exit` (`ocaml/engine/e4_engine.ml`). The battery `Test/Program/QueueEngine.lean`
binds the committed file to these programs, and `test_queue.ml`, beside this file, reads it.
-/

open Effect4 Effect4.Machine Effect4.Program
open Test.Program.QueueScenarios

/-- A Boolean or a number in the spelling of the engine's `show_val`. -/
def showScalar : Val → Option String
  | .bool b => some (toString b)
  | .nat n => some (toString n)
  | _ => none

/-- A value in the spelling of the engine's `show_val`. The scenarios answer Booleans, numbers
and flat lists of them: any other value has no spelling here, and the writer refuses it. -/
def showVal : Val → Option String
  | .list xs => (xs.mapM showScalar).map fun parts => "list[" ++ ",".intercalate parts ++ "]"
  | v => showScalar v

/-- An exit in the spelling of the engine's `show_exit`. Only a success has a spelling here. -/
def showExit : ExitV → Option String
  | .success v => (showVal v).map ("success " ++ ·)
  | .failure _ => none

def fuel : Nat := 20000

/-- One run of the fixture: its name, its fuel, its program's bytes and its exit. -/
def runText (name : String) (src : Authoring.Src NativeOp) : Option String := do
  let built ← (Effect4.Api.Author.build (mk src)).toOption
  let exit ← (Api.run built.program fuel).exit
  let shown ← showExit exit
  pure (s!"run {name}\nfuel {fuel}\nprogram {Wire.hexOf built.program}\nexit {shown}\nend\n")

def main : IO UInt32 := do
  match runText "r1" r1, runText "r4" r4 with
  | some first, some second =>
    let header := "# GENERATED by ocaml/engine/test/queue/write.lean; do not edit.\n" ++
      "# Write again: lake env lean --run ocaml/engine/test/queue/write.lean\n"
    IO.FS.writeFile "ocaml/engine/test/queue/queue.txt" (header ++ first ++ second)
    IO.println "wrote ocaml/engine/test/queue/queue.txt"
    return 0
  | _, _ =>
    IO.eprintln "write.lean: a scenario does not build, does not finish, or answers a value with no spelling"
    return 1
