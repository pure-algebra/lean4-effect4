import Test.Program.Gen
import Effect4.Store.Domain.ProgramWire
import Effect4.Run.Kit
import Tools.JsonBridge

/-!
The writer of the native kit's fixture. `make gen-fixtures` runs it, with every other lane's
writer (`scripts/generate.py --only fixtures`). Alone, run it from the repository's root, after a
build of its imports:

    lake env lean --run ocaml/engine/test/kit/write.lean

It writes `verdicts.txt` beside this file, or into the folder that its one argument names. One
line a program of the printed corpus's sources (the 400 programs of `Test/Program/Gen.lean` at
depth 4, then `Wire.Corpus.all`), tab-separated: the name, the canonical bytes in hex, Lean's
verdict (`typed`, the answer's and the error's TypeScript spelling; or `refused`, the reason's
name and the address), and the program's JSON print as the session tool gives it
(`Tools.JsonBridge.printJson`). `test_kit.ml`, beside this file, reads it.
-/

open Effect4 Effect4.Program Effect4.Store

def verdict (p : NativeEff) : String :=
  match Effect4.Run.Kit.check {} p with
  | .ok t => s!"typed\t{t.answer.render}\t{t.error.render}"
  | .error r =>
    let path := if r.path.isEmpty then "." else String.intercalate "." (r.path.map toString)
    s!"refused\t{r.reason.head}\t{path}"

def line (name : String) (p : NativeEff) : String :=
  s!"{name}\t{Tools.JsonBridge.toHex p}\t{verdict p}\t{(Tools.JsonBridge.printJson p).compress}\n"

def main (args : List String) : IO UInt32 := do
  let folder := args.head?.getD "ocaml/engine/test/kit"
  let generated := (List.range 400).map fun i => (s!"g{i}", Test.Program.Gen.program i 4)
  let header := "# GENERATED by ocaml/engine/test/kit/write.lean; do not edit.\n" ++
    "# Write again: lake env lean --run ocaml/engine/test/kit/write.lean\n"
  let text := header ++ String.join ((generated ++ Wire.Corpus.all).map fun (n, p) => line n p)
  IO.FS.writeFile s!"{folder}/verdicts.txt" text
  IO.println s!"wrote {folder}/verdicts.txt"
  return 0
