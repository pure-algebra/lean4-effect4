## lines no tool call can carry, through serve_line
# not JSON
serve> this is not json
< {"status":"error","message":"JSON at byte 0: unknown word"}
# empty
serve>
< {"status":"error","message":"JSON at byte 0: expected a value"}
# an array
serve> [1,2,3]
< {"status":"error","message":"a request is a JSON object"}
# no op
serve> {"program":3}
< {"status":"error","message":"the program's JSON does not read as a program"}
# op not a string
serve> {"op":3}
< {"status":"error","message":"a request names its op"}
# trailing bytes
serve> {"op":"check"} x
< {"status":"error","message":"JSON at byte 15: text after the value"}

## the MCP methods, through mcp_line
# initialize
mcp> {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26"}}
< {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-03-26","capabilities":{"tools":{}},"serverInfo":{"name":"effect4-kit","version":"0.1.0"}}}
# initialize, no params
mcp> {"jsonrpc":"2.0","id":2,"method":"initialize"}
< {"jsonrpc":"2.0","id":2,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{}},"serverInfo":{"name":"effect4-kit","version":"0.1.0"}}}
# ping
mcp> {"jsonrpc":"2.0","id":"a","method":"ping"}
< {"jsonrpc":"2.0","id":"a","result":{}}
# tools/list
mcp> {"jsonrpc":"2.0","id":3,"method":"tools/list"}
< {"jsonrpc":"2.0","id":3,"result":{"tools":[{"name":"check","description":"Type an Eff program at its application with Lean's checker, natively: its Effect<A, E> type, or the address of the refusing node and why; then program admission (the rows' registration and kind).","inputSchema":{"type":"object","properties":{"program":{"type":"object","description":"the program as its JSON print, the session tool's form ({\"_tag\":\"bind\",…})"},"rows":{"type":"array","description":"the application's host rows, an array of row records (name, spelling, shape, kind \"async\", registration \"external\", request, answer, error, …)"}},"required":["program"]}},{"name":"run","description":"Run an Eff program under a reply tape and report how it stops: finished (with its exit), waiting (the call the host has no reply for), refused (the reply that does not fit its row, and why), unsettled (the budget ended first: a finite probe, never a divergence) or stopped. Each call is listed with its request and reply. A program in the call tree's fragment settles at the least budget that does not cut it, and is run on the machine too; the answer says whether the two agree. Any other program runs on the machine.","inputSchema":{"type":"object","properties":{"program":{"type":"object","description":"the program as its JSON print, the session tool's form ({\"_tag\":\"bind\",…})"},"rows":{"type":"array","description":"the application's host rows, an array of row records (name, spelling, shape, kind \"async\", registration \"external\", request, answer, error, …)"},"tape":{"type":"array","description":"the host's replies in call order, an array of exits ({\"_tag\":\"success\",\"value\":…} or {\"_tag\":\"failure\",\"cause\":…}); with none, every call waits"},"limit":{"type":"integer","description":"the largest budget to try, or the machine's rounds (default 1024)"},"frames":{"type":"boolean","description":"also answer the call tree's runs at every budget up to the one it settles at: each extends the one before, so they play as one growing run"},"fast":{"type":"boolean","description":"skip the machine's run"}},"required":["program"]}},{"name":"explore","description":"Every path of an Eff program's call tree at a budget, with each host reply drawn from its row's declared types (small members: 0 and 1, \"\" and \"a\", empty and one-item lists, each union member, and failures from the error column). Each path lists its calls, its stop and its tape; each path the budget does not cut is replayed on the machine under its tape, and the answer says whether the two agree.","inputSchema":{"type":"object","properties":{"program":{"type":"object","description":"the program as its JSON print, the session tool's form ({\"_tag\":\"bind\",…})"},"rows":{"type":"array","description":"the application's host rows, an array of row records (name, spelling, shape, kind \"async\", registration \"external\", request, answer, error, …)"},"budget":{"type":"integer","description":"the budget (default 64)"},"width":{"type":"integer","description":"the most paths to answer (default 64)"},"fast":{"type":"boolean","description":"skip the machine's replays"}},"required":["program"]}}]}}
# tools/call
mcp> {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"check","arguments":{"program":{"_tag":"iterate","cursorTy":null,"initial":{"_tag":"lit","value":{"_tag":"nat","value":1}},"test":{"_tag":"app","atom":"lt","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":16}}]},"step":{"_tag":"app","atom":"mul","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":2}}]},"result":{"_tag":"var","index":0},"body":{"_tag":"perform","op":{"_tag":"external","index":0},"request":{"_tag":"var","index":0}}},"rows":[{"name":"echo","spelling":"echo","shape":"call","trailing":[],"kind":"async","request":{"_tag":"nat"},"answer":{"_tag":"unit"},"error":{"_tag":"never"},"requires":[],"cite":"","typeArgs":[],"registration":"external"}]}}}
< {"jsonrpc":"2.0","id":4,"result":{"content":[{"type":"text","text":"{\"status\":\"ok\",\"type\":{\"answer\":{\"_tag\":\"nat\"},\"error\":{\"_tag\":\"never\"},\"requires\":[]},\"text\":\"Effect<number, never>\"}"}],"isError":false}}
# tools/call, unreadable program
mcp> {"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"check","arguments":{"program":3}}}
< {"jsonrpc":"2.0","id":5,"result":{"content":[{"type":"text","text":"{\"status\":\"error\",\"message\":\"the program's JSON does not read as a program\"}"}],"isError":true}}
# tools/call, no name
mcp> {"jsonrpc":"2.0","id":6,"method":"tools/call","params":{}}
< {"jsonrpc":"2.0","id":6,"result":{"content":[{"type":"text","text":"{\"status\":\"error\",\"message\":\"unknown operation \\\"\\\" (the operations are check, run and explore)\"}"}],"isError":true}}
# notification
mcp> {"jsonrpc":"2.0","method":"notifications/initialized"}
< (no reply)
# notification with params
mcp> {"jsonrpc":"2.0","method":"notifications/cancelled","params":{"requestId":4}}
< (no reply)
# unknown method
mcp> {"jsonrpc":"2.0","id":7,"method":"resources/list"}
< {"jsonrpc":"2.0","id":7,"error":{"code":-32601,"message":"unknown method resources/list"}}
# no method
mcp> {"jsonrpc":"2.0","id":8}
< {"jsonrpc":"2.0","id":8,"error":{"code":-32600,"message":"not a request"}}
# method not a string
mcp> {"jsonrpc":"2.0","id":9,"method":3}
< {"jsonrpc":"2.0","id":9,"error":{"code":-32600,"message":"not a request"}}
# neither id nor method
mcp> {"jsonrpc":"2.0"}
< (no reply)
# not JSON
mcp> {"jsonrpc":
< {"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"JSON at byte 11: expected a value"}}
# not an object
mcp> []
< {"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"not a request"}}
