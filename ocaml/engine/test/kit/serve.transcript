## malformed requests, through both transports
# error: unknown op
both> {"op":"frobnicate","program":{"_tag":"iterate","cursorTy":null,"initial":{"_tag":"lit","value":{"_tag":"nat","value":1}},"test":{"_tag":"app","atom":"lt","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":16}}]},"step":{"_tag":"app","atom":"mul","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":2}}]},"result":{"_tag":"var","index":0},"body":{"_tag":"perform","op":{"_tag":"external","index":0},"request":{"_tag":"var","index":0}}}}
< {"status":"error","message":"unknown operation \"frobnicate\" (the operations are check, run and explore)"}
# error: no program
both> {"op":"check"}
< {"status":"error","message":"no program"}
# error: unreadable program
both> {"op":"check","program":3}
< {"status":"error","message":"the program's JSON does not read as a program"}
# error: not a program
both> {"op":"check","program":{"_tag":"nope"}}
< {"status":"error","message":"the program's JSON does not read as a program"}
# error: unreadable rows
both> {"op":"check","program":{"_tag":"iterate","cursorTy":null,"initial":{"_tag":"lit","value":{"_tag":"nat","value":1}},"test":{"_tag":"app","atom":"lt","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":16}}]},"step":{"_tag":"app","atom":"mul","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":2}}]},"result":{"_tag":"var","index":0},"body":{"_tag":"perform","op":{"_tag":"external","index":0},"request":{"_tag":"var","index":0}}},"rows":5}
< {"status":"error","message":"the rows do not read as a row table"}
# error: unreadable tape
both> {"op":"run","program":{"_tag":"iterate","cursorTy":null,"initial":{"_tag":"lit","value":{"_tag":"nat","value":1}},"test":{"_tag":"app","atom":"lt","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":16}}]},"step":{"_tag":"app","atom":"mul","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":2}}]},"result":{"_tag":"var","index":0},"body":{"_tag":"perform","op":{"_tag":"external","index":0},"request":{"_tag":"var","index":0}}},"rows":[{"name":"echo","spelling":"echo","shape":"call","trailing":[],"kind":"async","request":{"_tag":"nat"},"answer":{"_tag":"unit"},"error":{"_tag":"never"},"requires":[],"cite":"","typeArgs":[],"registration":"external"}],"tape":{}}
< {"status":"error","message":"the tape does not read as an array of exits"}
# error: limit not a number
both> {"op":"run","program":{"_tag":"iterate","cursorTy":null,"initial":{"_tag":"lit","value":{"_tag":"nat","value":1}},"test":{"_tag":"app","atom":"lt","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":16}}]},"step":{"_tag":"app","atom":"mul","args":[{"_tag":"var","index":0},{"_tag":"lit","value":{"_tag":"nat","value":2}}]},"result":{"_tag":"var","index":0},"body":{"_tag":"perform","op":{"_tag":"external","index":0},"request":{"_tag":"var","index":0}}},"rows":[{"name":"echo","spelling":"echo","shape":"call","trailing":[],"kind":"async","request":{"_tag":"nat"},"answer":{"_tag":"unit"},"error":{"_tag":"never"},"requires":[],"cite":"","typeArgs":[],"registration":"external"}],"limit":"many"}
