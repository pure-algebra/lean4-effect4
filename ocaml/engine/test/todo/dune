; lane T -- the to-do host run on LCNF-made code (LC-6; Test/Dogfood/Scenario/Todo/HostLane.lean).
;   todo_lane   todo_gen.ml (GENERATED by `make gen-lcnf` from ocaml/gen/roots.json): the to-do
;               lane's facade over the lanes' unit (../lanes/lanes_gen.ml, over the one closure
;               ../../../gen/closure_gen.ml), which keeps
;               this lane's roots and the types they name; and the hosts written in OCaml:
;               todo_core.ml (a pure repository, which the Rocq worked example reads) and
;               native_todo.ml (the module type REPO, its adapter to the lowered `host` record,
;               and every native host). A library, so that the test and the bench compile the
;               facade once.
;   test_todo   runs each request of todo-host.txt (written by Lean: write.lean, beside this file)
;               and compares the result's canonical bytes with Lean's, over the lowered hosts and
;               the native ones, through the lowered run and through E4_host.
;   bench_todo  the cost of a host call on the engine, by host and by stage. An executable, not a
;               test: a bench is a measurement, not a gate.
;               It is its own directory so that no other lane's dune file changes.

(library
 (name todo_lane)
 (wrapped false)
 (modules todo_gen todo_fixture todo_core native_todo)
 (flags
  (:standard -w @55))
 (no_dynlink)
 (libraries
  effect4_lanes
  effect4_eff
  effect4_clock
  effect4_bytes
  effect4_engine
  effect4_lcnf))

; Rule 7 of ocaml/STANDARDS.md over this library's typed tree (ocaml/tools/typed_lint).

(rule
 (alias runtest)
 (deps
  (sandbox none)
  (:cmt
   (glob_files .todo_lane.objs/byte/*.cmt)))
 (action
  (chdir
   %{workspace_root}
   (run %{exe:../../../tools/typed_lint/main.exe} %{cmt}))))

(test
 (name test_todo)
 (modules test_todo)
 (deps todo-host.txt)
 (libraries
  todo_lane
  effect4_eff
  effect4_clock
  effect4_bytes
  effect4_engine
  effect4_gen
  e4_gen_instance))

(executable
 (name bench_todo)
 (modules bench_todo)
 (libraries todo_lane effect4_eff effect4_bytes effect4_engine))
