; effect4_bytes — the byte layer of the engine and the CAS: big-endian framing (E4_be, which
; forwards to Eff_frame), hexadecimal (E4_hex),
; and SHA-256 (E4_sha256). It names no engine module, so it sits below the engine and the CAS:
; the CAS needs the engine only for E4_checkpoint. Unwrapped, as effect4_eff and effect4_clock
; are, so the generated engine and the CAS name its modules directly. A library of the
; estate's one dune project (ocaml/dune-project), in its own package, as cas/ is.

(library
 (name effect4_bytes)
 (public_name effect4_bytes)
 (wrapped false)
 (libraries effect4_eff)
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70)))

; Rule 7 of ocaml/STANDARDS.md over this library's typed tree (ocaml/tools/typed_lint).

(rule
 (alias runtest)
 (deps
  (sandbox none)
  (:cmt
   (glob_files .effect4_bytes.objs/byte/*.cmt)))
 (action
  (chdir
   %{workspace_root}
   (run %{exe:../../tools/typed_lint/main.exe} %{cmt}))))
