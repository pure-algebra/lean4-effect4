# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Unstable: the runtime library of Effect4's LCNF-made OCaml"
description:
  "The functions every OCaml file that Effect4's LCNF route generates links: strings as UTF-8 bytes, Lean's total arithmetic on exact naturals, the refusal at a named crossing, and the persistent array. Unstable: no release is published, and names may change."
maintainer: ["The Fold Lab"]
authors: ["The Fold Lab"]
license: "MIT"
homepage: "https://github.com/pure-algebra/lean4-effect4"
bug-reports: "https://github.com/pure-algebra/lean4-effect4/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1.1"}
  "zarith" {>= "1.14"}
  "conf-gmp"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/pure-algebra/lean4-effect4.git"
