; `effect4d` under dune: one library of the daemon's modules over the avatar's fifteen
; (ocaml/avatar/, read-only, linked as the public library `effect4-avatar` -- see "the
; avatar half" below), and two executables -- the POSIX transport as bytecode and native,
; the node transport as js_of_ocaml under `--enable effects`. The module list and its order
; are the ones build-server.sh compiled; the four generated modules are dune rules over the
; same generators (tools/*.py, python3). BUILD-DUNE.md is the account.

; --- the generated modules ------------------------------------------------------------

; The mask table and the classified divergences, compiled in. The mask table is the
; archived generated/traces/masks.tsv, vendored under generated/traces/ (see
; tools/vendor-archived-inputs.sh); the divergence table is the avatar's own.
(rule
 (target e4d_masks_data.ml)
 (deps generated/traces/masks.tsv ../avatar/corpus/known-divergences.tsv)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(* Generated by dune (server/dune). Do not edit. *)\n")
    (echo "(* generated/traces/masks.tsv, archived at 606918e, vendored under server/generated/traces/ *)\n")
    (echo "let text = {masks|")
    (cat generated/traces/masks.tsv)
    (echo "|masks}\n")
    (echo "(* ocaml/avatar/corpus/known-divergences.tsv *)\n")
    (echo "let known_text = {known|")
    (cat ../avatar/corpus/known-divergences.tsv)
    (echo "|known}\n")))))

; The five families' OpSpec rows, out of the archived harness fixtures (vendored under
; generated/harness-trace/).
(rule
 (target e4d_families_data.ml)
 (deps
  tools/gen_families.py
  generated/harness-trace/fibers-fixture.stub.ts
  generated/harness-trace/ref-fixture.ts
  generated/harness-trace/deferred-fixture.ts
  generated/harness-trace/scope-fixture.ts
  generated/harness-trace/layer-fixture.ts)
 (action
  (with-stdout-to
   %{target}
   (run python3 %{deps}))))

; The avatar's dispatch tables, arm row names and citations, resolved against the Lean
; machine. The avatar modules are dune dependencies (the library's own list, in its own
; order, minus the generated corpus_data). The Lean modules live outside this workspace
; (<repo>/src/Effect4/Machine/), which dune cannot depend on, so the rule depends on the
; universe instead: it re-runs on every build (about a second) and downstream compilation
; only re-runs when its output actually changes.
;
; Reaching them: `%{workspace_root}` expands to the *build context* root as seen from the
; action's directory -- from `_build/default/server` that is `./..`, i.e.
; `<repo>/ocaml/_build/default`. Three more `..` climb out of it (`_build/default` ->
; `_build` -> `ocaml` -> `<repo>`), so the Lean machine is
; `%{workspace_root}/../../../src/Effect4/Machine`. The count encodes two facts: this
; workspace root is one directory below the repo root, and a build context is two below the
; workspace root. If either moves, both rules below need the new count, and the symptom is
; a `FileNotFoundError` naming a path under `_build/`.
(rule
 (target e4d_armmap.ml)
 (deps
  (universe)
  tools/gen_armmap.py
  ../avatar/deep_fibers.ml
  ../avatar/deep_stores.ml
  ../avatar/deep_context.ml
  ../avatar/deep_layer.ml
  ../avatar/deep_forkflow.ml
  ../avatar/avatar_trace.ml
  ../avatar/deep_census.ml
  ../avatar/deep_clauses.ml
  ../avatar/deep_witnesses.ml
  ../avatar/fibers_fixture.ml
  ../avatar/store_fixtures.ml
  ../avatar/extra_fixture.ml
  ../avatar/corpus_dsl.ml
  ../avatar/corpus_run.ml)
 (action
  (with-stdout-to
   %{target}
   (run
    python3
    %{dep:tools/gen_armmap.py}
    %{workspace_root}/../../../src/Effect4/Machine
    %{dep:../avatar/deep_fibers.ml}
    %{dep:../avatar/deep_stores.ml}
    %{dep:../avatar/deep_context.ml}
    %{dep:../avatar/deep_layer.ml}
    %{dep:../avatar/deep_forkflow.ml}
    %{dep:../avatar/avatar_trace.ml}
    %{dep:../avatar/deep_census.ml}
    %{dep:../avatar/deep_clauses.ml}
    %{dep:../avatar/deep_witnesses.ml}
    %{dep:../avatar/fibers_fixture.ml}
    %{dep:../avatar/store_fixtures.ml}
    %{dep:../avatar/extra_fixture.ml}
    %{dep:../avatar/corpus_dsl.ml}
    %{dep:../avatar/corpus_run.ml}))))

; The rc.112 pin, the per-file digests and the build note. Depends on the universe for
; the same reason as the arm map (the Lean files), and because the node and js_of_ocaml
; versions in the build note are read off the machine.
(rule
 (target e4d_pins.ml)
 (deps
  (universe)
  tools/gen_pins.py
  generated/traces/masks.tsv
  ../avatar/corpus/programs.txt
  ../avatar/deep_fibers.ml
  ../avatar/deep_stores.ml
  ../avatar/deep_context.ml
  ../avatar/deep_layer.ml
  ../avatar/deep_forkflow.ml
  ../avatar/avatar_trace.ml
  ../avatar/deep_census.ml
  ../avatar/deep_clauses.ml
  ../avatar/deep_witnesses.ml
  ../avatar/fibers_fixture.ml
  ../avatar/store_fixtures.ml
  ../avatar/extra_fixture.ml
  ../avatar/corpus_dsl.ml
  ../avatar/corpus_run.ml
  dune
  server_runtime.js
  e4d_json.ml
  e4d_wire.ml
  e4d_protocol.ml
  e4d_stream.ml
  e4d_alphabet.ml
  e4d_server_loop.ml
  e4d_reset.ml
  e4d_catalog.ml
  e4d_snapshot.ml
  effect4_daemon.ml
  effect4d.ml
  effect4d_js.ml
  tools/gen_armmap.py
  tools/gen_families.py
  generated/harness-trace/fibers-fixture.stub.ts
  generated/harness-trace/ref-fixture.ts
  generated/harness-trace/deferred-fixture.ts
  generated/harness-trace/scope-fixture.ts
  generated/harness-trace/layer-fixture.ts)
 (action
  (with-stdout-to
   %{target}
   (system
    "python3 %{dep:tools/gen_pins.py} --ocaml %{ocaml_version} --node \"$( (node --version 2>/dev/null || node.exe --version 2>/dev/null || echo unavailable) | tr -d '\\r')\" --jsoo \"$( (js_of_ocaml --version 2>/dev/null || echo 5.7.1) | tr -d '\\r')\" --masks %{dep:generated/traces/masks.tsv} --corpus %{dep:../avatar/corpus/programs.txt} --avatar %{dep:../avatar/deep_fibers.ml} %{dep:../avatar/deep_stores.ml} %{dep:../avatar/deep_context.ml} %{dep:../avatar/deep_layer.ml} %{dep:../avatar/deep_forkflow.ml} %{dep:../avatar/avatar_trace.ml} %{dep:../avatar/deep_census.ml} %{dep:../avatar/deep_clauses.ml} %{dep:../avatar/deep_witnesses.ml} %{dep:../avatar/fibers_fixture.ml} %{dep:../avatar/store_fixtures.ml} %{dep:../avatar/extra_fixture.ml} %{dep:../avatar/corpus_dsl.ml} %{dep:../avatar/corpus_run.ml} --server %{dep:dune} %{dep:server_runtime.js} %{dep:e4d_json.ml} %{dep:e4d_wire.ml} %{dep:e4d_protocol.ml} %{dep:e4d_stream.ml} %{dep:e4d_alphabet.ml} %{dep:e4d_server_loop.ml} %{dep:e4d_reset.ml} %{dep:e4d_catalog.ml} %{dep:e4d_snapshot.ml} %{dep:effect4_daemon.ml} %{dep:effect4d.ml} %{dep:effect4d_js.ml} --tools %{dep:tools/gen_armmap.py} %{dep:tools/gen_families.py} %{dep:tools/gen_pins.py} --inputs %{dep:generated/traces/masks.tsv} %{dep:generated/harness-trace/fibers-fixture.stub.ts} %{dep:generated/harness-trace/ref-fixture.ts} %{dep:generated/harness-trace/deferred-fixture.ts} %{dep:generated/harness-trace/scope-fixture.ts} %{dep:generated/harness-trace/layer-fixture.ts} --lean %{workspace_root}/../../../src/Effect4/Machine/*.lean"))))

; --- the avatar half -------------------------------------------------------------------

; The avatar is linked, not copied. `avatar/dune`'s library carries
; `(public_name effect4-avatar)` (package `effect4-avatar`, `avatar/effect4-avatar.opam`),
; which is what makes it visible outside its own nested dune project; `effect4d_lib` below
; says `(libraries effect4-avatar)` and dune compiles the avatar's fifteen modules once,
; in `_build/default/avatar/`, for both the avatar's own executables and the daemon. The
; avatar's sources are read, never written. Until 2026-09-04 this block was a `copy_files#`
; of the same fifteen modules into a second library `effect4_avatar_copy`, the way
; build-server.sh did it with `cp`; BUILD-DUNE.md §4 records why and what replaced it.

; --- the daemon ------------------------------------------------------------------------

; Every module but the two transports, in the order build-server.sh compiled them.
(library
 (name effect4d_lib)
 (wrapped false)
 (modules
  e4d_json e4d_wire e4d_protocol e4d_stream e4d_alphabet e4d_server_loop
  e4d_masks_data e4d_families_data e4d_armmap e4d_pins
  e4d_reset e4d_catalog e4d_snapshot effect4_daemon)
 (libraries effect4-avatar)
 (flags (:standard -warn-error -a)))

; The POSIX transport (stdin/stdout, TCP): bytecode and native. `unix` is only for TCP.
(executable
 (name effect4d)
 (modules effect4d)
 (modes byte exe)
 (libraries effect4d_lib unix)
 (flags (:standard -warn-error -a)))

; The node transport and the module exports, under js_of_ocaml 5.7.1 `--enable effects`.
; Its four externals are implemented by server_runtime.js, which `javascript_files` hands to
; js_of_ocaml; nothing else links this module, so the native and bytecode builds never see
; them.
(executable
 (name effect4d_js)
 (modules effect4d_js)
 (modes js)
 (libraries effect4d_lib)
 (js_of_ocaml
  (flags (--enable effects --target-env=nodejs))
  (javascript_files server_runtime.js))
 (flags (:standard -warn-error -a)))

; The README's artefact names, beside dune's own (effect4d.bc, effect4d.exe,
; effect4d_js.bc.js), so `tests/test_client.py --build _build/default/server` and
; `require("./effect4d.js")` read as documented.
(rule
 (target effect4d.byte)
 (deps effect4d.bc)
 (action (copy %{deps} %{target})))

(rule
 (target effect4d.native)
 (deps effect4d.exe)
 (action (copy %{deps} %{target})))

(rule
 (target effect4d.js)
 (deps effect4d_js.bc.js)
 (action (copy %{deps} %{target})))
