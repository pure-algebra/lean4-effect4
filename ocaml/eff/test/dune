 (modules test_lean_wire)
 (libraries effect4_eff)
 (deps (glob_files %{project_root}/goldens/*)))

; DI-62: compile a supported witness battery, then require each Boolean introduction
; to fail for its own type mismatch rather than an unavailable module or tool.
(test
 (name test_error_typing)
 (modules test_error_typing)
 (libraries effect4_eff))

(rule
 (alias runtest)
 (deps
  error_witness_controls.sh
  (glob_files error_witness_controls/*.ml)
  ../.effect4_eff.objs/byte/eff_typed.cmi
  ../.effect4_eff.objs/byte/eff_types.cmi)
 (action (run bash %{dep:error_witness_controls.sh} %{ocamlc} ../.effect4_eff.objs/byte)))

