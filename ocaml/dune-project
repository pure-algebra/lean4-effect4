(lang dune 3.0)
; The OCaml estate as one dune project (decision D1, docs/research/2026-10-18-slices/
; receipt-w2-closure.md): gen/ (the LCNF route), eff/ (the Eff IR as an OCaml library), engine/
; (the host engine, its byte layer bytes/, its disk store cas/ and the native kit kit/), lcnf/
; (the library generated code links) and tools/; see `dune` and README.md. The avatar
; and the daemon that were once two more projects are archived on `archive/ocaml5-avatar`.
;
; One project holds the seven packages below. So a package-private library of effect4_gen (the
; LCNF closure, gen/dune) serves the installed facade Api_gen and the test lanes under
; engine/test/ alike, while an installed client names only each package's public modules.
;
; Install metadata (plan E1, docs/research/2026-10-18-slices/README.md, ruling 4): dune writes one
; opam file per package beside this file (`generate_opam_files`). The packages are unstable: no
; release is published, and their names may change. A Lean natural is Zarith's `Z.t` (M4), and
; Zarith links the system's GMP, so a package that reaches Zarith declares conf-gmp beside it. ocaml/engine/test/install
; checks the installed packages from a project outside ocaml/.
(generate_opam_files true)
(source (github pure-algebra/lean4-effect4))
(license MIT)
(authors "The Fold Lab")
(maintainers "The Fold Lab")

(package
 (name effect4_eff)
 (synopsis "Unstable: Effect4's Eff program IR as an OCaml library")
 (description
  "The Eff program IR of lean4-effect4 in OCaml: its types, its canonical wire and its JSON print, generated from Lean over a hand-written framing kernel. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (zarith (>= 1.14))
  conf-gmp))

(package
 (name effect4_lcnf)
 (synopsis "Unstable: the runtime library of Effect4's LCNF-made OCaml")
 (description
  "The functions every OCaml file that Effect4's LCNF route generates links: strings as UTF-8 bytes, Lean's total arithmetic on exact naturals, the refusal at a named crossing, and the persistent array. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (zarith (>= 1.14))
  conf-gmp))

(package
 (name effect4_gen)
 (synopsis "Unstable: Effect4's checker, call tree and tool, lowered from Lean")
 (description
  "Lean's checker, call tree, authoring surface and authoring tool for Effect4, lowered to OCaml through LCNF (Api_gen, generated). Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (zarith (>= 1.14))
  conf-gmp
  effect4_eff
  effect4_lcnf))

(package
 (name effect4_bytes)
 (synopsis "Unstable: Effect4's byte layer: framing, hexadecimal and SHA-256")
 (description
  "The byte layer below Effect4's engine and disk store: big-endian framing over Eff_frame, hexadecimal and SHA-256. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  effect4_eff))

(package
 (name effect4_engine)
 (synopsis "Unstable: Effect4's host engine under the lowered machine")
 (description
  "The host engine under Effect4's machine lowered from Lean: the carriers, the host drive, and the scheduler over domains with its mailbox, inbox and admission. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (zarith (>= 1.14))
  conf-gmp
  effect4_eff
  effect4_bytes
  effect4_lcnf))

(package
 (name effect4_engine_cas)
 (synopsis "Unstable: Effect4's on-disk content-addressed store")
 (description
  "Effect4's content-addressed store on disk: the node envelope, packs, the index, the log, checkpoints, and the owned disk writer. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (zarith (>= 1.14))
  conf-gmp
  effect4_bytes
  effect4_engine
  effect4_eff))

(package
 (name effect4_kit)
 (synopsis "Unstable: Effect4's native kit and the eff command line")
 (description
  "Check, run and explore Effect4 programs natively with Lean's lowered checker and call tree, and serve the authoring tool over JSON lines and MCP. Installs the eff command line. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (yojson (>= 2.2.2))
  (zarith (>= 1.14))
  conf-gmp
  effect4_eff
  effect4_gen
  effect4_engine))
