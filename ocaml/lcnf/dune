; effect4_lcnf -- the runtime library of LCNF-made code, as Lean's compiled code links lean.h.
; Every file the LCNF route generates names these functions by their path (`Lcnf_nat.pow`,
; `Lcnf_string.utf8_bytes`), and each row of `OCaml5.Lcnf.builtins` that needs one says so. The
; functions were the prelude the route printed into each generated file until slice 2.1 of the
; OCaml estate refactor (docs/research/2026-10-17-ocaml-estate-review/plan.md). Unwrapped, as
; effect4_eff is, so generated code names its modules directly. Zarith carries every natural and
; integer (M4), and the standard library the rest.

(library
 (name effect4_lcnf)
 (public_name effect4_lcnf)
 (wrapped false)
 (modules lcnf_array lcnf_crossing lcnf_list lcnf_nat lcnf_string)
 (libraries zarith)
 (flags
  (:standard -w +a-4-9-40-41-42-44-45-70)))

; Rule 7 of ocaml/STANDARDS.md over this library's typed tree (ocaml/tools/typed_lint).

(rule
 (alias runtest)
 (deps
  (sandbox none)
  (:cmt
   (glob_files .effect4_lcnf.objs/byte/*.cmt)))
 (action
  (chdir
   %{workspace_root}
   (run %{exe:../tools/typed_lint/main.exe} %{cmt}))))

(test
 (name test_lcnf)
 (modules test_lcnf)
 (libraries zarith effect4_lcnf))

(test
 (name test_array_conversion)
 (modules test_array_conversion)
 (libraries effect4_lcnf))
