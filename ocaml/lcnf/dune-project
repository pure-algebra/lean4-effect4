(lang dune 3.0)
; The package makes `effect4_lcnf` public, so the projects whose generated files call it
; (ocaml/gen and ocaml/engine, siblings in the ocaml/ workspace) can name it; a private library
; is scoped to its own project.
;
; Install metadata (plan E1, docs/research/2026-10-18-slices/README.md, ruling 4): dune writes
; effect4_lcnf.opam from the fields below (`generate_opam_files`). The package is unstable: no
; release is published, and its names may change when the generated name manifest lands.
; ocaml/engine/test/install checks the installed packages from a project outside ocaml/.
(generate_opam_files true)
(source (github pure-algebra/lean4-effect4))
(license MIT)
(authors "The Fold Lab")
(maintainers "The Fold Lab")

(package
 (name effect4_lcnf)
 (synopsis "Unstable: the runtime library of Effect4's LCNF-made OCaml")
 (description
  "The functions every OCaml file that Effect4's LCNF route generates links: strings as UTF-8 bytes, bounded naturals, and the persistent array. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))))
