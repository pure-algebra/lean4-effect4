opam-version: "2.0"
synopsis: "The Effect4 avatar: src/Effect4/Machine/*.lean as OCaml 5 effect handlers"
maintainer: "seat F1"
authors: ["lean4-effect4"]
license: "MIT"
# The pins of the `effect4` switch as it was populated on 2026-09-04 (coordinator note):
# v0.17 of the Jane Street set was refused (gel/bin_prot breakage), so v0.16 is pinned.
depends: [
  "ocaml" {= "5.1.1"}
  "dune" {>= "3.0"}
  "base" {= "v0.16.5"}
  "core" {= "v0.16.2"}
  "ppx_jane" {= "v0.16.0"}
  "ppx_expect" {= "v0.16.0"}
  "ppx_inline_test" {= "v0.16.1"}
  "expect_test_helpers_core" {= "v0.16.0"}
  "fieldslib" {= "v0.16.0"}
  "variantslib" {= "v0.16.0"}
  "sexplib" {= "v0.16.0"}
  "js_of_ocaml" {= "5.7.1"}
  "js_of_ocaml-compiler" {= "5.7.1"}
]
