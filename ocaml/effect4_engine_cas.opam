opam-version: "2.0"
synopsis: "Unstable: Effect4's on-disk content-addressed store"
description:
  "Effect4's content-addressed store on disk: the node envelope, packs, the index, the log, checkpoints, and the owned disk writer. Unstable: no release is published, and names may change."
maintainer: ["The Fold Lab"]
authors: ["The Fold Lab"]
license: "MIT"
homepage: "https://github.com/pure-algebra/lean4-effect4"
bug-reports: "https://github.com/pure-algebra/lean4-effect4/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1.1"}
  "zarith" {>= "1.14"}
  "conf-gmp"
  "effect4_bytes"
  "effect4_engine"
  "effect4_eff"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/pure-algebra/lean4-effect4.git"
