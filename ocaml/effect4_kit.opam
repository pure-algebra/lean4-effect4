# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Unstable: Effect4's native kit and the eff command line"
description:
  "Check, run and explore Effect4 programs natively with Lean's lowered checker and call tree, and serve the authoring tool over JSON lines and MCP. Installs the eff command line. Unstable: no release is published, and names may change."
maintainer: ["The Fold Lab"]
authors: ["The Fold Lab"]
license: "MIT"
homepage: "https://github.com/pure-algebra/lean4-effect4"
bug-reports: "https://github.com/pure-algebra/lean4-effect4/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1.1"}
  "yojson" {>= "2.2.2"}
  "zarith" {>= "1.14"}
  "conf-gmp"
  "effect4_eff"
  "effect4_gen"
  "effect4_engine"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/pure-algebra/lean4-effect4.git"
