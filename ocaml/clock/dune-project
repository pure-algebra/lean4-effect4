(lang dune 3.0)
; Install metadata (plan E1, docs/research/2026-10-18-slices/README.md, ruling 4): dune writes
; effect4_clock.opam from the fields below (`generate_opam_files`). The package is unstable: no
; release is published, and its names may change when the generated name manifest lands.
; Zarith links the system's GMP, so the package declares conf-gmp beside zarith.
; ocaml/engine/test/install checks the installed packages from a project outside ocaml/.
(generate_opam_files true)
(source (github pure-algebra/lean4-effect4))
(license MIT)
(authors "The Fold Lab")
(maintainers "The Fold Lab")

(package
 (name effect4_clock)
 (synopsis "Unstable: exact naturals over Zarith for Effect4")
 (description
  "Effect4's exact naturals over Zarith: the OCaml target of Effect4.ClockMillis and of the host profile's checked arithmetic. Unstable: no release is published, and names may change.")
 (depends
  (ocaml (>= 5.1.1))
  (zarith (>= 1.14))
  conf-gmp))
