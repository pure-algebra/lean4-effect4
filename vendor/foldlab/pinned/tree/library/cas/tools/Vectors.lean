import Cas
import Cas.Vectors.Schema
import Cas.Vectors.Registry
import Gate

/-!
# The vector emitter — `lake exe vectors`

Emits the registered conformance vectors as committed fixtures under
`vectors/`, one canonical JSON document per vector plus the
`index.json` tracking manifest. Every word is gated on `Word.wf` (the
executable admission scan) before a byte is written — a vector that
does not admit fails the run.

`lake exe vectors` regenerates; `lake exe vectors --check` is the
byte-identity gate: it re-renders every registered vector and fails if
any committed fixture differs or is missing. Run from the package
root (`library/cas`).

Content is seeded through the grammar under the production digest
(`sha256Addr`) — generated by executing the model, never hand-typed.

## No emitted header

Every other JSON emitter in `tools/` heads its documents with
`Gate.Emitted`. This one does not, and the reason is that these are not
the estate's documents about itself: a vector document and the index
beside it are WIRE documents, shaped by canonical schema codes
(`Cas.Vectors.Wire.VectorDocument`, `VectorIndex`) that are themselves
committed and content-addressed under `schemas/`, and decoded on the
TypeScript side through the Effect Schema mirrors of those same codes.
A field this emitter alone wrote would be a field the format does not
declare. The version these documents carry is the FORMAT's
(`schemaVersion`, already in every one of them), which is the thing a
reader of a wire document needs; adding a second one describing the
printer would put provenance where the format goes.
-/

open Cas Cas.Vectors Cas.Vectors.Registry Cas.Grammar

namespace VectorsMain

/-! ## The registered content lives in `Cas.Vectors.Registry` -/

/-- Lift one grammar term into a non-empty vector candidate. -/
def vector {sort : Ty} (name : VectorName) (description : String)
    (tree : Tree sort) : ConformanceVector where
  name := name
  description := description
  word := ⟨tree.flatten sha256Addr, Tree.flatten_nonempty sha256Addr tree⟩

/-- The vector format's own canonical schema, stored as a schema node
(sort 0x53): the payload IS the code's schema-node payload
(`SelfCodec`), no references — the store word that carries the
format's identity. -/
def schemaVectorCandidate : IO ConformanceVector := do
  if small : (Cas.Grammar.utf8 vectorDocumentCode.payload).length < 4294967296 then
    pure (vector
      ⟨"schema-vector-document", by simp [validVectorName, validVectorNameTail]⟩
      "the vector format's own canonical schema as a schema node (sort 0x53)"
      (.schema ⟨Cas.Grammar.utf8 vectorDocumentCode.payload, small⟩))
  else
    throw (IO.userError "schema vector: payload exceeds the node byte bound")

/-- The candidate registry: every vector in one place. Registry
checking performs admission once and rejects duplicate file names. -/
def candidates : List ConformanceVector := [
  vector ⟨"value-single", by simp [validVectorName, validVectorNameTail]⟩
    "one opaque value node, no references" helloValue,
  vector ⟨"blob-two-leaves", by simp [validVectorName, validVectorNameTail]⟩
    "a two-leaf blob: chunk, leaf, parent, manifest" blobTwoLeaves,
  vector ⟨"file-readme", by simp [validVectorName, validVectorNameTail]⟩
    "a named file over a one-chunk blob manifest" fileReadme,
  vector ⟨"journal-two-entries", by simp [validVectorName, validVectorNameTail]⟩
    "a journal: genesis and two entries over saved files" journalTwo,
  vector ⟨"shared-chunk", by simp [validVectorName, validVectorNameTail]⟩
    "a blob whose two leaves share one chunk — the word carries a duplicate binding that replays as a dedup"
    blobSharedChunk,
  vector ⟨"git-pin-commit", by simp [validVectorName, validVectorNameTail]⟩
    "the lean4-tree-sitter pin commit as a git node (sort 0x47): the payload is the loose-object preimage, so sha1(payload) IS the git id 3a57f55e…"
    gitPinCommit
]

/-! ## Emission -/

def outDir : System.FilePath := "vectors"

def pathOf (v : CheckedConformanceVector) : System.FilePath :=
  outDir / v.fileName

def orThrow : Except VectorError α → IO α
  | .ok value => pure value
  | .error error => throw (IO.userError error.message)

def checkedRegistry : IO VectorRegistry := do
  let schemaVector ← schemaVectorCandidate
  orThrow (VectorRegistry.check (candidates ++ [schemaVector]))

def indexPath : System.FilePath := outDir / "index.json"

/-- The registry rendered as the driver's fixtures: one document per
admitted vector, then the tracking manifest. Admission runs here — a
vector that does not admit fails before a byte is written. -/
def fixtures : IO (List Gate.Fixture) := do
  let registry ← checkedRegistry
  let index ← orThrow (indexDocument registry)
  return registry.vectors.map (fun v =>
      ({ path := pathOf v, content := v.document,
         label := s!"{v.bindingCount} bindings" } : Gate.Fixture)) ++
    [⟨indexPath, index, s!"{registry.length} vectors"⟩]

end VectorsMain

def main := Gate.main "lake exe vectors" VectorsMain.fixtures
