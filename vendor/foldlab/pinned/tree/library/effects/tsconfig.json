{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          // Style suggestions, not correctness: they fire on settled,
          // committed patterns across src/bin/test (Schema.Struct with a
          // `_tag` field, Schema.Number on domain fields, decodeUnknown*
          // over already-typed input) with no local judgment call to
          // make, so every agent had to re-derive "not mine, not a bug"
          // ~99 times per typecheck run. Silenced at the source instead.
          "schemaStructWithTag": "off",
          "schemaNumber": "off",
          "preferTypedSchemaDecoder": "off",
          "schemaSyncInEffect": "off",
          "catchToIgnore": "off",
          "asyncFunction": "off",
          "cryptoRandomUUID": "off",
          "cryptoRandomUUIDInEffect": "off",
          "globalConsole": "off",
          "globalConsoleInEffect": "off",
          "globalDate": "off",
          "globalDateInEffect": "off",
          "globalFetch": "off",
          "globalFetchInEffect": "off",
          "globalRandom": "off",
          "globalRandomInEffect": "off",
          "globalTimers": "off",
          "globalTimersInEffect": "off",
          "newPromise": "off",
          "nodeBuiltinImport": "off",
          "preferSchemaOverJson": "off",
          "processEnv": "off",
          "processEnvInEffect": "off",
          "tryCatchInEffectGen": "off"
        }
      }
    ]
  },
  "include": ["src"]
}
