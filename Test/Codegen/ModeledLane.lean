import Effect4.Schema.Modeled.Derive
import Effect4.Store.Domain.Shape

/-!
# The Modeled lane: a derived codec, lowered to OCaml and run against Lean's bytes

`deriving Modeled` writes each instance's staged image: the carrier fold's image at the type,
written as its combinators (`docs/research/2026-10-16-modeled-universe/README.md` §3.3). This lane
lowers that codec through the LCNF route (`ocaml/gen/roots.json`) into
`ocaml/engine/test/modeled/modeled_gen.ml`. The dune test there checks two things against Lean's
canonical bytes, which `write.lean` writes into `modeled.txt`:

- the writer: each sample that the lowered code builds is encoded to Lean's bytes;
- the reader: each input, well formed or not, round-trips through the lowered reader and writer
  to Lean's answer, `none` where Lean's reader refuses.

The types reach every shape of the checked domain: a record of records, a sum of records with
`_tag` columns, a literal enum, an integer of either sign, a list, an option, a string outside
ASCII, a natural and a flag.
-/

open Effect4 Effect4.Schema Effect4.Store

namespace Test.Codegen.ModeledLane

structure Todo where
  id : Nat
  title : String
  done : Bool
  deriving Modeled

inductive Status where
  | pending
  | closed (reason : String)
  deriving Modeled

inductive Color where
  | red | green | blue
  deriving Modeled

structure Item where
  name : String
  qty : Int
  tags : List String
  note : Option String
  status : Status
  todo : Todo
  color : Color
  deriving Modeled

/-- The lowered writer. -/
def encodeItem (i : Item) : Val := (Modeled.image Item).toVal i
/-- The lowered reader. -/
def decodeItem (v : Val) : Option Item := (Modeled.image Item).ofVal v
/-- The reader, then the writer: `none` where the reader refuses. -/
def roundTrip (v : Val) : Option Val := (decodeItem v).map encodeItem

/-- The samples, built by the lowered code too. -/
def samples : List Item := [
  ⟨"café", -3, [], none, .pending, ⟨1, "write the lane", false⟩, .red⟩,
  ⟨"plain", 42, ["a", "b"], some "a note", .closed "done", ⟨2, "ship", true⟩, .blue⟩,
  ⟨"", 0, ["ü"], some "", .closed "", ⟨0, "", false⟩, .green⟩,
  ⟨"big", -4611686018427387903, ["x"], none, .pending, ⟨4611686018427387903, "max", true⟩, .red⟩]

/-- The samples' encodings, as the lowered writer makes them. -/
def sampleVals : List Val := samples.map encodeItem

/-- An encoding with one field replaced, or removed when the value is `none`, the order kept. -/
def edit (v : Val) (field : String) (value : Option Val) : Val :=
  match v with
  | .ctor 0 [.list names, .list values] =>
    let pairs := (names.zip values).filterMap fun (n, x) =>
      if n == .str field then value.map (n, ·) else some (n, x)
    .ctor 0 [.list (pairs.map Prod.fst), .list (pairs.map Prod.snd)]
  | _ => v

/-- A column of an encoding: the value a record frame holds at a field. -/
def column (v : Val) (field : String) : Val :=
  match v with
  | .ctor 0 [.list names, .list values] =>
    ((names.zip values).find? (·.1 == .str field)).map Prod.snd |>.getD v
  | _ => v

/-- The first sample's encoding. -/
def first : Val := encodeItem ⟨"café", -3, [], none, .pending, ⟨1, "write the lane", false⟩, .red⟩

/-- Inputs Lean's reader refuses, each for one reason, named as the fixture line names it. -/
def refused : List (String × Val) := [
  ("a_field_missing", edit first "todo" none),
  ("an_unknown_tag", edit first "status" (some (.ctor 0 [.list [.str "_tag"], .list [.str "archived"]]))),
  ("a_string_where_an_integer_stands", edit first "qty" (some (.str "3"))),
  ("a_negative_integer_where_a_natural_stands",
    edit first "todo" (some (edit (column first "todo") "id" (some (.negInt 0))))),
  ("a_colour_outside_the_enum", edit first "color" (some (.str "purple"))),
  ("a_record_that_is_no_record", .list [.str "name"]),
  ("names_out_of_order", match first with
    | .ctor 0 [.list names, .list values] => .ctor 0 [.list names.reverse, .list values.reverse]
    | v => v)]

/-- Bytes in lowercase hexadecimal. -/
def hex (v : Val) : String := hexString (Val.encode v)

/-- Each line the dune test reads: the samples' encodings, then each input with Lean's round
trip. -/
def answers : List String :=
  sampleVals.map (fun v => "sample " ++ hex v) ++
  (sampleVals.map ("well_formed", ·) ++ refused).map fun (why, v) =>
    "input " ++ hex v ++ " " ++ ((roundTrip v).map hex).getD "none" ++ " " ++ why

/-- The fixture: `answers` under the generated header, which `write.lean` writes beside the test. -/
def fixtureText : String :=
  "# GENERATED by Test/Codegen/ModeledLane.lean; do not edit.\n" ++
  "# Write again: lake env lean --run ocaml/engine/test/modeled/write.lean\n" ++
  String.intercalate "\n" answers ++ "\n"

-- Finite evaluation: Lean's reader refuses every input of `refused`, and reads every sample.
#guard refused.all fun (_, v) => (roundTrip v).isNone
#guard sampleVals.all fun v => roundTrip v == some v

end Test.Codegen.ModeledLane
