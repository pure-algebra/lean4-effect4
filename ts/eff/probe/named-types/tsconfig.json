{
  "//": "The compiler options of the printed modules (harness/truth/tsconfig.json). Each case file names the diagnostic codes it expects in its first line; run.ts compares.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["cases/*.ts", "run.ts", "documents.run.ts"]
}
