{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  "include": [
    "./Person.generated.ts",
    "./runtime-check.ts",
    "./AllRepresentations.generated.ts",
    "./coverage-runtime-check.ts",
    "./TwoRoots.generated.ts",
    "./multi-runtime-check.ts"
  ]
}
