import Effect4.Target.TypeScript.Schema

/-!
Emits the two-root multi-document fixture.

`Schema.multiDocumentSource` renders a bare value, not a module: there is no
`module?` entry point for `MultiDocument`. The import line and the single
export below are therefore harness scaffolding; only the value expression is
generated. The emitted bytes are still byte-compared by
`scripts/check-schema-typescript-generation.sh`, so drift in either part is
caught.
-/

namespace Effect4Harness.SchemaGenerationMulti

open Effect4

private def multi : MultiDocument :=
  { representations := [Schema.string, Schema.boolean]
    references := [{ key := "shared", representation := Schema.number }] }

private def fixture : String :=
  String.intercalate "\n"
    [ "/**"
    , " * Generated by Effect4 Schema."
    , " *"
    , " * Do not edit."
    , " */"
    , "import * as Schema from \"effect/Schema\""
    , ""
    , "/** Raw Effect Schema multi-root document. */"
    , "export const TwoRootsSchemaJson: Schema.Json = " ++
        Target.TypeScript.Schema.multiDocumentSource multi
    , "" ]

#eval IO.print fixture

end Effect4Harness.SchemaGenerationMulti
