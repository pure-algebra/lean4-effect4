{
  "//": "Slice E4: tsgo 7 type-checks the to-do's emitted service (in the keyed lane's work folder), its consumer and the runner, with the compiler options of harness/truth/tsconfig.json.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["consumer.ts", "run-todo.ts"]
}
