{
  "//": "Slice E4: tsgo 7 type-checks the to-do's emitted service and its consumer (in apps/todo/) and the runner, with the compiler options of harness/truth/tsconfig.json.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["run-todo.ts", "../../../apps/todo/consumer.ts"]
}
