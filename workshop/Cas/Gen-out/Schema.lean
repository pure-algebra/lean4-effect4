    intro v hv
    simp only [toValL1, List.mem_cons] at hv
    rcases hv with rfl | hv
    · exact fitsCheck x
    · exact fitsL1 xs v hv
termination_by structural xs
theorem fitsL2 (xs : _root_.List (_root_.Effect4.ElementOf (_root_.Effect4.Representation))) :
    ∀ v ∈ toValL2 xs,
