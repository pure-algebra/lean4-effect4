  | .mk a0 a1 a2 a3 a4 => .ctor 0 [Canonical.toVal a0, toValRepresentation a1,
      Canonical.toVal a2, Canonical.toVal a3, Canonical.toVal a4]
def toValIndexSignatureOf : _root_.Effect4.IndexSignatureOf (_root_.Effect4.Representation) → Val
  | .mk a0 a1 => .ctor 0 [toValRepresentation a0, toValRepresentation a1]
def toValL0 : _root_.List (_root_.Effect4.Representation) → List Val
  | [] => []
  | x :: xs => toValRepresentation x :: toValL0 xs
def toValL1 : _root_.List (_root_.Effect4.Check) → List Val
  | [] => []
  | x :: xs => toValCheck x :: toValL1 xs
def toValL2 : _root_.List (_root_.Effect4.ElementOf (_root_.Effect4.Representation)) → List Val
