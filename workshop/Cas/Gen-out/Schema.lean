      (shape (_root_.List (_root_.Effect4.EnumEntry))).defs ++
      (shape _root_.Effect4.UnionMode).defs ++ (shape _root_.Bool).defs ++
      (shape _root_.String).defs ++ (shape _root_.Effect4.Json).defs ++
