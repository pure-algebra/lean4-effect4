     ("isMutable", (shape _root_.Bool).root),
     ("annotations", (shape (_root_.Option (_root_.List (_root_.Effect4.AnnotationEntry)))).root)]

def IndexSignatureOfShape : Shape :=
  .struct "IndexSignatureOf" [("parameter", .named "Representation"),
     ("type", .named "Representation")]

