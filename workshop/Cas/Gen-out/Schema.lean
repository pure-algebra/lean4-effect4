def defs : List (String × Shape) :=
  ("Representation", RepresentationShape) :: ("Check", CheckShape) ::
    ("CheckRepresentationAnnotationOf", CheckRepresentationAnnotationOfShape) ::
    ("ElementOf", ElementOfShape) :: ("PropertySignatureOf", PropertySignatureOfShape) ::
    ("IndexSignatureOf", IndexSignatureOfShape) ::
    ((shape _root_.Effect4.RepresentationAnnotation).defs ++
      (shape (_root_.Option (_root_.List (_root_.Effect4.AnnotationEntry)))).defs ++
      (shape _root_.Effect4.ReferenceKey).defs ++ (shape _root_.Effect4.LiteralValue).defs ++
