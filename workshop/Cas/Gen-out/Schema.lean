def toValL4 : _root_.List (_root_.Effect4.IndexSignatureOf (_root_.Effect4.Representation)) → List Val
  | [] => []
  | x :: xs => toValIndexSignatureOf x :: toValL4 xs
def toValO5 : _root_.Option (_root_.Effect4.CheckRepresentationAnnotationOf (_root_.Effect4.Representation)) → Val
  | none => .none
