theorem fitsO5 (o : _root_.Option (_root_.Effect4.CheckRepresentationAnnotationOf (_root_.Effect4.Representation))) :
    acceptsIn defs (.option (.named "CheckRepresentationAnnotationOf"))
      (toValO5 o) = true := by
  match o with
  | none => exact accepts_option_none _ _
  | some x =>
    exact accepts_option_some _ _ _ (fitsCheckRepresentationAnnotationOf x)
termination_by structural o
theorem fitsL6 (xs : _root_.List (_root_.Effect4.Representation)) :
    ∀ v ∈ toValL6 xs,
      acceptsIn defs (.named "Representation") v = true := by
  match xs with
  | [] =>
    intro v hv
    exact nomatch hv
  | x :: xs =>
