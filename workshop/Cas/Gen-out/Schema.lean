namespace ReferenceEntryC

def shapeDoc : ShapeDoc :=
  ⟨.struct "ReferenceEntry" [("key", (shape _root_.String).root),
     ("representation", (shape _root_.Effect4.Representation).root)],
   (shape _root_.String).defs ++ (shape _root_.Effect4.Representation).defs⟩

def toVal : _root_.Effect4.ReferenceEntry → Val
  | .mk a0 a1 => .ctor 0 [Canonical.toVal a0, Canonical.toVal a1]

def ofVal : Val → Option (_root_.Effect4.ReferenceEntry)
  | .ctor 0 [v0, v1] =>
    match Canonical.ofVal (α := _root_.String) v0,
        Canonical.ofVal (α := _root_.Effect4.Representation) v1 with
    | some a0, some a1 => some ⟨a0, a1⟩
    | _, _ => none
  | _ => none

theorem ofVal_toVal (a : _root_.Effect4.ReferenceEntry) : ofVal (toVal a) = some a := by
  obtain ⟨a0, a1⟩ := a
  simp [toVal, ofVal, Canonical.ofVal_toVal]

theorem ofVal_exact {v : Val} {a : _root_.Effect4.ReferenceEntry} (h : ofVal v = some a) :
    v = toVal a := by
  unfold ofVal at h
  split at h
  · next v0 v1 =>
    split at h
    · next b0 b1 h0 h1 =>
      injection h with h
      subst h
      simp only [toVal]
      rw [Canonical.ofVal_exact h0, Canonical.ofVal_exact h1]
    · exact nomatch h
  · exact nomatch h

theorem lift_String (x : _root_.String) :
    acceptsIn shapeDoc.defs (shape _root_.String).root (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset (fun _ hp => mem_append_of_left (hp))
    _ _ (Canonical.fits x)
theorem lift_Representation (x : _root_.Effect4.Representation) :
    acceptsIn shapeDoc.defs (shape _root_.Effect4.Representation).root
      (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset (fun _ hp => mem_append_of_right (hp))
    _ _ (Canonical.fits x)

theorem fits (a : _root_.Effect4.ReferenceEntry) : shapeDoc.accepts (toVal a) = true := by
  obtain ⟨a0, a1⟩ := a
  apply accepts_struct
  exact
    (acceptsFields_cons _ _ _ _ _ _ (lift_String a0)
      (acceptsFields_cons _ _ _ _ _ _ (lift_Representation a1) (acceptsFields_nil _)))

instance instCanonical : Canonical (_root_.Effect4.ReferenceEntry) :=
  ⟨shapeDoc, toVal, ofVal, ofVal_toVal, ofVal_exact, fits⟩

end ReferenceEntryC

