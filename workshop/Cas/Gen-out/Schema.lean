/-- Into the appended tail of the block's table. -/
theorem mem_tail {p : String × Shape}
    (h : p ∈ (shape _root_.Effect4.RepresentationAnnotation).defs ++
      (shape (_root_.Option (_root_.List (_root_.Effect4.AnnotationEntry)))).defs ++
      (shape _root_.Effect4.ReferenceKey).defs ++ (shape _root_.Effect4.LiteralValue).defs ++
      (shape _root_.Effect4.GlobalSymbolKey).defs ++
      (shape (_root_.List (_root_.Effect4.EnumEntry))).defs ++
      (shape _root_.Effect4.UnionMode).defs ++ (shape _root_.Bool).defs ++
      (shape _root_.String).defs ++ (shape _root_.Effect4.Json).defs ++
      (shape _root_.Effect4.PropertyKey).defs) : p ∈ defs :=
  List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (h))))))

