/-! ## Acceptance against the hand oracle and the goldens

Appended verbatim by `--append`; not generated. Two oracles: `Cas/Program.lean`'s hand
`ProgramCanonical`, which lane S1 proved, and `ocaml/goldens/eff/*.hex`, the bytes the OCaml
host writes. The hex literals below are the golden files' contents, copied by
`workshop/Cas/tools/generate-derived.ps1`; agreement of the two `toVal`s is agreement of the
bytes, because `Canonical.encode` is `Val.encode` of the image and nothing else reads the
carrier. -/

namespace ProgramAcceptance

open Effect4.Program (Eff NativeOp Term Terms Lit CauseTerm)

/-- The corpus of `Wire.lean:576-618`, as `Cas/Program.lean` copies it. -/
abbrev corpus : List (Eff NativeOp) := ProgramCanonical.Corpus.all

/-- The generated bytes of a program, lowercase hex: the goldens' spelling. -/
def genHex (p : Eff NativeOp) : String := hexString (Val.encode (ProgramGen.EffC.toValEff p))

/-- The generated exact decoder, spelled without the instance so that the hand instance in
scope cannot answer for it. -/
def genDecode (b : Bytes) : Option (Eff NativeOp) :=
  (Val.decode b).bind (guarded ProgramGen.EffC.toValEff ProgramGen.EffC.rawEff)

-- The generated image is the hand image, tree for tree, on the whole corpus.
#guard corpus.all fun p => ProgramGen.EffC.toValEff p = ProgramCanonical.EffC.toValEff p
#guard corpus.all fun p =>
  Val.encode (ProgramGen.EffC.toValEff p) = Val.encode (ProgramCanonical.EffC.toValEff p)

-- The alphabets and the term family agree with the hand instances constructor by constructor.
#guard [Lit.unit, .nat 42, .bool true, .bool false, .str "x"].all fun l =>
  ProgramGen.LitC.toVal l = ProgramCanonical.LitC.toVal l
#guard [Effect4.Machine.FnName.incr, .double, .zeroWhenPositive, .noChange, .takeAndBump].all
  fun f => ProgramGen.FnNameC.toVal f = ProgramCanonical.FnNameC.toVal f
#guard [Effect4.Supervision.MaskMode.interruptible, .uninterruptible, .inherit].all fun m =>
  ProgramGen.MaskModeC.toVal m = ProgramCanonical.MaskModeC.toVal m
#guard [Effect4.Supervision.ObserverMode.awaitValue, .joinEffect].all fun m =>
  ProgramGen.ObserverModeC.toVal m = ProgramCanonical.ObserverModeC.toVal m
#guard [Effect4.FinalizerStrategy.sequential, .parallel].all fun s =>
  ProgramGen.FinalizerStrategyC.toVal s = ProgramCanonical.StrategyC.toVal s
#guard [NativeOp.refMake, .refGet, .refSet, .refGetAndSet, .refSetAndGet, .refUpdate .incr,
    .refGetAndUpdate .double, .refUpdateAndGet .noChange, .refUpdateSome .incr,
    .refGetAndUpdateSome .incr, .refUpdateSomeAndGet .incr, .refModify .takeAndBump,
    .refModifySome .incr, .deferredMake, .deferredIsDone, .deferredPoll, .deferredSucceed,
    .deferredFail, .deferredAwait, .scopeMake .parallel].all fun o =>
  ProgramGen.NativeOpC.toVal o = ProgramCanonical.NativeOpC.toVal o
#guard ProgramGen.ForkOptionsC.toVal ProgramCanonical.Corpus.forkOptions =
  ProgramCanonical.ForkOptionsC.toVal ProgramCanonical.Corpus.forkOptions
#guard [Term.var 0, .lit (.nat 1), .app "succ" (.cons (.var 0) .nil)].all fun t =>
  ProgramGen.TermC.toValTerm t = ProgramCanonical.TermC.toValT t
#guard [CauseTerm.fail (.lit (.nat 1)), .die (.var 0), .interrupt none,
    .interrupt (some (.var 1)), .both (.fail (.var 0)) (.die (.var 1))].all fun c =>
  ProgramGen.CauseTermC.toValCauseTerm c = ProgramCanonical.CauseC.toVal c

-- The bytes of the eight corpus programs, against `ocaml/goldens/eff/*.hex`.
#guard genHex ProgramCanonical.Corpus.p42 =
  "0a00000000000000390200000000000000000a0000000000000027020000000000000001010a0000000000000014020000000000000001010200000000000000012a"
#guard genHex ProgramCanonical.Corpus.pBind =
  ""
#guard genHex ProgramCanonical.Corpus.pFork =
  ""
#guard genHex ProgramCanonical.Corpus.pAwait =
  ""
#guard genHex ProgramCanonical.Corpus.pGen =
  ""
#guard genHex ProgramCanonical.Corpus.pLoop =
  ""
#guard genHex ProgramCanonical.Corpus.pCatch =
  ""
#guard genHex ProgramCanonical.Corpus.pScope =
  ""

-- The facts note's §6 receipts, on the generated image.
#guard (Val.encode (ProgramGen.EffC.toValEff ProgramCanonical.Corpus.p42)).length = 66
#guard (sha256 (Val.encode (ProgramGen.EffC.toValEff ProgramCanonical.Corpus.p42))).hex =
  "fa5f40f054198e91b2446522308e197b0a02c4edfe823f894763d3aa63ad62a3"

-- The generated reader round-trips the corpus and refuses a byte appended or dropped.
#guard corpus.all fun p => genDecode (Val.encode (ProgramGen.EffC.toValEff p)) = some p
#guard corpus.all fun p => genDecode (Val.encode (ProgramGen.EffC.toValEff p) ++ [0]) = none
#guard corpus.all fun p =>
  genDecode (Val.encode (ProgramGen.EffC.toValEff p)).dropLast = none
-- A non-canonical natural inside a program is refused (`Wire.lean:628`, restated).
#guard genDecode
  (framed Tag.ctor (framed Tag.nat [0, 17] ++ Val.encode (ProgramGen.TermC.toValTerm (.lit .unit))))
  = none

-- Every corpus tree fits the generated shape, and the hand shape accepts the generated image.
#guard corpus.all fun p =>
  (ShapeDoc.mk (.named "Eff") ProgramGen.EffC.defs).accepts (ProgramGen.EffC.toValEff p)
#guard corpus.all fun p =>
  (ShapeDoc.mk (.named "Eff") ProgramCanonical.EffC.defs).accepts (ProgramGen.EffC.toValEff p)

end ProgramAcceptance
