      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «interrupt» a0 =>
    exact acceptsAt_sum _ _ _ 2 "interrupt" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_OptionTerm a0) (acceptsFields_nil _))
  | «both» a0 a1 =>
