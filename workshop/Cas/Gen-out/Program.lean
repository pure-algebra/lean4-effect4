  | .forkIn a0 a1 a2 => .ctor 1 [toValEff a0, Canonical.toVal a1, Canonical.toVal a2]
  | .forkScoped a0 a1 => .ctor 2 [toValEff a0, Canonical.toVal a1]
  | .runIn a0 a1 => .ctor 3 [Canonical.toVal a0, Canonical.toVal a1]
  | .interrupt a0 => .ctor 4 [Canonical.toVal a0]
  | .interruptScoped a0 => .ctor 5 [Canonical.toVal a0]
  | .interruptAll a0 a1 => .ctor 6 [Canonical.toVal a0, Canonical.toVal a1]
  | .awaitAll a0 => .ctor 7 [Canonical.toVal a0]
  | .awaitAllFailFast a0 => .ctor 8 [Canonical.toVal a0]
  | .snapshotChildren => .ctor 9 []
  | .awaitNewChildren a0 => .ctor 10 [Canonical.toVal a0]
  | .raceAll a0 => .ctor 11 [toValEffs a0]
  | .setContext a0 => .ctor 12 [Canonical.toVal a0]
  | .getContext => .ctor 13 []
  | .getId => .ctor 14 []
