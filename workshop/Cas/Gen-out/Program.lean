/-! The structural readers. Exactness is bought by the re-encode guard, so a reader
only has to be a left inverse. -/

mutual
def rawEff : Val → Option (_root_.Effect4.Program.Eff (_root_.Effect4.Program.NativeOp))
  | .ctor 0 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.succeed a0)
    | _ => none
  | .ctor 1 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.fail a0)
    | _ => none
  | .ctor 2 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.CauseTerm) v0 with
    | some a0 => some (.failCause a0)
    | _ => none
  | .ctor 3 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.yieldError a0)
    | _ => none
  | .ctor 4 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.sync a0)
    | _ => none
  | .ctor 5 [v0] =>
    match rawEff v0 with
    | some a0 => some (.suspend a0)
    | _ => none
  | .ctor 6 [v0, v1] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.NativeOp) v0,
        Canonical.ofVal (α := _root_.Effect4.Program.Term) v1 with
    | some a0, some a1 => some (.perform a0 a1)
    | _, _ => none
  | .ctor 7 [v0, v1] =>
    match rawEff v0, rawEff v1 with
    | some a0, some a1 => some (.bind a0 a1)
    | _, _ => none
  | .ctor 8 [v0] =>
    match rawStmts v0 with
    | some a0 => some (.gen a0)
    | _ => none
  | .ctor 9 [v0, v1] =>
    match rawEff v0, rawEff v1 with
    | some a0, some a1 => some (.catchCause a0 a1)
    | _, _ => none
  | .ctor 10 [v0, v1, v2] =>
    match rawEff v0, rawEff v1, rawEff v2 with
    | some a0, some a1, some a2 => some (.matchCause a0 a1 a2)
    | _, _, _ => none
  | .ctor 11 [v0, v1] =>
    match rawEff v0, rawEff v1 with
    | some a0, some a1 => some (.onExit a0 a1)
    | _, _ => none
  | .ctor 12 [v0] =>
    match rawEff v0 with
    | some a0 => some (.exit a0)
    | _ => none
  | .ctor 13 [v0] =>
    match rawEff v0 with
    | some a0 => some (.uninterruptible a0)
    | _ => none
  | .ctor 14 [v0] =>
    match rawEff v0 with
    | some a0 => some (.interruptible a0)
    | _ => none
  | .ctor 15 [v0, v1, v2] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0, rawEff v1, rawEff v2 with
    | some a0, some a1, some a2 => some (.branch a0 a1 a2)
    | _, _, _ => none
  | .ctor 16 [v0, v1, v2, v3] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0,
        Canonical.ofVal (α := _root_.Effect4.Program.Term) v1,
        Canonical.ofVal (α := _root_.Effect4.Program.Term) v2, rawEff v3 with
    | some a0, some a1, some a2, some a3 => some (.whileLoop a0 a1 a2 a3)
    | _, _, _, _ => none
  | .ctor 17 [v0] =>
    match Canonical.ofVal (α := _root_.Nat) v0 with
    | some a0 => some (.yieldNow a0)
    | _ => none
  | .ctor 18 [v0, v1] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.NativeOp) v0,
        Canonical.ofVal (α := _root_.Effect4.Program.Term) v1 with
    | some a0, some a1 => some (.callback a0 a1)
    | _, _ => none
  | .ctor 19 [v0, v1] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0,
        Canonical.ofVal (α := _root_.Effect4.Supervision.ObserverMode) v1 with
    | some a0, some a1 => some (.awaitFiber a0 a1)
    | _, _ => none
  | .ctor 20 [v0] =>
    match rawActionTerm v0 with
    | some a0 => some (.withFiber a0)
    | _ => none
  | .ctor 21 [v0] =>
    match rawEff v0 with
    | some a0 => some (.scoped a0)
    | _ => none
  | .ctor 22 [v0, v1] =>
    match rawEff v0, rawEff v1 with
    | some a0, some a1 => some (.acquireRelease a0 a1)
    | _, _ => none
  | .ctor 23 [v0, v1, v2] =>
    match Canonical.ofVal (α := _root_.Nat) v0, rawEff v1, rawEff v2 with
    | some a0, some a1, some a2 => some (.choose a0 a1 a2)
    | _, _, _ => none
  | _ => none
def rawStmt : Val → Option (_root_.Effect4.Program.Stmt (_root_.Effect4.Program.NativeOp))
  | .ctor 0 [v0] =>
    match rawEff v0 with
    | some a0 => some (.bindYield a0)
    | _ => none
  | .ctor 1 [v0] =>
    match rawEff v0 with
    | some a0 => some (.yieldDiscard a0)
    | _ => none
  | .ctor 2 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.ret a0)
    | _ => none
  | .ctor 3 [v0, v1, v2] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0, rawStmts v1, rawStmts v2 with
    | some a0, some a1, some a2 => some (.ifElse a0 a1 a2)
    | _, _, _ => none
  | .ctor 4 [v0] =>
    match rawStmts v0 with
    | some a0 => some (.whileTrue a0)
    | _ => none
  | .ctor 5 [] => some .breakLoop
  | _ => none
def rawStmts : Val → Option (_root_.Effect4.Program.Stmts (_root_.Effect4.Program.NativeOp))
  | .ctor 0 [] => some .nil
  | .ctor 1 [v0, v1] =>
    match rawStmt v0, rawStmts v1 with
    | some a0, some a1 => some (.cons a0 a1)
    | _, _ => none
  | _ => none
def rawEffs : Val → Option (_root_.Effect4.Program.Effs (_root_.Effect4.Program.NativeOp))
  | .ctor 0 [] => some .nil
  | .ctor 1 [v0, v1] =>
    match rawEff v0, rawEffs v1 with
    | some a0, some a1 => some (.cons a0 a1)
    | _, _ => none
  | _ => none
def rawActionTerm :
  Val → Option (_root_.Effect4.Program.ActionTerm (_root_.Effect4.Program.NativeOp))
  | .ctor 0 [v0, v1] =>
    match rawEff v0, Canonical.ofVal (α := _root_.Effect4.Supervision.ForkOptions) v1 with
    | some a0, some a1 => some (.fork a0 a1)
    | _, _ => none
  | .ctor 1 [v0, v1, v2] =>
    match rawEff v0, Canonical.ofVal (α := _root_.Effect4.Supervision.ForkOptions) v1,
        Canonical.ofVal (α := _root_.Effect4.Program.Term) v2 with
    | some a0, some a1, some a2 => some (.forkIn a0 a1 a2)
    | _, _, _ => none
  | .ctor 2 [v0, v1] =>
    match rawEff v0, Canonical.ofVal (α := _root_.Effect4.Supervision.ForkOptions) v1 with
    | some a0, some a1 => some (.forkScoped a0 a1)
    | _, _ => none
  | .ctor 3 [v0, v1] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0,
        Canonical.ofVal (α := _root_.Effect4.Program.Term) v1 with
    | some a0, some a1 => some (.runIn a0 a1)
    | _, _ => none
  | .ctor 4 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.interrupt a0)
    | _ => none
  | .ctor 5 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.interruptScoped a0)
    | _ => none
  | .ctor 6 [v0, v1] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0,
        Canonical.ofVal (α := (_root_.Option (_root_.Effect4.Program.Term))) v1 with
    | some a0, some a1 => some (.interruptAll a0 a1)
    | _, _ => none
  | .ctor 7 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.awaitAll a0)
    | _ => none
  | .ctor 8 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.awaitAllFailFast a0)
    | _ => none
  | .ctor 9 [] => some .snapshotChildren
  | .ctor 10 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.awaitNewChildren a0)
    | _ => none
  | .ctor 11 [v0] =>
    match rawEffs v0 with
    | some a0 => some (.raceAll a0)
    | _ => none
  | .ctor 12 [v0] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0 with
    | some a0 => some (.setContext a0)
    | _ => none
  | .ctor 13 [] => some .getContext
  | .ctor 14 [] => some .getId
  | .ctor 15 [v0, v1] =>
    match Canonical.ofVal (α := _root_.Effect4.Program.Term) v0,
        Canonical.ofVal (α := _root_.Effect4.Program.Term) v1 with
    | some a0, some a1 => some (.closeScope a0 a1)
    | _, _ => none
  | _ => none
end

mutual
theorem rawEff_toValEff (a : _root_.Effect4.Program.Eff (_root_.Effect4.Program.NativeOp)) :
    rawEff (toValEff a) = some a := by
  cases a with
  | «succeed» a0 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «fail» a0 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «failCause» a0 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «yieldError» a0 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «sync» a0 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «suspend» a0 =>
    simp [toValEff, rawEff, rawEff_toValEff a0]
  | «perform» a0 a1 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «bind» a0 a1 =>
    simp [toValEff, rawEff, rawEff_toValEff a0, rawEff_toValEff a1]
  | «gen» a0 =>
    simp [toValEff, rawEff, rawStmts_toValStmts a0]
  | «catchCause» a0 a1 =>
    simp [toValEff, rawEff, rawEff_toValEff a0, rawEff_toValEff a1]
  | «matchCause» a0 a1 a2 =>
    simp [toValEff, rawEff, rawEff_toValEff a0, rawEff_toValEff a1, rawEff_toValEff a2]
  | «onExit» a0 a1 =>
    simp [toValEff, rawEff, rawEff_toValEff a0, rawEff_toValEff a1]
  | «exit» a0 =>
    simp [toValEff, rawEff, rawEff_toValEff a0]
  | «uninterruptible» a0 =>
    simp [toValEff, rawEff, rawEff_toValEff a0]
  | «interruptible» a0 =>
    simp [toValEff, rawEff, rawEff_toValEff a0]
  | «branch» a0 a1 a2 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal, rawEff_toValEff a1, rawEff_toValEff a2]
  | «whileLoop» a0 a1 a2 a3 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal, rawEff_toValEff a3]
  | «yieldNow» a0 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «callback» a0 a1 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «awaitFiber» a0 a1 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal]
  | «withFiber» a0 =>
    simp [toValEff, rawEff, rawActionTerm_toValActionTerm a0]
  | «scoped» a0 =>
    simp [toValEff, rawEff, rawEff_toValEff a0]
  | «acquireRelease» a0 a1 =>
    simp [toValEff, rawEff, rawEff_toValEff a0, rawEff_toValEff a1]
  | «choose» a0 a1 a2 =>
    simp [toValEff, rawEff, Canonical.ofVal_toVal, rawEff_toValEff a1, rawEff_toValEff a2]
termination_by structural a
theorem rawStmt_toValStmt (a : _root_.Effect4.Program.Stmt (_root_.Effect4.Program.NativeOp)) :
    rawStmt (toValStmt a) = some a := by
  cases a with
  | «bindYield» a0 =>
    simp [toValStmt, rawStmt, rawEff_toValEff a0]
  | «yieldDiscard» a0 =>
    simp [toValStmt, rawStmt, rawEff_toValEff a0]
  | «ret» a0 =>
    simp [toValStmt, rawStmt, Canonical.ofVal_toVal]
  | «ifElse» a0 a1 a2 =>
    simp [toValStmt, rawStmt, Canonical.ofVal_toVal, rawStmts_toValStmts a1,
      rawStmts_toValStmts a2]
  | «whileTrue» a0 =>
    simp [toValStmt, rawStmt, rawStmts_toValStmts a0]
  | «breakLoop» => rfl
termination_by structural a
theorem rawStmts_toValStmts (a : _root_.Effect4.Program.Stmts (_root_.Effect4.Program.NativeOp)) :
    rawStmts (toValStmts a) = some a := by
  cases a with
  | «nil» => rfl
  | «cons» a0 a1 =>
    simp [toValStmts, rawStmts, rawStmt_toValStmt a0, rawStmts_toValStmts a1]
termination_by structural a
theorem rawEffs_toValEffs (a : _root_.Effect4.Program.Effs (_root_.Effect4.Program.NativeOp)) :
    rawEffs (toValEffs a) = some a := by
  cases a with
  | «nil» => rfl
  | «cons» a0 a1 =>
    simp [toValEffs, rawEffs, rawEff_toValEff a0, rawEffs_toValEffs a1]
termination_by structural a
theorem rawActionTerm_toValActionTerm
  (a : _root_.Effect4.Program.ActionTerm (_root_.Effect4.Program.NativeOp)) :
    rawActionTerm (toValActionTerm a) = some a := by
  cases a with
  | «fork» a0 a1 =>
    simp [toValActionTerm, rawActionTerm, rawEff_toValEff a0, Canonical.ofVal_toVal]
  | «forkIn» a0 a1 a2 =>
    simp [toValActionTerm, rawActionTerm, rawEff_toValEff a0, Canonical.ofVal_toVal]
  | «forkScoped» a0 a1 =>
    simp [toValActionTerm, rawActionTerm, rawEff_toValEff a0, Canonical.ofVal_toVal]
  | «runIn» a0 a1 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «interrupt» a0 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «interruptScoped» a0 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «interruptAll» a0 a1 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «awaitAll» a0 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «awaitAllFailFast» a0 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «snapshotChildren» => rfl
  | «awaitNewChildren» a0 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «raceAll» a0 =>
    simp [toValActionTerm, rawActionTerm, rawEffs_toValEffs a0]
  | «setContext» a0 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
  | «getContext» => rfl
  | «getId» => rfl
  | «closeScope» a0 a1 =>
    simp [toValActionTerm, rawActionTerm, Canonical.ofVal_toVal]
termination_by structural a
end

/-! The table memberships and the field lifts, one per member and one per field type. -/

theorem mem_Eff : ("Eff", EffShape) ∈ defs := List.Mem.head _
theorem mem_Stmt : ("Stmt", StmtShape) ∈ defs := List.Mem.tail _ (List.Mem.head _)
theorem mem_Stmts : ("Stmts", StmtsShape) ∈ defs :=
  List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))
theorem mem_Effs : ("Effs", EffsShape) ∈ defs :=
  List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))
theorem mem_ActionTerm : ("ActionTerm", ActionTermShape) ∈ defs :=
  List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _))))

/-- Into the appended tail of the block's table. -/
theorem mem_tail {p : String × Shape}
    (h : p ∈ (shape _root_.Effect4.Program.Term).defs ++
      (shape _root_.Effect4.Program.CauseTerm).defs ++
      (shape _root_.Effect4.Program.NativeOp).defs ++ (shape _root_.Nat).defs ++
      (shape _root_.Effect4.Supervision.ObserverMode).defs ++
      (shape _root_.Effect4.Supervision.ForkOptions).defs ++
      (shape (_root_.Option (_root_.Effect4.Program.Term))).defs) : p ∈ defs :=
  List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.tail _ (h)))))

theorem lift_Term (x : _root_.Effect4.Program.Term) :
    acceptsIn defs (shape _root_.Effect4.Program.Term).root (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset
    (fun _ hp => mem_tail (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_left (hp))))))))
    _ _ (Canonical.fits x)
theorem lift_CauseTerm (x : _root_.Effect4.Program.CauseTerm) :
    acceptsIn defs (shape _root_.Effect4.Program.CauseTerm).root (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset
    (fun _ hp => mem_tail (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_right (hp))))))))
    _ _ (Canonical.fits x)
theorem lift_NativeOp (x : _root_.Effect4.Program.NativeOp) :
    acceptsIn defs (shape _root_.Effect4.Program.NativeOp).root (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset
    (fun _ hp => mem_tail (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_right (hp)))))))
    _ _ (Canonical.fits x)
theorem lift_Nat (x : _root_.Nat) :
    acceptsIn defs (shape _root_.Nat).root (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset
    (fun _ hp => mem_tail (mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_right (hp))))))
    _ _ (Canonical.fits x)
theorem lift_ObserverMode (x : _root_.Effect4.Supervision.ObserverMode) :
    acceptsIn defs (shape _root_.Effect4.Supervision.ObserverMode).root
      (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset
    (fun _ hp => mem_tail (mem_append_of_left (mem_append_of_left (mem_append_of_right (hp)))))
    _ _ (Canonical.fits x)
theorem lift_ForkOptions (x : _root_.Effect4.Supervision.ForkOptions) :
    acceptsIn defs (shape _root_.Effect4.Supervision.ForkOptions).root
      (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset (fun _ hp => mem_tail (mem_append_of_left (mem_append_of_right (hp))))
    _ _ (Canonical.fits x)
theorem lift_OptionTerm (x : (_root_.Option (_root_.Effect4.Program.Term))) :
    acceptsIn defs (shape (_root_.Option (_root_.Effect4.Program.Term))).root
      (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset (fun _ hp => mem_tail (mem_append_of_right (hp)))
    _ _ (Canonical.fits x)

mutual
theorem fitsEff (a : _root_.Effect4.Program.Eff (_root_.Effect4.Program.NativeOp)) :
    acceptsIn defs (.named "Eff") (toValEff a) = true := by
  apply accepts_named_of_mem _ _ EffShape _ mem_Eff
  cases a with
  | «succeed» a0 =>
    exact acceptsAt_sum _ _ _ 0 "succeed" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «fail» a0 =>
    exact acceptsAt_sum _ _ _ 1 "fail" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «failCause» a0 =>
    exact acceptsAt_sum _ _ _ 2 "failCause" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_CauseTerm a0) (acceptsFields_nil _))
  | «yieldError» a0 =>
    exact acceptsAt_sum _ _ _ 3 "yieldError" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «sync» a0 =>
    exact acceptsAt_sum _ _ _ 4 "sync" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «suspend» a0 =>
    exact acceptsAt_sum _ _ _ 5 "suspend" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0) (acceptsFields_nil _))
  | «perform» a0 a1 =>
    exact acceptsAt_sum _ _ _ 6 "perform" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_NativeOp a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_Term a1) (acceptsFields_nil _)))
  | «bind» a0 a1 =>
    exact acceptsAt_sum _ _ _ 7 "bind" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEff a1) (acceptsFields_nil _)))
  | «gen» a0 =>
    exact acceptsAt_sum _ _ _ 8 "gen" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsStmts a0) (acceptsFields_nil _))
  | «catchCause» a0 a1 =>
    exact acceptsAt_sum _ _ _ 9 "catchCause" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEff a1) (acceptsFields_nil _)))
  | «matchCause» a0 a1 a2 =>
    exact acceptsAt_sum _ _ _ 10 "matchCause" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEff a1)
          (acceptsFields_cons _ _ _ _ _ _ (fitsEff a2) (acceptsFields_nil _))))
  | «onExit» a0 a1 =>
    exact acceptsAt_sum _ _ _ 11 "onExit" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEff a1) (acceptsFields_nil _)))
  | «exit» a0 =>
    exact acceptsAt_sum _ _ _ 12 "exit" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0) (acceptsFields_nil _))
  | «uninterruptible» a0 =>
    exact acceptsAt_sum _ _ _ 13 "uninterruptible" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0) (acceptsFields_nil _))
  | «interruptible» a0 =>
    exact acceptsAt_sum _ _ _ 14 "interruptible" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0) (acceptsFields_nil _))
  | «branch» a0 a1 a2 =>
    exact acceptsAt_sum _ _ _ 15 "branch" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEff a1)
          (acceptsFields_cons _ _ _ _ _ _ (fitsEff a2) (acceptsFields_nil _))))
  | «whileLoop» a0 a1 a2 a3 =>
    exact acceptsAt_sum _ _ _ 16 "whileLoop" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_Term a1)
          (acceptsFields_cons _ _ _ _ _ _ (lift_Term a2)
            (acceptsFields_cons _ _ _ _ _ _ (fitsEff a3) (acceptsFields_nil _)))))
  | «yieldNow» a0 =>
    exact acceptsAt_sum _ _ _ 17 "yieldNow" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Nat a0) (acceptsFields_nil _))
  | «callback» a0 a1 =>
    exact acceptsAt_sum _ _ _ 18 "callback" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_NativeOp a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_Term a1) (acceptsFields_nil _)))
  | «awaitFiber» a0 a1 =>
    exact acceptsAt_sum _ _ _ 19 "awaitFiber" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_ObserverMode a1) (acceptsFields_nil _)))
  | «withFiber» a0 =>
    exact acceptsAt_sum _ _ _ 20 "withFiber" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsActionTerm a0) (acceptsFields_nil _))
  | «scoped» a0 =>
    exact acceptsAt_sum _ _ _ 21 "scoped" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0) (acceptsFields_nil _))
  | «acquireRelease» a0 a1 =>
    exact acceptsAt_sum _ _ _ 22 "acquireRelease" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEff a1) (acceptsFields_nil _)))
  | «choose» a0 a1 a2 =>
    exact acceptsAt_sum _ _ _ 23 "choose" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Nat a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEff a1)
          (acceptsFields_cons _ _ _ _ _ _ (fitsEff a2) (acceptsFields_nil _))))
termination_by structural a
theorem fitsStmt (a : _root_.Effect4.Program.Stmt (_root_.Effect4.Program.NativeOp)) :
    acceptsIn defs (.named "Stmt") (toValStmt a) = true := by
  apply accepts_named_of_mem _ _ StmtShape _ mem_Stmt
  cases a with
  | «bindYield» a0 =>
    exact acceptsAt_sum _ _ _ 0 "bindYield" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0) (acceptsFields_nil _))
  | «yieldDiscard» a0 =>
    exact acceptsAt_sum _ _ _ 1 "yieldDiscard" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0) (acceptsFields_nil _))
  | «ret» a0 =>
    exact acceptsAt_sum _ _ _ 2 "ret" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «ifElse» a0 a1 a2 =>
    exact acceptsAt_sum _ _ _ 3 "ifElse" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsStmts a1)
          (acceptsFields_cons _ _ _ _ _ _ (fitsStmts a2) (acceptsFields_nil _))))
  | «whileTrue» a0 =>
    exact acceptsAt_sum _ _ _ 4 "whileTrue" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsStmts a0) (acceptsFields_nil _))
  | «breakLoop» =>
    exact acceptsAt_sum _ _ _ 5 "breakLoop" [] [] rfl (acceptsFields_nil _)
termination_by structural a
theorem fitsStmts (a : _root_.Effect4.Program.Stmts (_root_.Effect4.Program.NativeOp)) :
    acceptsIn defs (.named "Stmts") (toValStmts a) = true := by
  apply accepts_named_of_mem _ _ StmtsShape _ mem_Stmts
  cases a with
  | «nil» =>
    exact acceptsAt_sum _ _ _ 0 "nil" [] [] rfl (acceptsFields_nil _)
  | «cons» a0 a1 =>
    exact acceptsAt_sum _ _ _ 1 "cons" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsStmt a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsStmts a1) (acceptsFields_nil _)))
termination_by structural a
theorem fitsEffs (a : _root_.Effect4.Program.Effs (_root_.Effect4.Program.NativeOp)) :
    acceptsIn defs (.named "Effs") (toValEffs a) = true := by
  apply accepts_named_of_mem _ _ EffsShape _ mem_Effs
  cases a with
  | «nil» =>
    exact acceptsAt_sum _ _ _ 0 "nil" [] [] rfl (acceptsFields_nil _)
  | «cons» a0 a1 =>
    exact acceptsAt_sum _ _ _ 1 "cons" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (fitsEffs a1) (acceptsFields_nil _)))
termination_by structural a
theorem fitsActionTerm (a : _root_.Effect4.Program.ActionTerm (_root_.Effect4.Program.NativeOp)) :
    acceptsIn defs (.named "ActionTerm") (toValActionTerm a) = true := by
  apply accepts_named_of_mem _ _ ActionTermShape _ mem_ActionTerm
  cases a with
  | «fork» a0 a1 =>
    exact acceptsAt_sum _ _ _ 0 "fork" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_ForkOptions a1) (acceptsFields_nil _)))
  | «forkIn» a0 a1 a2 =>
    exact acceptsAt_sum _ _ _ 1 "forkIn" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_ForkOptions a1)
          (acceptsFields_cons _ _ _ _ _ _ (lift_Term a2) (acceptsFields_nil _))))
  | «forkScoped» a0 a1 =>
    exact acceptsAt_sum _ _ _ 2 "forkScoped" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEff a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_ForkOptions a1) (acceptsFields_nil _)))
  | «runIn» a0 a1 =>
    exact acceptsAt_sum _ _ _ 3 "runIn" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_Term a1) (acceptsFields_nil _)))
  | «interrupt» a0 =>
    exact acceptsAt_sum _ _ _ 4 "interrupt" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «interruptScoped» a0 =>
    exact acceptsAt_sum _ _ _ 5 "interruptScoped" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «interruptAll» a0 a1 =>
    exact acceptsAt_sum _ _ _ 6 "interruptAll" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_OptionTerm a1) (acceptsFields_nil _)))
  | «awaitAll» a0 =>
    exact acceptsAt_sum _ _ _ 7 "awaitAll" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «awaitAllFailFast» a0 =>
    exact acceptsAt_sum _ _ _ 8 "awaitAllFailFast" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «snapshotChildren» =>
    exact acceptsAt_sum _ _ _ 9 "snapshotChildren" [] [] rfl (acceptsFields_nil _)
  | «awaitNewChildren» a0 =>
    exact acceptsAt_sum _ _ _ 10 "awaitNewChildren" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «raceAll» a0 =>
    exact acceptsAt_sum _ _ _ 11 "raceAll" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (fitsEffs a0) (acceptsFields_nil _))
  | «setContext» a0 =>
    exact acceptsAt_sum _ _ _ 12 "setContext" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0) (acceptsFields_nil _))
  | «getContext» =>
    exact acceptsAt_sum _ _ _ 13 "getContext" [] [] rfl (acceptsFields_nil _)
  | «getId» =>
    exact acceptsAt_sum _ _ _ 14 "getId" [] [] rfl (acceptsFields_nil _)
  | «closeScope» a0 a1 =>
    exact acceptsAt_sum _ _ _ 15 "closeScope" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Term a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_Term a1) (acceptsFields_nil _)))
termination_by structural a
end

