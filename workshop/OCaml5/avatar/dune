; Seat F1: the avatar under dune. One library of the Deep ports and the fixtures, two
; executables (the trace face and the witness report), each in the three modes of ruling 7:
; bytecode, native, and js_of_ocaml under `--enable effects` (the modelled backend, 5.7.1).
;
; `corpus_data.ml` is generated from `corpus/programs.txt` exactly as `build-avatar.sh`
; generates it, so the corpus is compiled in and there is no file to open under jsoo.
; `jsprobe.ml` (the JS-boundary probe, built with `-no-check-prims` and its own runtime),
; `fuzz_register.ml` (links P5's generated `corpus_fixture.ml`, which `run-fuzz.sh` copies in)
; and the `server/` directory (seat W2) are outside this build.
;
; No ppx yet: the generated carriers will carry `[@@deriving sexp, compare, equal, fields,
; variants]` once the generator emits the attributes through the descriptions
; (`Render.lean`, SEAT W1) and the hand-written carriers they reference derive too -- the
; report names the obstacle (closures in `run_fiber`/`kops`; `[@sexp.opaque]` per field).

(rule
 (target corpus_data.ml)
 (deps corpus/programs.txt)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(* Generated by dune from corpus/programs.txt. Do not edit. *)\n")
    (echo "let text = {corpus|")
    (cat corpus/programs.txt)
    (echo "|corpus}\n")))))

(library
 (name effect4_avatar)
 (wrapped false)
 (modules
  deep_fibers deep_stores deep_context deep_layer deep_forkflow avatar_trace deep_census deep_clauses deep_witnesses
  fibers_fixture store_fixtures extra_fixture corpus_dsl corpus_data corpus_run)
 (flags (:standard -w -a)))

(executables
 (names avatar_main avatar_witnesses)
 (modules avatar_main avatar_witnesses)
 (libraries effect4_avatar)
 (modes byte exe js)
 (js_of_ocaml (flags (--enable effects --target-env=nodejs)))
 (flags (:standard -w -a)))
