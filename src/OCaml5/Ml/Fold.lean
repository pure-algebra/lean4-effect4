structure DeclAlgebra (R : DeclFam → Type u) where
  decl_types : (List OCaml5.Ml.TypeDecl) → R .decl
  decl_letD : (Bool) → (List OCaml5.Ml.Bind) → R .decl
  decl_comment : (String) → R .decl
  decl_rawD : (String) → R .decl
  decl_moduleD : (String) → (List (Prod String String)) → List (R .decl) → R .decl
  decl_floatingAttrD : (String) → R .decl
  decl_blank : R .decl
  decl_openD : (String) → R .decl
  decl_moduleTypeD : (String) → (List OCaml5.Ml.SigItem) → R .decl
  decl_moduleRecD : (List (Prod String (List OCaml5.Ml.SigItem))) → R .decl
  decl_moduleAliasD : (String) → (String) → R .decl
  decl_includeD : (String) → R .decl

mutual
def cata_decl {R : DeclFam → Type u} (alg : DeclAlgebra R)
    (node : OCaml5.Ml.Decl) : R .decl :=
  match node with
  | .types a0 => alg.decl_types a0
  | .letD a0 a1 => alg.decl_letD a0 a1
  | .comment a0 => alg.decl_comment a0
  | .rawD a0 => alg.decl_rawD a0
  | .moduleD a0 a1 a2 => alg.decl_moduleD a0 a1 (cata_pos_list_decl alg a2)
  | .floatingAttrD a0 => alg.decl_floatingAttrD a0
  | .blank => alg.decl_blank
  | .openD a0 => alg.decl_openD a0
  | .moduleTypeD a0 a1 => alg.decl_moduleTypeD a0 a1
  | .moduleRecD a0 => alg.decl_moduleRecD a0
  | .moduleAliasD a0 a1 => alg.decl_moduleAliasD a0 a1
  | .includeD a0 => alg.decl_includeD a0
termination_by structural node
def cata_pos_list_decl {R : DeclFam → Type u} (alg : DeclAlgebra R)
    (xs : List OCaml5.Ml.Decl) : List (R .decl) :=
  match xs with
  | [] => []
  | x :: rest => cata_decl alg x :: cata_pos_list_decl alg rest
termination_by structural xs
end

theorem cata_pos_list_decl_eq {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (xs : List OCaml5.Ml.Decl) :
    cata_pos_list_decl alg xs = xs.map (cata_decl alg) := by
  induction xs with
  | nil => simp only [cata_pos_list_decl, List.map_nil]
  | cons x rest ih => simp only [cata_pos_list_decl, List.map_cons, ih]

@[simp] theorem cata_decl_types {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : List OCaml5.Ml.TypeDecl) :
    cata_decl alg (.types a0) =
      alg.decl_types a0 := rfl

@[simp] theorem cata_decl_letD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : Bool) (a1 : List OCaml5.Ml.Bind) :
    cata_decl alg (.letD a0 a1) =
      alg.decl_letD a0 a1 := rfl

@[simp] theorem cata_decl_comment {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) :
    cata_decl alg (.comment a0) =
      alg.decl_comment a0 := rfl

@[simp] theorem cata_decl_rawD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) :
    cata_decl alg (.rawD a0) =
      alg.decl_rawD a0 := rfl

@[simp] theorem cata_decl_moduleD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) (a1 : List (Prod String String)) (a2 : List OCaml5.Ml.Decl) :
    cata_decl alg (.moduleD a0 a1 a2) =
      alg.decl_moduleD a0 a1 (a2.map (cata_decl alg)) := by
  simp only [cata_decl, cata_pos_list_decl_eq]

@[simp] theorem cata_decl_floatingAttrD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) :
    cata_decl alg (.floatingAttrD a0) =
      alg.decl_floatingAttrD a0 := rfl

@[simp] theorem cata_decl_blank {R : DeclFam → Type u}
    (alg : DeclAlgebra R) :
    cata_decl alg (.blank) =
      alg.decl_blank := rfl

@[simp] theorem cata_decl_openD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) :
    cata_decl alg (.openD a0) =
      alg.decl_openD a0 := rfl

@[simp] theorem cata_decl_moduleTypeD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) (a1 : List OCaml5.Ml.SigItem) :
    cata_decl alg (.moduleTypeD a0 a1) =
      alg.decl_moduleTypeD a0 a1 := rfl

@[simp] theorem cata_decl_moduleRecD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : List (Prod String (List OCaml5.Ml.SigItem))) :
    cata_decl alg (.moduleRecD a0) =
      alg.decl_moduleRecD a0 := rfl

@[simp] theorem cata_decl_moduleAliasD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) (a1 : String) :
    cata_decl alg (.moduleAliasD a0 a1) =
      alg.decl_moduleAliasD a0 a1 := rfl

@[simp] theorem cata_decl_includeD {R : DeclFam → Type u}
    (alg : DeclAlgebra R) (a0 : String) :
    cata_decl alg (.includeD a0) =
      alg.decl_includeD a0 := rfl

structure DeclHom {R : DeclFam → Type u} (alg : DeclAlgebra R) where
  f_decl : OCaml5.Ml.Decl → R .decl
  h_decl_types : ∀ a0, f_decl (.types a0) =
    alg.decl_types a0
  h_decl_letD : ∀ a0 a1, f_decl (.letD a0 a1) =
    alg.decl_letD a0 a1
  h_decl_comment : ∀ a0, f_decl (.comment a0) =
    alg.decl_comment a0
  h_decl_rawD : ∀ a0, f_decl (.rawD a0) =
    alg.decl_rawD a0
  h_decl_moduleD : ∀ a0 a1 a2, f_decl (.moduleD a0 a1 a2) =
    alg.decl_moduleD a0 a1 (a2.map f_decl)
  h_decl_floatingAttrD : ∀ a0, f_decl (.floatingAttrD a0) =
    alg.decl_floatingAttrD a0
  h_decl_blank : f_decl (.blank) =
    alg.decl_blank
  h_decl_openD : ∀ a0, f_decl (.openD a0) =
    alg.decl_openD a0
  h_decl_moduleTypeD : ∀ a0 a1, f_decl (.moduleTypeD a0 a1) =
    alg.decl_moduleTypeD a0 a1
  h_decl_moduleRecD : ∀ a0, f_decl (.moduleRecD a0) =
    alg.decl_moduleRecD a0
  h_decl_moduleAliasD : ∀ a0 a1, f_decl (.moduleAliasD a0 a1) =
    alg.decl_moduleAliasD a0 a1
  h_decl_includeD : ∀ a0, f_decl (.includeD a0) =
    alg.decl_includeD a0

mutual
theorem hom_eq_cata_decl {R : DeclFam → Type u}
    {alg : DeclAlgebra R} (hom : DeclHom alg) (node : OCaml5.Ml.Decl) :
    hom.f_decl node = cata_decl alg node := by
  match node with
  | .types a0 =>
    simp only [cata_decl, hom.h_decl_types a0]
  | .letD a0 a1 =>
    simp only [cata_decl, hom.h_decl_letD a0 a1]
  | .comment a0 =>
    simp only [cata_decl, hom.h_decl_comment a0]
  | .rawD a0 =>
    simp only [cata_decl, hom.h_decl_rawD a0]
  | .moduleD a0 a1 a2 =>
    simp only [cata_decl, hom.h_decl_moduleD a0 a1 a2, hom_pos_list_decl hom a2]
  | .floatingAttrD a0 =>
    simp only [cata_decl, hom.h_decl_floatingAttrD a0]
  | .blank =>
    simp only [cata_decl, hom.h_decl_blank]
  | .openD a0 =>
    simp only [cata_decl, hom.h_decl_openD a0]
  | .moduleTypeD a0 a1 =>
    simp only [cata_decl, hom.h_decl_moduleTypeD a0 a1]
  | .moduleRecD a0 =>
    simp only [cata_decl, hom.h_decl_moduleRecD a0]
  | .moduleAliasD a0 a1 =>
    simp only [cata_decl, hom.h_decl_moduleAliasD a0 a1]
  | .includeD a0 =>
    simp only [cata_decl, hom.h_decl_includeD a0]
termination_by structural node
theorem hom_pos_list_decl {R : DeclFam → Type u}
    {alg : DeclAlgebra R} (hom : DeclHom alg) (xs : List OCaml5.Ml.Decl) :
    xs.map hom.f_decl = cata_pos_list_decl alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_decl, List.map_nil]
  | x :: rest => simp only [cata_pos_list_decl, List.map_cons, hom_eq_cata_decl hom x, hom_pos_list_decl hom rest]
termination_by structural xs
end

abbrev DeclSelfCarrier : DeclFam → Type
  | .decl => OCaml5.Ml.Decl

def DeclAlgebra.id : DeclAlgebra (DeclSelfCarrier) where
  decl_types a0 := OCaml5.Ml.Decl.types a0
  decl_letD a0 a1 := OCaml5.Ml.Decl.letD a0 a1
  decl_comment a0 := OCaml5.Ml.Decl.comment a0
  decl_rawD a0 := OCaml5.Ml.Decl.rawD a0
  decl_moduleD a0 a1 a2 := OCaml5.Ml.Decl.moduleD a0 a1 a2
  decl_floatingAttrD a0 := OCaml5.Ml.Decl.floatingAttrD a0
  decl_blank := OCaml5.Ml.Decl.blank
  decl_openD a0 := OCaml5.Ml.Decl.openD a0
  decl_moduleTypeD a0 a1 := OCaml5.Ml.Decl.moduleTypeD a0 a1
  decl_moduleRecD a0 := OCaml5.Ml.Decl.moduleRecD a0
  decl_moduleAliasD a0 a1 := OCaml5.Ml.Decl.moduleAliasD a0 a1
  decl_includeD a0 := OCaml5.Ml.Decl.includeD a0

mutual
@[simp] theorem cata_id_decl (node : OCaml5.Ml.Decl) :
    cata_decl (DeclAlgebra.id) node = node := by
  match node with
  | .types a0 =>
    simp only [cata_decl]
    rfl
  | .letD a0 a1 =>
    simp only [cata_decl]
    rfl
  | .comment a0 =>
    simp only [cata_decl]
    rfl
  | .rawD a0 =>
    simp only [cata_decl]
    rfl
  | .moduleD a0 a1 a2 =>
    simp only [cata_decl, cata_id_pos_list_decl a2]
    rfl
  | .floatingAttrD a0 =>
    simp only [cata_decl]
    rfl
  | .blank =>
    simp only [cata_decl]
    rfl
  | .openD a0 =>
    simp only [cata_decl]
    rfl
  | .moduleTypeD a0 a1 =>
    simp only [cata_decl]
    rfl
  | .moduleRecD a0 =>
    simp only [cata_decl]
    rfl
  | .moduleAliasD a0 a1 =>
    simp only [cata_decl]
    rfl
  | .includeD a0 =>
    simp only [cata_decl]
    rfl
termination_by structural node
theorem cata_id_pos_list_decl (xs : List OCaml5.Ml.Decl) :
    cata_pos_list_decl (DeclAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_decl]
  | x :: rest => simp only [cata_pos_list_decl, cata_id_decl x, cata_id_pos_list_decl rest]
termination_by structural xs
end

mutual
def foldMap_decl {M : Type u} (unit : M) (op : M → M → M) (node : OCaml5.Ml.Decl)
    (f_decl : OCaml5.Ml.Decl → M := fun _ => unit) : M :=
  match node with
  | .types a0 =>
    f_decl (.types a0)
  | .letD a0 a1 =>
    f_decl (.letD a0 a1)
  | .comment a0 =>
    f_decl (.comment a0)
  | .rawD a0 =>
    f_decl (.rawD a0)
  | .moduleD a0 a1 a2 =>
    op (f_decl (.moduleD a0 a1 a2)) ((foldMap_pos_list_decl unit op a2 f_decl))
  | .floatingAttrD a0 =>
    f_decl (.floatingAttrD a0)
  | .blank =>
    f_decl (.blank)
  | .openD a0 =>
    f_decl (.openD a0)
  | .moduleTypeD a0 a1 =>
    f_decl (.moduleTypeD a0 a1)
  | .moduleRecD a0 =>
    f_decl (.moduleRecD a0)
  | .moduleAliasD a0 a1 =>
    f_decl (.moduleAliasD a0 a1)
  | .includeD a0 =>
    f_decl (.includeD a0)
termination_by structural node
def foldMap_pos_list_decl {M : Type u} (unit : M) (op : M → M → M) (xs : List OCaml5.Ml.Decl)
    (f_decl : OCaml5.Ml.Decl → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_decl unit op x f_decl) (foldMap_pos_list_decl unit op rest f_decl)
termination_by structural xs
end

end OCaml5.Ml
