@[simp] theorem cata_id_expr (node : OCaml5.Ml.Expr) :
    cata_expr (ExprAlgebra.id) node = node := by
  match node with
  | .var a0 =>
    simp only [cata_expr]
    rfl
  | .int a0 =>
    simp only [cata_expr]
    rfl
  | .str a0 =>
    simp only [cata_expr]
    rfl
  | .bool a0 =>
    simp only [cata_expr]
    rfl
  | .unit =>
    simp only [cata_expr]
    rfl
  | .ctor a0 a1 =>
    simp only [cata_expr, cata_id_pos_list_expr a1]
    rfl
  | .app a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_pos_list_expr a1]
    rfl
  | .appL a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_pos_list_prod_argLabel_expr a1]
    rfl
  | .binop a0 a1 a2 =>
    simp only [cata_expr, cata_id_expr a1, cata_id_expr a2]
    rfl
  | .fn a0 a1 =>
    simp only [cata_expr, cata_id_expr a1]
    rfl
  | .letIn a0 a1 a2 =>
    simp only [cata_expr, cata_id_expr a1, cata_id_expr a2]
    rfl
  | .letAttr a0 a1 a2 a3 =>
    simp only [cata_expr, cata_id_expr a2, cata_id_expr a3]
    rfl
  | .letRec a0 a1 a2 a3 =>
    simp only [cata_expr, cata_id_expr a2, cata_id_expr a3]
    rfl
  | .ifThen a0 a1 a2 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_expr a1, cata_id_expr a2]
    rfl
  | .matchE a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_pos_list_prod_pat_expr a1]
    rfl
  | .record a0 =>
    simp only [cata_expr, cata_id_pos_list_prod_string_expr a0]
    rfl
  | .field a0 a1 =>
    simp only [cata_expr, cata_id_expr a0]
    rfl
  | .tuple a0 =>
    simp only [cata_expr, cata_id_pos_list_expr a0]
    rfl
  | .listLit a0 =>
    simp only [cata_expr, cata_id_pos_list_expr a0]
    rfl
  | .annot a0 a1 =>
    simp only [cata_expr, cata_id_expr a0]
    rfl
  | .hole a0 a1 =>
    simp only [cata_expr, cata_id_expr a1]
    rfl
  | .assertE a0 =>
    simp only [cata_expr, cata_id_expr a0]
    rfl
  | .fnMatch a0 =>
    simp only [cata_expr, cata_id_pos_list_prod_pat_expr a0]
    rfl
  | .seq a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_expr a1]
    rfl
  | .letPat a0 a1 a2 =>
    simp only [cata_expr, cata_id_expr a1, cata_id_expr a2]
    rfl
  | .ifUnit a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_expr a1]
    rfl
  | .commented a0 a1 =>
    simp only [cata_expr, cata_id_expr a0]
    rfl
  | .pack a0 a1 =>
    simp only [cata_expr]
    rfl
termination_by structural node
theorem cata_id_pos_list_expr (xs : List OCaml5.Ml.Expr) :
    cata_pos_list_expr (ExprAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_expr]
