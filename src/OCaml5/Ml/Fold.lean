mutual
theorem hom_eq_cata_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (node : OCaml5.Ml.Expr) :
    hom.f_expr node = cata_expr alg node := by
  match node with
  | .var a0 =>
    simp only [cata_expr, hom.h_expr_var a0]
  | .int a0 =>
    simp only [cata_expr, hom.h_expr_int a0]
  | .str a0 =>
    simp only [cata_expr, hom.h_expr_str a0]
  | .bool a0 =>
    simp only [cata_expr, hom.h_expr_bool a0]
  | .unit =>
    simp only [cata_expr, hom.h_expr_unit]
  | .ctor a0 a1 =>
    simp only [cata_expr, hom.h_expr_ctor a0 a1, hom_pos_list_expr hom a1]
  | .app a0 a1 =>
    simp only [cata_expr, hom.h_expr_app a0 a1, hom_eq_cata_expr hom a0, hom_pos_list_expr hom a1]
  | .appL a0 a1 =>
    simp only [cata_expr, hom.h_expr_appL a0 a1, hom_eq_cata_expr hom a0, hom_pos_list_prod_argLabel_expr hom a1]
  | .binop a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_binop a0 a1 a2, hom_eq_cata_expr hom a1, hom_eq_cata_expr hom a2]
  | .fn a0 a1 =>
    simp only [cata_expr, hom.h_expr_fn a0 a1, hom_eq_cata_expr hom a1]
  | .letIn a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_letIn a0 a1 a2, hom_eq_cata_expr hom a1, hom_eq_cata_expr hom a2]
  | .letAttr a0 a1 a2 a3 =>
    simp only [cata_expr, hom.h_expr_letAttr a0 a1 a2 a3, hom_eq_cata_expr hom a2, hom_eq_cata_expr hom a3]
  | .letRec a0 a1 a2 a3 =>
    simp only [cata_expr, hom.h_expr_letRec a0 a1 a2 a3, hom_eq_cata_expr hom a2, hom_eq_cata_expr hom a3]
  | .ifThen a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_ifThen a0 a1 a2, hom_eq_cata_expr hom a0, hom_eq_cata_expr hom a1, hom_eq_cata_expr hom a2]
  | .matchE a0 a1 =>
    simp only [cata_expr, hom.h_expr_matchE a0 a1, hom_eq_cata_expr hom a0, hom_pos_list_prod_pat_expr hom a1]
  | .record a0 =>
    simp only [cata_expr, hom.h_expr_record a0, hom_pos_list_prod_string_expr hom a0]
  | .field a0 a1 =>
    simp only [cata_expr, hom.h_expr_field a0 a1, hom_eq_cata_expr hom a0]
  | .tuple a0 =>
    simp only [cata_expr, hom.h_expr_tuple a0, hom_pos_list_expr hom a0]
  | .listLit a0 =>
    simp only [cata_expr, hom.h_expr_listLit a0, hom_pos_list_expr hom a0]
  | .annot a0 a1 =>
    simp only [cata_expr, hom.h_expr_annot a0 a1, hom_eq_cata_expr hom a0]
  | .hole a0 a1 =>
    simp only [cata_expr, hom.h_expr_hole a0 a1, hom_eq_cata_expr hom a1]
  | .assertE a0 =>
    simp only [cata_expr, hom.h_expr_assertE a0, hom_eq_cata_expr hom a0]
  | .fnMatch a0 =>
    simp only [cata_expr, hom.h_expr_fnMatch a0, hom_pos_list_prod_pat_expr hom a0]
  | .seq a0 a1 =>
    simp only [cata_expr, hom.h_expr_seq a0 a1, hom_eq_cata_expr hom a0, hom_eq_cata_expr hom a1]
  | .letPat a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_letPat a0 a1 a2, hom_eq_cata_expr hom a1, hom_eq_cata_expr hom a2]
  | .ifUnit a0 a1 =>
    simp only [cata_expr, hom.h_expr_ifUnit a0 a1, hom_eq_cata_expr hom a0, hom_eq_cata_expr hom a1]
  | .commented a0 a1 =>
    simp only [cata_expr, hom.h_expr_commented a0 a1, hom_eq_cata_expr hom a0]
  | .pack a0 a1 =>
    simp only [cata_expr, hom.h_expr_pack a0 a1]
termination_by structural node
theorem hom_pos_list_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (xs : List OCaml5.Ml.Expr) :
    xs.map hom.f_expr = cata_pos_list_expr alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_expr, List.map_nil]
  | x :: rest => simp only [cata_pos_list_expr, List.map_cons, hom_eq_cata_expr hom x, hom_pos_list_expr hom rest]
termination_by structural xs
theorem hom_pos_prod_argLabel_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (x : OCaml5.Ml.ArgLabel × OCaml5.Ml.Expr) :
    prodMapSnd hom.f_expr x = cata_pos_prod_argLabel_expr alg x := by
  match x with
  | (u, v) => simp only [cata_pos_prod_argLabel_expr, prodMapSnd_mk, hom_eq_cata_expr hom v]
termination_by structural x
theorem hom_pos_list_prod_argLabel_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (xs : List (OCaml5.Ml.ArgLabel × OCaml5.Ml.Expr)) :
    xs.map (prodMapSnd hom.f_expr) = cata_pos_list_prod_argLabel_expr alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_prod_argLabel_expr, List.map_nil]
  | x :: rest => simp only [cata_pos_list_prod_argLabel_expr, List.map_cons, hom_pos_prod_argLabel_expr hom x, hom_pos_list_prod_argLabel_expr hom rest]
termination_by structural xs
theorem hom_pos_prod_pat_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (x : OCaml5.Ml.Pat × OCaml5.Ml.Expr) :
    prodMapSnd hom.f_expr x = cata_pos_prod_pat_expr alg x := by
  match x with
