    (f_pat : OCaml5.Ml.Pat → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_pat unit op v f_pat)
termination_by structural x
def foldMap_pos_list_prod_string_pat {M : Type u} (unit : M) (op : M → M → M) (xs : List (String × OCaml5.Ml.Pat))
    (f_pat : OCaml5.Ml.Pat → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_string_pat unit op x f_pat) (foldMap_pos_list_prod_string_pat unit op rest f_pat)
termination_by structural xs
end


inductive ExprFam where
  | expr
deriving DecidableEq, Repr

structure ExprAlgebra (R : ExprFam → Type u) where
  expr_var : (String) → R .expr
  expr_int : (Nat) → R .expr
  expr_str : (String) → R .expr
  expr_bool : (Bool) → R .expr
  expr_unit : R .expr
  expr_ctor : (String) → List (R .expr) → R .expr
  expr_app : R .expr → List (R .expr) → R .expr
  expr_appL : R .expr → List (OCaml5.Ml.ArgLabel × R .expr) → R .expr
  expr_binop : (String) → R .expr → R .expr → R .expr
  expr_fn : (List String) → R .expr → R .expr
  expr_letIn : (String) → R .expr → R .expr → R .expr
  expr_letAttr : (String) → (String) → R .expr → R .expr → R .expr
  expr_letRec : (String) → (List String) → R .expr → R .expr → R .expr
  expr_ifThen : R .expr → R .expr → R .expr → R .expr
  expr_matchE : R .expr → List (OCaml5.Ml.Pat × R .expr) → R .expr
  expr_record : List (String × R .expr) → R .expr
  expr_field : R .expr → (String) → R .expr
  expr_tuple : List (R .expr) → R .expr
  expr_listLit : List (R .expr) → R .expr
  expr_annot : R .expr → (OCaml5.Ml.Ty) → R .expr
  expr_hole : (String) → R .expr → R .expr
  expr_assertE : R .expr → R .expr
  expr_fnMatch : List (OCaml5.Ml.Pat × R .expr) → R .expr
  expr_seq : R .expr → R .expr → R .expr
  expr_letPat : (OCaml5.Ml.Pat) → R .expr → R .expr → R .expr
  expr_ifUnit : R .expr → R .expr → R .expr
  expr_commented : R .expr → (String) → R .expr
  expr_pack : (String) → (String) → R .expr

mutual
def cata_expr {R : ExprFam → Type u} (alg : ExprAlgebra R)
    (node : OCaml5.Ml.Expr) : R .expr :=
  match node with
  | .var a0 => alg.expr_var a0
  | .int a0 => alg.expr_int a0
  | .str a0 => alg.expr_str a0
  | .bool a0 => alg.expr_bool a0
  | .unit => alg.expr_unit
  | .ctor a0 a1 => alg.expr_ctor a0 (cata_pos_list_expr alg a1)
  | .app a0 a1 => alg.expr_app (cata_expr alg a0) (cata_pos_list_expr alg a1)
  | .appL a0 a1 => alg.expr_appL (cata_expr alg a0) (cata_pos_list_prod_argLabel_expr alg a1)
  | .binop a0 a1 a2 => alg.expr_binop a0 (cata_expr alg a1) (cata_expr alg a2)
  | .fn a0 a1 => alg.expr_fn a0 (cata_expr alg a1)
  | .letIn a0 a1 a2 => alg.expr_letIn a0 (cata_expr alg a1) (cata_expr alg a2)
  | .letAttr a0 a1 a2 a3 => alg.expr_letAttr a0 a1 (cata_expr alg a2) (cata_expr alg a3)
  | .letRec a0 a1 a2 a3 => alg.expr_letRec a0 a1 (cata_expr alg a2) (cata_expr alg a3)
  | .ifThen a0 a1 a2 => alg.expr_ifThen (cata_expr alg a0) (cata_expr alg a1) (cata_expr alg a2)
  | .matchE a0 a1 => alg.expr_matchE (cata_expr alg a0) (cata_pos_list_prod_pat_expr alg a1)
  | .record a0 => alg.expr_record (cata_pos_list_prod_string_expr alg a0)
  | .field a0 a1 => alg.expr_field (cata_expr alg a0) a1
  | .tuple a0 => alg.expr_tuple (cata_pos_list_expr alg a0)
  | .listLit a0 => alg.expr_listLit (cata_pos_list_expr alg a0)
  | .annot a0 a1 => alg.expr_annot (cata_expr alg a0) a1
  | .hole a0 a1 => alg.expr_hole a0 (cata_expr alg a1)
  | .assertE a0 => alg.expr_assertE (cata_expr alg a0)
  | .fnMatch a0 => alg.expr_fnMatch (cata_pos_list_prod_pat_expr alg a0)
  | .seq a0 a1 => alg.expr_seq (cata_expr alg a0) (cata_expr alg a1)
  | .letPat a0 a1 a2 => alg.expr_letPat a0 (cata_expr alg a1) (cata_expr alg a2)
  | .ifUnit a0 a1 => alg.expr_ifUnit (cata_expr alg a0) (cata_expr alg a1)
  | .commented a0 a1 => alg.expr_commented (cata_expr alg a0) a1
  | .pack a0 a1 => alg.expr_pack a0 a1
termination_by structural node
def cata_pos_list_expr {R : ExprFam → Type u} (alg : ExprAlgebra R)
    (xs : List OCaml5.Ml.Expr) : List (R .expr) :=
  match xs with
  | [] => []
  | x :: rest => cata_expr alg x :: cata_pos_list_expr alg rest
termination_by structural xs
def cata_pos_prod_argLabel_expr {R : ExprFam → Type u} (alg : ExprAlgebra R)
    (x : OCaml5.Ml.ArgLabel × OCaml5.Ml.Expr) : OCaml5.Ml.ArgLabel × R .expr :=
  match x with
  | (u, v) => (u, cata_expr alg v)
termination_by structural x
