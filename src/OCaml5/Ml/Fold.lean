def foldMap_expr {M : Type u} (unit : M) (op : M → M → M) (node : OCaml5.Ml.Expr)
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match node with
  | .var a0 =>
    f_expr (.var a0)
  | .int a0 =>
    f_expr (.int a0)
  | .str a0 =>
    f_expr (.str a0)
  | .bool a0 =>
    f_expr (.bool a0)
  | .unit =>
    f_expr (.unit)
  | .ctor a0 a1 =>
    op (f_expr (.ctor a0 a1)) ((foldMap_pos_list_expr unit op a1 f_expr))
  | .app a0 a1 =>
    op (f_expr (.app a0 a1)) (op (foldMap_expr unit op a0 f_expr) ((foldMap_pos_list_expr unit op a1 f_expr)))
  | .appL a0 a1 =>
    op (f_expr (.appL a0 a1)) (op (foldMap_expr unit op a0 f_expr) ((foldMap_pos_list_prod_argLabel_expr unit op a1 f_expr)))
  | .binop a0 a1 a2 =>
    op (f_expr (.binop a0 a1 a2)) (op (foldMap_expr unit op a1 f_expr) ((foldMap_expr unit op a2 f_expr)))
  | .fn a0 a1 =>
    op (f_expr (.fn a0 a1)) ((foldMap_expr unit op a1 f_expr))
  | .letIn a0 a1 a2 =>
    op (f_expr (.letIn a0 a1 a2)) (op (foldMap_expr unit op a1 f_expr) ((foldMap_expr unit op a2 f_expr)))
  | .letAttr a0 a1 a2 a3 =>
    op (f_expr (.letAttr a0 a1 a2 a3)) (op (foldMap_expr unit op a2 f_expr) ((foldMap_expr unit op a3 f_expr)))
  | .letRec a0 a1 a2 a3 =>
    op (f_expr (.letRec a0 a1 a2 a3)) (op (foldMap_expr unit op a2 f_expr) ((foldMap_expr unit op a3 f_expr)))
  | .ifThen a0 a1 a2 =>
    op (f_expr (.ifThen a0 a1 a2)) (op (foldMap_expr unit op a0 f_expr) (op (foldMap_expr unit op a1 f_expr) ((foldMap_expr unit op a2 f_expr))))
  | .matchE a0 a1 =>
    op (f_expr (.matchE a0 a1)) (op (foldMap_expr unit op a0 f_expr) ((foldMap_pos_list_prod_pat_expr unit op a1 f_expr)))
  | .record a0 =>
    op (f_expr (.record a0)) ((foldMap_pos_list_prod_string_expr unit op a0 f_expr))
  | .field a0 a1 =>
    op (f_expr (.field a0 a1)) ((foldMap_expr unit op a0 f_expr))
  | .tuple a0 =>
    op (f_expr (.tuple a0)) ((foldMap_pos_list_expr unit op a0 f_expr))
  | .listLit a0 =>
    op (f_expr (.listLit a0)) ((foldMap_pos_list_expr unit op a0 f_expr))
  | .annot a0 a1 =>
    op (f_expr (.annot a0 a1)) ((foldMap_expr unit op a0 f_expr))
  | .hole a0 a1 =>
    op (f_expr (.hole a0 a1)) ((foldMap_expr unit op a1 f_expr))
  | .assertE a0 =>
    op (f_expr (.assertE a0)) ((foldMap_expr unit op a0 f_expr))
  | .fnMatch a0 =>
    op (f_expr (.fnMatch a0)) ((foldMap_pos_list_prod_pat_expr unit op a0 f_expr))
  | .seq a0 a1 =>
    op (f_expr (.seq a0 a1)) (op (foldMap_expr unit op a0 f_expr) ((foldMap_expr unit op a1 f_expr)))
  | .letPat a0 a1 a2 =>
    op (f_expr (.letPat a0 a1 a2)) (op (foldMap_expr unit op a1 f_expr) ((foldMap_expr unit op a2 f_expr)))
  | .ifUnit a0 a1 =>
    op (f_expr (.ifUnit a0 a1)) (op (foldMap_expr unit op a0 f_expr) ((foldMap_expr unit op a1 f_expr)))
  | .commented a0 a1 =>
    op (f_expr (.commented a0 a1)) ((foldMap_expr unit op a0 f_expr))
  | .pack a0 a1 =>
    f_expr (.pack a0 a1)
termination_by structural node
def foldMap_pos_list_expr {M : Type u} (unit : M) (op : M → M → M) (xs : List OCaml5.Ml.Expr)
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_expr unit op x f_expr) (foldMap_pos_list_expr unit op rest f_expr)
termination_by structural xs
def foldMap_pos_prod_argLabel_expr {M : Type u} (unit : M) (op : M → M → M) (x : OCaml5.Ml.ArgLabel × OCaml5.Ml.Expr)
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_expr unit op v f_expr)
termination_by structural x
def foldMap_pos_list_prod_argLabel_expr {M : Type u} (unit : M) (op : M → M → M) (xs : List (OCaml5.Ml.ArgLabel × OCaml5.Ml.Expr))
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_argLabel_expr unit op x f_expr) (foldMap_pos_list_prod_argLabel_expr unit op rest f_expr)
termination_by structural xs
def foldMap_pos_prod_pat_expr {M : Type u} (unit : M) (op : M → M → M) (x : OCaml5.Ml.Pat × OCaml5.Ml.Expr)
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_expr unit op v f_expr)
termination_by structural x
def foldMap_pos_list_prod_pat_expr {M : Type u} (unit : M) (op : M → M → M) (xs : List (OCaml5.Ml.Pat × OCaml5.Ml.Expr))
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_pat_expr unit op x f_expr) (foldMap_pos_list_prod_pat_expr unit op rest f_expr)
termination_by structural xs
def foldMap_pos_prod_string_expr {M : Type u} (unit : M) (op : M → M → M) (x : String × OCaml5.Ml.Expr)
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_expr unit op v f_expr)
termination_by structural x
def foldMap_pos_list_prod_string_expr {M : Type u} (unit : M) (op : M → M → M) (xs : List (String × OCaml5.Ml.Expr))
    (f_expr : OCaml5.Ml.Expr → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_string_expr unit op x f_expr) (foldMap_pos_list_prod_string_expr unit op rest f_expr)
termination_by structural xs
end


