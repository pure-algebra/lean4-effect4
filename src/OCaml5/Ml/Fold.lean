theorem cata_pos_list_expr_eq {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (xs : List OCaml5.Ml.Expr) :
    cata_pos_list_expr alg xs = xs.map (cata_expr alg) := by
  induction xs with
  | nil => simp only [cata_pos_list_expr, List.map_nil]
  | cons x rest ih => simp only [cata_pos_list_expr, List.map_cons, ih]

theorem cata_pos_prod_argLabel_expr_eq {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (x : OCaml5.Ml.ArgLabel × OCaml5.Ml.Expr) :
    cata_pos_prod_argLabel_expr alg x = prodMapSnd (cata_expr alg) x := by
  cases x with
  | mk u v => simp only [cata_pos_prod_argLabel_expr, prodMapSnd_mk]

theorem cata_pos_list_prod_argLabel_expr_eq {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (xs : List (OCaml5.Ml.ArgLabel × OCaml5.Ml.Expr)) :
    cata_pos_list_prod_argLabel_expr alg xs = xs.map (prodMapSnd (cata_expr alg)) := by
  induction xs with
  | nil => simp only [cata_pos_list_prod_argLabel_expr, List.map_nil]
  | cons x rest ih => simp only [cata_pos_list_prod_argLabel_expr, List.map_cons, ih, cata_pos_prod_argLabel_expr_eq]

