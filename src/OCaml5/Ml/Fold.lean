structure ExprHom {R : ExprFam → Type u} (alg : ExprAlgebra R) where
  f_expr : OCaml5.Ml.Expr → R .expr
  h_expr_var : ∀ a0, f_expr (.var a0) =
    alg.expr_var a0
  h_expr_int : ∀ a0, f_expr (.int a0) =
    alg.expr_int a0
  h_expr_str : ∀ a0, f_expr (.str a0) =
    alg.expr_str a0
  h_expr_bool : ∀ a0, f_expr (.bool a0) =
    alg.expr_bool a0
  h_expr_unit : f_expr (.unit) =
    alg.expr_unit
  h_expr_ctor : ∀ a0 a1, f_expr (.ctor a0 a1) =
    alg.expr_ctor a0 (a1.map f_expr)
  h_expr_app : ∀ a0 a1, f_expr (.app a0 a1) =
    alg.expr_app (f_expr a0) (a1.map f_expr)
  h_expr_appL : ∀ a0 a1, f_expr (.appL a0 a1) =
    alg.expr_appL (f_expr a0) (a1.map (prodMapSnd f_expr))
  h_expr_binop : ∀ a0 a1 a2, f_expr (.binop a0 a1 a2) =
    alg.expr_binop a0 (f_expr a1) (f_expr a2)
  h_expr_fn : ∀ a0 a1, f_expr (.fn a0 a1) =
    alg.expr_fn a0 (f_expr a1)
  h_expr_letIn : ∀ a0 a1 a2, f_expr (.letIn a0 a1 a2) =
    alg.expr_letIn a0 (f_expr a1) (f_expr a2)
  h_expr_letAttr : ∀ a0 a1 a2 a3, f_expr (.letAttr a0 a1 a2 a3) =
    alg.expr_letAttr a0 a1 (f_expr a2) (f_expr a3)
  h_expr_letRec : ∀ a0 a1 a2 a3, f_expr (.letRec a0 a1 a2 a3) =
    alg.expr_letRec a0 a1 (f_expr a2) (f_expr a3)
  h_expr_ifThen : ∀ a0 a1 a2, f_expr (.ifThen a0 a1 a2) =
    alg.expr_ifThen (f_expr a0) (f_expr a1) (f_expr a2)
  h_expr_matchE : ∀ a0 a1, f_expr (.matchE a0 a1) =
    alg.expr_matchE (f_expr a0) (a1.map (prodMapSnd f_expr))
  h_expr_record : ∀ a0, f_expr (.record a0) =
    alg.expr_record (a0.map (prodMapSnd f_expr))
  h_expr_field : ∀ a0 a1, f_expr (.field a0 a1) =
    alg.expr_field (f_expr a0) a1
  h_expr_tuple : ∀ a0, f_expr (.tuple a0) =
    alg.expr_tuple (a0.map f_expr)
  h_expr_listLit : ∀ a0, f_expr (.listLit a0) =
    alg.expr_listLit (a0.map f_expr)
  h_expr_annot : ∀ a0 a1, f_expr (.annot a0 a1) =
    alg.expr_annot (f_expr a0) a1
  h_expr_hole : ∀ a0 a1, f_expr (.hole a0 a1) =
    alg.expr_hole a0 (f_expr a1)
  h_expr_assertE : ∀ a0, f_expr (.assertE a0) =
    alg.expr_assertE (f_expr a0)
  h_expr_fnMatch : ∀ a0, f_expr (.fnMatch a0) =
    alg.expr_fnMatch (a0.map (prodMapSnd f_expr))
  h_expr_seq : ∀ a0 a1, f_expr (.seq a0 a1) =
    alg.expr_seq (f_expr a0) (f_expr a1)
  h_expr_letPat : ∀ a0 a1 a2, f_expr (.letPat a0 a1 a2) =
    alg.expr_letPat a0 (f_expr a1) (f_expr a2)
  h_expr_ifUnit : ∀ a0 a1, f_expr (.ifUnit a0 a1) =
    alg.expr_ifUnit (f_expr a0) (f_expr a1)
  h_expr_commented : ∀ a0 a1, f_expr (.commented a0 a1) =
    alg.expr_commented (f_expr a0) a1
  h_expr_pack : ∀ a0 a1, f_expr (.pack a0 a1) =
