import Lean
import OCaml5.Lcnf.Gallina

/-!
# GallinaGen — the call tree's control skeleton as Rocq

A thin driver over `OCaml5.Lcnf.Gallina`: import the module that defines the skeleton, print its
spec (`treeSpec`) from the persisted base-phase LCNF, and write the file. Run from the repository's
root after `lake build Effect4.Run.Tree OCaml5.Lcnf.Gallina`:

    lake env lean -M4096 --run src/OCaml5/Tools/GallinaGen.lean docs/research/2026-10-16-itrees/generated/Skeleton.v

This is a tool (`IO`, `CoreM`); it is not part of any audited library.
-/

open Lean OCaml5.Lcnf.Gallina

def main (args : List String) : IO UInt32 := do
  let out := args.head?.getD "Skeleton.v"
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `Effect4.Run.Tree }, { module := `OCaml5.Lcnf.Gallina }] {} 0
  let ctx : Core.Context := { fileName := "<gallina>", fileMap := default, maxHeartbeats := 0 }
  let header := "(* GENERATED by src/OCaml5/Tools/GallinaGen.lean (OCaml5.Lcnf.Gallina, treeSpec) from the\n" ++
    "   base-phase LCNF of Effect4.Run.Tree, Lean " ++ Lean.versionString ++ ". Do not edit. Regenerate with:\n" ++
    "   lake env lean -M4096 --run src/OCaml5/Tools/GallinaGen.lean " ++ out ++ " *)"
  let (text, _) ← (render treeSpec header).toIO ctx { env := env }
  IO.FS.writeFile out text
  IO.println s!"wrote {out} ({text.length} bytes)"
  return 0
