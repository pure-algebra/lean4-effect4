import Lean
import OCaml5.Lcnf.Gallina

/-!
# GallinaGen — the call tree's control skeleton and the store's code as Rocq

A thin driver over `OCaml5.Lcnf.Gallina`: import the modules that define them, print each spec
(`treeSpec`, then `storeSpec` when a second path is given) from the persisted base-phase LCNF, and
write the files. `make gen-rocq` runs it after
`lake build Effect4.Run.Tree Effect4.Store.Domain.Word OCaml5.Lcnf.Gallina`, from the repository's
root:

    lake env lean -M4096 --run src/OCaml5/Tools/GallinaGen.lean rocq/Skeleton.v rocq/StoreCode.v

This is a tool (`IO`, `CoreM`); it is not part of any audited library.
-/

open Lean OCaml5.Lcnf.Gallina

def main (args : List String) : IO UInt32 := do
  let out := args.head?.getD "Skeleton.v"
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := `Effect4.Run.Tree }, { module := `Effect4.Store.Domain.Word },
    { module := `OCaml5.Lcnf.Gallina }] {} 0
  let ctx : Core.Context := { fileName := "<gallina>", fileMap := default, maxHeartbeats := 0 }
  let header (spec module : String) (file : String) :=
    s!"(* GENERATED by src/OCaml5/Tools/GallinaGen.lean (OCaml5.Lcnf.Gallina, {spec}) from the\n" ++
    s!"   base-phase LCNF of {module}, Lean " ++ Lean.versionString ++ ". Do not edit. Regenerate with\n" ++
    "   `make gen-rocq`, which runs: lake env lean -M4096 --run src/OCaml5/Tools/GallinaGen.lean " ++ file ++ " *)"
  let (text, _) ← (render treeSpec (header "treeSpec" "Effect4.Run.Tree" out)).toIO ctx { env := env }
  IO.FS.writeFile out text
  IO.println s!"wrote {out} ({text.length} bytes)"
  if let some (storeOut : String) := args[1]? then
    let (text, _) ← (render storeSpec (header "storeSpec" "Effect4.Store" s!"{out} {storeOut}")).toIO ctx { env := env }
    IO.FS.writeFile storeOut text
    IO.println s!"wrote {storeOut} ({text.length} bytes)"
  return 0
