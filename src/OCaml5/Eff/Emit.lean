import OCaml5.Eff.World
import OCaml5.Ml.Render
import OCaml5.Ml.Check
import Effect4.Program.TyFoldExtras

/-!
# OCaml5.Eff.Emit

**What it is.** The `eff/` library as OCaml syntax (`OCaml5.Ml.Syntax`), one module per generated
file: `ctorsModule` (`eff_ctors.ml`: the constructor tables), `subtermModule` (`eff_subterm.ml`),
`nativeModule` (`eff_native.ml`: the native atom names, const-generic metadata and operation rows
as data) and `layoutModule` (`eff_layout.ml`), with `manifest` (`eff_manifest.txt`, text). The
driver `OCaml5.Tools.EffGen` checks each module (`OCaml5.Ml.checkModule`) and renders it
(`OCaml5.Ml.render`), as the LCNF route does. Program typing remains in Lean. The program types
themselves are the LCNF route's (`ocaml/eff/eff_types.ml`, the recipe's first artifact): every
name here is spelled by that route's rule (`OCaml5.Eff.octor`, `ofield`). No codec is emitted
here: a program's canonical bytes are Lean's exact embedding, lowered by the same route
(`ocaml/eff/eff_image.ml`), over the hand-written framing kernel (`ocaml/eff/eff_codec.ml`).

**Depends on.** `OCaml5.Eff.World`, `OCaml5.Ml`.

**Properties.**
* **One emitter.** Every file is a value of the OCaml syntax, printed by the one renderer and
  checked by the one checker: no OCaml is built as text here — *by construction*.
* **Bytes are the driver's contract.** `ocaml/eff/*.ml` are byte-identical to this output
  — *tested* (regenerate and `git diff`).
* **Every generated file says so** in its first lines, with the regeneration command — *by
  construction* (`headerItems`).
-/

open Lean Meta
open Effect4.Program
open Effect4.Supervision (MaskMode ForkOptions ObserverMode)
open Effect4 (FinalizerStrategy ServiceKey)

namespace OCaml5.Eff

/-! ## Text helpers -/

def hex4 (n : Nat) : String :=
  let s := String.ofList (Nat.toDigits 16 n)
  "".pushn '0' (4 - s.length) ++ s

/-- A JSON string: `"` and `\` escaped, control characters as `\n \r \t \b \f` or `\u00XX`,
everything else verbatim: the goldens' spelling (`V.json`), the rule of the profile's renderer
(`NatJson.render`) too. -/
def jsonStr (s : String) : String :=
  let esc (c : Char) : String :=
    if c == '"' then "\\\"" else if c == '\\' then "\\\\"
    else if c == '\n' then "\\n" else if c == '\r' then "\\r" else if c == '\t' then "\\t"
    else if c.toNat == 8 then "\\b" else if c.toNat == 12 then "\\f"
    else if c.toNat < 0x20 then "\\u" ++ hex4 c.toNat else c.toString
  "\"" ++ String.join (s.toList.map esc) ++ "\""

/-! ## Syntax helpers -/

/-- A name applied to its arguments. -/
private def call (f : String) (args : List Ml.Expr) : Ml.Expr := Ml.Expr.call f args

/-- One top-level binding whose parameters and result are annotated. -/
private def bind (name : String) (params : List (String × Ml.Ty)) (result : Ml.Ty) (body : Ml.Expr) :
    Ml.Bind :=
  { name, params := params.map fun (p, t) => (p, some t), result := some result, body }

/-- A binding alone, as a structure item. -/
private def letOne (b : Ml.Bind) : Ml.Decl := .letD false [b]

/-- The two comment lines every file opens with, after the stamp the driver puts first. -/
def headerItems (what : String) : List Ml.Decl :=
  [.comment ("GENERATED by src/OCaml5/Tools/EffGen.lean — regenerate: lake env lean --run "
      ++ "src/OCaml5/Tools/EffGen.lean <outdir>. Do not edit."),
   .comment what]

/-- The spelling of a type row at converted arguments (`OCaml5.Lcnf.builtinTy?`). Every carrier
below names a type with a row, so the anonymous type never stands in (the `#guard`s at the foot). -/
private def rowTy (lean : Name) (args : List Ml.Ty) : Ml.Ty :=
  (OCaml5.Lcnf.builtinTy? lean args).getD .anon

/-- The OCaml type of a carrier as syntax: a Lean type with a row is the type rows' spelling
(`OCaml5.Lcnf.typeRows`, the one owner of every OCaml spelling), and a family is its owner's
type (`labelType`). -/
partial def OTy.ml : OTy → Ml.Ty
  | .nat => rowTy ``Nat []
  | .bool => rowTy ``Bool []
  | .string => rowTy ``String []
  | .unit => rowTy ``Unit []
  | .option a => rowTy ``Option [a.ml]
  | .list a => rowTy ``List [a.ml]
  | .prod a b => rowTy ``Prod [a.ml, b.ml]
  | .named n => .named (labelType n)
  | .requirements => rowTy ``List [.named (otype ``Effect4.ServiceKey)]

/-- The OCaml type of a family as `eff_types.ml` declares it: its parameters applied
(`NativeOp.t Eff.t`). `pre` qualifies each family name (`Eff_types.`). -/
def Family.ty (f : Family) (pre : String := "") : Ml.Ty :=
  .con (pre ++ otype f.spec.leanName) (f.spec.params.map fun t => match t with
    | .named n => .named (pre ++ labelType n)
    | t => t.ml)

/-- A constructor matched whatever its arguments: `C`, or `C _` at every arity from one. -/
def ctorPat (t : Name) (c : Ctor) : Ml.Pat :=
  .ctor (octor t c.short) (if c.args.isEmpty then [] else [.wild])

/-- The interface of `Eff_types` these modules read: each type's module and declaration, made by
the LCNF route's type generator (`OCaml5.Lcnf.generateInFull`) as `eff_types.ml` declares them.
A family whose module the owner decided otherwise than `ownerNames` (a short name claimed
twice) is refused, so every name here is the owner's. -/
def typesInterface (bs : List (List Family)) : MetaM Ml.Interface := do
  let (g, tn) ← OCaml5.Lcnf.generateInFull (bs.flatten.map (·.spec.leanName)).toArray
  for f in bs.flatten do
    unless tn.modules[f.spec.leanName]? == some (OCaml5.Lcnf.moduleName f.spec.leanName) do
      throwError s!"EffGen: the owner names {f.spec.leanName} {tn.modules[f.spec.leanName]?}, not its short name"
  return { name := "Eff_types",
           modules := g.entries.toList.filterMap fun (n, d, _) => (tn.modules[n]?).map fun m => (m, [d]) }

/-! ## eff_ctors.ml: the constructor tables -/

def tablesOf (f : Family) : List Ml.Decl :=
  let o := f.spec.oname
  let t := f.ty
  if f.isStruct then
    let c := f.ctors.head!
    [letOne (bind s!"ctor_index_{o}" [("_", t)] .int (.int 0)),
     letOne (bind s!"wire_tag_{o}" [("_", t)] .int (.int 0)),
     letOne (bind s!"ctor_name_{o}" [("_", t)] .string (.str c.short)),
     letOne (bind s!"ctor_names_{o}" [] (.list .string) (.listLit [.str c.short])),
     letOne (bind s!"field_names_{o}" [] (.list .string)
       (.listLit (c.args.map fun (nm, _) => .str nm)))]
  else
    let arms (k : Nat → Ctor → Ml.Expr) : List (Ml.Pat × Ml.Expr) :=
      (enumL f.ctors).map fun (i, c) => (ctorPat f.spec.leanName c, k i c)
    [letOne (bind s!"ctor_index_{o}" [] (.arrow t .int) (.fnMatch (arms fun i _ => .int i))),
     letOne (bind s!"wire_tag_{o}" [] (.arrow t .int) (.fnMatch (arms fun _ c => .int c.tag))),
     letOne (bind s!"ctor_name_{o}" [] (.arrow t .string) (.fnMatch (arms fun _ c => .str c.short))),
     letOne (bind s!"ctor_names_{o}" [] (.list .string) (.listLit (f.ctors.map fun c => .str c.short)))]

def ctorsModule (bs : List (List Family)) : Ml.Module :=
  { name := "eff_ctors",
    items := headerItems ("Eff_ctors: the constructor tables of every carrier of Eff_types (the program types the LCNF route declares, ocaml/eff/eff_types.ml). ctor_index_<t> is the Lean declaration order; wire_tag_<t> is the number the constructor carries in the canonical bytes (tools/Effect4Gen/wire-tags.json); the two agree only while no constructor of the family has been retired or reordered. A program's natural literals are Lean's to judge at ingress (Effect4.Program.ProfileData.literalRefusal, lowered).")
      ++ [.floatingAttrD "warning \"-26-27-32-39\"", .openD "Eff_types"]
      ++ bs.flatMap (·.flatMap tablesOf) }

/-! ## eff_subterm.ml: the children table, the node sum and one witness per constructor -/

/-- The mark a seeded value carries where its number goes. -/
def seedMark : String := "§"

/-- The value with every mark replaced by the natural `k`, as the `Nat` row spells it
(`OCaml5.Lcnf.natLiteral`). -/
def seedWith (k : Nat) (e : Ml.Expr) : Ml.Expr :=
  Ml.cata_expr { Ml.ExprAlgebra.id with
    expr_var := fun n => if n == seedMark then OCaml5.Lcnf.natLiteral k else Ml.Expr.var n } e

/-- Whether a value carries a mark. -/
def seeded (e : Ml.Expr) : Bool := (Ml.renderExpr 0 e |>.splitOn seedMark).length > 1

/-- A value of a carrier: numbers are `number`, a family is what `base` says. -/
partial def valueOf (number : Ml.Expr) (base : String → Option Ml.Expr) : OTy → Option Ml.Expr
  | .nat => some number
  | .bool => some (.bool false)
  | .string => some (.str "")
  | .unit => some .unit
  | .option _ => some (.ctor "None" [])
  | .list _ => some (.listLit [])
  | .requirements => some (.listLit [])
  | .prod a b => do
    let x ← valueOf number base a
    let y ← valueOf number base b
    some (.tuple [x, y])
  | .named n => base n

/-- A constructor (or a record) applied to the given arguments. -/
def applied (f : Family) (c : Ctor) (args : List Ml.Expr) : Ml.Expr :=
  if f.trivial then
    match args with
    | [a] => a
    | _ => .tuple args
  else if f.isStruct then
    .annot (.record ((c.args.zip args).map fun ((nm, _), v) => ("Eff_types." ++ ofield f.spec.leanName nm, v)))
      (f.ty "Eff_types.")
  else .ctor ("Eff_types." ++ octor f.spec.leanName c.short) args

/-- A constructor applied to the least value of every argument. -/
def inhabitant (base : String → Option Ml.Expr) (f : Family) (c : Ctor) : Option Ml.Expr := do
  some (applied f c (← c.args.mapM fun (_, t) => valueOf (OCaml5.Lcnf.natLiteral 0) base t))

/-- A fixpoint over the families, one round per family. -/
def closeOver (fs : List Family) (step : List (String × Ml.Expr) → Family → Option Ml.Expr) :
    List (String × Ml.Expr) :=
  fs.foldl (init := []) fun table _ =>
    fs.foldl (init := table) fun table f =>
      if (List.lookup f.spec.oname table).isSome then table
      else match step table f with
        | some v => table ++ [(f.spec.oname, v)]
        | none => table

/-- The least value of every family. -/
def leastValues (fs : List Family) : List (String × Ml.Expr) :=
  closeOver fs fun table f => f.ctors.findSome? (inhabitant (List.lookup · table) f)

/-- For every family that can carry a number, a value with `seedMark` where the number goes:
two such values at different numbers are different values. -/
def seededValues (fs : List Family) (least : List (String × Ml.Expr)) : List (String × Ml.Expr) :=
  closeOver fs fun table f => f.ctors.findSome? fun c => do
    let base (n : String) := (List.lookup n table).orElse fun _ => List.lookup n least
    let v := applied f c (← c.args.mapM fun (_, t) => valueOf (.var seedMark) base t)
    if seeded v then some v else none

/-- The witness of a constructor: argument `j` is seeded with `j + 1`, so the children of a
witness are pairwise different wherever their family can carry a number. -/
def witnessOf (least seeds : List (String × Ml.Expr)) (f : Family) (c : Ctor) : Option Ml.Expr := do
  let args ← (enumL c.args).mapM fun (j, (_, t)) => do
    let base (n : String) := (List.lookup n seeds).orElse fun _ => List.lookup n least
    let v ← valueOf (.var seedMark) base t
    some (seedWith (j + 1) v)
  some (applied f c args)

def subtermModule (sorts : List (String × String)) (bs : List (List Family)) :
    Except String Ml.Module := do
  let fs := bs.flatten
  let sortFamilies ← sorts.mapM fun (short, label) =>
    match fs.find? (·.spec.oname == label) with
    | some f => pure (short, f)
    | none => throw s!"EffGen: node sort {short} names the unread family {label}"
  let sortOf (t : OTy) : Option String :=
    match t with
    | .named n => (sorts.find? (·.2 == n)).map (·.1)
    | _ => none
  let family (short : String) : Ml.Expr := .ctor short.capitalize []
  let least := leastValues fs
  let seeds := seededValues fs least
  let childRows := sortFamilies.flatMap fun (short, f) => (enumL f.ctors).filterMap fun (i, c) =>
    let kids := (enumL c.args).filterMap fun (j, (_, t)) =>
      (sortOf t).map fun s => Ml.Expr.tuple [.int j, family s]
    if kids.isEmpty then none
    else some (Ml.Pat.tuple [.ctor short.capitalize [], .int i], Ml.Expr.commented (.listLit kids) c.short)
  let childArms := sortFamilies.flatMap fun (short, f) => f.ctors.flatMap fun c =>
    let kids := (enumL c.args).filterMap fun (j, (_, t)) => (sortOf t).map fun s => (j, s)
    (enumL kids).map fun (k, (j, s)) =>
      let pats := (List.range c.args.length).map fun i => if i == j then Ml.Pat.var s!"a{i}" else .wild
      (Ml.Pat.tuple [.ctor s!"N_{short}" [.ctor ("Eff_types." ++ octor f.spec.leanName c.short) pats],
         .int k],
       Ml.Expr.ctor "Some" [.ctor s!"N_{s}" [.var s!"a{j}"]])
  -- A byte walker reads a wire tag; the children table is keyed by declaration position. The
  -- two numbers differ once a constructor has retired, so the walker asks for the position.
  let tagRows := sortFamilies.flatMap fun (short, f) => (enumL f.ctors).map fun (i, c) =>
    (Ml.Pat.tuple [.ctor short.capitalize [], .int c.tag], Ml.Expr.commented (.ctor "Some" [.int i]) c.short)
  let witnesses ← sortFamilies.mapM fun (short, f) => f.ctors.mapM fun c =>
    match witnessOf least seeds f c with
    | some v => pure (Ml.Expr.ctor s!"N_{short}" [v])
    | none => throw s!"EffGen: no witness of {c.name}: an argument's family has no least value"
  let perSort (arm : String → Family → Ml.Pat × Ml.Expr) : Ml.Expr :=
    .fnMatch (sortFamilies.map fun (short, f) => arm short f)
  let pair (a b : String) : Ml.Expr := .tuple [.var a, .var b]
  let familyType : Ml.TypeDecl :=
    { name := "family", body := .variant (sorts.map fun (s, _) => { name := s.capitalize }) }
  let nodeType : Ml.TypeDecl :=
    { name := "node", body := .variant (sortFamilies.map fun (short, f) =>
      ({ name := s!"N_{short}", args := [f.ty "Eff_types."] } : Ml.Ctor)) }
  let familyName := perSort fun short _ => (.ctor short.capitalize [], .str short)
  let familyCtorNames := perSort fun short f =>
    (.ctor short.capitalize [], .var s!"Eff_ctors.ctor_names_{f.spec.oname}")
  let familyOf := perSort fun short _ => (.ctor s!"N_{short}" [.wild], family short)
  let ctorIndex := perSort fun short f =>
    (.ctor s!"N_{short}" [.var "v"], call s!"Eff_ctors.ctor_index_{f.spec.oname}" [.var "v"])
  let items : List Ml.Decl :=
    headerItems ("Eff_subterm: the node sorts of Effect4.Program.Node, the children of every constructor as (value argument index, child sort) in program-child order (a node's children are its node-typed arguments in declaration order, Program/Node.lean), keyed by declaration position, the map from a wire tag to that position, the one-step child function, and one witness of every constructor of every sort, its arguments seeded with different numbers so that two children of one witness differ.")
    ++ [.types [familyType],
        letOne { name := "families", body := .listLit (sorts.map (family ·.1)) },
        letOne { name := "family_name", body := familyName },
        letOne { name := "family_ctor_names", body := familyCtorNames },
        letOne (bind "children" [("f", .named "family"), ("c", .int)] (.list (.tuple [.int, .named "family"]))
          (.matchE (pair "f" "c") (childRows ++ [(.tuple [.wild, .wild], .listLit [])]))),
        .comment ("The declaration position of the constructor a wire tag names (tools/Effect4Gen/wire-tags.json);\n"
          ++ "   None for a tag no active constructor holds. `children` and `ctor_index` speak positions."),
        letOne (bind "position_of_tag" [("f", .named "family"), ("tag", .int)] (.option .int)
          (.matchE (pair "f" "tag") (tagRows ++ [(.tuple [.wild, .wild], .ctor "None" [])]))),
        .types [nodeType],
        letOne { name := "family_of", body := familyOf },
        letOne { name := "ctor_index", body := ctorIndex },
        letOne (bind "child" [("n", .named "node"), ("i", .int)] (.option (.named "node"))
          (.matchE (pair "n" "i") (childArms ++ [(.tuple [.wild, .wild], .ctor "None" [])]))),
        letOne (bind "witnesses" [] (.list (.named "node")) (.listLit witnesses.flatten))]
  pure { name := "eff_subterm", items := items }

/-! ## eff_manifest.txt -/

/-- One line per family: its Lean name, its label, its constructors (or fields) with their
carriers' OCaml types (`OTy.ml`, the type rows' spellings), in order. -/
def manifest (bs : List (List Family)) : String :=
  let carrier (t : OTy) : String := Ml.renderTy t.ml
  String.join (bs.map fun b => String.join (b.map fun f =>
    let o := f.spec.oname
    if f.isStruct then
      let c := f.ctors.head!
      s!"{f.spec.leanName} ({o}) structure: " ++ " ".intercalate (c.args.map fun (nm, t) => s!"{nm}:{carrier t}") ++ "\n"
    else
      s!"{f.spec.leanName} ({o}) inductive: " ++ " ".intercalate (f.ctors.map fun c =>
        if c.args.isEmpty then c.short
        else c.short ++ "(" ++ ",".intercalate (c.args.map fun (_, t) => carrier t) ++ ")") ++ "\n"))

/-! ## eff_native.ml — the alphabet as data, rendered from Lean values -/

/-- A natural of the program as OCaml: the `Nat` row's literal (`OCaml5.Lcnf.natLiteral`). -/
private def natO (n : Nat) : Ml.Expr := OCaml5.Lcnf.natLiteral n

def keyO (k : ServiceKey) : Ml.Expr :=
  .annot (.record [(ofield ``Effect4.ServiceKey "name", natO k.name.value),
                   (ofield ``Effect4.ServiceKey "service", natO k.service.value)])
    (.named (otype ``Effect4.ServiceKey))

/-- A constructor of a type of the program, applied. -/
private def pc (t : Name) (c : String) (args : List Ml.Expr := []) : Ml.Expr := .ctor (octor t c) args

/-- One argument of a `Ty` constructor as OCaml: a child folded, a payload as its literal. -/
private def tyArgO : TyArgF Ml.Expr → Ml.Expr
  | .child r => r
  | .str s => .str s
  | .nat n => natO n
  | .list_prod_string_prod_bool_ty fs => .listLit (fs.map fun (n, o, t) => .tuple [.str n, .tuple [.bool o, t]])
  | .list_ty ts => .listLit ts
  | .serviceKey keys => .listLit (keys.elems.map keyO)

/-- A program type as OCaml: each constructor applied to its arguments by its own name, as one
fold (`TyAlgebra.ofLayer`), so a new constructor of `Ty` needs no line here. -/
def tyO (t : Ty) : Ml.Expr :=
  cata_ty (TyAlgebra.ofLayer fun c args => pc `Effect4.Program.Ty c.name (args.map tyArgO)) t

/-- A record's fields, `(string * (bool * ty))` each. -/
def fieldsO (fs : List (String × Bool × Ty)) : List Ml.Expr :=
  fs.map fun (n, o, t) => .tuple [.str n, .tuple [.bool o, tyO t]]

def litO : Lit → Ml.Expr
  | .unit => pc `Effect4.Program.Lit "unit"
  | .nat n => pc `Effect4.Program.Lit "nat" [natO n]
  | .bool b => pc `Effect4.Program.Lit "bool" [.bool b]
  | .str s => pc `Effect4.Program.Lit "str" [.str s]

def readModeO : FieldReadMode → Ml.Expr
  | .required => pc `Effect4.Program.FieldReadMode "required"
  | .optional => pc `Effect4.Program.FieldReadMode "optional"

mutual
/-- A term as an OCaml value: the binder term a read-modify-write row carries in `all_ops`. -/
def termO : Effect4.Program.Term → Ml.Expr
  | .var i => pc `Effect4.Program.Term "var" [natO i]
  | .lit l => pc `Effect4.Program.Term "lit" [litO l]
  | .app atom args => pc `Effect4.Program.Term "app" [.str atom, termsO args]
  | .record fields names values =>
    pc `Effect4.Program.Term "record" [.listLit (fieldsO fields), .listLit (names.map .str), termsO values]
  | .field mode target name =>
    pc `Effect4.Program.Term "field" [readModeO mode, termO target, .str name]
  | .recordSet target name value =>
    pc `Effect4.Program.Term "recordSet" [termO target, .str name, termO value]
  | .tupleAt target index => pc `Effect4.Program.Term "tupleAt" [termO target, natO index]
  | .fold accTy list init body =>
    let acc : Ml.Expr := match accTy with
      | none => .ctor "None" []
      | some ty => .ctor "Some" [tyO ty]
    pc `Effect4.Program.Term "fold" [acc, termO list, termO init, termO body]
/-- An argument list as an OCaml value. -/
def termsO : Effect4.Program.Terms → Ml.Expr
  | .nil => pc `Effect4.Program.Terms "nil"
  | .cons head tail => pc `Effect4.Program.Terms "cons" [termO head, termsO tail]
end

def stratO : FinalizerStrategy → Ml.Expr
  | .sequential => pc `Effect4.FinalizerStrategy "sequential"
  | .parallel => pc `Effect4.FinalizerStrategy "parallel"

def opO : NativeOp → Ml.Expr
  | .refMake => pc `Effect4.Program.NativeOp "refMake"
  | .refGet => pc `Effect4.Program.NativeOp "refGet"
  | .refSet => pc `Effect4.Program.NativeOp "refSet"
  | .refGetAndSet => pc `Effect4.Program.NativeOp "refGetAndSet"
  | .refSetAndGet => pc `Effect4.Program.NativeOp "refSetAndGet"
  | .refUpdateWith f => pc `Effect4.Program.NativeOp "refUpdateWith" [termO f]
  | .refGetAndUpdateWith f => pc `Effect4.Program.NativeOp "refGetAndUpdateWith" [termO f]
  | .refUpdateAndGetWith f => pc `Effect4.Program.NativeOp "refUpdateAndGetWith" [termO f]
  | .refUpdateSomeWith f => pc `Effect4.Program.NativeOp "refUpdateSomeWith" [termO f]
  | .refGetAndUpdateSomeWith f => pc `Effect4.Program.NativeOp "refGetAndUpdateSomeWith" [termO f]
  | .refUpdateSomeAndGetWith f => pc `Effect4.Program.NativeOp "refUpdateSomeAndGetWith" [termO f]
  | .refModifyWith f => pc `Effect4.Program.NativeOp "refModifyWith" [termO f]
  | .refModifySomeWith f => pc `Effect4.Program.NativeOp "refModifySomeWith" [termO f]
  | .deferredMakeOf value error => pc `Effect4.Program.NativeOp "deferredMakeOf" [tyO value, tyO error]
  | .deferredIsDone => pc `Effect4.Program.NativeOp "deferredIsDone"
  | .deferredPoll => pc `Effect4.Program.NativeOp "deferredPoll"
  | .deferredSucceed => pc `Effect4.Program.NativeOp "deferredSucceed"
  | .deferredFail => pc `Effect4.Program.NativeOp "deferredFail"
  | .deferredAwait => pc `Effect4.Program.NativeOp "deferredAwait"
  | .scopeMake s => pc `Effect4.Program.NativeOp "scopeMake" [stratO s]
  | .sleep => pc `Effect4.Program.NativeOp "sleep"
  | .clockNow => pc `Effect4.Program.NativeOp "clockNow"
  | .external i => pc `Effect4.Program.NativeOp "external" [natO i]
  | .call k => pc `Effect4.Program.NativeOp "call" [natO k]
  | .param k => pc `Effect4.Program.NativeOp "param" [natO k]

/-- The finite built-in alphabet, one operation per spelling key: the core's `NativeOp.spelled`
(`src/Effect4/Program/Native.lean`), `Deferred.make` at its face, the instance `(nat, nat)`, and
each read-modify-write row at its face, the unit literal for its binder term. External row indices
range over `Nat` and are supplied by a separate table. `main` checks the constructor classes. -/
def allOps : List NativeOp := NativeOp.spelled

/-- The const-generic atoms by name (`NativeAtom.constGeneric`, the literal rule's flag). -/
def constAtomNames : List String :=
  (NativeAtom.all.filter NativeAtom.constGeneric).map NativeAtom.name

def nativeModule (nullaryOps typedOps termOps stratOps : Nat) : Ml.Module :=
  { name := "eff_native",
    items := headerItems ("Eff_native: the native alphabet as data. atom names and const-generic metadata project the complete NativeAtom inventory (src/Effect4/Program/NativeAtom.lean). Typing remains in Lean; no second atom checker is emitted. all_ops is NativeOp.spelled, one operation per spelling key (the constructor table checks the classes). scope_key is nativeScopeKey.")
      ++ [.openD "Eff_types",
          letOne (bind "atom_names" [] (.list .string) (.listLit (NativeAtom.names.map .str))),
          .comment "The const-generic atoms (NativeAtom.constGeneric): a string literal argument keeps its literal type (the literal rule, DI-15).",
          letOne (bind "const_atoms" [] (.list .string) (.listLit (constAtomNames.map .str))),
          letOne (bind "const_atom" [("name", .string)] .bool (call "List.mem" [.var "name", .var "const_atoms"])),
          .comment s!"{nullaryOps} nullary operations, {typedOps} at the faces' type arguments, {termOps} at their faces (a binder term at the unit literal), {stratOps} over every finalizer_strategy: {allOps.length} values.",
          letOne (bind "all_ops" [] (.list (.named (otype ``Effect4.Program.NativeOp))) (.listLit (allOps.map opO))),
          letOne (bind "scope_key" [] (.named (otype ``Effect4.ServiceKey)) (keyO nativeScopeKey)),
          letOne (bind "scope_ty" [] (.named (otype ``Effect4.Program.Ty)) (tyO Ty.scope)),
          letOne (bind "context_ty" [] (.named (otype ``Effect4.Program.Ty)) (tyO Ty.context))] }

/-! ## eff_layout.ml — the source structure as data -/

def layoutModule (bs : List (List Family)) : Ml.Module :=
  let fields (f : Family) : List String :=
    if f.isStruct then f.ctors.head!.args.map (·.1) else f.ctors.map (·.short)
  let families : Ml.Expr := .listLit (bs.flatten.map fun f =>
    .tuple [.str f.spec.leanName.getString!, .listLit ((fields f).map .str)])
  let tags : Ml.Expr := .listLit ((bs.flatten.filter (!·.isStruct)).map fun f =>
    .tuple [.str f.spec.leanName.getString!, .listLit (f.ctors.map fun c => .tuple [.str c.short, .int c.tag])])
  { name := "eff_layout",
    items := [.comment "GENERATED source-structure view; no runtime or execution-permission claim.",
      letOne { name := "wire_families", body := families },
      .comment ("The wire tag of every constructor of every inductive family, from\n"
        ++ "   tools/Effect4Gen/wire-tags.json. A tag is not a declaration position."),
      letOne { name := "wire_tags", body := tags }] }

/-! ### Controls: the carriers' OCaml spellings are the type rows' -/

#guard OTy.nat.ml == Ml.Ty.int
#guard (OTy.option .nat).ml == Ml.Ty.option Ml.Ty.int
#guard (OTy.prod .string .bool).ml == .tuple [Ml.Ty.string, Ml.Ty.bool]
#guard OTy.requirements.ml == Ml.Ty.list (.named (otype ``Effect4.ServiceKey))

end OCaml5.Eff
