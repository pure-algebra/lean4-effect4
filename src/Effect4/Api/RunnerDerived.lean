  acceptsIn_mono_of_subset (fun _ hp => mem_append_of_left (mem_append_of_left (mem_append_of_left (mem_append_of_left (hp)))))
    _ _ (Canonical.fits x)
theorem lift_Nat (x : _root_.Nat) :
