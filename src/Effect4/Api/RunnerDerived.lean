  all_goals first
    | (injection h with h; subst h; rfl)
    | (rename_i w
       obtain ⟨x, hx, hj⟩ := Option.map_eq_some_iff.mp h
       subst hj
       simp only [toVal]
       rw [Canonical.ofVal_exact hx])
    | (split at h
       · rename_i b0 b1 h0 h1
         injection h with h
         subst h
         simp only [toVal]
         rw [Canonical.ofVal_exact h0, Canonical.ofVal_exact h1]
         done
       all_goals exact nomatch h)
    | exact nomatch h

