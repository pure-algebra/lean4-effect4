theorem lift_RunDecisionEffNameEffThunkValErrDefectFiberIdAnn (x : (@_root_.Effect4.Machine.RunDecision (_root_.Effect4.Program.EffName) (_root_.Effect4.Program.EffThunk) (_root_.Effect4.Machine.Val) (_root_.Effect4.Machine.Err) (_root_.Effect4.Machine.Defect) (_root_.Effect4.FiberId) (_root_.Effect4.Machine.Ann))) :
    acceptsIn shapeDoc.defs (shape (@_root_.Effect4.Machine.RunDecision (_root_.Effect4.Program.EffName) (_root_.Effect4.Program.EffThunk) (_root_.Effect4.Machine.Val) (_root_.Effect4.Machine.Err) (_root_.Effect4.Machine.Defect) (_root_.Effect4.FiberId) (_root_.Effect4.Machine.Ann))).root
      (Canonical.toVal x) = true :=
  acceptsIn_mono_of_subset (fun _ hp => mem_append_of_right (hp))
    _ _ (Canonical.fits x)

theorem fits (a : _root_.Effect4.Api.Runner.Command) : shapeDoc.accepts (toVal a) = true := by
  cases a with
  | «bind» a0 a1 =>
    exact accepts_sum _ _ _ 0 "bind" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Call a0)
        (acceptsFields_cons _ _ _ _ _ _ (lift_Nat a1) (acceptsFields_nil _)))
  | «submit» a0 =>
    exact accepts_sum _ _ _ 1 "submit" _ _ rfl
      (acceptsFields_cons _ _ _ _ _ _ (lift_Reply a0) (acceptsFields_nil _))
  | «apply» a0 =>
