namespace RowKindC

def shapeDoc : ShapeDoc :=
  ⟨.sum "RowKind"
     [("sync", 0, []),
      ("async", 1, []),
      ("program", 2, [])],
   []⟩

def toVal : _root_.Effect4.Program.RowKind → Val
  | .sync => .ctor 0 []
  | .async => .ctor 1 []
  | .program => .ctor 2 []

def ofVal : Val → Option (_root_.Effect4.Program.RowKind)
  | .ctor 0 [] => some .sync
  | .ctor 1 [] => some .async
  | .ctor 2 [] => some .program
  | _ => none

set_option linter.unusedSimpArgs false in
theorem ofVal_toVal (a : _root_.Effect4.Program.RowKind) : ofVal (toVal a) = some a := by
  cases a <;> simp [toVal, ofVal, Canonical.ofVal_toVal]

theorem ofVal_exact {v : Val} {a : _root_.Effect4.Program.RowKind} (h : ofVal v = some a) :
    v = toVal a := by
  unfold ofVal at h
  split at h
  all_goals first
    | (injection h with h; subst h; rfl)
    | (rename_i w
       obtain ⟨x, hx, hj⟩ := Option.map_eq_some_iff.mp h
       subst hj
       simp only [toVal]
       rw [Canonical.ofVal_exact hx])
    | exact nomatch h

theorem fits (a : _root_.Effect4.Program.RowKind) : shapeDoc.accepts (toVal a) = true := by
  cases a with
  | «sync» =>
    exact accepts_sum _ _ _ 0 "sync" [] [] rfl (acceptsFields_nil _)
  | «async» =>
    exact accepts_sum _ _ _ 1 "async" [] [] rfl (acceptsFields_nil _)
  | «program» =>
    exact accepts_sum _ _ _ 2 "program" [] [] rfl (acceptsFields_nil _)

instance instCanonical : Canonical (_root_.Effect4.Program.RowKind) :=
  ⟨shapeDoc, toVal, ofVal, ofVal_toVal, ofVal_exact, fits⟩

-- No sum of the document gives one wire tag to two cases.
#guard shapeDoc.wellTagged

end RowKindC

namespace RowShapeC

def shapeDoc : ShapeDoc :=
  ⟨.sum "RowShape"
     [("call", 0, []),
      ("value", 1, []),
      ("tupleCall", 2, []),
      ("method", 3, [])],
   []⟩

def toVal : _root_.Effect4.Program.RowShape → Val
  | .call => .ctor 0 []
  | .value => .ctor 1 []
  | .tupleCall => .ctor 2 []
  | .method => .ctor 3 []

def ofVal : Val → Option (_root_.Effect4.Program.RowShape)
  | .ctor 0 [] => some .call
  | .ctor 1 [] => some .value
  | .ctor 2 [] => some .tupleCall
  | .ctor 3 [] => some .method
  | _ => none

set_option linter.unusedSimpArgs false in
theorem ofVal_toVal (a : _root_.Effect4.Program.RowShape) : ofVal (toVal a) = some a := by
  cases a <;> simp [toVal, ofVal, Canonical.ofVal_toVal]

theorem ofVal_exact {v : Val} {a : _root_.Effect4.Program.RowShape} (h : ofVal v = some a) :
    v = toVal a := by
  unfold ofVal at h
  split at h
  all_goals first
    | (injection h with h; subst h; rfl)
    | (rename_i w
       obtain ⟨x, hx, hj⟩ := Option.map_eq_some_iff.mp h
       subst hj
       simp only [toVal]
       rw [Canonical.ofVal_exact hx])
    | exact nomatch h

theorem fits (a : _root_.Effect4.Program.RowShape) : shapeDoc.accepts (toVal a) = true := by
  cases a with
  | «call» =>
    exact accepts_sum _ _ _ 0 "call" [] [] rfl (acceptsFields_nil _)
  | «value» =>
    exact accepts_sum _ _ _ 1 "value" [] [] rfl (acceptsFields_nil _)
  | «tupleCall» =>
    exact accepts_sum _ _ _ 2 "tupleCall" [] [] rfl (acceptsFields_nil _)
  | «method» =>
    exact accepts_sum _ _ _ 3 "method" [] [] rfl (acceptsFields_nil _)

instance instCanonical : Canonical (_root_.Effect4.Program.RowShape) :=
  ⟨shapeDoc, toVal, ofVal, ofVal_toVal, ofVal_exact, fits⟩

-- No sum of the document gives one wire tag to two cases.
#guard shapeDoc.wellTagged

end RowShapeC

