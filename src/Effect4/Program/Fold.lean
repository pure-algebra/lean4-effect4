end


inductive EffFrontierFam where
  | eff
  | stmt
  | stmts
  | effs
  | action
deriving DecidableEq, Repr

structure EffFrontierAlgebra (Op : Type) (R : EffFrontierFam → Type u) where
  eff_succeed : (Effect4.Program.Term) → R .eff
  eff_fail : (Effect4.Program.Term) → R .eff
  eff_failCause : (Effect4.Program.CauseTerm) → R .eff
  eff_yieldError : (Effect4.Program.Term) → R .eff
  eff_sync : (Effect4.Program.Term) → R .eff
  eff_suspend : R .eff → R .eff
  eff_perform : (Op) → (Effect4.Program.Term) → R .eff
  eff_bind : R .eff → R .eff → R .eff
  eff_gen : R .stmts → R .eff
  eff_catchCause : R .eff → R .eff → R .eff
  eff_matchCause : R .eff → R .eff → R .eff → R .eff
  eff_onExit : R .eff → R .eff → R .eff
  eff_exit : R .eff → R .eff
  eff_uninterruptible : R .eff → R .eff
  eff_interruptible : R .eff → R .eff
  eff_branch : (Effect4.Program.Term) → R .eff → R .eff → R .eff
  eff_whileLoop : (Effect4.Program.Term) → (Effect4.Program.Term) → (Effect4.Program.Term) → R .eff → R .eff
  eff_yieldNow : (Nat) → R .eff
  eff_callback : (Op) → (Effect4.Program.Term) → R .eff
  eff_awaitFiber : (Effect4.Program.Term) → (Effect4.Supervision.ObserverMode) → R .eff
  eff_withFiber : R .action → R .eff
  eff_scoped : R .eff → R .eff
  eff_acquireRelease : R .eff → R .eff → R .eff
  eff_provideLayer : (Effect4.Program.LayerTerm Op) → (Bool) → R .eff → R .eff
  eff_service : (Effect4.ServiceKey) → R .eff
  eff_provideService : (Effect4.ServiceKey) → (Effect4.Program.Term) → R .eff → R .eff
  eff_catchIf : (Effect4.Program.Term) → R .eff → R .eff → R .eff
  stmt_bindYield : R .eff → R .stmt
  stmt_yieldDiscard : R .eff → R .stmt
  stmt_ret : (Effect4.Program.Term) → R .stmt
  stmt_ifElse : (Effect4.Program.Term) → R .stmts → R .stmts → R .stmt
  stmt_whileTrue : R .stmts → R .stmt
  stmt_breakLoop : R .stmt
  stmts_nil : R .stmts
  stmts_cons : R .stmt → R .stmts → R .stmts
  effs_nil : R .effs
  effs_cons : R .eff → R .effs → R .effs
  action_fork : R .eff → (Effect4.Supervision.ForkOptions) → R .action
  action_forkIn : R .eff → (Effect4.Supervision.ForkOptions) → (Effect4.Program.Term) → R .action
  action_forkScoped : R .eff → (Effect4.Supervision.ForkOptions) → R .action
  action_runIn : (Effect4.Program.Term) → (Effect4.Program.Term) → R .action
  action_interrupt : (Effect4.Program.Term) → R .action
  action_interruptScoped : (Effect4.Program.Term) → R .action
  action_interruptAll : (Effect4.Program.Term) → (Option Effect4.Program.Term) → R .action
  action_awaitAll : (Effect4.Program.Term) → R .action
  action_awaitAllFailFast : (Effect4.Program.Term) → R .action
  action_snapshotChildren : R .action
  action_awaitNewChildren : (Effect4.Program.Term) → R .action
  action_raceAll : R .effs → R .action
  action_setContext : (Effect4.Program.Term) → R .action
  action_getContext : R .action
  action_getId : R .action
  action_closeScope : (Effect4.Program.Term) → (Effect4.Program.Term) → R .action

mutual
def cata_frontier_eff {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Eff Op) : R .eff :=
  match node with
  | .succeed a0 => alg.eff_succeed a0
  | .fail a0 => alg.eff_fail a0
  | .failCause a0 => alg.eff_failCause a0
  | .yieldError a0 => alg.eff_yieldError a0
  | .sync a0 => alg.eff_sync a0
  | .suspend a0 => alg.eff_suspend (cata_frontier_eff alg a0)
  | .perform a0 a1 => alg.eff_perform a0 a1
  | .bind a0 a1 => alg.eff_bind (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .gen a0 => alg.eff_gen (cata_frontier_stmts alg a0)
  | .catchCause a0 a1 => alg.eff_catchCause (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .matchCause a0 a1 a2 => alg.eff_matchCause (cata_frontier_eff alg a0) (cata_frontier_eff alg a1) (cata_frontier_eff alg a2)
  | .onExit a0 a1 => alg.eff_onExit (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .exit a0 => alg.eff_exit (cata_frontier_eff alg a0)
  | .uninterruptible a0 => alg.eff_uninterruptible (cata_frontier_eff alg a0)
  | .interruptible a0 => alg.eff_interruptible (cata_frontier_eff alg a0)
  | .branch a0 a1 a2 => alg.eff_branch a0 (cata_frontier_eff alg a1) (cata_frontier_eff alg a2)
  | .whileLoop a0 a1 a2 a3 => alg.eff_whileLoop a0 a1 a2 (cata_frontier_eff alg a3)
  | .yieldNow a0 => alg.eff_yieldNow a0
  | .callback a0 a1 => alg.eff_callback a0 a1
  | .awaitFiber a0 a1 => alg.eff_awaitFiber a0 a1
  | .withFiber a0 => alg.eff_withFiber (cata_frontier_action alg a0)
  | .scoped a0 => alg.eff_scoped (cata_frontier_eff alg a0)
  | .acquireRelease a0 a1 => alg.eff_acquireRelease (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .provideLayer a0 a1 a2 => alg.eff_provideLayer a0 a1 (cata_frontier_eff alg a2)
  | .service a0 => alg.eff_service a0
  | .provideService a0 a1 a2 => alg.eff_provideService a0 a1 (cata_frontier_eff alg a2)
  | .catchIf a0 a1 a2 => alg.eff_catchIf a0 (cata_frontier_eff alg a1) (cata_frontier_eff alg a2)
termination_by structural node
def cata_frontier_stmt {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Stmt Op) : R .stmt :=
  match node with
  | .bindYield a0 => alg.stmt_bindYield (cata_frontier_eff alg a0)
  | .yieldDiscard a0 => alg.stmt_yieldDiscard (cata_frontier_eff alg a0)
  | .ret a0 => alg.stmt_ret a0
  | .ifElse a0 a1 a2 => alg.stmt_ifElse a0 (cata_frontier_stmts alg a1) (cata_frontier_stmts alg a2)
  | .whileTrue a0 => alg.stmt_whileTrue (cata_frontier_stmts alg a0)
  | .breakLoop => alg.stmt_breakLoop
termination_by structural node
def cata_frontier_stmts {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Stmts Op) : R .stmts :=
  match node with
  | .nil => alg.stmts_nil
  | .cons a0 a1 => alg.stmts_cons (cata_frontier_stmt alg a0) (cata_frontier_stmts alg a1)
termination_by structural node
def cata_frontier_effs {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Effs Op) : R .effs :=
  match node with
  | .nil => alg.effs_nil
  | .cons a0 a1 => alg.effs_cons (cata_frontier_eff alg a0) (cata_frontier_effs alg a1)
termination_by structural node
def cata_frontier_action {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.ActionTerm Op) : R .action :=
  match node with
  | .fork a0 a1 => alg.action_fork (cata_frontier_eff alg a0) a1
  | .forkIn a0 a1 a2 => alg.action_forkIn (cata_frontier_eff alg a0) a1 a2
  | .forkScoped a0 a1 => alg.action_forkScoped (cata_frontier_eff alg a0) a1
  | .runIn a0 a1 => alg.action_runIn a0 a1
  | .interrupt a0 => alg.action_interrupt a0
  | .interruptScoped a0 => alg.action_interruptScoped a0
  | .interruptAll a0 a1 => alg.action_interruptAll a0 a1
  | .awaitAll a0 => alg.action_awaitAll a0
  | .awaitAllFailFast a0 => alg.action_awaitAllFailFast a0
  | .snapshotChildren => alg.action_snapshotChildren
  | .awaitNewChildren a0 => alg.action_awaitNewChildren a0
  | .raceAll a0 => alg.action_raceAll (cata_frontier_effs alg a0)
  | .setContext a0 => alg.action_setContext a0
  | .getContext => alg.action_getContext
  | .getId => alg.action_getId
  | .closeScope a0 a1 => alg.action_closeScope a0 a1
termination_by structural node
end

def frontierSelfCarrier (Op : Type) : EffFrontierFam → Type
  | .eff => Effect4.Program.Eff Op
  | .stmt => Effect4.Program.Stmt Op
  | .stmts => Effect4.Program.Stmts Op
  | .effs => Effect4.Program.Effs Op
  | .action => Effect4.Program.ActionTerm Op

def weakenAlg {Op : Type} (cut : Nat) : EffFrontierAlgebra Op (frontierSelfCarrier Op) where
  eff_succeed a0 := .succeed (Effect4.Program.Term.weaken cut a0)
  eff_fail a0 := .fail (Effect4.Program.Term.weaken cut a0)
  eff_failCause a0 := .failCause (Effect4.Program.CauseTerm.weaken cut a0)
  eff_yieldError a0 := .yieldError (Effect4.Program.Term.weaken cut a0)
  eff_sync a0 := .sync (Effect4.Program.Term.weaken cut a0)
  eff_suspend a0 := .suspend a0
  eff_perform a0 a1 := .perform a0 (Effect4.Program.Term.weaken cut a1)
  eff_bind a0 a1 := .bind a0 a1
  eff_gen a0 := .gen a0
  eff_catchCause a0 a1 := .catchCause a0 a1
  eff_matchCause a0 a1 a2 := .matchCause a0 a1 a2
  eff_onExit a0 a1 := .onExit a0 a1
  eff_exit a0 := .exit a0
  eff_uninterruptible a0 := .uninterruptible a0
  eff_interruptible a0 := .interruptible a0
  eff_branch a0 a1 a2 := .branch (Effect4.Program.Term.weaken cut a0) a1 a2
  eff_whileLoop a0 a1 a2 a3 := .whileLoop (Effect4.Program.Term.weaken cut a0) (Effect4.Program.Term.weaken cut a1) (Effect4.Program.Term.weaken cut a2) a3
  eff_yieldNow a0 := .yieldNow a0
  eff_callback a0 a1 := .callback a0 (Effect4.Program.Term.weaken cut a1)
  eff_awaitFiber a0 a1 := .awaitFiber (Effect4.Program.Term.weaken cut a0) a1
  eff_withFiber a0 := .withFiber a0
  eff_scoped a0 := .scoped a0
  eff_acquireRelease a0 a1 := .acquireRelease a0 a1
  eff_provideLayer a0 a1 a2 := .provideLayer a0 a1 a2
  eff_service a0 := .service a0
  eff_provideService a0 a1 a2 := .provideService a0 (Effect4.Program.Term.weaken cut a1) a2
  eff_catchIf a0 a1 a2 := .catchIf (Effect4.Program.Term.weaken cut a0) a1 a2
  stmt_bindYield a0 := .bindYield a0
  stmt_yieldDiscard a0 := .yieldDiscard a0
  stmt_ret a0 := .ret (Effect4.Program.Term.weaken cut a0)
  stmt_ifElse a0 a1 a2 := .ifElse (Effect4.Program.Term.weaken cut a0) a1 a2
  stmt_whileTrue a0 := .whileTrue a0
  stmt_breakLoop := .breakLoop
  stmts_nil := .nil
  stmts_cons a0 a1 := .cons a0 a1
  effs_nil := .nil
  effs_cons a0 a1 := .cons a0 a1
  action_fork a0 a1 := .fork a0 a1
  action_forkIn a0 a1 a2 := .forkIn a0 a1 (Effect4.Program.Term.weaken cut a2)
  action_forkScoped a0 a1 := .forkScoped a0 a1
  action_runIn a0 a1 := .runIn (Effect4.Program.Term.weaken cut a0) (Effect4.Program.Term.weaken cut a1)
  action_interrupt a0 := .interrupt (Effect4.Program.Term.weaken cut a0)
  action_interruptScoped a0 := .interruptScoped (Effect4.Program.Term.weaken cut a0)
  action_interruptAll a0 a1 := .interruptAll (Effect4.Program.Term.weaken cut a0) (a1.map (Effect4.Program.Term.weaken cut))
  action_awaitAll a0 := .awaitAll (Effect4.Program.Term.weaken cut a0)
  action_awaitAllFailFast a0 := .awaitAllFailFast (Effect4.Program.Term.weaken cut a0)
  action_snapshotChildren := .snapshotChildren
  action_awaitNewChildren a0 := .awaitNewChildren (Effect4.Program.Term.weaken cut a0)
  action_raceAll a0 := .raceAll a0
  action_setContext a0 := .setContext (Effect4.Program.Term.weaken cut a0)
  action_getContext := .getContext
  action_getId := .getId
  action_closeScope a0 a1 := .closeScope (Effect4.Program.Term.weaken cut a0) (Effect4.Program.Term.weaken cut a1)

mutual
theorem weaken_eq_cata_eff {Op : Type} (cut : Nat) (node : Effect4.Program.Eff Op) :
    Effect4.Program.Eff.weaken cut node = cata_frontier_eff (weakenAlg cut) node := by
  match node with
  | .succeed a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .fail a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .failCause a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .yieldError a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .sync a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .suspend a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .perform a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .bind a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1]
  | .gen a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_stmts cut a0]
  | .catchCause a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1]
  | .matchCause a0 a1 a2 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1, weaken_eq_cata_eff cut a2]
  | .onExit a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1]
  | .exit a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .uninterruptible a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .interruptible a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .branch a0 a1 a2 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a1, weaken_eq_cata_eff cut a2]
  | .whileLoop a0 a1 a2 a3 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a3]
  | .yieldNow a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .callback a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .awaitFiber a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .withFiber a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_action cut a0]
  | .scoped a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .acquireRelease a0 a1 =>
