structure TermMAlgebra (M : Type u → Type v) (R : TermFam → Type u) where
  term_var : (Effect4.Program.Var) → M (R .term)
  term_lit : (Effect4.Program.Lit) → M (R .term)
  term_app : (String) → R .terms → M (R .term)
  terms_nil : M (R .terms)
  terms_cons : R .term → R .terms → M (R .terms)

def TermAlgebra.toM {M : Type u → Type v} [Monad M] {R : TermFam → Type u}
    (alg : TermAlgebra R) : TermMAlgebra M R where
  term_var a0 := pure (alg.term_var a0)
  term_lit a0 := pure (alg.term_lit a0)
  term_app a0 a1 := pure (alg.term_app a0 a1)
  terms_nil := pure alg.terms_nil
  terms_cons a0 a1 := pure (alg.terms_cons a0 a1)

def TermMAlgebra.map {M : Type u → Type v} {N : Type u → Type w}
    {R : TermFam → Type u} (φ : ∀ {α}, M α → N α)
    (alg : TermMAlgebra M R) : TermMAlgebra N R where
  term_var a0 := φ (alg.term_var a0)
  term_lit a0 := φ (alg.term_lit a0)
  term_app a0 a1 := φ (alg.term_app a0 a1)
  terms_nil := φ alg.terms_nil
  terms_cons a0 a1 := φ (alg.terms_cons a0 a1)

def TermMAlgebra.toSeq {M : Type u → Type v} [Monad M]
    {R : TermFam → Type u} (alg : TermMAlgebra M R) :
    TermAlgebra (fun f => M (R f)) where
  term_var a0 := alg.term_var a0
  term_lit a0 := alg.term_lit a0
  term_app a0 a1 := do
    let x1 ← a1
    alg.term_app a0 x1
  terms_nil := alg.terms_nil
  terms_cons a0 a1 := do
    let x0 ← a0
    let x1 ← a1
    alg.terms_cons x0 x1

mutual
def foldM_term {M : Type u → Type v} [Monad M] {R : TermFam → Type u}
    (alg : TermMAlgebra M R) (node : Effect4.Program.Term) : M (R .term) :=
  match node with
  | .var a0 => alg.term_var a0
  | .lit a0 => alg.term_lit a0
  | .app a0 a1 => do
      let x1 ← foldM_terms alg a1
      alg.term_app a0 x1
termination_by structural node
def foldM_terms {M : Type u → Type v} [Monad M] {R : TermFam → Type u}
    (alg : TermMAlgebra M R) (node : Effect4.Program.Terms) : M (R .terms) :=
  match node with
  | .nil => alg.terms_nil
  | .cons a0 a1 => do
      let x0 ← foldM_term alg a0
      let x1 ← foldM_terms alg a1
      alg.terms_cons x0 x1
termination_by structural node
end

mutual
theorem foldM_eq_cata_term {M : Type u → Type v} [Monad M]
    {R : TermFam → Type u} (alg : TermMAlgebra M R) (node : Effect4.Program.Term) :
    foldM_term alg node = cata_term alg.toSeq node := by
  match node with
  | .var a0 =>
    simp only [foldM_term, cata_term, TermMAlgebra.toSeq]
  | .lit a0 =>
    simp only [foldM_term, cata_term, TermMAlgebra.toSeq]
  | .app a0 a1 =>
    simp only [foldM_term, cata_term, TermMAlgebra.toSeq, foldM_eq_cata_terms alg a1]
termination_by structural node
theorem foldM_eq_cata_terms {M : Type u → Type v} [Monad M]
    {R : TermFam → Type u} (alg : TermMAlgebra M R) (node : Effect4.Program.Terms) :
    foldM_terms alg node = cata_terms alg.toSeq node := by
  match node with
  | .nil =>
    simp only [foldM_terms, cata_terms, TermMAlgebra.toSeq]
  | .cons a0 a1 =>
    simp only [foldM_terms, cata_terms, TermMAlgebra.toSeq, foldM_eq_cata_term alg a0, foldM_eq_cata_terms alg a1]
termination_by structural node
end

theorem foldM_id_term {R : TermFam → Type u} (alg : TermAlgebra R)
    (node : Effect4.Program.Term) :
    foldM_term (M := Id) alg.toM node = cata_term alg node := by
  rw [foldM_eq_cata_term]
  rfl

theorem foldM_id_terms {R : TermFam → Type u} (alg : TermAlgebra R)
    (node : Effect4.Program.Terms) :
    foldM_terms (M := Id) alg.toM node = cata_terms alg node := by
  rw [foldM_eq_cata_terms]
  rfl

mutual
theorem foldM_natural_term {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : TermFam → Type u} (φ : MonadMorphism M N)
    (alg : TermMAlgebra M R) (node : Effect4.Program.Term) :
    φ.toFun (foldM_term alg node) = foldM_term (alg.map φ.toFun) node := by
  match node with
  | .var a0 =>
    simp only [foldM_term, TermMAlgebra.map]
  | .lit a0 =>
    simp only [foldM_term, TermMAlgebra.map]
  | .app a0 a1 =>
    simp only [foldM_term, TermMAlgebra.map, φ.map_bind, foldM_natural_terms φ alg a1]
termination_by structural node
theorem foldM_natural_terms {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : TermFam → Type u} (φ : MonadMorphism M N)
    (alg : TermMAlgebra M R) (node : Effect4.Program.Terms) :
    φ.toFun (foldM_terms alg node) = foldM_terms (alg.map φ.toFun) node := by
  match node with
  | .nil =>
    simp only [foldM_terms, TermMAlgebra.map]
  | .cons a0 a1 =>
    simp only [foldM_terms, TermMAlgebra.map, φ.map_bind, foldM_natural_term φ alg a0, foldM_natural_terms φ alg a1]
termination_by structural node
end


inductive CauseTermFam where
  | cause
deriving DecidableEq, Repr

structure CauseTermAlgebra (R : CauseTermFam → Type u) where
  cause_fail : (Effect4.Program.Term) → R .cause
  cause_die : (Effect4.Program.Term) → R .cause
  cause_interrupt : (Option Effect4.Program.Term) → R .cause
  cause_both : R .cause → R .cause → R .cause

def cata_cause {R : CauseTermFam → Type u} (alg : CauseTermAlgebra R)
    (node : Effect4.Program.CauseTerm) : R .cause :=
  match node with
  | .fail a0 => alg.cause_fail a0
  | .die a0 => alg.cause_die a0
  | .interrupt a0 => alg.cause_interrupt a0
  | .both a0 a1 => alg.cause_both (cata_cause alg a0) (cata_cause alg a1)
termination_by structural node

structure CauseTermHom {R : CauseTermFam → Type u} (alg : CauseTermAlgebra R) where
  f_cause : Effect4.Program.CauseTerm → R .cause
  h_cause_fail : ∀ a0, f_cause (.fail a0) = alg.cause_fail a0
  h_cause_die : ∀ a0, f_cause (.die a0) = alg.cause_die a0
  h_cause_interrupt : ∀ a0, f_cause (.interrupt a0) = alg.cause_interrupt a0
  h_cause_both : ∀ a0 a1, f_cause (.both a0 a1) = alg.cause_both (f_cause a0) (f_cause a1)

theorem hom_eq_cata_cause {R : CauseTermFam → Type u}
    {alg : CauseTermAlgebra R} (hom : CauseTermHom alg) (node : Effect4.Program.CauseTerm) :
    hom.f_cause node = cata_cause alg node := by
  match node with
  | .fail a0 =>
    simp only [cata_cause, hom.h_cause_fail a0]
  | .die a0 =>
    simp only [cata_cause, hom.h_cause_die a0]
  | .interrupt a0 =>
    simp only [cata_cause, hom.h_cause_interrupt a0]
  | .both a0 a1 =>
    simp only [cata_cause, hom.h_cause_both a0 a1, hom_eq_cata_cause hom a0, hom_eq_cata_cause hom a1]
termination_by structural node

def foldMap_cause {M : Type u} (unit : M) (op : M → M → M) (node : Effect4.Program.CauseTerm)
    (f_cause : Effect4.Program.CauseTerm → M := fun _ => unit) : M :=
  match node with
  | .fail a0 =>
    f_cause (.fail a0)
  | .die a0 =>
    f_cause (.die a0)
  | .interrupt a0 =>
    f_cause (.interrupt a0)
  | .both a0 a1 =>
    op (f_cause (.both a0 a1)) (op (foldMap_cause unit op a0 f_cause) ((foldMap_cause unit op a1 f_cause)))
termination_by structural node

structure CauseTermMAlgebra (M : Type u → Type v) (R : CauseTermFam → Type u) where
  cause_fail : (Effect4.Program.Term) → M (R .cause)
  cause_die : (Effect4.Program.Term) → M (R .cause)
  cause_interrupt : (Option Effect4.Program.Term) → M (R .cause)
  cause_both : R .cause → R .cause → M (R .cause)

def CauseTermAlgebra.toM {M : Type u → Type v} [Monad M] {R : CauseTermFam → Type u}
    (alg : CauseTermAlgebra R) : CauseTermMAlgebra M R where
  cause_fail a0 := pure (alg.cause_fail a0)
  cause_die a0 := pure (alg.cause_die a0)
  cause_interrupt a0 := pure (alg.cause_interrupt a0)
  cause_both a0 a1 := pure (alg.cause_both a0 a1)

def CauseTermMAlgebra.map {M : Type u → Type v} {N : Type u → Type w}
    {R : CauseTermFam → Type u} (φ : ∀ {α}, M α → N α)
    (alg : CauseTermMAlgebra M R) : CauseTermMAlgebra N R where
  cause_fail a0 := φ (alg.cause_fail a0)
  cause_die a0 := φ (alg.cause_die a0)
  cause_interrupt a0 := φ (alg.cause_interrupt a0)
  cause_both a0 a1 := φ (alg.cause_both a0 a1)

def CauseTermMAlgebra.toSeq {M : Type u → Type v} [Monad M]
    {R : CauseTermFam → Type u} (alg : CauseTermMAlgebra M R) :
    CauseTermAlgebra (fun f => M (R f)) where
  cause_fail a0 := alg.cause_fail a0
  cause_die a0 := alg.cause_die a0
  cause_interrupt a0 := alg.cause_interrupt a0
  cause_both a0 a1 := do
    let x0 ← a0
    let x1 ← a1
    alg.cause_both x0 x1

def foldM_cause {M : Type u → Type v} [Monad M] {R : CauseTermFam → Type u}
    (alg : CauseTermMAlgebra M R) (node : Effect4.Program.CauseTerm) : M (R .cause) :=
  match node with
  | .fail a0 => alg.cause_fail a0
  | .die a0 => alg.cause_die a0
  | .interrupt a0 => alg.cause_interrupt a0
  | .both a0 a1 => do
      let x0 ← foldM_cause alg a0
      let x1 ← foldM_cause alg a1
      alg.cause_both x0 x1
termination_by structural node

theorem foldM_eq_cata_cause {M : Type u → Type v} [Monad M]
    {R : CauseTermFam → Type u} (alg : CauseTermMAlgebra M R) (node : Effect4.Program.CauseTerm) :
    foldM_cause alg node = cata_cause alg.toSeq node := by
  match node with
  | .fail a0 =>
    simp only [foldM_cause, cata_cause, CauseTermMAlgebra.toSeq]
  | .die a0 =>
    simp only [foldM_cause, cata_cause, CauseTermMAlgebra.toSeq]
  | .interrupt a0 =>
    simp only [foldM_cause, cata_cause, CauseTermMAlgebra.toSeq]
  | .both a0 a1 =>
    simp only [foldM_cause, cata_cause, CauseTermMAlgebra.toSeq, foldM_eq_cata_cause alg a0, foldM_eq_cata_cause alg a1]
termination_by structural node

theorem foldM_id_cause {R : CauseTermFam → Type u} (alg : CauseTermAlgebra R)
    (node : Effect4.Program.CauseTerm) :
    foldM_cause (M := Id) alg.toM node = cata_cause alg node := by
  rw [foldM_eq_cata_cause]
  rfl

theorem foldM_natural_cause {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : CauseTermFam → Type u} (φ : MonadMorphism M N)
    (alg : CauseTermMAlgebra M R) (node : Effect4.Program.CauseTerm) :
    φ.toFun (foldM_cause alg node) = foldM_cause (alg.map φ.toFun) node := by
  match node with
  | .fail a0 =>
    simp only [foldM_cause, CauseTermMAlgebra.map]
  | .die a0 =>
    simp only [foldM_cause, CauseTermMAlgebra.map]
  | .interrupt a0 =>
    simp only [foldM_cause, CauseTermMAlgebra.map]
  | .both a0 a1 =>
    simp only [foldM_cause, CauseTermMAlgebra.map, φ.map_bind, foldM_natural_cause φ alg a0, foldM_natural_cause φ alg a1]
termination_by structural node


inductive EffFam where
  | eff
  | stmt
  | stmts
  | effs
  | action
  | layer
  | layers
deriving DecidableEq, Repr

structure EffAlgebra (Op : Type) (R : EffFam → Type u) where
  eff_succeed : (Effect4.Program.Term) → R .eff
  eff_fail : (Effect4.Program.Term) → R .eff
  eff_failCause : (Effect4.Program.CauseTerm) → R .eff
  eff_yieldError : (Effect4.Program.Term) → R .eff
  eff_sync : (Effect4.Program.Term) → R .eff
  eff_suspend : R .eff → R .eff
  eff_perform : (Op) → (Effect4.Program.Term) → R .eff
  eff_bind : R .eff → R .eff → R .eff
  eff_gen : R .stmts → R .eff
  eff_catchCause : R .eff → R .eff → R .eff
  eff_matchCause : R .eff → R .eff → R .eff → R .eff
  eff_onExit : R .eff → R .eff → R .eff
  eff_exit : R .eff → R .eff
  eff_uninterruptible : R .eff → R .eff
  eff_interruptible : R .eff → R .eff
  eff_branch : (Effect4.Program.Term) → R .eff → R .eff → R .eff
  eff_whileLoop : (Effect4.Program.Term) → (Effect4.Program.Term) → (Effect4.Program.Term) → R .eff → R .eff
  eff_yieldNow : (Nat) → R .eff
  eff_callback : (Op) → (Effect4.Program.Term) → R .eff
  eff_awaitFiber : (Effect4.Program.Term) → (Effect4.Supervision.ObserverMode) → R .eff
  eff_withFiber : R .action → R .eff
  eff_scoped : R .eff → R .eff
  eff_acquireRelease : R .eff → R .eff → R .eff
  eff_provideLayer : R .layer → (Bool) → R .eff → R .eff
  eff_service : (Effect4.ServiceKey) → R .eff
  eff_provideService : (Effect4.ServiceKey) → (Effect4.Program.Term) → R .eff → R .eff
  eff_catchIf : (Effect4.Program.Term) → R .eff → R .eff → R .eff
  stmt_bindYield : R .eff → R .stmt
  stmt_yieldDiscard : R .eff → R .stmt
  stmt_ret : (Effect4.Program.Term) → R .stmt
  stmt_ifElse : (Effect4.Program.Term) → R .stmts → R .stmts → R .stmt
  stmt_whileTrue : R .stmts → R .stmt
  stmt_breakLoop : R .stmt
  stmts_nil : R .stmts
  stmts_cons : R .stmt → R .stmts → R .stmts
  effs_nil : R .effs
  effs_cons : R .eff → R .effs → R .effs
  action_fork : R .eff → (Effect4.Supervision.ForkOptions) → R .action
  action_forkIn : R .eff → (Effect4.Supervision.ForkOptions) → (Effect4.Program.Term) → R .action
  action_forkScoped : R .eff → (Effect4.Supervision.ForkOptions) → R .action
  action_runIn : (Effect4.Program.Term) → (Effect4.Program.Term) → R .action
  action_interrupt : (Effect4.Program.Term) → R .action
  action_interruptScoped : (Effect4.Program.Term) → R .action
  action_interruptAll : (Effect4.Program.Term) → (Option Effect4.Program.Term) → R .action
  action_awaitAll : (Effect4.Program.Term) → R .action
  action_awaitAllFailFast : (Effect4.Program.Term) → R .action
  action_snapshotChildren : R .action
  action_awaitNewChildren : (Effect4.Program.Term) → R .action
  action_raceAll : R .effs → R .action
  action_setContext : (Effect4.Program.Term) → R .action
  action_getContext : R .action
  action_getId : R .action
  action_closeScope : (Effect4.Program.Term) → (Effect4.Program.Term) → R .action
  layer_succeed : (Effect4.ServiceKey) → (Effect4.Program.Lit) → R .layer
  layer_effect : (Effect4.ServiceKey) → R .eff → R .layer
  layer_effectDiscard : R .eff → R .layer
  layer_provide : R .layer → R .layer → R .layer
  layer_provideMerge : R .layer → R .layer → R .layer
  layer_merge : R .layer → R .layer → R .layer
  layer_fresh : R .layer → R .layer
  layer_orDie : R .layer → R .layer
  layer_ref : (List Nat) → R .layer
  layer_mergeAll : R .layers → R .layer
  layers_nil : R .layers
  layers_cons : R .layer → R .layers → R .layers

mutual
def cata_eff {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Eff Op) : R .eff :=
  match node with
  | .succeed a0 => alg.eff_succeed a0
  | .fail a0 => alg.eff_fail a0
  | .failCause a0 => alg.eff_failCause a0
  | .yieldError a0 => alg.eff_yieldError a0
  | .sync a0 => alg.eff_sync a0
  | .suspend a0 => alg.eff_suspend (cata_eff alg a0)
  | .perform a0 a1 => alg.eff_perform a0 a1
  | .bind a0 a1 => alg.eff_bind (cata_eff alg a0) (cata_eff alg a1)
  | .gen a0 => alg.eff_gen (cata_stmts alg a0)
  | .catchCause a0 a1 => alg.eff_catchCause (cata_eff alg a0) (cata_eff alg a1)
  | .matchCause a0 a1 a2 => alg.eff_matchCause (cata_eff alg a0) (cata_eff alg a1) (cata_eff alg a2)
  | .onExit a0 a1 => alg.eff_onExit (cata_eff alg a0) (cata_eff alg a1)
  | .exit a0 => alg.eff_exit (cata_eff alg a0)
  | .uninterruptible a0 => alg.eff_uninterruptible (cata_eff alg a0)
  | .interruptible a0 => alg.eff_interruptible (cata_eff alg a0)
  | .branch a0 a1 a2 => alg.eff_branch a0 (cata_eff alg a1) (cata_eff alg a2)
  | .whileLoop a0 a1 a2 a3 => alg.eff_whileLoop a0 a1 a2 (cata_eff alg a3)
  | .yieldNow a0 => alg.eff_yieldNow a0
  | .callback a0 a1 => alg.eff_callback a0 a1
  | .awaitFiber a0 a1 => alg.eff_awaitFiber a0 a1
  | .withFiber a0 => alg.eff_withFiber (cata_action alg a0)
  | .scoped a0 => alg.eff_scoped (cata_eff alg a0)
  | .acquireRelease a0 a1 => alg.eff_acquireRelease (cata_eff alg a0) (cata_eff alg a1)
  | .provideLayer a0 a1 a2 => alg.eff_provideLayer (cata_layer alg a0) a1 (cata_eff alg a2)
  | .service a0 => alg.eff_service a0
  | .provideService a0 a1 a2 => alg.eff_provideService a0 a1 (cata_eff alg a2)
  | .catchIf a0 a1 a2 => alg.eff_catchIf a0 (cata_eff alg a1) (cata_eff alg a2)
termination_by structural node
def cata_stmt {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Stmt Op) : R .stmt :=
  match node with
  | .bindYield a0 => alg.stmt_bindYield (cata_eff alg a0)
  | .yieldDiscard a0 => alg.stmt_yieldDiscard (cata_eff alg a0)
  | .ret a0 => alg.stmt_ret a0
  | .ifElse a0 a1 a2 => alg.stmt_ifElse a0 (cata_stmts alg a1) (cata_stmts alg a2)
  | .whileTrue a0 => alg.stmt_whileTrue (cata_stmts alg a0)
  | .breakLoop => alg.stmt_breakLoop
termination_by structural node
def cata_stmts {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Stmts Op) : R .stmts :=
  match node with
  | .nil => alg.stmts_nil
  | .cons a0 a1 => alg.stmts_cons (cata_stmt alg a0) (cata_stmts alg a1)
termination_by structural node
def cata_effs {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Effs Op) : R .effs :=
  match node with
  | .nil => alg.effs_nil
  | .cons a0 a1 => alg.effs_cons (cata_eff alg a0) (cata_effs alg a1)
termination_by structural node
def cata_action {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.ActionTerm Op) : R .action :=
  match node with
  | .fork a0 a1 => alg.action_fork (cata_eff alg a0) a1
  | .forkIn a0 a1 a2 => alg.action_forkIn (cata_eff alg a0) a1 a2
  | .forkScoped a0 a1 => alg.action_forkScoped (cata_eff alg a0) a1
  | .runIn a0 a1 => alg.action_runIn a0 a1
  | .interrupt a0 => alg.action_interrupt a0
  | .interruptScoped a0 => alg.action_interruptScoped a0
  | .interruptAll a0 a1 => alg.action_interruptAll a0 a1
  | .awaitAll a0 => alg.action_awaitAll a0
  | .awaitAllFailFast a0 => alg.action_awaitAllFailFast a0
  | .snapshotChildren => alg.action_snapshotChildren
  | .awaitNewChildren a0 => alg.action_awaitNewChildren a0
  | .raceAll a0 => alg.action_raceAll (cata_effs alg a0)
  | .setContext a0 => alg.action_setContext a0
  | .getContext => alg.action_getContext
  | .getId => alg.action_getId
  | .closeScope a0 a1 => alg.action_closeScope a0 a1
termination_by structural node
def cata_layer {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.LayerTerm Op) : R .layer :=
  match node with
  | .succeed a0 a1 => alg.layer_succeed a0 a1
  | .effect a0 a1 => alg.layer_effect a0 (cata_eff alg a1)
  | .effectDiscard a0 => alg.layer_effectDiscard (cata_eff alg a0)
  | .provide a0 a1 => alg.layer_provide (cata_layer alg a0) (cata_layer alg a1)
  | .provideMerge a0 a1 => alg.layer_provideMerge (cata_layer alg a0) (cata_layer alg a1)
  | .merge a0 a1 => alg.layer_merge (cata_layer alg a0) (cata_layer alg a1)
  | .fresh a0 => alg.layer_fresh (cata_layer alg a0)
  | .orDie a0 => alg.layer_orDie (cata_layer alg a0)
  | .ref a0 => alg.layer_ref a0
  | .mergeAll a0 => alg.layer_mergeAll (cata_layers alg a0)
termination_by structural node
def cata_layers {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.LayerTerms Op) : R .layers :=
  match node with
  | .nil => alg.layers_nil
  | .cons a0 a1 => alg.layers_cons (cata_layer alg a0) (cata_layers alg a1)
termination_by structural node
end

structure EffHom {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R) where
  f_eff : Effect4.Program.Eff Op → R .eff
  f_stmt : Effect4.Program.Stmt Op → R .stmt
  f_stmts : Effect4.Program.Stmts Op → R .stmts
  f_effs : Effect4.Program.Effs Op → R .effs
  f_action : Effect4.Program.ActionTerm Op → R .action
  f_layer : Effect4.Program.LayerTerm Op → R .layer
  f_layers : Effect4.Program.LayerTerms Op → R .layers
  h_eff_succeed : ∀ a0, f_eff (.succeed a0) = alg.eff_succeed a0
  h_eff_fail : ∀ a0, f_eff (.fail a0) = alg.eff_fail a0
  h_eff_failCause : ∀ a0, f_eff (.failCause a0) = alg.eff_failCause a0
  h_eff_yieldError : ∀ a0, f_eff (.yieldError a0) = alg.eff_yieldError a0
  h_eff_sync : ∀ a0, f_eff (.sync a0) = alg.eff_sync a0
  h_eff_suspend : ∀ a0, f_eff (.suspend a0) = alg.eff_suspend (f_eff a0)
  h_eff_perform : ∀ a0 a1, f_eff (.perform a0 a1) = alg.eff_perform a0 a1
  h_eff_bind : ∀ a0 a1, f_eff (.bind a0 a1) = alg.eff_bind (f_eff a0) (f_eff a1)
  h_eff_gen : ∀ a0, f_eff (.gen a0) = alg.eff_gen (f_stmts a0)
  h_eff_catchCause : ∀ a0 a1, f_eff (.catchCause a0 a1) = alg.eff_catchCause (f_eff a0) (f_eff a1)
  h_eff_matchCause : ∀ a0 a1 a2, f_eff (.matchCause a0 a1 a2) = alg.eff_matchCause (f_eff a0) (f_eff a1) (f_eff a2)
  h_eff_onExit : ∀ a0 a1, f_eff (.onExit a0 a1) = alg.eff_onExit (f_eff a0) (f_eff a1)
  h_eff_exit : ∀ a0, f_eff (.exit a0) = alg.eff_exit (f_eff a0)
  h_eff_uninterruptible : ∀ a0, f_eff (.uninterruptible a0) = alg.eff_uninterruptible (f_eff a0)
  h_eff_interruptible : ∀ a0, f_eff (.interruptible a0) = alg.eff_interruptible (f_eff a0)
  h_eff_branch : ∀ a0 a1 a2, f_eff (.branch a0 a1 a2) = alg.eff_branch a0 (f_eff a1) (f_eff a2)
  h_eff_whileLoop : ∀ a0 a1 a2 a3, f_eff (.whileLoop a0 a1 a2 a3) = alg.eff_whileLoop a0 a1 a2 (f_eff a3)
  h_eff_yieldNow : ∀ a0, f_eff (.yieldNow a0) = alg.eff_yieldNow a0
  h_eff_callback : ∀ a0 a1, f_eff (.callback a0 a1) = alg.eff_callback a0 a1
  h_eff_awaitFiber : ∀ a0 a1, f_eff (.awaitFiber a0 a1) = alg.eff_awaitFiber a0 a1
  h_eff_withFiber : ∀ a0, f_eff (.withFiber a0) = alg.eff_withFiber (f_action a0)
  h_eff_scoped : ∀ a0, f_eff (.scoped a0) = alg.eff_scoped (f_eff a0)
  h_eff_acquireRelease : ∀ a0 a1, f_eff (.acquireRelease a0 a1) = alg.eff_acquireRelease (f_eff a0) (f_eff a1)
  h_eff_provideLayer : ∀ a0 a1 a2, f_eff (.provideLayer a0 a1 a2) = alg.eff_provideLayer (f_layer a0) a1 (f_eff a2)
  h_eff_service : ∀ a0, f_eff (.service a0) = alg.eff_service a0
  h_eff_provideService : ∀ a0 a1 a2, f_eff (.provideService a0 a1 a2) = alg.eff_provideService a0 a1 (f_eff a2)
  h_eff_catchIf : ∀ a0 a1 a2, f_eff (.catchIf a0 a1 a2) = alg.eff_catchIf a0 (f_eff a1) (f_eff a2)
  h_stmt_bindYield : ∀ a0, f_stmt (.bindYield a0) = alg.stmt_bindYield (f_eff a0)
  h_stmt_yieldDiscard : ∀ a0, f_stmt (.yieldDiscard a0) = alg.stmt_yieldDiscard (f_eff a0)
  h_stmt_ret : ∀ a0, f_stmt (.ret a0) = alg.stmt_ret a0
  h_stmt_ifElse : ∀ a0 a1 a2, f_stmt (.ifElse a0 a1 a2) = alg.stmt_ifElse a0 (f_stmts a1) (f_stmts a2)
  h_stmt_whileTrue : ∀ a0, f_stmt (.whileTrue a0) = alg.stmt_whileTrue (f_stmts a0)
  h_stmt_breakLoop : f_stmt (.breakLoop) = alg.stmt_breakLoop
  h_stmts_nil : f_stmts (.nil) = alg.stmts_nil
  h_stmts_cons : ∀ a0 a1, f_stmts (.cons a0 a1) = alg.stmts_cons (f_stmt a0) (f_stmts a1)
  h_effs_nil : f_effs (.nil) = alg.effs_nil
  h_effs_cons : ∀ a0 a1, f_effs (.cons a0 a1) = alg.effs_cons (f_eff a0) (f_effs a1)
  h_action_fork : ∀ a0 a1, f_action (.fork a0 a1) = alg.action_fork (f_eff a0) a1
  h_action_forkIn : ∀ a0 a1 a2, f_action (.forkIn a0 a1 a2) = alg.action_forkIn (f_eff a0) a1 a2
  h_action_forkScoped : ∀ a0 a1, f_action (.forkScoped a0 a1) = alg.action_forkScoped (f_eff a0) a1
  h_action_runIn : ∀ a0 a1, f_action (.runIn a0 a1) = alg.action_runIn a0 a1
  h_action_interrupt : ∀ a0, f_action (.interrupt a0) = alg.action_interrupt a0
  h_action_interruptScoped : ∀ a0, f_action (.interruptScoped a0) = alg.action_interruptScoped a0
  h_action_interruptAll : ∀ a0 a1, f_action (.interruptAll a0 a1) = alg.action_interruptAll a0 a1
  h_action_awaitAll : ∀ a0, f_action (.awaitAll a0) = alg.action_awaitAll a0
  h_action_awaitAllFailFast : ∀ a0, f_action (.awaitAllFailFast a0) = alg.action_awaitAllFailFast a0
  h_action_snapshotChildren : f_action (.snapshotChildren) = alg.action_snapshotChildren
  h_action_awaitNewChildren : ∀ a0, f_action (.awaitNewChildren a0) = alg.action_awaitNewChildren a0
  h_action_raceAll : ∀ a0, f_action (.raceAll a0) = alg.action_raceAll (f_effs a0)
  h_action_setContext : ∀ a0, f_action (.setContext a0) = alg.action_setContext a0
  h_action_getContext : f_action (.getContext) = alg.action_getContext
  h_action_getId : f_action (.getId) = alg.action_getId
  h_action_closeScope : ∀ a0 a1, f_action (.closeScope a0 a1) = alg.action_closeScope a0 a1
  h_layer_succeed : ∀ a0 a1, f_layer (.succeed a0 a1) = alg.layer_succeed a0 a1
  h_layer_effect : ∀ a0 a1, f_layer (.effect a0 a1) = alg.layer_effect a0 (f_eff a1)
  h_layer_effectDiscard : ∀ a0, f_layer (.effectDiscard a0) = alg.layer_effectDiscard (f_eff a0)
  h_layer_provide : ∀ a0 a1, f_layer (.provide a0 a1) = alg.layer_provide (f_layer a0) (f_layer a1)
  h_layer_provideMerge : ∀ a0 a1, f_layer (.provideMerge a0 a1) = alg.layer_provideMerge (f_layer a0) (f_layer a1)
  h_layer_merge : ∀ a0 a1, f_layer (.merge a0 a1) = alg.layer_merge (f_layer a0) (f_layer a1)
  h_layer_fresh : ∀ a0, f_layer (.fresh a0) = alg.layer_fresh (f_layer a0)
  h_layer_orDie : ∀ a0, f_layer (.orDie a0) = alg.layer_orDie (f_layer a0)
  h_layer_ref : ∀ a0, f_layer (.ref a0) = alg.layer_ref a0
  h_layer_mergeAll : ∀ a0, f_layer (.mergeAll a0) = alg.layer_mergeAll (f_layers a0)
  h_layers_nil : f_layers (.nil) = alg.layers_nil
  h_layers_cons : ∀ a0 a1, f_layers (.cons a0 a1) = alg.layers_cons (f_layer a0) (f_layers a1)

mutual
theorem hom_eq_cata_eff {Op : Type} {R : EffFam → Type u}
    {alg : EffAlgebra Op R} (hom : EffHom alg) (node : Effect4.Program.Eff Op) :
    hom.f_eff node = cata_eff alg node := by
  match node with
  | .succeed a0 =>
    simp only [cata_eff, hom.h_eff_succeed a0]
  | .fail a0 =>
    simp only [cata_eff, hom.h_eff_fail a0]
  | .failCause a0 =>
    simp only [cata_eff, hom.h_eff_failCause a0]
  | .yieldError a0 =>
    simp only [cata_eff, hom.h_eff_yieldError a0]
  | .sync a0 =>
    simp only [cata_eff, hom.h_eff_sync a0]
  | .suspend a0 =>
    simp only [cata_eff, hom.h_eff_suspend a0, hom_eq_cata_eff hom a0]
  | .perform a0 a1 =>
    simp only [cata_eff, hom.h_eff_perform a0 a1]
  | .bind a0 a1 =>
    simp only [cata_eff, hom.h_eff_bind a0 a1, hom_eq_cata_eff hom a0, hom_eq_cata_eff hom a1]
  | .gen a0 =>
    simp only [cata_eff, hom.h_eff_gen a0, hom_eq_cata_stmts hom a0]
  | .catchCause a0 a1 =>
    simp only [cata_eff, hom.h_eff_catchCause a0 a1, hom_eq_cata_eff hom a0, hom_eq_cata_eff hom a1]
  | .matchCause a0 a1 a2 =>
    simp only [cata_eff, hom.h_eff_matchCause a0 a1 a2, hom_eq_cata_eff hom a0, hom_eq_cata_eff hom a1, hom_eq_cata_eff hom a2]
  | .onExit a0 a1 =>
    simp only [cata_eff, hom.h_eff_onExit a0 a1, hom_eq_cata_eff hom a0, hom_eq_cata_eff hom a1]
  | .exit a0 =>
    simp only [cata_eff, hom.h_eff_exit a0, hom_eq_cata_eff hom a0]
  | .uninterruptible a0 =>
    simp only [cata_eff, hom.h_eff_uninterruptible a0, hom_eq_cata_eff hom a0]
  | .interruptible a0 =>
    simp only [cata_eff, hom.h_eff_interruptible a0, hom_eq_cata_eff hom a0]
  | .branch a0 a1 a2 =>
    simp only [cata_eff, hom.h_eff_branch a0 a1 a2, hom_eq_cata_eff hom a1, hom_eq_cata_eff hom a2]
  | .whileLoop a0 a1 a2 a3 =>
    simp only [cata_eff, hom.h_eff_whileLoop a0 a1 a2 a3, hom_eq_cata_eff hom a3]
  | .yieldNow a0 =>
    simp only [cata_eff, hom.h_eff_yieldNow a0]
  | .callback a0 a1 =>
    simp only [cata_eff, hom.h_eff_callback a0 a1]
  | .awaitFiber a0 a1 =>
    simp only [cata_eff, hom.h_eff_awaitFiber a0 a1]
  | .withFiber a0 =>
    simp only [cata_eff, hom.h_eff_withFiber a0, hom_eq_cata_action hom a0]
  | .scoped a0 =>
    simp only [cata_eff, hom.h_eff_scoped a0, hom_eq_cata_eff hom a0]
  | .acquireRelease a0 a1 =>
    simp only [cata_eff, hom.h_eff_acquireRelease a0 a1, hom_eq_cata_eff hom a0, hom_eq_cata_eff hom a1]
  | .provideLayer a0 a1 a2 =>
    simp only [cata_eff, hom.h_eff_provideLayer a0 a1 a2, hom_eq_cata_layer hom a0, hom_eq_cata_eff hom a2]
  | .service a0 =>
    simp only [cata_eff, hom.h_eff_service a0]
  | .provideService a0 a1 a2 =>
    simp only [cata_eff, hom.h_eff_provideService a0 a1 a2, hom_eq_cata_eff hom a2]
  | .catchIf a0 a1 a2 =>
    simp only [cata_eff, hom.h_eff_catchIf a0 a1 a2, hom_eq_cata_eff hom a1, hom_eq_cata_eff hom a2]
termination_by structural node
theorem hom_eq_cata_stmt {Op : Type} {R : EffFam → Type u}
    {alg : EffAlgebra Op R} (hom : EffHom alg) (node : Effect4.Program.Stmt Op) :
    hom.f_stmt node = cata_stmt alg node := by
  match node with
  | .bindYield a0 =>
    simp only [cata_stmt, hom.h_stmt_bindYield a0, hom_eq_cata_eff hom a0]
  | .yieldDiscard a0 =>
    simp only [cata_stmt, hom.h_stmt_yieldDiscard a0, hom_eq_cata_eff hom a0]
  | .ret a0 =>
    simp only [cata_stmt, hom.h_stmt_ret a0]
  | .ifElse a0 a1 a2 =>
    simp only [cata_stmt, hom.h_stmt_ifElse a0 a1 a2, hom_eq_cata_stmts hom a1, hom_eq_cata_stmts hom a2]
  | .whileTrue a0 =>
    simp only [cata_stmt, hom.h_stmt_whileTrue a0, hom_eq_cata_stmts hom a0]
  | .breakLoop =>
    simp only [cata_stmt, hom.h_stmt_breakLoop]
termination_by structural node
theorem hom_eq_cata_stmts {Op : Type} {R : EffFam → Type u}
    {alg : EffAlgebra Op R} (hom : EffHom alg) (node : Effect4.Program.Stmts Op) :
    hom.f_stmts node = cata_stmts alg node := by
  match node with
  | .nil =>
    simp only [cata_stmts, hom.h_stmts_nil]
  | .cons a0 a1 =>
    simp only [cata_stmts, hom.h_stmts_cons a0 a1, hom_eq_cata_stmt hom a0, hom_eq_cata_stmts hom a1]
termination_by structural node
theorem hom_eq_cata_effs {Op : Type} {R : EffFam → Type u}
    {alg : EffAlgebra Op R} (hom : EffHom alg) (node : Effect4.Program.Effs Op) :
    hom.f_effs node = cata_effs alg node := by
  match node with
  | .nil =>
    simp only [cata_effs, hom.h_effs_nil]
  | .cons a0 a1 =>
    simp only [cata_effs, hom.h_effs_cons a0 a1, hom_eq_cata_eff hom a0, hom_eq_cata_effs hom a1]
termination_by structural node
theorem hom_eq_cata_action {Op : Type} {R : EffFam → Type u}
    {alg : EffAlgebra Op R} (hom : EffHom alg) (node : Effect4.Program.ActionTerm Op) :
    hom.f_action node = cata_action alg node := by
  match node with
  | .fork a0 a1 =>
    simp only [cata_action, hom.h_action_fork a0 a1, hom_eq_cata_eff hom a0]
  | .forkIn a0 a1 a2 =>
    simp only [cata_action, hom.h_action_forkIn a0 a1 a2, hom_eq_cata_eff hom a0]
  | .forkScoped a0 a1 =>
    simp only [cata_action, hom.h_action_forkScoped a0 a1, hom_eq_cata_eff hom a0]
  | .runIn a0 a1 =>
    simp only [cata_action, hom.h_action_runIn a0 a1]
  | .interrupt a0 =>
    simp only [cata_action, hom.h_action_interrupt a0]
  | .interruptScoped a0 =>
    simp only [cata_action, hom.h_action_interruptScoped a0]
  | .interruptAll a0 a1 =>
    simp only [cata_action, hom.h_action_interruptAll a0 a1]
  | .awaitAll a0 =>
    simp only [cata_action, hom.h_action_awaitAll a0]
  | .awaitAllFailFast a0 =>
    simp only [cata_action, hom.h_action_awaitAllFailFast a0]
  | .snapshotChildren =>
    simp only [cata_action, hom.h_action_snapshotChildren]
  | .awaitNewChildren a0 =>
    simp only [cata_action, hom.h_action_awaitNewChildren a0]
  | .raceAll a0 =>
    simp only [cata_action, hom.h_action_raceAll a0, hom_eq_cata_effs hom a0]
  | .setContext a0 =>
    simp only [cata_action, hom.h_action_setContext a0]
  | .getContext =>
    simp only [cata_action, hom.h_action_getContext]
  | .getId =>
    simp only [cata_action, hom.h_action_getId]
  | .closeScope a0 a1 =>
    simp only [cata_action, hom.h_action_closeScope a0 a1]
termination_by structural node
theorem hom_eq_cata_layer {Op : Type} {R : EffFam → Type u}
    {alg : EffAlgebra Op R} (hom : EffHom alg) (node : Effect4.Program.LayerTerm Op) :
    hom.f_layer node = cata_layer alg node := by
  match node with
  | .succeed a0 a1 =>
    simp only [cata_layer, hom.h_layer_succeed a0 a1]
  | .effect a0 a1 =>
    simp only [cata_layer, hom.h_layer_effect a0 a1, hom_eq_cata_eff hom a1]
  | .effectDiscard a0 =>
    simp only [cata_layer, hom.h_layer_effectDiscard a0, hom_eq_cata_eff hom a0]
  | .provide a0 a1 =>
    simp only [cata_layer, hom.h_layer_provide a0 a1, hom_eq_cata_layer hom a0, hom_eq_cata_layer hom a1]
  | .provideMerge a0 a1 =>
    simp only [cata_layer, hom.h_layer_provideMerge a0 a1, hom_eq_cata_layer hom a0, hom_eq_cata_layer hom a1]
  | .merge a0 a1 =>
    simp only [cata_layer, hom.h_layer_merge a0 a1, hom_eq_cata_layer hom a0, hom_eq_cata_layer hom a1]
  | .fresh a0 =>
    simp only [cata_layer, hom.h_layer_fresh a0, hom_eq_cata_layer hom a0]
  | .orDie a0 =>
    simp only [cata_layer, hom.h_layer_orDie a0, hom_eq_cata_layer hom a0]
  | .ref a0 =>
    simp only [cata_layer, hom.h_layer_ref a0]
  | .mergeAll a0 =>
    simp only [cata_layer, hom.h_layer_mergeAll a0, hom_eq_cata_layers hom a0]
termination_by structural node
theorem hom_eq_cata_layers {Op : Type} {R : EffFam → Type u}
    {alg : EffAlgebra Op R} (hom : EffHom alg) (node : Effect4.Program.LayerTerms Op) :
    hom.f_layers node = cata_layers alg node := by
  match node with
  | .nil =>
    simp only [cata_layers, hom.h_layers_nil]
  | .cons a0 a1 =>
    simp only [cata_layers, hom.h_layers_cons a0 a1, hom_eq_cata_layer hom a0, hom_eq_cata_layers hom a1]
termination_by structural node
end

mutual
def foldMap_eff {Op : Type} {M : Type u} (unit : M) (op : M → M → M) (node : Effect4.Program.Eff Op)
    (f_eff : Effect4.Program.Eff Op → M := fun _ => unit) (f_stmt : Effect4.Program.Stmt Op → M := fun _ => unit) (f_stmts : Effect4.Program.Stmts Op → M := fun _ => unit) (f_effs : Effect4.Program.Effs Op → M := fun _ => unit) (f_action : Effect4.Program.ActionTerm Op → M := fun _ => unit) (f_layer : Effect4.Program.LayerTerm Op → M := fun _ => unit) (f_layers : Effect4.Program.LayerTerms Op → M := fun _ => unit) : M :=
  match node with
  | .succeed a0 =>
    f_eff (.succeed a0)
  | .fail a0 =>
    f_eff (.fail a0)
  | .failCause a0 =>
    f_eff (.failCause a0)
  | .yieldError a0 =>
    f_eff (.yieldError a0)
  | .sync a0 =>
    f_eff (.sync a0)
  | .suspend a0 =>
    op (f_eff (.suspend a0)) ((foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .perform a0 a1 =>
    f_eff (.perform a0 a1)
  | .bind a0 a1 =>
    op (f_eff (.bind a0 a1)) (op (foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a1 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers)))
  | .gen a0 =>
    op (f_eff (.gen a0)) ((foldMap_stmts unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .catchCause a0 a1 =>
    op (f_eff (.catchCause a0 a1)) (op (foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a1 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers)))
  | .matchCause a0 a1 a2 =>
    op (f_eff (.matchCause a0 a1 a2)) (op (foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) (op (foldMap_eff unit op a1 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a2 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))))
  | .onExit a0 a1 =>
    op (f_eff (.onExit a0 a1)) (op (foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a1 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers)))
  | .exit a0 =>
    op (f_eff (.exit a0)) ((foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .uninterruptible a0 =>
    op (f_eff (.uninterruptible a0)) ((foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .interruptible a0 =>
    op (f_eff (.interruptible a0)) ((foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .branch a0 a1 a2 =>
    op (f_eff (.branch a0 a1 a2)) (op (foldMap_eff unit op a1 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a2 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers)))
  | .whileLoop a0 a1 a2 a3 =>
    op (f_eff (.whileLoop a0 a1 a2 a3)) ((foldMap_eff unit op a3 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .yieldNow a0 =>
    f_eff (.yieldNow a0)
  | .callback a0 a1 =>
    f_eff (.callback a0 a1)
  | .awaitFiber a0 a1 =>
    f_eff (.awaitFiber a0 a1)
  | .withFiber a0 =>
    op (f_eff (.withFiber a0)) ((foldMap_action unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .scoped a0 =>
    op (f_eff (.scoped a0)) ((foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .acquireRelease a0 a1 =>
    op (f_eff (.acquireRelease a0 a1)) (op (foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a1 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers)))
  | .provideLayer a0 a1 a2 =>
    op (f_eff (.provideLayer a0 a1 a2)) (op (foldMap_layer unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a2 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers)))
  | .service a0 =>
    f_eff (.service a0)
  | .provideService a0 a1 a2 =>
    op (f_eff (.provideService a0 a1 a2)) ((foldMap_eff unit op a2 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .catchIf a0 a1 a2 =>
    op (f_eff (.catchIf a0 a1 a2)) (op (foldMap_eff unit op a1 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers) ((foldMap_eff unit op a2 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers)))
termination_by structural node
def foldMap_stmt {Op : Type} {M : Type u} (unit : M) (op : M → M → M) (node : Effect4.Program.Stmt Op)
    (f_eff : Effect4.Program.Eff Op → M := fun _ => unit) (f_stmt : Effect4.Program.Stmt Op → M := fun _ => unit) (f_stmts : Effect4.Program.Stmts Op → M := fun _ => unit) (f_effs : Effect4.Program.Effs Op → M := fun _ => unit) (f_action : Effect4.Program.ActionTerm Op → M := fun _ => unit) (f_layer : Effect4.Program.LayerTerm Op → M := fun _ => unit) (f_layers : Effect4.Program.LayerTerms Op → M := fun _ => unit) : M :=
  match node with
  | .bindYield a0 =>
    op (f_stmt (.bindYield a0)) ((foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .yieldDiscard a0 =>
    op (f_stmt (.yieldDiscard a0)) ((foldMap_eff unit op a0 f_eff f_stmt f_stmts f_effs f_action f_layer f_layers))
  | .ret a0 =>
    f_stmt (.ret a0)
  | .ifElse a0 a1 a2 =>
