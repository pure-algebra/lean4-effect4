    alg.eff_scoped x0
  eff_acquireRelease a0 a1 := do
    let x0 ← a0
    let x1 ← a1
    alg.eff_acquireRelease x0 x1
  eff_provideLayer a0 a1 a2 := do
    let x0 ← a0
    let x2 ← a2
    alg.eff_provideLayer x0 a1 x2
  eff_service a0 := alg.eff_service a0
  eff_provideService a0 a1 a2 := do
    let x2 ← a2
    alg.eff_provideService a0 a1 x2
  eff_catchIf a0 a1 a2 := do
    let x1 ← a1
    let x2 ← a2
    alg.eff_catchIf a0 x1 x2
  stmt_bindYield a0 := do
    let x0 ← a0
    alg.stmt_bindYield x0
  stmt_yieldDiscard a0 := do
    let x0 ← a0
    alg.stmt_yieldDiscard x0
  stmt_ret a0 := alg.stmt_ret a0
  stmt_ifElse a0 a1 a2 := do
    let x1 ← a1
    let x2 ← a2
    alg.stmt_ifElse a0 x1 x2
  stmt_whileTrue a0 := do
    let x0 ← a0
    alg.stmt_whileTrue x0
  stmt_breakLoop := alg.stmt_breakLoop
  stmts_nil := alg.stmts_nil
  stmts_cons a0 a1 := do
    let x0 ← a0
    let x1 ← a1
    alg.stmts_cons x0 x1
  effs_nil := alg.effs_nil
  effs_cons a0 a1 := do
    let x0 ← a0
    let x1 ← a1
    alg.effs_cons x0 x1
  action_fork a0 a1 := do
    let x0 ← a0
    alg.action_fork x0 a1
  action_forkIn a0 a1 a2 := do
    let x0 ← a0
    alg.action_forkIn x0 a1 a2
  action_forkScoped a0 a1 := do
    let x0 ← a0
    alg.action_forkScoped x0 a1
  action_runIn a0 a1 := alg.action_runIn a0 a1
  action_interrupt a0 := alg.action_interrupt a0
  action_interruptScoped a0 := alg.action_interruptScoped a0
  action_interruptAll a0 a1 := alg.action_interruptAll a0 a1
  action_awaitAll a0 := alg.action_awaitAll a0
  action_awaitAllFailFast a0 := alg.action_awaitAllFailFast a0
  action_snapshotChildren := alg.action_snapshotChildren
  action_awaitNewChildren a0 := alg.action_awaitNewChildren a0
  action_raceAll a0 := do
    let x0 ← a0
    alg.action_raceAll x0
  action_setContext a0 := alg.action_setContext a0
  action_getContext := alg.action_getContext
  action_getId := alg.action_getId
  action_closeScope a0 a1 := alg.action_closeScope a0 a1
  layer_succeed a0 a1 := alg.layer_succeed a0 a1
  layer_effect a0 a1 := do
