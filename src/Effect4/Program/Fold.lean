mutual
def foldM_eff {Op : Type} {M : Type u → Type v} [Monad M] {R : EffFam → Type u}
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Eff Op) : M (R .eff) :=
  match node with
  | .succeed a0 => alg.eff_succeed a0
  | .fail a0 => alg.eff_fail a0
  | .failCause a0 => alg.eff_failCause a0
  | .yieldError a0 => alg.eff_yieldError a0
  | .sync a0 => alg.eff_sync a0
  | .suspend a0 => do
      let x0 ← foldM_eff alg a0
      alg.eff_suspend x0
  | .perform a0 a1 => alg.eff_perform a0 a1
  | .bind a0 a1 => do
      let x0 ← foldM_eff alg a0
      let x1 ← foldM_eff alg a1
      alg.eff_bind x0 x1
  | .gen a0 => do
      let x0 ← foldM_stmts alg a0
      alg.eff_gen x0
  | .catchCause a0 a1 => do
      let x0 ← foldM_eff alg a0
      let x1 ← foldM_eff alg a1
      alg.eff_catchCause x0 x1
  | .matchCause a0 a1 a2 => do
      let x0 ← foldM_eff alg a0
      let x1 ← foldM_eff alg a1
      let x2 ← foldM_eff alg a2
      alg.eff_matchCause x0 x1 x2
  | .onExit a0 a1 => do
      let x0 ← foldM_eff alg a0
      let x1 ← foldM_eff alg a1
      alg.eff_onExit x0 x1
  | .exit a0 => do
      let x0 ← foldM_eff alg a0
      alg.eff_exit x0
  | .uninterruptible a0 => do
      let x0 ← foldM_eff alg a0
      alg.eff_uninterruptible x0
  | .interruptible a0 => do
      let x0 ← foldM_eff alg a0
      alg.eff_interruptible x0
  | .branch a0 a1 a2 => do
      let x1 ← foldM_eff alg a1
      let x2 ← foldM_eff alg a2
      alg.eff_branch a0 x1 x2
  | .whileLoop a0 a1 a2 a3 => do
      let x3 ← foldM_eff alg a3
      alg.eff_whileLoop a0 a1 a2 x3
  | .yieldNow a0 => alg.eff_yieldNow a0
  | .callback a0 a1 => alg.eff_callback a0 a1
  | .awaitFiber a0 a1 => alg.eff_awaitFiber a0 a1
  | .withFiber a0 => do
      let x0 ← foldM_action alg a0
      alg.eff_withFiber x0
  | .scoped a0 => do
      let x0 ← foldM_eff alg a0
      alg.eff_scoped x0
  | .acquireRelease a0 a1 => do
      let x0 ← foldM_eff alg a0
      let x1 ← foldM_eff alg a1
      alg.eff_acquireRelease x0 x1
  | .provideLayer a0 a1 a2 => do
      let x0 ← foldM_layer alg a0
      let x2 ← foldM_eff alg a2
      alg.eff_provideLayer x0 a1 x2
  | .service a0 => alg.eff_service a0
  | .provideService a0 a1 a2 => do
      let x2 ← foldM_eff alg a2
      alg.eff_provideService a0 a1 x2
  | .catchIf a0 a1 a2 => do
      let x1 ← foldM_eff alg a1
      let x2 ← foldM_eff alg a2
      alg.eff_catchIf a0 x1 x2
termination_by structural node
def foldM_stmt {Op : Type} {M : Type u → Type v} [Monad M] {R : EffFam → Type u}
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Stmt Op) : M (R .stmt) :=
  match node with
  | .bindYield a0 => do
      let x0 ← foldM_eff alg a0
      alg.stmt_bindYield x0
  | .yieldDiscard a0 => do
      let x0 ← foldM_eff alg a0
      alg.stmt_yieldDiscard x0
  | .ret a0 => alg.stmt_ret a0
  | .ifElse a0 a1 a2 => do
      let x1 ← foldM_stmts alg a1
      let x2 ← foldM_stmts alg a2
      alg.stmt_ifElse a0 x1 x2
  | .whileTrue a0 => do
      let x0 ← foldM_stmts alg a0
      alg.stmt_whileTrue x0
  | .breakLoop => alg.stmt_breakLoop
termination_by structural node
def foldM_stmts {Op : Type} {M : Type u → Type v} [Monad M] {R : EffFam → Type u}
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Stmts Op) : M (R .stmts) :=
  match node with
  | .nil => alg.stmts_nil
  | .cons a0 a1 => do
      let x0 ← foldM_stmt alg a0
      let x1 ← foldM_stmts alg a1
      alg.stmts_cons x0 x1
termination_by structural node
def foldM_effs {Op : Type} {M : Type u → Type v} [Monad M] {R : EffFam → Type u}
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Effs Op) : M (R .effs) :=
  match node with
  | .nil => alg.effs_nil
  | .cons a0 a1 => do
      let x0 ← foldM_eff alg a0
      let x1 ← foldM_effs alg a1
      alg.effs_cons x0 x1
termination_by structural node
def foldM_action {Op : Type} {M : Type u → Type v} [Monad M] {R : EffFam → Type u}
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.ActionTerm Op) : M (R .action) :=
  match node with
  | .fork a0 a1 => do
      let x0 ← foldM_eff alg a0
      alg.action_fork x0 a1
  | .forkIn a0 a1 a2 => do
      let x0 ← foldM_eff alg a0
      alg.action_forkIn x0 a1 a2
  | .forkScoped a0 a1 => do
      let x0 ← foldM_eff alg a0
      alg.action_forkScoped x0 a1
  | .runIn a0 a1 => alg.action_runIn a0 a1
  | .interrupt a0 => alg.action_interrupt a0
  | .interruptScoped a0 => alg.action_interruptScoped a0
  | .interruptAll a0 a1 => alg.action_interruptAll a0 a1
  | .awaitAll a0 => alg.action_awaitAll a0
  | .awaitAllFailFast a0 => alg.action_awaitAllFailFast a0
  | .snapshotChildren => alg.action_snapshotChildren
  | .awaitNewChildren a0 => alg.action_awaitNewChildren a0
  | .raceAll a0 => do
      let x0 ← foldM_effs alg a0
      alg.action_raceAll x0
  | .setContext a0 => alg.action_setContext a0
  | .getContext => alg.action_getContext
  | .getId => alg.action_getId
  | .closeScope a0 a1 => alg.action_closeScope a0 a1
termination_by structural node
def foldM_layer {Op : Type} {M : Type u → Type v} [Monad M] {R : EffFam → Type u}
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.LayerTerm Op) : M (R .layer) :=
  match node with
  | .succeed a0 a1 => alg.layer_succeed a0 a1
  | .effect a0 a1 => do
      let x1 ← foldM_eff alg a1
      alg.layer_effect a0 x1
  | .effectDiscard a0 => do
      let x0 ← foldM_eff alg a0
      alg.layer_effectDiscard x0
  | .provide a0 a1 => do
      let x0 ← foldM_layer alg a0
      let x1 ← foldM_layer alg a1
      alg.layer_provide x0 x1
  | .provideMerge a0 a1 => do
      let x0 ← foldM_layer alg a0
      let x1 ← foldM_layer alg a1
      alg.layer_provideMerge x0 x1
  | .merge a0 a1 => do
      let x0 ← foldM_layer alg a0
      let x1 ← foldM_layer alg a1
      alg.layer_merge x0 x1
  | .fresh a0 => do
      let x0 ← foldM_layer alg a0
      alg.layer_fresh x0
  | .orDie a0 => do
      let x0 ← foldM_layer alg a0
      alg.layer_orDie x0
  | .ref a0 => alg.layer_ref a0
  | .mergeAll a0 => do
      let x0 ← foldM_layers alg a0
      alg.layer_mergeAll x0
termination_by structural node
def foldM_layers {Op : Type} {M : Type u → Type v} [Monad M] {R : EffFam → Type u}
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.LayerTerms Op) : M (R .layers) :=
  match node with
  | .nil => alg.layers_nil
  | .cons a0 a1 => do
      let x0 ← foldM_layer alg a0
      let x1 ← foldM_layers alg a1
      alg.layers_cons x0 x1
termination_by structural node
end

mutual
theorem foldM_eq_cata_eff {Op : Type} {M : Type u → Type v} [Monad M]
    {R : EffFam → Type u} (alg : EffMAlgebra Op M R) (node : Effect4.Program.Eff Op) :
    foldM_eff alg node = cata_eff alg.toSeq node := by
  match node with
  | .succeed a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .fail a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .failCause a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .yieldError a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .sync a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .suspend a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .perform a0 a1 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .bind a0 a1 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0, foldM_eq_cata_eff alg a1]
  | .gen a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_stmts alg a0]
  | .catchCause a0 a1 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0, foldM_eq_cata_eff alg a1]
  | .matchCause a0 a1 a2 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0, foldM_eq_cata_eff alg a1, foldM_eq_cata_eff alg a2]
  | .onExit a0 a1 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0, foldM_eq_cata_eff alg a1]
  | .exit a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .uninterruptible a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .interruptible a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .branch a0 a1 a2 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a1, foldM_eq_cata_eff alg a2]
  | .whileLoop a0 a1 a2 a3 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a3]
  | .yieldNow a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .callback a0 a1 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .awaitFiber a0 a1 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .withFiber a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_action alg a0]
  | .scoped a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .acquireRelease a0 a1 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0, foldM_eq_cata_eff alg a1]
  | .provideLayer a0 a1 a2 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_layer alg a0, foldM_eq_cata_eff alg a2]
  | .service a0 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq]
  | .provideService a0 a1 a2 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a2]
  | .catchIf a0 a1 a2 =>
    simp only [foldM_eff, cata_eff, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a1, foldM_eq_cata_eff alg a2]
termination_by structural node
theorem foldM_eq_cata_stmt {Op : Type} {M : Type u → Type v} [Monad M]
    {R : EffFam → Type u} (alg : EffMAlgebra Op M R) (node : Effect4.Program.Stmt Op) :
    foldM_stmt alg node = cata_stmt alg.toSeq node := by
  match node with
  | .bindYield a0 =>
    simp only [foldM_stmt, cata_stmt, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .yieldDiscard a0 =>
    simp only [foldM_stmt, cata_stmt, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .ret a0 =>
    simp only [foldM_stmt, cata_stmt, EffMAlgebra.toSeq]
  | .ifElse a0 a1 a2 =>
    simp only [foldM_stmt, cata_stmt, EffMAlgebra.toSeq, foldM_eq_cata_stmts alg a1, foldM_eq_cata_stmts alg a2]
  | .whileTrue a0 =>
    simp only [foldM_stmt, cata_stmt, EffMAlgebra.toSeq, foldM_eq_cata_stmts alg a0]
  | .breakLoop =>
    simp only [foldM_stmt, cata_stmt, EffMAlgebra.toSeq]
termination_by structural node
theorem foldM_eq_cata_stmts {Op : Type} {M : Type u → Type v} [Monad M]
    {R : EffFam → Type u} (alg : EffMAlgebra Op M R) (node : Effect4.Program.Stmts Op) :
    foldM_stmts alg node = cata_stmts alg.toSeq node := by
  match node with
  | .nil =>
    simp only [foldM_stmts, cata_stmts, EffMAlgebra.toSeq]
  | .cons a0 a1 =>
    simp only [foldM_stmts, cata_stmts, EffMAlgebra.toSeq, foldM_eq_cata_stmt alg a0, foldM_eq_cata_stmts alg a1]
termination_by structural node
theorem foldM_eq_cata_effs {Op : Type} {M : Type u → Type v} [Monad M]
    {R : EffFam → Type u} (alg : EffMAlgebra Op M R) (node : Effect4.Program.Effs Op) :
    foldM_effs alg node = cata_effs alg.toSeq node := by
  match node with
  | .nil =>
    simp only [foldM_effs, cata_effs, EffMAlgebra.toSeq]
  | .cons a0 a1 =>
    simp only [foldM_effs, cata_effs, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0, foldM_eq_cata_effs alg a1]
termination_by structural node
theorem foldM_eq_cata_action {Op : Type} {M : Type u → Type v} [Monad M]
    {R : EffFam → Type u} (alg : EffMAlgebra Op M R) (node : Effect4.Program.ActionTerm Op) :
    foldM_action alg node = cata_action alg.toSeq node := by
  match node with
  | .fork a0 a1 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .forkIn a0 a1 a2 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .forkScoped a0 a1 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .runIn a0 a1 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .interrupt a0 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .interruptScoped a0 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .interruptAll a0 a1 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .awaitAll a0 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .awaitAllFailFast a0 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .snapshotChildren =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .awaitNewChildren a0 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .raceAll a0 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq, foldM_eq_cata_effs alg a0]
  | .setContext a0 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .getContext =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .getId =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
  | .closeScope a0 a1 =>
    simp only [foldM_action, cata_action, EffMAlgebra.toSeq]
termination_by structural node
theorem foldM_eq_cata_layer {Op : Type} {M : Type u → Type v} [Monad M]
    {R : EffFam → Type u} (alg : EffMAlgebra Op M R) (node : Effect4.Program.LayerTerm Op) :
    foldM_layer alg node = cata_layer alg.toSeq node := by
  match node with
  | .succeed a0 a1 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq]
  | .effect a0 a1 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a1]
  | .effectDiscard a0 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_eff alg a0]
  | .provide a0 a1 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_layer alg a0, foldM_eq_cata_layer alg a1]
  | .provideMerge a0 a1 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_layer alg a0, foldM_eq_cata_layer alg a1]
  | .merge a0 a1 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_layer alg a0, foldM_eq_cata_layer alg a1]
  | .fresh a0 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_layer alg a0]
  | .orDie a0 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_layer alg a0]
  | .ref a0 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq]
  | .mergeAll a0 =>
    simp only [foldM_layer, cata_layer, EffMAlgebra.toSeq, foldM_eq_cata_layers alg a0]
termination_by structural node
theorem foldM_eq_cata_layers {Op : Type} {M : Type u → Type v} [Monad M]
    {R : EffFam → Type u} (alg : EffMAlgebra Op M R) (node : Effect4.Program.LayerTerms Op) :
    foldM_layers alg node = cata_layers alg.toSeq node := by
  match node with
  | .nil =>
    simp only [foldM_layers, cata_layers, EffMAlgebra.toSeq]
  | .cons a0 a1 =>
    simp only [foldM_layers, cata_layers, EffMAlgebra.toSeq, foldM_eq_cata_layer alg a0, foldM_eq_cata_layers alg a1]
termination_by structural node
end

theorem foldM_id_eff {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Eff Op) :
    foldM_eff (M := Id) alg.toM node = cata_eff alg node := by
  rw [foldM_eq_cata_eff]
  rfl

theorem foldM_id_stmt {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Stmt Op) :
    foldM_stmt (M := Id) alg.toM node = cata_stmt alg node := by
  rw [foldM_eq_cata_stmt]
  rfl

theorem foldM_id_stmts {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Stmts Op) :
    foldM_stmts (M := Id) alg.toM node = cata_stmts alg node := by
  rw [foldM_eq_cata_stmts]
  rfl

theorem foldM_id_effs {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.Effs Op) :
    foldM_effs (M := Id) alg.toM node = cata_effs alg node := by
  rw [foldM_eq_cata_effs]
  rfl

theorem foldM_id_action {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.ActionTerm Op) :
    foldM_action (M := Id) alg.toM node = cata_action alg node := by
  rw [foldM_eq_cata_action]
  rfl

theorem foldM_id_layer {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.LayerTerm Op) :
    foldM_layer (M := Id) alg.toM node = cata_layer alg node := by
  rw [foldM_eq_cata_layer]
  rfl

theorem foldM_id_layers {Op : Type} {R : EffFam → Type u} (alg : EffAlgebra Op R)
    (node : Effect4.Program.LayerTerms Op) :
    foldM_layers (M := Id) alg.toM node = cata_layers alg node := by
  rw [foldM_eq_cata_layers]
  rfl

mutual
theorem foldM_natural_eff {Op : Type} {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : EffFam → Type u} (φ : MonadMorphism M N)
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Eff Op) :
    φ.toFun (foldM_eff alg node) = foldM_eff (alg.map φ.toFun) node := by
  match node with
  | .succeed a0 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .fail a0 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .failCause a0 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .yieldError a0 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .sync a0 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .suspend a0 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .perform a0 a1 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .bind a0 a1 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0, foldM_natural_eff φ alg a1]
  | .gen a0 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_stmts φ alg a0]
  | .catchCause a0 a1 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0, foldM_natural_eff φ alg a1]
  | .matchCause a0 a1 a2 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0, foldM_natural_eff φ alg a1, foldM_natural_eff φ alg a2]
  | .onExit a0 a1 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0, foldM_natural_eff φ alg a1]
  | .exit a0 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .uninterruptible a0 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .interruptible a0 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .branch a0 a1 a2 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a1, foldM_natural_eff φ alg a2]
  | .whileLoop a0 a1 a2 a3 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a3]
  | .yieldNow a0 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .callback a0 a1 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .awaitFiber a0 a1 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .withFiber a0 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_action φ alg a0]
  | .scoped a0 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .acquireRelease a0 a1 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0, foldM_natural_eff φ alg a1]
  | .provideLayer a0 a1 a2 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_layer φ alg a0, foldM_natural_eff φ alg a2]
  | .service a0 =>
    simp only [foldM_eff, EffMAlgebra.map]
  | .provideService a0 a1 a2 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a2]
  | .catchIf a0 a1 a2 =>
    simp only [foldM_eff, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a1, foldM_natural_eff φ alg a2]
termination_by structural node
theorem foldM_natural_stmt {Op : Type} {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : EffFam → Type u} (φ : MonadMorphism M N)
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Stmt Op) :
    φ.toFun (foldM_stmt alg node) = foldM_stmt (alg.map φ.toFun) node := by
  match node with
  | .bindYield a0 =>
    simp only [foldM_stmt, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .yieldDiscard a0 =>
    simp only [foldM_stmt, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .ret a0 =>
    simp only [foldM_stmt, EffMAlgebra.map]
  | .ifElse a0 a1 a2 =>
    simp only [foldM_stmt, EffMAlgebra.map, φ.map_bind, foldM_natural_stmts φ alg a1, foldM_natural_stmts φ alg a2]
  | .whileTrue a0 =>
    simp only [foldM_stmt, EffMAlgebra.map, φ.map_bind, foldM_natural_stmts φ alg a0]
  | .breakLoop =>
    simp only [foldM_stmt, EffMAlgebra.map]
termination_by structural node
theorem foldM_natural_stmts {Op : Type} {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : EffFam → Type u} (φ : MonadMorphism M N)
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Stmts Op) :
    φ.toFun (foldM_stmts alg node) = foldM_stmts (alg.map φ.toFun) node := by
  match node with
  | .nil =>
    simp only [foldM_stmts, EffMAlgebra.map]
  | .cons a0 a1 =>
    simp only [foldM_stmts, EffMAlgebra.map, φ.map_bind, foldM_natural_stmt φ alg a0, foldM_natural_stmts φ alg a1]
termination_by structural node
theorem foldM_natural_effs {Op : Type} {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : EffFam → Type u} (φ : MonadMorphism M N)
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.Effs Op) :
    φ.toFun (foldM_effs alg node) = foldM_effs (alg.map φ.toFun) node := by
  match node with
  | .nil =>
    simp only [foldM_effs, EffMAlgebra.map]
  | .cons a0 a1 =>
    simp only [foldM_effs, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0, foldM_natural_effs φ alg a1]
termination_by structural node
theorem foldM_natural_action {Op : Type} {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : EffFam → Type u} (φ : MonadMorphism M N)
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.ActionTerm Op) :
    φ.toFun (foldM_action alg node) = foldM_action (alg.map φ.toFun) node := by
  match node with
  | .fork a0 a1 =>
    simp only [foldM_action, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .forkIn a0 a1 a2 =>
    simp only [foldM_action, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .forkScoped a0 a1 =>
    simp only [foldM_action, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .runIn a0 a1 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .interrupt a0 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .interruptScoped a0 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .interruptAll a0 a1 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .awaitAll a0 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .awaitAllFailFast a0 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .snapshotChildren =>
    simp only [foldM_action, EffMAlgebra.map]
  | .awaitNewChildren a0 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .raceAll a0 =>
    simp only [foldM_action, EffMAlgebra.map, φ.map_bind, foldM_natural_effs φ alg a0]
  | .setContext a0 =>
    simp only [foldM_action, EffMAlgebra.map]
  | .getContext =>
    simp only [foldM_action, EffMAlgebra.map]
  | .getId =>
    simp only [foldM_action, EffMAlgebra.map]
  | .closeScope a0 a1 =>
    simp only [foldM_action, EffMAlgebra.map]
termination_by structural node
theorem foldM_natural_layer {Op : Type} {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : EffFam → Type u} (φ : MonadMorphism M N)
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.LayerTerm Op) :
    φ.toFun (foldM_layer alg node) = foldM_layer (alg.map φ.toFun) node := by
  match node with
  | .succeed a0 a1 =>
    simp only [foldM_layer, EffMAlgebra.map]
  | .effect a0 a1 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a1]
  | .effectDiscard a0 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_eff φ alg a0]
  | .provide a0 a1 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_layer φ alg a0, foldM_natural_layer φ alg a1]
  | .provideMerge a0 a1 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_layer φ alg a0, foldM_natural_layer φ alg a1]
  | .merge a0 a1 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_layer φ alg a0, foldM_natural_layer φ alg a1]
  | .fresh a0 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_layer φ alg a0]
  | .orDie a0 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_layer φ alg a0]
  | .ref a0 =>
    simp only [foldM_layer, EffMAlgebra.map]
  | .mergeAll a0 =>
    simp only [foldM_layer, EffMAlgebra.map, φ.map_bind, foldM_natural_layers φ alg a0]
termination_by structural node
theorem foldM_natural_layers {Op : Type} {M : Type u → Type v} {N : Type u → Type w}
    [Monad M] [Monad N] {R : EffFam → Type u} (φ : MonadMorphism M N)
    (alg : EffMAlgebra Op M R) (node : Effect4.Program.LayerTerms Op) :
    φ.toFun (foldM_layers alg node) = foldM_layers (alg.map φ.toFun) node := by
  match node with
  | .nil =>
    simp only [foldM_layers, EffMAlgebra.map]
  | .cons a0 a1 =>
    simp only [foldM_layers, EffMAlgebra.map, φ.map_bind, foldM_natural_layer φ alg a0, foldM_natural_layers φ alg a1]
termination_by structural node
end


inductive EffFrontierFam where
  | eff
  | stmt
  | stmts
  | effs
  | action
deriving DecidableEq, Repr

structure EffFrontierAlgebra (Op : Type) (R : EffFrontierFam → Type u) where
  eff_succeed : (Effect4.Program.Term) → R .eff
  eff_fail : (Effect4.Program.Term) → R .eff
  eff_failCause : (Effect4.Program.CauseTerm) → R .eff
  eff_yieldError : (Effect4.Program.Term) → R .eff
  eff_sync : (Effect4.Program.Term) → R .eff
  eff_suspend : R .eff → R .eff
  eff_perform : (Op) → (Effect4.Program.Term) → R .eff
  eff_bind : R .eff → R .eff → R .eff
  eff_gen : R .stmts → R .eff
  eff_catchCause : R .eff → R .eff → R .eff
  eff_matchCause : R .eff → R .eff → R .eff → R .eff
  eff_onExit : R .eff → R .eff → R .eff
  eff_exit : R .eff → R .eff
  eff_uninterruptible : R .eff → R .eff
  eff_interruptible : R .eff → R .eff
  eff_branch : (Effect4.Program.Term) → R .eff → R .eff → R .eff
  eff_whileLoop : (Effect4.Program.Term) → (Effect4.Program.Term) → (Effect4.Program.Term) → R .eff → R .eff
  eff_yieldNow : (Nat) → R .eff
  eff_callback : (Op) → (Effect4.Program.Term) → R .eff
  eff_awaitFiber : (Effect4.Program.Term) → (Effect4.Supervision.ObserverMode) → R .eff
  eff_withFiber : R .action → R .eff
  eff_scoped : R .eff → R .eff
  eff_acquireRelease : R .eff → R .eff → R .eff
  eff_provideLayer : (Effect4.Program.LayerTerm Op) → (Bool) → R .eff → R .eff
  eff_service : (Effect4.ServiceKey) → R .eff
  eff_provideService : (Effect4.ServiceKey) → (Effect4.Program.Term) → R .eff → R .eff
  eff_catchIf : (Effect4.Program.Term) → R .eff → R .eff → R .eff
  stmt_bindYield : R .eff → R .stmt
  stmt_yieldDiscard : R .eff → R .stmt
  stmt_ret : (Effect4.Program.Term) → R .stmt
  stmt_ifElse : (Effect4.Program.Term) → R .stmts → R .stmts → R .stmt
  stmt_whileTrue : R .stmts → R .stmt
  stmt_breakLoop : R .stmt
  stmts_nil : R .stmts
  stmts_cons : R .stmt → R .stmts → R .stmts
  effs_nil : R .effs
  effs_cons : R .eff → R .effs → R .effs
  action_fork : R .eff → (Effect4.Supervision.ForkOptions) → R .action
  action_forkIn : R .eff → (Effect4.Supervision.ForkOptions) → (Effect4.Program.Term) → R .action
  action_forkScoped : R .eff → (Effect4.Supervision.ForkOptions) → R .action
  action_runIn : (Effect4.Program.Term) → (Effect4.Program.Term) → R .action
  action_interrupt : (Effect4.Program.Term) → R .action
  action_interruptScoped : (Effect4.Program.Term) → R .action
  action_interruptAll : (Effect4.Program.Term) → (Option Effect4.Program.Term) → R .action
  action_awaitAll : (Effect4.Program.Term) → R .action
  action_awaitAllFailFast : (Effect4.Program.Term) → R .action
  action_snapshotChildren : R .action
  action_awaitNewChildren : (Effect4.Program.Term) → R .action
  action_raceAll : R .effs → R .action
  action_setContext : (Effect4.Program.Term) → R .action
  action_getContext : R .action
  action_getId : R .action
  action_closeScope : (Effect4.Program.Term) → (Effect4.Program.Term) → R .action

mutual
def cata_frontier_eff {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Eff Op) : R .eff :=
  match node with
  | .succeed a0 => alg.eff_succeed a0
  | .fail a0 => alg.eff_fail a0
  | .failCause a0 => alg.eff_failCause a0
  | .yieldError a0 => alg.eff_yieldError a0
  | .sync a0 => alg.eff_sync a0
  | .suspend a0 => alg.eff_suspend (cata_frontier_eff alg a0)
  | .perform a0 a1 => alg.eff_perform a0 a1
  | .bind a0 a1 => alg.eff_bind (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .gen a0 => alg.eff_gen (cata_frontier_stmts alg a0)
  | .catchCause a0 a1 => alg.eff_catchCause (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .matchCause a0 a1 a2 => alg.eff_matchCause (cata_frontier_eff alg a0) (cata_frontier_eff alg a1) (cata_frontier_eff alg a2)
  | .onExit a0 a1 => alg.eff_onExit (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .exit a0 => alg.eff_exit (cata_frontier_eff alg a0)
  | .uninterruptible a0 => alg.eff_uninterruptible (cata_frontier_eff alg a0)
  | .interruptible a0 => alg.eff_interruptible (cata_frontier_eff alg a0)
  | .branch a0 a1 a2 => alg.eff_branch a0 (cata_frontier_eff alg a1) (cata_frontier_eff alg a2)
  | .whileLoop a0 a1 a2 a3 => alg.eff_whileLoop a0 a1 a2 (cata_frontier_eff alg a3)
  | .yieldNow a0 => alg.eff_yieldNow a0
  | .callback a0 a1 => alg.eff_callback a0 a1
  | .awaitFiber a0 a1 => alg.eff_awaitFiber a0 a1
  | .withFiber a0 => alg.eff_withFiber (cata_frontier_action alg a0)
  | .scoped a0 => alg.eff_scoped (cata_frontier_eff alg a0)
  | .acquireRelease a0 a1 => alg.eff_acquireRelease (cata_frontier_eff alg a0) (cata_frontier_eff alg a1)
  | .provideLayer a0 a1 a2 => alg.eff_provideLayer a0 a1 (cata_frontier_eff alg a2)
  | .service a0 => alg.eff_service a0
  | .provideService a0 a1 a2 => alg.eff_provideService a0 a1 (cata_frontier_eff alg a2)
  | .catchIf a0 a1 a2 => alg.eff_catchIf a0 (cata_frontier_eff alg a1) (cata_frontier_eff alg a2)
termination_by structural node
def cata_frontier_stmt {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Stmt Op) : R .stmt :=
  match node with
  | .bindYield a0 => alg.stmt_bindYield (cata_frontier_eff alg a0)
  | .yieldDiscard a0 => alg.stmt_yieldDiscard (cata_frontier_eff alg a0)
  | .ret a0 => alg.stmt_ret a0
  | .ifElse a0 a1 a2 => alg.stmt_ifElse a0 (cata_frontier_stmts alg a1) (cata_frontier_stmts alg a2)
  | .whileTrue a0 => alg.stmt_whileTrue (cata_frontier_stmts alg a0)
  | .breakLoop => alg.stmt_breakLoop
termination_by structural node
def cata_frontier_stmts {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Stmts Op) : R .stmts :=
  match node with
  | .nil => alg.stmts_nil
  | .cons a0 a1 => alg.stmts_cons (cata_frontier_stmt alg a0) (cata_frontier_stmts alg a1)
termination_by structural node
def cata_frontier_effs {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.Effs Op) : R .effs :=
  match node with
  | .nil => alg.effs_nil
  | .cons a0 a1 => alg.effs_cons (cata_frontier_eff alg a0) (cata_frontier_effs alg a1)
termination_by structural node
def cata_frontier_action {Op : Type} {R : EffFrontierFam → Type u} (alg : EffFrontierAlgebra Op R)
    (node : Effect4.Program.ActionTerm Op) : R .action :=
  match node with
  | .fork a0 a1 => alg.action_fork (cata_frontier_eff alg a0) a1
  | .forkIn a0 a1 a2 => alg.action_forkIn (cata_frontier_eff alg a0) a1 a2
  | .forkScoped a0 a1 => alg.action_forkScoped (cata_frontier_eff alg a0) a1
  | .runIn a0 a1 => alg.action_runIn a0 a1
  | .interrupt a0 => alg.action_interrupt a0
  | .interruptScoped a0 => alg.action_interruptScoped a0
  | .interruptAll a0 a1 => alg.action_interruptAll a0 a1
  | .awaitAll a0 => alg.action_awaitAll a0
  | .awaitAllFailFast a0 => alg.action_awaitAllFailFast a0
  | .snapshotChildren => alg.action_snapshotChildren
  | .awaitNewChildren a0 => alg.action_awaitNewChildren a0
  | .raceAll a0 => alg.action_raceAll (cata_frontier_effs alg a0)
  | .setContext a0 => alg.action_setContext a0
  | .getContext => alg.action_getContext
  | .getId => alg.action_getId
  | .closeScope a0 a1 => alg.action_closeScope a0 a1
termination_by structural node
end

def frontierSelfCarrier (Op : Type) : EffFrontierFam → Type
  | .eff => Effect4.Program.Eff Op
  | .stmt => Effect4.Program.Stmt Op
  | .stmts => Effect4.Program.Stmts Op
  | .effs => Effect4.Program.Effs Op
  | .action => Effect4.Program.ActionTerm Op

def weakenAlg {Op : Type} (cut : Nat) : EffFrontierAlgebra Op (frontierSelfCarrier Op) where
  eff_succeed a0 := .succeed (Effect4.Program.Term.weaken cut a0)
  eff_fail a0 := .fail (Effect4.Program.Term.weaken cut a0)
  eff_failCause a0 := .failCause (Effect4.Program.CauseTerm.weaken cut a0)
  eff_yieldError a0 := .yieldError (Effect4.Program.Term.weaken cut a0)
  eff_sync a0 := .sync (Effect4.Program.Term.weaken cut a0)
  eff_suspend a0 := .suspend a0
  eff_perform a0 a1 := .perform a0 (Effect4.Program.Term.weaken cut a1)
  eff_bind a0 a1 := .bind a0 a1
  eff_gen a0 := .gen a0
  eff_catchCause a0 a1 := .catchCause a0 a1
  eff_matchCause a0 a1 a2 := .matchCause a0 a1 a2
  eff_onExit a0 a1 := .onExit a0 a1
  eff_exit a0 := .exit a0
  eff_uninterruptible a0 := .uninterruptible a0
  eff_interruptible a0 := .interruptible a0
  eff_branch a0 a1 a2 := .branch (Effect4.Program.Term.weaken cut a0) a1 a2
  eff_whileLoop a0 a1 a2 a3 := .whileLoop (Effect4.Program.Term.weaken cut a0) (Effect4.Program.Term.weaken cut a1) (Effect4.Program.Term.weaken cut a2) a3
  eff_yieldNow a0 := .yieldNow a0
  eff_callback a0 a1 := .callback a0 (Effect4.Program.Term.weaken cut a1)
  eff_awaitFiber a0 a1 := .awaitFiber (Effect4.Program.Term.weaken cut a0) a1
  eff_withFiber a0 := .withFiber a0
  eff_scoped a0 := .scoped a0
  eff_acquireRelease a0 a1 := .acquireRelease a0 a1
  eff_provideLayer a0 a1 a2 := .provideLayer a0 a1 a2
  eff_service a0 := .service a0
  eff_provideService a0 a1 a2 := .provideService a0 (Effect4.Program.Term.weaken cut a1) a2
  eff_catchIf a0 a1 a2 := .catchIf (Effect4.Program.Term.weaken cut a0) a1 a2
  stmt_bindYield a0 := .bindYield a0
  stmt_yieldDiscard a0 := .yieldDiscard a0
  stmt_ret a0 := .ret (Effect4.Program.Term.weaken cut a0)
  stmt_ifElse a0 a1 a2 := .ifElse (Effect4.Program.Term.weaken cut a0) a1 a2
  stmt_whileTrue a0 := .whileTrue a0
  stmt_breakLoop := .breakLoop
  stmts_nil := .nil
  stmts_cons a0 a1 := .cons a0 a1
  effs_nil := .nil
  effs_cons a0 a1 := .cons a0 a1
  action_fork a0 a1 := .fork a0 a1
  action_forkIn a0 a1 a2 := .forkIn a0 a1 (Effect4.Program.Term.weaken cut a2)
  action_forkScoped a0 a1 := .forkScoped a0 a1
  action_runIn a0 a1 := .runIn (Effect4.Program.Term.weaken cut a0) (Effect4.Program.Term.weaken cut a1)
  action_interrupt a0 := .interrupt (Effect4.Program.Term.weaken cut a0)
  action_interruptScoped a0 := .interruptScoped (Effect4.Program.Term.weaken cut a0)
  action_interruptAll a0 a1 := .interruptAll (Effect4.Program.Term.weaken cut a0) (a1.map (Effect4.Program.Term.weaken cut))
  action_awaitAll a0 := .awaitAll (Effect4.Program.Term.weaken cut a0)
  action_awaitAllFailFast a0 := .awaitAllFailFast (Effect4.Program.Term.weaken cut a0)
  action_snapshotChildren := .snapshotChildren
  action_awaitNewChildren a0 := .awaitNewChildren (Effect4.Program.Term.weaken cut a0)
  action_raceAll a0 := .raceAll a0
  action_setContext a0 := .setContext (Effect4.Program.Term.weaken cut a0)
  action_getContext := .getContext
  action_getId := .getId
  action_closeScope a0 a1 := .closeScope (Effect4.Program.Term.weaken cut a0) (Effect4.Program.Term.weaken cut a1)

mutual
theorem weaken_eq_cata_eff {Op : Type} (cut : Nat) (node : Effect4.Program.Eff Op) :
    Effect4.Program.Eff.weaken cut node = cata_frontier_eff (weakenAlg cut) node := by
  match node with
  | .succeed a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .fail a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .failCause a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .yieldError a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .sync a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .suspend a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .perform a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .bind a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1]
  | .gen a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_stmts cut a0]
  | .catchCause a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1]
  | .matchCause a0 a1 a2 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1, weaken_eq_cata_eff cut a2]
  | .onExit a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1]
  | .exit a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .uninterruptible a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .interruptible a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .branch a0 a1 a2 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a1, weaken_eq_cata_eff cut a2]
  | .whileLoop a0 a1 a2 a3 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a3]
  | .yieldNow a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .callback a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .awaitFiber a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .withFiber a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_action cut a0]
  | .scoped a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0]
  | .acquireRelease a0 a1 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_eff cut a1]
  | .provideLayer a0 a1 a2 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a2]
  | .service a0 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg]
  | .provideService a0 a1 a2 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a2]
  | .catchIf a0 a1 a2 =>
    simp only [Effect4.Program.Eff.weaken, cata_frontier_eff, weakenAlg, weaken_eq_cata_eff cut a1, weaken_eq_cata_eff cut a2]
termination_by structural node
theorem weaken_eq_cata_stmt {Op : Type} (cut : Nat) (node : Effect4.Program.Stmt Op) :
    Effect4.Program.Stmt.weaken cut node = cata_frontier_stmt (weakenAlg cut) node := by
  match node with
  | .bindYield a0 =>
    simp only [Effect4.Program.Stmt.weaken, cata_frontier_stmt, weakenAlg, weaken_eq_cata_eff cut a0]
  | .yieldDiscard a0 =>
    simp only [Effect4.Program.Stmt.weaken, cata_frontier_stmt, weakenAlg, weaken_eq_cata_eff cut a0]
  | .ret a0 =>
    simp only [Effect4.Program.Stmt.weaken, cata_frontier_stmt, weakenAlg]
  | .ifElse a0 a1 a2 =>
    simp only [Effect4.Program.Stmt.weaken, cata_frontier_stmt, weakenAlg, weaken_eq_cata_stmts cut a1, weaken_eq_cata_stmts cut a2]
  | .whileTrue a0 =>
    simp only [Effect4.Program.Stmt.weaken, cata_frontier_stmt, weakenAlg, weaken_eq_cata_stmts cut a0]
  | .breakLoop =>
    simp only [Effect4.Program.Stmt.weaken, cata_frontier_stmt, weakenAlg]
termination_by structural node
theorem weaken_eq_cata_stmts {Op : Type} (cut : Nat) (node : Effect4.Program.Stmts Op) :
    Effect4.Program.Stmts.weaken cut node = cata_frontier_stmts (weakenAlg cut) node := by
  match node with
  | .nil =>
    simp only [Effect4.Program.Stmts.weaken, cata_frontier_stmts, weakenAlg]
  | .cons a0 a1 =>
    simp only [Effect4.Program.Stmts.weaken, cata_frontier_stmts, weakenAlg, weaken_eq_cata_stmt cut a0, weaken_eq_cata_stmts cut a1]
termination_by structural node
theorem weaken_eq_cata_effs {Op : Type} (cut : Nat) (node : Effect4.Program.Effs Op) :
    Effect4.Program.Effs.weaken cut node = cata_frontier_effs (weakenAlg cut) node := by
  match node with
  | .nil =>
    simp only [Effect4.Program.Effs.weaken, cata_frontier_effs, weakenAlg]
  | .cons a0 a1 =>
    simp only [Effect4.Program.Effs.weaken, cata_frontier_effs, weakenAlg, weaken_eq_cata_eff cut a0, weaken_eq_cata_effs cut a1]
termination_by structural node
theorem weaken_eq_cata_action {Op : Type} (cut : Nat) (node : Effect4.Program.ActionTerm Op) :
    Effect4.Program.ActionTerm.weaken cut node = cata_frontier_action (weakenAlg cut) node := by
  match node with
  | .fork a0 a1 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg, weaken_eq_cata_eff cut a0]
  | .forkIn a0 a1 a2 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg, weaken_eq_cata_eff cut a0]
  | .forkScoped a0 a1 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg, weaken_eq_cata_eff cut a0]
  | .runIn a0 a1 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .interrupt a0 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .interruptScoped a0 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .interruptAll a0 a1 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .awaitAll a0 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .awaitAllFailFast a0 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .snapshotChildren =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .awaitNewChildren a0 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .raceAll a0 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg, weaken_eq_cata_effs cut a0]
  | .setContext a0 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .getContext =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .getId =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
  | .closeScope a0 a1 =>
    simp only [Effect4.Program.ActionTerm.weaken, cata_frontier_action, weakenAlg]
termination_by structural node
end


