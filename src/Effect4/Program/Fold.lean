    alg.layer_merge x0 x1
  layer_fresh a0 := do
    let x0 ← a0
    alg.layer_fresh x0
  layer_orDie a0 := do
    let x0 ← a0
    alg.layer_orDie x0
  layer_ref a0 := alg.layer_ref a0
  layer_mergeAll a0 := do
