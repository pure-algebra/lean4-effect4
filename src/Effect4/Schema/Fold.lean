theorem cata_id_pos_list_representation (xs : List Effect4.Representation) :
    cata_pos_list_representation (RepresentationAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_representation]
  | x :: rest => simp only [cata_pos_list_representation, cata_id_representation x, cata_id_pos_list_representation rest]
termination_by structural xs
theorem cata_id_pos_list_check (xs : List Effect4.Check) :
    cata_pos_list_check (RepresentationAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_check]
  | x :: rest => simp only [cata_pos_list_check, cata_id_check x, cata_id_pos_list_check rest]
