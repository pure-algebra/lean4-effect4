mutual
@[simp] theorem cata_id_representation (node : Effect4.Representation) :
    cata_representation (RepresentationAlgebra.id) node = node := by
  match node with
  | .declaration a0 a1 a2 a3 =>
    simp only [cata_representation, cata_id_pos_list_representation a2, cata_id_pos_list_check a3]
    rfl
  | .reference a0 =>
    simp only [cata_representation]
    rfl
  | .suspend a0 a1 a2 =>
    simp only [cata_representation, cata_id_pos_list_check a1, cata_id_representation a2]
    rfl
  | .null a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .undefined a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .void a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .never a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .unknown a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .any a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .string a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .number a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .boolean a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .bigint a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .symbol a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .literal a0 a1 a2 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .uniqueSymbol a0 a1 a2 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .objectKeyword a0 a1 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .enum a0 a1 a2 =>
    simp only [cata_representation, cata_id_pos_list_check a1]
    rfl
  | .templateLiteral a0 a1 a2 =>
    simp only [cata_representation, cata_id_pos_list_check a1, cata_id_pos_list_representation a2]
    rfl
  | .arrays a0 a1 a2 a3 =>
    simp only [cata_representation, cata_id_pos_list_check a1, cata_id_pos_list_elementOf_representation a2, cata_id_pos_list_representation a3]
    rfl
  | .objects a0 a1 a2 a3 =>
    simp only [cata_representation, cata_id_pos_list_check a1, cata_id_pos_list_propertySignatureOf_representation a2, cata_id_pos_list_indexSignatureOf_representation a3]
    rfl
  | .union a0 a1 a2 a3 =>
    simp only [cata_representation, cata_id_pos_list_check a1, cata_id_pos_list_representation a2]
    rfl
termination_by structural node
@[simp] theorem cata_id_check (node : Effect4.Check) :
    cata_check (RepresentationAlgebra.id) node = node := by
  match node with
  | .filter a0 a1 a2 =>
    simp only [cata_check, cata_id_pos_checkRepresentationAnnotationOf_representation a0]
    rfl
  | .filterGroup a0 a1 a2 =>
    simp only [cata_check, cata_id_pos_option_checkRepresentationAnnotationOf_representation a0, cata_id_pos_list_check a2]
