structure RepresentationHom {R : RepresentationFam → Type u} (alg : RepresentationAlgebra R) where
  f_representation : Effect4.Representation → R .representation
  f_check : Effect4.Check → R .check
  h_representation_declaration : ∀ a0 a1 a2 a3, f_representation (.declaration a0 a1 a2 a3) =
    alg.representation_declaration a0 a1 (a2.map f_representation) (a3.map f_check)
  h_representation_reference : ∀ a0, f_representation (.reference a0) =
    alg.representation_reference a0
  h_representation_suspend : ∀ a0 a1 a2, f_representation (.suspend a0 a1 a2) =
    alg.representation_suspend a0 (a1.map f_check) (f_representation a2)
  h_representation_null : ∀ a0 a1, f_representation (.null a0 a1) =
    alg.representation_null a0 (a1.map f_check)
  h_representation_undefined : ∀ a0 a1, f_representation (.undefined a0 a1) =
    alg.representation_undefined a0 (a1.map f_check)
  h_representation_void : ∀ a0 a1, f_representation (.void a0 a1) =
    alg.representation_void a0 (a1.map f_check)
  h_representation_never : ∀ a0 a1, f_representation (.never a0 a1) =
    alg.representation_never a0 (a1.map f_check)
  h_representation_unknown : ∀ a0 a1, f_representation (.unknown a0 a1) =
    alg.representation_unknown a0 (a1.map f_check)
  h_representation_any : ∀ a0 a1, f_representation (.any a0 a1) =
    alg.representation_any a0 (a1.map f_check)
  h_representation_string : ∀ a0 a1, f_representation (.string a0 a1) =
    alg.representation_string a0 (a1.map f_check)
  h_representation_number : ∀ a0 a1, f_representation (.number a0 a1) =
    alg.representation_number a0 (a1.map f_check)
  h_representation_boolean : ∀ a0 a1, f_representation (.boolean a0 a1) =
    alg.representation_boolean a0 (a1.map f_check)
  h_representation_bigint : ∀ a0 a1, f_representation (.bigint a0 a1) =
    alg.representation_bigint a0 (a1.map f_check)
  h_representation_symbol : ∀ a0 a1, f_representation (.symbol a0 a1) =
    alg.representation_symbol a0 (a1.map f_check)
  h_representation_literal : ∀ a0 a1 a2, f_representation (.literal a0 a1 a2) =
    alg.representation_literal a0 (a1.map f_check) a2
  h_representation_uniqueSymbol : ∀ a0 a1 a2, f_representation (.uniqueSymbol a0 a1 a2) =
    alg.representation_uniqueSymbol a0 (a1.map f_check) a2
  h_representation_objectKeyword : ∀ a0 a1, f_representation (.objectKeyword a0 a1) =
    alg.representation_objectKeyword a0 (a1.map f_check)
  h_representation_enum : ∀ a0 a1 a2, f_representation (.enum a0 a1 a2) =
    alg.representation_enum a0 (a1.map f_check) a2
  h_representation_templateLiteral : ∀ a0 a1 a2, f_representation (.templateLiteral a0 a1 a2) =
    alg.representation_templateLiteral a0 (a1.map f_check) (a2.map f_representation)
  h_representation_arrays : ∀ a0 a1 a2 a3, f_representation (.arrays a0 a1 a2 a3) =
    alg.representation_arrays a0 (a1.map f_check) (a2.map (Effect4.ElementOf.map f_representation)) (a3.map f_representation)
  h_representation_objects : ∀ a0 a1 a2 a3, f_representation (.objects a0 a1 a2 a3) =
    alg.representation_objects a0 (a1.map f_check) (a2.map (Effect4.PropertySignatureOf.map f_representation)) (a3.map (Effect4.IndexSignatureOf.map f_representation))
  h_representation_union : ∀ a0 a1 a2 a3, f_representation (.union a0 a1 a2 a3) =
    alg.representation_union a0 (a1.map f_check) (a2.map f_representation) a3
  h_check_filter : ∀ a0 a1 a2, f_check (.filter a0 a1 a2) =
    alg.check_filter (a0.map f_representation) a1 a2
  h_check_filterGroup : ∀ a0 a1 a2, f_check (.filterGroup a0 a1 a2) =
    alg.check_filterGroup (a0.map (Effect4.CheckRepresentationAnnotationOf.map f_representation)) a1 (a2.map f_check)

mutual
theorem hom_eq_cata_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (node : Effect4.Representation) :
    hom.f_representation node = cata_representation alg node := by
  match node with
  | .declaration a0 a1 a2 a3 =>
    simp only [cata_representation, hom.h_representation_declaration a0 a1 a2 a3, hom_pos_list_representation hom a2, hom_pos_list_check hom a3]
  | .reference a0 =>
    simp only [cata_representation, hom.h_representation_reference a0]
  | .suspend a0 a1 a2 =>
    simp only [cata_representation, hom.h_representation_suspend a0 a1 a2, hom_pos_list_check hom a1, hom_eq_cata_representation hom a2]
  | .null a0 a1 =>
    simp only [cata_representation, hom.h_representation_null a0 a1, hom_pos_list_check hom a1]
  | .undefined a0 a1 =>
    simp only [cata_representation, hom.h_representation_undefined a0 a1, hom_pos_list_check hom a1]
  | .void a0 a1 =>
    simp only [cata_representation, hom.h_representation_void a0 a1, hom_pos_list_check hom a1]
  | .never a0 a1 =>
    simp only [cata_representation, hom.h_representation_never a0 a1, hom_pos_list_check hom a1]
  | .unknown a0 a1 =>
    simp only [cata_representation, hom.h_representation_unknown a0 a1, hom_pos_list_check hom a1]
  | .any a0 a1 =>
    simp only [cata_representation, hom.h_representation_any a0 a1, hom_pos_list_check hom a1]
  | .string a0 a1 =>
    simp only [cata_representation, hom.h_representation_string a0 a1, hom_pos_list_check hom a1]
  | .number a0 a1 =>
    simp only [cata_representation, hom.h_representation_number a0 a1, hom_pos_list_check hom a1]
  | .boolean a0 a1 =>
    simp only [cata_representation, hom.h_representation_boolean a0 a1, hom_pos_list_check hom a1]
  | .bigint a0 a1 =>
    simp only [cata_representation, hom.h_representation_bigint a0 a1, hom_pos_list_check hom a1]
  | .symbol a0 a1 =>
    simp only [cata_representation, hom.h_representation_symbol a0 a1, hom_pos_list_check hom a1]
  | .literal a0 a1 a2 =>
    simp only [cata_representation, hom.h_representation_literal a0 a1 a2, hom_pos_list_check hom a1]
  | .uniqueSymbol a0 a1 a2 =>
    simp only [cata_representation, hom.h_representation_uniqueSymbol a0 a1 a2, hom_pos_list_check hom a1]
  | .objectKeyword a0 a1 =>
    simp only [cata_representation, hom.h_representation_objectKeyword a0 a1, hom_pos_list_check hom a1]
  | .enum a0 a1 a2 =>
    simp only [cata_representation, hom.h_representation_enum a0 a1 a2, hom_pos_list_check hom a1]
  | .templateLiteral a0 a1 a2 =>
    simp only [cata_representation, hom.h_representation_templateLiteral a0 a1 a2, hom_pos_list_check hom a1, hom_pos_list_representation hom a2]
  | .arrays a0 a1 a2 a3 =>
    simp only [cata_representation, hom.h_representation_arrays a0 a1 a2 a3, hom_pos_list_check hom a1, hom_pos_list_elementOf_representation hom a2, hom_pos_list_representation hom a3]
  | .objects a0 a1 a2 a3 =>
    simp only [cata_representation, hom.h_representation_objects a0 a1 a2 a3, hom_pos_list_check hom a1, hom_pos_list_propertySignatureOf_representation hom a2, hom_pos_list_indexSignatureOf_representation hom a3]
  | .union a0 a1 a2 a3 =>
    simp only [cata_representation, hom.h_representation_union a0 a1 a2 a3, hom_pos_list_check hom a1, hom_pos_list_representation hom a2]
termination_by structural node
theorem hom_eq_cata_check {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (node : Effect4.Check) :
    hom.f_check node = cata_check alg node := by
  match node with
  | .filter a0 a1 a2 =>
    simp only [cata_check, hom.h_check_filter a0 a1 a2, hom_pos_checkRepresentationAnnotationOf_representation hom a0]
  | .filterGroup a0 a1 a2 =>
    simp only [cata_check, hom.h_check_filterGroup a0 a1 a2, hom_pos_option_checkRepresentationAnnotationOf_representation hom a0, hom_pos_list_check hom a2]
termination_by structural node
theorem hom_pos_list_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (xs : List Effect4.Representation) :
    xs.map hom.f_representation = cata_pos_list_representation alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_representation, List.map_nil]
  | x :: rest => simp only [cata_pos_list_representation, List.map_cons, hom_eq_cata_representation hom x, hom_pos_list_representation hom rest]
termination_by structural xs
theorem hom_pos_list_check {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (xs : List Effect4.Check) :
    xs.map hom.f_check = cata_pos_list_check alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_check, List.map_nil]
  | x :: rest => simp only [cata_pos_list_check, List.map_cons, hom_eq_cata_check hom x, hom_pos_list_check hom rest]
termination_by structural xs
theorem hom_pos_elementOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (x : Effect4.ElementOf Effect4.Representation) :
    x.map hom.f_representation = cata_pos_elementOf_representation alg x := by
  match x with
  | ⟨isOptional, type, annotations⟩ => simp only [cata_pos_elementOf_representation, Effect4.ElementOf.map, hom_eq_cata_representation hom type]
termination_by structural x
theorem hom_pos_list_elementOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (xs : List (Effect4.ElementOf Effect4.Representation)) :
    xs.map (Effect4.ElementOf.map hom.f_representation) = cata_pos_list_elementOf_representation alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_elementOf_representation, List.map_nil]
  | x :: rest => simp only [cata_pos_list_elementOf_representation, List.map_cons, hom_pos_elementOf_representation hom x, hom_pos_list_elementOf_representation hom rest]
termination_by structural xs
theorem hom_pos_propertySignatureOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (x : Effect4.PropertySignatureOf Effect4.Representation) :
    x.map hom.f_representation = cata_pos_propertySignatureOf_representation alg x := by
  match x with
  | ⟨name, type, isOptional, isMutable, annotations⟩ => simp only [cata_pos_propertySignatureOf_representation, Effect4.PropertySignatureOf.map, hom_eq_cata_representation hom type]
termination_by structural x
theorem hom_pos_list_propertySignatureOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (xs : List (Effect4.PropertySignatureOf Effect4.Representation)) :
    xs.map (Effect4.PropertySignatureOf.map hom.f_representation) = cata_pos_list_propertySignatureOf_representation alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_propertySignatureOf_representation, List.map_nil]
  | x :: rest => simp only [cata_pos_list_propertySignatureOf_representation, List.map_cons, hom_pos_propertySignatureOf_representation hom x, hom_pos_list_propertySignatureOf_representation hom rest]
termination_by structural xs
theorem hom_pos_indexSignatureOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (x : Effect4.IndexSignatureOf Effect4.Representation) :
    x.map hom.f_representation = cata_pos_indexSignatureOf_representation alg x := by
  match x with
  | ⟨parameter, type⟩ => simp only [cata_pos_indexSignatureOf_representation, Effect4.IndexSignatureOf.map, hom_eq_cata_representation hom parameter, hom_eq_cata_representation hom type]
termination_by structural x
theorem hom_pos_list_indexSignatureOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (xs : List (Effect4.IndexSignatureOf Effect4.Representation)) :
    xs.map (Effect4.IndexSignatureOf.map hom.f_representation) = cata_pos_list_indexSignatureOf_representation alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_indexSignatureOf_representation, List.map_nil]
  | x :: rest => simp only [cata_pos_list_indexSignatureOf_representation, List.map_cons, hom_pos_indexSignatureOf_representation hom x, hom_pos_list_indexSignatureOf_representation hom rest]
termination_by structural xs
theorem hom_pos_option_list_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (x : Option (List Effect4.Representation)) :
    x.map (List.map hom.f_representation) = cata_pos_option_list_representation alg x := by
  match x with
  | none => simp only [cata_pos_option_list_representation, Option.map_none]
  | some y => simp only [cata_pos_option_list_representation, Option.map_some, hom_pos_list_representation hom y]
termination_by structural x
theorem hom_pos_checkRepresentationAnnotationOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (x : Effect4.CheckRepresentationAnnotationOf Effect4.Representation) :
    x.map hom.f_representation = cata_pos_checkRepresentationAnnotationOf_representation alg x := by
  match x with
  | ⟨id, payload, schemas⟩ => simp only [cata_pos_checkRepresentationAnnotationOf_representation, Effect4.CheckRepresentationAnnotationOf.map, hom_pos_option_list_representation hom schemas]
termination_by structural x
theorem hom_pos_option_checkRepresentationAnnotationOf_representation {R : RepresentationFam → Type u}
    {alg : RepresentationAlgebra R} (hom : RepresentationHom alg) (x : Option (Effect4.CheckRepresentationAnnotationOf Effect4.Representation)) :
    x.map (Effect4.CheckRepresentationAnnotationOf.map hom.f_representation) = cata_pos_option_checkRepresentationAnnotationOf_representation alg x := by
  match x with
  | none => simp only [cata_pos_option_checkRepresentationAnnotationOf_representation, Option.map_none]
  | some y => simp only [cata_pos_option_checkRepresentationAnnotationOf_representation, Option.map_some, hom_pos_checkRepresentationAnnotationOf_representation hom y]
termination_by structural x
end

