mutual
def foldMap_representation {M : Type u} (unit : M) (op : M → M → M) (node : Effect4.Representation)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match node with
  | .declaration a0 a1 a2 a3 =>
    op (f_representation (.declaration a0 a1 a2 a3)) (op (foldMap_pos_list_representation unit op a2 f_representation f_check) ((foldMap_pos_list_check unit op a3 f_representation f_check)))
  | .reference a0 =>
    f_representation (.reference a0)
  | .suspend a0 a1 a2 =>
    op (f_representation (.suspend a0 a1 a2)) (op (foldMap_pos_list_check unit op a1 f_representation f_check) ((foldMap_representation unit op a2 f_representation f_check)))
  | .null a0 a1 =>
    op (f_representation (.null a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .undefined a0 a1 =>
    op (f_representation (.undefined a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .void a0 a1 =>
    op (f_representation (.void a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .never a0 a1 =>
    op (f_representation (.never a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .unknown a0 a1 =>
    op (f_representation (.unknown a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .any a0 a1 =>
    op (f_representation (.any a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .string a0 a1 =>
    op (f_representation (.string a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .number a0 a1 =>
    op (f_representation (.number a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .boolean a0 a1 =>
    op (f_representation (.boolean a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .bigint a0 a1 =>
    op (f_representation (.bigint a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .symbol a0 a1 =>
    op (f_representation (.symbol a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .literal a0 a1 a2 =>
    op (f_representation (.literal a0 a1 a2)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .uniqueSymbol a0 a1 a2 =>
    op (f_representation (.uniqueSymbol a0 a1 a2)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .objectKeyword a0 a1 =>
    op (f_representation (.objectKeyword a0 a1)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .enum a0 a1 a2 =>
    op (f_representation (.enum a0 a1 a2)) ((foldMap_pos_list_check unit op a1 f_representation f_check))
  | .templateLiteral a0 a1 a2 =>
    op (f_representation (.templateLiteral a0 a1 a2)) (op (foldMap_pos_list_check unit op a1 f_representation f_check) ((foldMap_pos_list_representation unit op a2 f_representation f_check)))
  | .arrays a0 a1 a2 a3 =>
    op (f_representation (.arrays a0 a1 a2 a3)) (op (foldMap_pos_list_check unit op a1 f_representation f_check) (op (foldMap_pos_list_elementOf_representation unit op a2 f_representation f_check) ((foldMap_pos_list_representation unit op a3 f_representation f_check))))
  | .objects a0 a1 a2 a3 =>
    op (f_representation (.objects a0 a1 a2 a3)) (op (foldMap_pos_list_check unit op a1 f_representation f_check) (op (foldMap_pos_list_propertySignatureOf_representation unit op a2 f_representation f_check) ((foldMap_pos_list_indexSignatureOf_representation unit op a3 f_representation f_check))))
  | .union a0 a1 a2 a3 =>
    op (f_representation (.union a0 a1 a2 a3)) (op (foldMap_pos_list_check unit op a1 f_representation f_check) ((foldMap_pos_list_representation unit op a2 f_representation f_check)))
termination_by structural node
def foldMap_check {M : Type u} (unit : M) (op : M → M → M) (node : Effect4.Check)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match node with
  | .filter a0 a1 a2 =>
    op (f_check (.filter a0 a1 a2)) ((foldMap_pos_checkRepresentationAnnotationOf_representation unit op a0 f_representation f_check))
  | .filterGroup a0 a1 a2 =>
    op (f_check (.filterGroup a0 a1 a2)) (op (foldMap_pos_option_checkRepresentationAnnotationOf_representation unit op a0 f_representation f_check) ((foldMap_pos_list_check unit op a2 f_representation f_check)))
termination_by structural node
def foldMap_pos_list_representation {M : Type u} (unit : M) (op : M → M → M) (xs : List Effect4.Representation)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_representation unit op x f_representation f_check) (foldMap_pos_list_representation unit op rest f_representation f_check)
termination_by structural xs
def foldMap_pos_list_check {M : Type u} (unit : M) (op : M → M → M) (xs : List Effect4.Check)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_check unit op x f_representation f_check) (foldMap_pos_list_check unit op rest f_representation f_check)
termination_by structural xs
def foldMap_pos_elementOf_representation {M : Type u} (unit : M) (op : M → M → M) (x : Effect4.ElementOf Effect4.Representation)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match x with
  | ⟨_, type, _⟩ => (foldMap_representation unit op type f_representation f_check)
termination_by structural x
def foldMap_pos_list_elementOf_representation {M : Type u} (unit : M) (op : M → M → M) (xs : List (Effect4.ElementOf Effect4.Representation))
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_elementOf_representation unit op x f_representation f_check) (foldMap_pos_list_elementOf_representation unit op rest f_representation f_check)
termination_by structural xs
def foldMap_pos_propertySignatureOf_representation {M : Type u} (unit : M) (op : M → M → M) (x : Effect4.PropertySignatureOf Effect4.Representation)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match x with
  | ⟨_, type, _, _, _⟩ => (foldMap_representation unit op type f_representation f_check)
termination_by structural x
def foldMap_pos_list_propertySignatureOf_representation {M : Type u} (unit : M) (op : M → M → M) (xs : List (Effect4.PropertySignatureOf Effect4.Representation))
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_propertySignatureOf_representation unit op x f_representation f_check) (foldMap_pos_list_propertySignatureOf_representation unit op rest f_representation f_check)
termination_by structural xs
def foldMap_pos_indexSignatureOf_representation {M : Type u} (unit : M) (op : M → M → M) (x : Effect4.IndexSignatureOf Effect4.Representation)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match x with
  | ⟨parameter, type⟩ => op (foldMap_representation unit op parameter f_representation f_check) ((foldMap_representation unit op type f_representation f_check))
termination_by structural x
def foldMap_pos_list_indexSignatureOf_representation {M : Type u} (unit : M) (op : M → M → M) (xs : List (Effect4.IndexSignatureOf Effect4.Representation))
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_indexSignatureOf_representation unit op x f_representation f_check) (foldMap_pos_list_indexSignatureOf_representation unit op rest f_representation f_check)
termination_by structural xs
def foldMap_pos_option_list_representation {M : Type u} (unit : M) (op : M → M → M) (x : Option (List Effect4.Representation))
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match x with
  | none => unit
  | some y => (foldMap_pos_list_representation unit op y f_representation f_check)
termination_by structural x
def foldMap_pos_checkRepresentationAnnotationOf_representation {M : Type u} (unit : M) (op : M → M → M) (x : Effect4.CheckRepresentationAnnotationOf Effect4.Representation)
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match x with
  | ⟨_, _, schemas⟩ => (foldMap_pos_option_list_representation unit op schemas f_representation f_check)
termination_by structural x
def foldMap_pos_option_checkRepresentationAnnotationOf_representation {M : Type u} (unit : M) (op : M → M → M) (x : Option (Effect4.CheckRepresentationAnnotationOf Effect4.Representation))
    (f_representation : Effect4.Representation → M := fun _ => unit) (f_check : Effect4.Check → M := fun _ => unit) : M :=
  match x with
  | none => unit
  | some y => (foldMap_pos_checkRepresentationAnnotationOf_representation unit op y f_representation f_check)
termination_by structural x
end


