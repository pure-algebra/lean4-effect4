{
  "//": "Seat SVC's check: the compiler options of ts/eff/tsconfig.json (check-target's base), without bun's types.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["prelude/*.ts", "todo/todo.gen.ts", "todo/todo-host.d.ts", "todo/consumer.ts"]
}
