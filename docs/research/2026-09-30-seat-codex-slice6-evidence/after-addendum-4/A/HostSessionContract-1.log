'Test.Api.HostSessionContract.evaluate_retains_guard' depends on axioms: [propext, Quot.sound]
'Test.Api.HostSessionContract.evaluate_retains_token' depends on axioms: [propext, Quot.sound]
@preflight_envelope : ∀ {program : Api.Program} {table : RowTable} (s : Session program table) (reply : Reply)
  (decision : NativeDecision),
  preflight s reply = Except.ok decision →
    ∃ bound,
      List.find? (fun b => b.key == reply.key) s.active = some bound ∧
        reply.callId = bound.call.callId ∧
          Envelope table s.machine (bound.record reply) ∧
            decision = RunDecision.answerAsync bound.call.fiber bound.token reply.completion
@applyPending_zero : ∀ {program : Api.Program} {table : RowTable} (s : Session program table),
  applyPending s 0 = { phase := Phase.frontier, session := s }
@applied_guard_absent : ∀ {program : Api.Program} {table : RowTable} (s : Session program table) (fuel : Nat)
  (bound : BoundCall),
  List.find? (fun b => b.key == bound.key) s.active = some bound →
    (applyReply s bound.key fuel).phase = Phase.applied →
      Api.requestOf (applyReply s bound.key fuel).session.machine bound.call.fiber bound.token = none
@applied_reply_refused : ∀ {program : Api.Program} {table : RowTable} (s : Session program table) (fuel : Nat)
  (bound : BoundCall) (reply : Reply),
  List.find? (fun b => b.key == bound.key) s.active = some bound →
    (applyReply s bound.key fuel).phase = Phase.applied →
      acceptReply table (applyReply s bound.key fuel).session.machine (bound.record reply) = none
@advance_answer_refuses : ∀ {program : Api.Program} {table : RowTable} (s : Session program table) (fuel : Nat)
  (fiber : FiberId) (token : Nat) (reply : Answer),
  advance s fuel (RunDecision.answerAsync fiber token reply) =
    { phase := Phase.refused Refusal.directAnswer, session := s }
