Run.receive_rows : ∀ (s : Run) (key : Key) (c : Api.HostSession.Answer) (call : Api.HostSession.Call),
  Api.HostSession.Call.at s key = some call →
    Rows.receive s key c = [Api.Runner.Command.bind call key.token, Api.Runner.Command.submit (Rows.reply s call key c)]
Run.answer_rows : ∀ (s : Run) (key : Key) (c : Api.HostSession.Answer) (call : Api.HostSession.Call),
  Api.HostSession.Call.at s key = some call →
    Rows.answer s key c = Rows.receive s key c ++ [Api.Runner.Command.apply key]
Run.acceptReply_after_applied : ∀ (s : Run) (key : Key) (bound : Api.HostSession.BoundCall)
  (reply : Api.HostSession.Reply),
  List.find? (fun b => b.key == key) s.session.active = some bound →
    bound.key = key →
      (Api.HostSession.applyReply s.session key s.budget.fuel).phase = Api.HostSession.Phase.applied →
        acceptReply s.built.table (s.step (Api.Runner.Command.apply key)).machine (bound.record reply) = none
