+def RegistrationTail {Code : Type}
+    (command : Cmd EffName EffThunk Val Err Defect FiberId Ann Code)
+    (rest : List (Cmd EffName EffThunk Val Err Defect FiberId Ann Code)) : Prop :=
   match command with
   | .launch race | .enrollRace race _ => ∃ yielding, .registrationDone race yielding ∈ rest
   | _ => True
 
