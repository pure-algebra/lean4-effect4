+/-- Part-one exclusion: no failure reason is a shape defect. This does not depend on the
+answer, error, or requirement columns; ordinary defects remain admitted. -/
+def NoShapeDefect : ExitV → Prop
+  | .success _ => True
+  | .failure cause => ∀ reason ∈ cause.reasons, match reason with
+    | .die defect _ => defect ≠ .badName ∧ defect ≠ .notImplemented
+    | _ => True
+
+/-- Membership plus the part-one exclusion, shared by every typed exit position. -/
+def ExitOk (w : World) (ty : EffTy) (ex : ExitV) : Prop :=
+  FitsExit w ty ex ∧ NoShapeDefect ex
 
