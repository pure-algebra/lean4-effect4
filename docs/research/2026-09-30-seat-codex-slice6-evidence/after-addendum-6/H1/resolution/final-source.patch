+theorem loaded_code (w : W) : TypedProg (program : ProgramSource) w ty
+    (denoteR program program (rootPoint 20)) := by
+  change TypedProg (program : ProgramSource) w ty (.pure (.success .unit))
+  exact TypedProg.pure trivial
