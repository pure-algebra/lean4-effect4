+    · intro q hq; cases hq
+    · intro v0 h; cases h
+    · intro v0 h; cases h
+    · intro v0 hv; cases hv
+    · intro key sv sty hget
+      change (Env.Context.empty : Env.Ctx).getV key = some sv at hget
