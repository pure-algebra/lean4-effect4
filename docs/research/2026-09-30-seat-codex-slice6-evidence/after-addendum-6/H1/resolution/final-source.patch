+theorem early_resume_rejected (w : W) :
+    ¬ QueueOk (program : ProgramSource) w m0 [earlyResume] := by
+  intro queue
+  have impossible : 0 < 0 := queue.keys.below (Api.root, 0) (List.mem_singleton_self _)
+  exact Nat.not_lt_zero 0 impossible
