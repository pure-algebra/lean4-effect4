+def rootProgram : NativeEff := .succeed (.lit .unit)
+def unitTy : EffTy := EffTy.pure .unit
+def natTy : EffTy := EffTy.pure .nat
+def current : RProgram := .pure (.success (.nat 42))
+def answer : ExitV → RProgram := fun _ => .pure (.success .unit)
