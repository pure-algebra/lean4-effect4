+    heapClosed := old.heapClosed, promiseClosed := old.promiseClosed,
+    tokenClosed := old.tokenClosed, root := old.root }
+  intro f hf token hp
+  change f ∈ [fiber] at hf
+  rw [List.mem_singleton] at hf
+  subst f
+  cases hp
