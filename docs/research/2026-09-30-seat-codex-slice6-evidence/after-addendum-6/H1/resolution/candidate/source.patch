+def TerminalFiber (m : RState) (commands : List RCmd) (id : FiberId) : Prop :=
+  (∃ exit, .finish id exit ∈ commands) ∨
+    ∃ fiber ∈ m.fibers, fiber.id = id ∧ fiber.exit.isSome = true
