-  have h := roundTrip (2 ^ 53)
-  rw [natural_collision, roundTrip (2 ^ 53 + 1)] at h
-  have bad : (2 ^ 53 + 1 : Nat) = 2 ^ 53 := by
-    injection h with hv
-    injection hv
