-one exact marker, exact operation identities, and legal imported spellings. -/
-def requestReady (request : Request) : Bool :=
-  match request.property.name, request.property.type,
-      EffectfulFieldSpec.check request.property.annotations with
-  | .string fieldName, .string _ _, some spec =>
-      namesReady request fieldName && importsReady request &&
-        bindingsMatch request spec
-  | _, _, _ => false
-
-/-- Logical spelling of checked target admission. -/
-def RequestReady (request : Request) : Prop :=
-  requestReady request = true
-
-theorem requestReady_iff (request : Request) :
-    requestReady request = true <-> RequestReady request :=
-  Iff.rfl
-
