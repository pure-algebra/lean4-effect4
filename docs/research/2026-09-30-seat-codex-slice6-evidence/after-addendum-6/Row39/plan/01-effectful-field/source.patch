-    (fieldName readError writeError : String)
-    {request : Request} {style : Style} {source : String}
-    (generated : source? request style = some source)
-    (fieldName_eq : request.property.name = .string fieldName)
-    (readError_eq : request.read.errorType = readError)
-    (writeError_eq : request.write.errorType = writeError) :
-    source.contains
-      ("Effect.Services<ReturnType<typeof " ++ fieldName ++ ".get>>") = true /\
-    source.contains
-      ("Effect.Services<ReturnType<typeof " ++ fieldName ++
-        ".replace>>") = true /\
-    source.contains
-      (readError ++ " | " ++ writeError) = true := by
-  unfold source? at generated
-  cases moduleResult : module? request with
-  | none => simp [moduleResult] at generated
-  | some target =>
-      simp only [moduleResult] at generated
-      by_cases present : directionalRowsPresent request (Render.module style target)
-      · simp [present] at generated
-        cases generated
-        unfold directionalRowsPresent at present
-        have requestFieldName_eq : requestFieldName request = fieldName := by
-          unfold requestFieldName
-          rw [fieldName_eq]
-        simp only [Bool.and_eq_true] at present
-        rw [requestFieldName_eq, readError_eq, writeError_eq] at present
-        exact present
-      · simp [present] at generated
-
-end Effect4.Codegen.EffectfulField
