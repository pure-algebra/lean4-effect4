-private def namesReady (request : Request) (fieldName : String) : Bool :=
-  [ fieldName
-  , request.sourceType
-  , request.read.serviceName
-  , request.read.methodName
-  , request.read.errorType
-  , request.write.serviceName
-  , request.write.methodName
-  , request.write.errorType
-  ].all Schema.targetIdentifier
-
-private def importsReady (request : Request) : Bool :=
-  [ request.sourceImport
-  , request.read.serviceImport
-  , request.read.errorImport
-  , request.write.serviceImport
-  , request.write.errorImport
-  ].all fun path => !path.isEmpty
-
-private def bindingsMatch (request : Request)
-    (spec : EffectfulFieldSpec) : Bool :=
-  decide (request.read.alphabet = spec.alphabet) &&
-    decide (request.write.alphabet = spec.alphabet) &&
-    decide (request.read.operation = spec.readOperation) &&
-    decide (request.write.operation = spec.writeOperation)
