-- LCNF CaptureProbe.subCap
def CaptureProbe.subCap max a b : Nat :=
  let _x.1 := Nat.sub a b;
  let _x.2 := max _x.1 b;
  return _x.2

-- LCNF CaptureProbe.helperCap
def CaptureProbe.helperCap lcnf_nat_mul a b : Nat :=
  let _x.1 := Nat.mul a b;
  let _x.2 := lcnf_nat_mul _x.1 b;
  return _x.2

-- LCNF CaptureProbe.globalCap
def CaptureProbe.globalCap capture_probe_apply_to y : Nat :=
  let _x.1 := 2;
  let _x.2 := Nat.add _x.1;
  let _x.3 := 1;
  let _x.4 := Nat.add _x.3;
  let _x.5 := CaptureProbe.applyTo _x.4 y;
  let _x.6 := capture_probe_apply_to _x.2 _x.5;
  return _x.6

