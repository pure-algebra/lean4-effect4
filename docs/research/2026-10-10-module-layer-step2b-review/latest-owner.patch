diff --git a/Test/Codegen/DefinitionsPrint.lean b/Test/Codegen/DefinitionsPrint.lean
index 0a963335a..6ab29c3db 100644
--- a/Test/Codegen/DefinitionsPrint.lean
+++ b/Test/Codegen/DefinitionsPrint.lean
@@ -53,6 +53,26 @@ open Effect4 Effect4.Program Test.Program.DefinitionsControls
 #guard moduleReadable [] (nativeSignature []) (.succeed (.lit (.nat 1)) : NativeEff)
 #guard !moduleReadable [] (nativeSignature []) twiceProg
 
+/-! ## The module's layers (decisions row 341, step 2) -/
+
+/-- The block with a module layer (`moduleLayerProg`, Test/Program/DefinitionsControls.lean). -/
+def moduleLayered : NativeEff := moduleLayerProg
+
+-- the module types, and runs to the layer's value
+#guard Api.typeOf moduleLayered == some (EffTy.pure .nat)
+#guard (match (Api.run moduleLayered 200).exit with
+  | some (.success v) => v == .nat 7
+  | _ => false)
+-- the printer writes the module layer as a constant named by its path, after the definition
+-- and before the main declaration, and both uses print as that name
+#guard (Api.printModule "main" moduleLayered).map (fun m => m.decls.filterMap fun
+    | .const c => some c.name
+    | _ => none) = some ["readKey", "L_2_0", "main"]
+-- the program is in the readable domain of a block, and its module reads back to it
+#guard blockReadable [] (nativeSignature []) moduleLayered
+#guard (Api.printModule "main" moduleLayered).map (fun m =>
+  decide (Api.readModule m [] = .ok moduleLayered)) = some true
+
 /-! ## The name bridge (a reader) -/
 
 -- the printer's name check gives the names the block's spelling map reads back
diff --git a/Test/Program/DefinitionsControls.lean b/Test/Program/DefinitionsControls.lean
index e3a2fd03a..9126e9909 100644
--- a/Test/Program/DefinitionsControls.lean
+++ b/Test/Program/DefinitionsControls.lean
@@ -110,6 +110,18 @@ def spinProg : NativeEff :=
   .defs [{ name := "spin", request := .nat, answer := .nat }]
     (.cons (.perform (.call 0) (.var 0)) .nil) (.perform (.call 0) (.lit (.nat 1))) .nil
 
+/-- A service key the module layer provides. -/
+def layerKey : ServiceKey := ⟨⟨4⟩, ⟨4⟩⟩
+
+/-- **A block with a module layer** (decisions row 341, step 2): `readKey : number → number`
+reads the service of the module's one layer, at `[2, 0]`, which provides `7`; the main program
+invokes it and then reads the service itself. Both name the layer by reference. -/
+def moduleLayerProg : NativeEff :=
+  .defs [{ name := "readKey", request := .nat, answer := .nat }]
+    (.cons (.provideLayer (.ref [2, 0]) false (.service layerKey)) .nil)
+    (.bind (.perform (.call 0) (.lit (.nat 1))) (.provideLayer (.ref [2, 0]) false (.service layerKey)))
+    (.cons (.succeed layerKey (.nat 7)) .nil)
+
 /-- An invocation inside a fork, joined. -/
 def forkProg : NativeEff :=
   .defs [twiceDecl] (.cons (.succeed (ap "pair" [.var 0, .var 0])) .nil)
