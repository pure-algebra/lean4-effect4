--- a/tools/Drivers/ForeignCorpus.lean
+++ b/tools/Drivers/ForeignCorpus.lean
@@ -162,6 +162,23 @@ def contextProbes : List (String × Eff NativeOp) :=
   [ ("context-provide", .bind (.withFiber (.context .empty))
       (.provideContext (.var 0) (.succeed (.lit (.nat 1))))) ]
 
+/-- A definition block and a passed program, absent from the seeded generator.
+This finite reader probe serves `module-defs-round-trip`; it claims no host agreement. -/
+def definitionProbes : List (String × Eff NativeOp) :=
+  [("definition-invoke", .defs
+    [{ name := "apply", request := .nat, answer := .nat,
+       params := [{ name := "f", request := .nat, answer := .nat }] }]
+    (.cons (.perform (.param 0) (.var 0)) .nil)
+    (.invoke 0 (.lit (.nat 1)) (.cons (.succeed (.var 0)) .nil)) .nil)]
+
+/-- A definition block reads as a module. Other probes retain the expression reader. -/
+def constructedRoundTrip (p : Eff NativeOp) : Except ReadRefusal (Eff NativeOp) :=
+  if p.block?.isSome then do
+    let module ← (printModule nativeSignature "program" ⟨.unit, .never, .empty⟩ p).mapError
+      (fun _ => ReadRefusal.shape "printer")
+    readModule nativeSignature nativeSpell NativeOp.call NativeOp.param [] (module.map .const)
+  else roundTrip nativeSignature nativeSpell 0 p
+
 def corpus (dir : System.FilePath) (skeletons : List (String × Eff NativeOp)) : IO Unit := do
   IO.FS.createDirAll dir
   let mut index := "name\tstyle\tbytes\n"
@@ -170,8 +187,9 @@ def corpus (dir : System.FilePath) (skeletons : List (String × Eff NativeOp)) :
   for c in Tools.Styles.isolated do
