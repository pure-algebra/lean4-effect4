'Effect4.Api.isRunnable' does not depend on any axioms
'Effect4.Api.runnableFibers' does not depend on any axioms
'Effect4.Api.mem_runnableFibers' depends on axioms: [propext, Quot.sound]
'Effect4.Run.Work' does not depend on any axioms
'Effect4.Run.instDecidableEqWork' depends on axioms: [propext]
'Effect4.Run.work' depends on axioms: [propext, Quot.sound]
'Effect4.Run.nextControl' depends on axioms: [propext, Quot.sound]
'Effect4.Run.controlOnce' depends on axioms: [propext, Quot.sound]
'Effect4.Run.work_runnable_mem' depends on axioms: [propext, Quot.sound]
'Effect4.Run.work_queued' depends on axioms: [propext, Quot.sound]
'Effect4.Run.work_waits' depends on axioms: [propext, Quot.sound]
'Effect4.Run.nextControl_spec' depends on axioms: [propext, Quot.sound]
'Effect4.Run.nextControl_none_iff' depends on axioms: [propext, Quot.sound]
'Effect4.Run.nextControl_evaluate_mem' depends on axioms: [propext, Quot.sound]
'Effect4.Run.controlOnce_none' depends on axioms: [propext, Quot.sound]
'Effect4.Run.controlOnce_some' depends on axioms: [propext, Quot.sound]
'Effect4.Run.controlOnce_journal' depends on axioms: [propext, Quot.sound]
Effect4.Run.nextControl_spec (s : Effect4.Run) (decision : Effect4.Api.Decision) :
  s.nextControl = some decision ↔
    s.machine.stuck
          (Effect4.Prim Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
            Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
          (Effect4.FrameFiber Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
            Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
          (Effect4.FrameEvent Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
            Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann) =
        none ∧
      (decision = Effect4.Api.flush ∧ s.work.queued ≠ [] ∨
        ∃ fiber,
          decision = Effect4.Machine.RunDecision.evaluate fiber ∧
            s.work.queued = [] ∧ s.work.runnable.head? = some fiber)
Effect4.Run.nextControl_none_iff (s : Effect4.Run) :
  s.nextControl = none ↔
    (s.machine.stuck
            (Effect4.Prim Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
              Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
            (Effect4.FrameFiber Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
              Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
            (Effect4.FrameEvent Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
              Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)).isSome =
        true ∨
      s.work.queued = [] ∧ s.work.runnable = []
Effect4.Run.controlOnce_journal (s : Effect4.Run) (decision : Effect4.Api.Decision)
  (chosen : s.nextControl = some decision) :
  s.controlOnce.journal = s.journal ++ [Effect4.Api.Runner.Command.control decision]
