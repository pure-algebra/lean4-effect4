@[reducible] def Effect4.Program.Typed.RStateOk : {W : Type} → Typed.Preds W → W → RState → Prop :=
fun {W} P w x => Typed.RunMachineOk P w Typed.Expect.root x
def Effect4.Program.Typed.TaskOk : {W : Type} →
  Typed.Preds W → W → Typed.Expect → Machine.Task EffName EffThunk Val Err Defect FiberId Ann RProgram → Prop :=
fun {W} P w e x =>
  match x with
  | Task.start child => True
  | Task.resume target token answer => P.ResumeOk w e answer
  | Task.wake list phase => True
def Effect4.Program.Typed.CmdOk : {W : Type} →
  Typed.Preds W → W → Typed.Expect → Cmd EffName EffThunk Val Err Defect FiberId Ann RProgram → Prop :=
fun {W} P w e x =>
  match x with
  | Cmd.evaluate fiber => True
  | Cmd.loop fiber yielding => True
  | Cmd.deliver fiber yielding => True
  | Cmd.finish fiber exit => P.exit w (Typed.Expect.fiber fiber) exit
  | Cmd.resume fiber token answer => P.ResumeOk w e answer
  | Cmd.launch race => True
  | Cmd.enrollRace race child => True
  | Cmd.registrationDone race yielding => True
  | Cmd.interruptTarget target who extra => True
  | Cmd.afterInterrupt host yielding kind => True
  | Cmd.raceCancel race host yielding remaining visited => True
  | Cmd.trackChild parent child => True
  | Cmd.observe fiber exit observer => P.exit w (Typed.Expect.fiber fiber) exit
  | Cmd.exitDone fiber => True
  | Cmd.closeParAwait host yielding fibers => True
  | Cmd.link mode scope target interruptor extra => True
  | Cmd.drainDue => True
  | Cmd.wake list phase => True
