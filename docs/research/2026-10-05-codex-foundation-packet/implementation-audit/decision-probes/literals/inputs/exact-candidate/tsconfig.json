{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ]
  },
  "files": [
    "term-rows.typecheck.ts",
    "tuples.typecheck.ts",
    "records.typecheck.ts",
    "folds.typecheck.ts",
    "real-queue-take.ts",
    "policy-controls.ts"
  ]
}
