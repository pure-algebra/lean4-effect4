def Test.Dogfood.Scenario.Routing.InfrastructureEscapes : Prop :=
∀ (id : Nat) (idText tag message : String) (b : Effect4.Api.Built),
  Effect4.Api.Author.build (request "secret" id idText) = Except.ok b →
    tag ≠ "NotFound" →
      tag ≠ "Unauthorized" →
        (observe (play (opened b) (failing tag message))).outcome =
          some (Effect4.Exit.failure (Effect4.Cause.fail (Effect4.Machine.Err.tagged tag message)))
def Test.Dogfood.Scenario.Routing.UnauthorizedCallsNothing : Prop :=
∀ (token : String) (id : Nat) (idText : String) (b : Effect4.Api.Built) (moves : List Move),
  Effect4.Api.Author.build (request token id idText) = Except.ok b →
    (∀ (reply : Effect4.Api.HostSession.Reply) (pageSize : Nat),
        Effect4.Api.Runner.Command.submit reply ∈ (play (opened b) moves).journal →
          reply.completion ≠ ok (configOf token pageSize)) →
      (observe (play (opened b) moves)).repositoryCalls = []
