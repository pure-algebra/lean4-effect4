fold_of: Effect4.Machine.Val.keys.eq_cata : ∀ (a : Val), a.keys = Store.cata_val Val.keys.alg a
fold_of: Effect4.Machine.Val.keysList.eq_cata : ∀ (a : List Val),
  Val.keysList a = List.foldr (fun r rrest => r ++ rrest) [] (Store.cata_pos_list_val Val.keys.alg a)
