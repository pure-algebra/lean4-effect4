== dyn
  type: answer Effect4.Program.Ty.nat, requires []
  admitted: true
  exit: success (Val.nat 1)
== lexical
  type: answer Effect4.Program.Ty.nat, requires []
  admitted: true
  exit: success (Val.nat 2)
== bodyOnly
  type: answer Effect4.Program.Ty.nat, requires [{ name := { value := 4 }, service := { value := 4 } }]
  admitted: true
  exit: success (Val.nat 1)
== twice
  type: answer Effect4.Program.Ty.prod (Effect4.Program.Ty.nat) (Effect4.Program.Ty.nat), requires []
  admitted: true
  exit: success (Val.list [(Val.nat 1), (Val.nat 2)])
== forked
  type: answer Effect4.Program.Ty.nat, requires []
  admitted: true
  exit: success (Val.nat 1)
== reset
  type: answer Effect4.Program.Ty.nat, requires []
  admitted: true
  exit: failure [die Effect4.Machine.Defect.missingService]
== resetInBody
  type: answer Effect4.Program.Ty.nat, requires []
  admitted: true
  exit: failure [die Effect4.Machine.Defect.missingService]
