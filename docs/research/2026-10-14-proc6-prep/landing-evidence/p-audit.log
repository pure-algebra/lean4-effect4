  goal Effect4.Program.Agreement.hostRunBlockB_exits : ∀ {table : Effect4.Program.RowTable} {σ : Type} (host : Effects.Comodel (Effect4.Program.Denote.RowSig table) σ)
  (root : Effect4.Program.NativeEff),
  Effect4.Program.Denote.BlockRows table root = true →
    ∀ (cf : Nat) (R st : σ) {ex : Effect4.Machine.ExitV} {s : Effect4.Machine.Stores},
