  goal Effect4.Run.conforms_sat_blocks : ∀ (protocols : Effect4.Program.RowProtocols) (s : Effect4.Run),
  s.Reached →
    s.funded = true →
      s.atRest = true →
        s.hostDriven = true →
          Effect4.Program.Denote.BlockRows s.built.table s.built.program = true →
            Effect4.Run.conforms protocols s = true →
              ∀ {Q : Effect4.Machine.ExitV → Prop},
                (∀ (k : Nat),
                    Effects.Program.Sat (Effect4.Run.rowsProtocol s.built.table protocols)
                      (fun result =>
                        match result with
                        | none => True
                        | some ex => Q ex)
                      (Effect4.Program.Denote.denoteBlockB s.built.table
                        (Effect4.Program.Denote.bodiesOf s.built.program) k [] s.built.program Effect4.Machine.emptyCtx
                        [])) →
                  ∀ (ex : Effect4.Machine.ExitV), s.exit = some ex → Q ex
  goal Effect4.Run.agrees_hostRun_blocks : ∀ {σ : Type} (model : Effect4.Run.Reactor σ) (s : Effect4.Run),
  s.Reached →
    s.funded = true →
      s.atRest = true →
        s.hostDriven = true →
          Effect4.Program.Denote.BlockRows s.built.table s.built.program = true →
            ∀ (start finish : σ),
              Effect4.Run.agrees model s start = some finish →
                ∀ (ex : Effect4.Machine.ExitV),
                  s.exit = some ex →
                    ∃ lower,
                      ∀ (k : Nat),
                        lower ≤ k →
                          Effect4.Program.Denote.hostRunBlockB (Effect4.Run.reactorHost s.built.table model)
                              (Effect4.Program.Denote.bodiesOf s.built.program) k [] s.built.program
                              Effect4.Machine.emptyCtx [] Effect4.Machine.Stores.empty start =
                            some
                              (some ex,
                                s.machine.state
                                  (Effect4.Prim Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val
                                    Effect4.Machine.Err Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
                                  (Effect4.FrameFiber Effect4.Program.EffName Effect4.Program.EffThunk
                                    Effect4.Machine.Val Effect4.Machine.Err Effect4.Machine.Defect Effect4.FiberId
                                    Effect4.Machine.Ann)
                                  (Effect4.FrameEvent Effect4.Program.EffName Effect4.Program.EffThunk
                                    Effect4.Machine.Val Effect4.Machine.Err Effect4.Machine.Defect Effect4.FiberId
                                    Effect4.Machine.Ann),
                                finish)
