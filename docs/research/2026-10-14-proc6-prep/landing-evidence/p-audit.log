  goal Effect4.Program.Agreement.localRunC_to_blockB : ∀ {table : Effect4.Program.RowTable} {σ : Type} (host : Effects.Comodel (Effect4.Program.Denote.RowSig table) σ)
  (root : Effect4.Program.NativeEff),
  Effect4.Program.Denote.BlockRows table root = true →
    ∀ (cf : Nat) (R : σ) {c : Nat} {ex : Effect4.Machine.ExitV} {s' : Effect4.Machine.Stores} {r' : σ},
      Effect4.Program.Agreement.localRunC host root c
            (Effect4.Program.Agreement.fiberOf (Effect4.Program.compile root cf) []) Effect4.Machine.Stores.empty R =
