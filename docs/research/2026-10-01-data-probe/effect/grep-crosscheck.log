# grep cross-check of count_schema.py over the v4 application subset (v4-app-files.txt, 10,905 files)
ugrep 7.8.4 aarch64-apple-macosx +neon/AArch64; -P:pcre2jit; -z:zlib,bzip2,zstd,brotli,7z,tar/pax/cpio/zip
2730	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.Struct\(' | wc -l
931	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.decodeUnknown[A-Za-z0-9_]*\(' | wc -l
5	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.suspend\(' | wc -l
291	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bJSON\.parse\(' | wc -l
970	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bData\.TaggedError\(' | wc -l
535	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.TaggedError(Class)?\b' | wc -l
325	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.(Class|TaggedClass)\b' | wc -l
41	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.(decodeTo|encodeTo|transform|transformOrFail|transformLiteral|transformLiterals|compose|link|middlewareDecoding|middlewareEncoding|catchDecoding[A-Za-z0-9_]*|catchEncoding[A-Za-z0-9_]*)\b' | wc -l
2802	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.(optional|optionalKey|optionalWith)\(' | wc -l
442	tr '\n' '\0' < v4-app-files.txt | xargs -0 grep -ohE '\bSchema\.Number\b' | wc -l
