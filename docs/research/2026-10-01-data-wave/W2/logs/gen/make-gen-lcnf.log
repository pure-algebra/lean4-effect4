info: Test/Api/HostSessionContract.lean:133:0: @preflight_envelope : ∀ {program : Api.Program} {table : RowTable} (s : Session program table) (reply : Reply)
  (decision : NativeDecision),
  preflight s reply = Except.ok decision →
    ∃ bound,
      List.find? (fun b => b.key == reply.key) s.active = some bound ∧
        reply.callId = bound.call.callId ∧
          Envelope table s.machine (bound.record reply) ∧
            decision = RunDecision.answerAsync bound.call.fiber bound.token reply.completion
