info: Test/Run/RunContract.lean:179:0: Run.acceptReply_after_applied : ∀ (s : Run) (key : Key) (bound : Api.HostSession.BoundCall)
  (reply : Api.HostSession.Reply),
  List.find? (fun b => b.key == key) s.session.active = some bound →
    bound.key = key →
