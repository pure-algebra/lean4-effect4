fun id idText =>
  Eff.catchIf (Term.app "tagIs" (Terms.cons (Term.lit (Lit.str "NotFound")) (Terms.cons (Term.var 0) Terms.nil)))
    (Eff.catchIf (Term.app "tagIs" (Terms.cons (Term.lit (Lit.str "Unauthorized")) (Terms.cons (Term.var 0) Terms.nil)))
      (((Eff.perform (NativeOp.external 0) (Term.lit Lit.unit)).bind
            (Eff.select
              (Term.app "not"
                (Terms.cons
                  (Term.app "eq"
                    (Terms.cons (Term.lit (Lit.str "secret"))
                      (Terms.cons (Term.field FieldReadMode.required (Term.var 0) "adminToken") Terms.nil)))
                  Terms.nil))
              Decision.bool
              (Eff.fail
                (Term.app "pair"
                  (Terms.cons (Term.lit (Lit.str "Unauthorized"))
                    (Terms.cons (Term.lit (Lit.str "bad token")) Terms.nil))))
              (((Eff.perform (NativeOp.external 1) (Term.lit (Lit.nat 1))).bind
                    (Eff.select (Term.var 1) Decision.option
                      (Eff.fail
                        (Term.app "pair"
                          (Terms.cons (Term.lit (Lit.str "NotFound")) (Terms.cons (Term.lit (Lit.str "1")) Terms.nil))))
                      (Eff.succeed (Term.var 2)))).bind
                (Eff.select
                  (Term.app "and"
                    (Terms.cons
                      (Term.app "not"
                        (Terms.cons
                          (Term.app "eq"
                            (Terms.cons (Term.field FieldReadMode.required (Term.var 1) "role")
                              (Terms.cons (Term.lit (Lit.str "admin")) Terms.nil)))
                          Terms.nil))
                      (Terms.cons
                        (Term.app "not"
                          (Terms.cons
                            (Term.app "eq"
                              (Terms.cons (Term.field FieldReadMode.required (Term.var 1) "id")
                                (Terms.cons (Term.lit (Lit.nat id)) Terms.nil)))
                            Terms.nil))
                        Terms.nil)))
                  Decision.bool
                  (Eff.fail
                    (Term.app "pair"
                      (Terms.cons (Term.lit (Lit.str "Unauthorized"))
                        (Terms.cons (Term.lit (Lit.str "not yours")) Terms.nil))))
                  ((Eff.perform (NativeOp.external 1) (Term.lit (Lit.nat id))).bind
                    (Eff.select (Term.var 2) Decision.option
                      (Eff.fail
                        (Term.app "pair"
                          (Terms.cons (Term.lit (Lit.str "NotFound"))
                            (Terms.cons (Term.lit (Lit.str idText)) Terms.nil))))
                      (Eff.succeed (Term.var 3)))))))).bind
        (Eff.succeed
          (Term.record [("status", false, Ty.nat), ("body", false, Ty.string)] ["status", "body"]
            (Terms.cons (Term.lit (Lit.nat 200))
              (Terms.cons (Term.field FieldReadMode.required (Term.var 0) "name") Terms.nil)))))
      (Eff.succeed
        (Term.record [("status", false, Ty.nat), ("body", false, Ty.string)] ["status", "body"]
          (Terms.cons (Term.lit (Lit.nat 401))
            (Terms.cons (Term.app "snd" (Terms.cons (Term.var 0) Terms.nil)) Terms.nil)))))
    (Eff.succeed
      (Term.record [("status", false, Ty.nat), ("body", false, Ty.string)] ["status", "body"]
        (Terms.cons (Term.lit (Lit.nat 404))
          (Terms.cons
            (Term.app "concat"
              (Terms.cons (Term.lit (Lit.str "no user "))
                (Terms.cons (Term.app "snd" (Terms.cons (Term.var 0) Terms.nil)) Terms.nil)))
            Terms.nil))))
