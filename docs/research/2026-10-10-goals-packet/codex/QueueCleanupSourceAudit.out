  Effect4.Api.Author.build (Test.Dogfood.Scenario.QueueWorkers.crew total) = Except.ok b →
    Effect4.Run.HistoryOf b compileFuel machine →
      (∀ (value : Effect4.Machine.Val),
          value ∈ Test.Dogfood.Scenario.QueueWorkers.Assertions.log machine →
            ∃ i, i ∈ [1, 2, 3] ∧ value = Effect4.Store.Val.nat i) ∧
        ∀ (i : Nat),
          i ∈ [1, 2, 3] →
            List.count (Effect4.Store.Val.nat i) (Test.Dogfood.Scenario.QueueWorkers.Assertions.log machine) ≤
              List.countP
                (Effect4.Program.ReleaseTrace.releaseAt (Test.Dogfood.Scenario.QueueWorkers.Assertions.acquirePath i))
                (machine.trace
                  (Effect4.Prim Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
                    Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
                  (Effect4.FrameFiber Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val
                    Effect4.Machine.Err Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
