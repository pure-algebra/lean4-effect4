  goal Effect4.Program.FinalizerRun.once_placed_pushes_once : ∀ (p : Effect4.Program.NativeEff) (table : Effect4.Program.RowTable) (cf : Nat) (m : Effect4.Program.NativeMachine)
  (q : List Nat),
  Effect4.Program.OncePlaced (Effect4.Program.Node.eff p) q = true →
    Effect4.Program.Guard.Reachable p table cf m →
      List.countP (Effect4.Program.FinalizerRun.registeredAt q)
          (m.trace
            (Effect4.Prim Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
              Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
            (Effect4.FrameFiber Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
              Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
            (Effect4.FrameEvent Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
              Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)) ≤
        1
  goal Test.Dogfood.Scenario.Atomic.Cleanup.log_debits : ∀ (b : Effect4.Api.Built) (m : Effect4.Program.NativeMachine),
  Effect4.Api.Author.build (Test.Dogfood.Scenario.Atomic.shop Test.Dogfood.Scenario.Atomic.Fault.none) = Except.ok b →
    Effect4.Run.HistoryOf b Test.Dogfood.Scenario.Atomic.budget.compileFuel m →
      (∀ (i : Nat),
          i ∈ (Test.Dogfood.Scenario.Atomic.Store.observeM m).cleaned → i ∈ Test.Dogfood.Scenario.Atomic.requests) ∧
        ∀ (i : Nat),
          i ∈ Test.Dogfood.Scenario.Atomic.requests →
            List.count i (Test.Dogfood.Scenario.Atomic.Store.observeM m).cleaned ≤
              List.countP (Effect4.Program.FinalizerRun.startedAt (Test.Dogfood.Scenario.Atomic.Cleanup.requestPath i))
                (m.trace
                  (Effect4.Prim Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val Effect4.Machine.Err
                    Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
                  (Effect4.FrameFiber Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val
                    Effect4.Machine.Err Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann)
                  (Effect4.FrameEvent Effect4.Program.EffName Effect4.Program.EffThunk Effect4.Machine.Val
                    Effect4.Machine.Err Effect4.Machine.Defect Effect4.FiberId Effect4.Machine.Ann))
