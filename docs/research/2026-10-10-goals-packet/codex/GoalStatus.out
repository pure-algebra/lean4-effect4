  goal Test.Dogfood.Scenario.Workers.Assertions.logs_step : ∀ (total cf : Nat) (b : Effect4.Api.Built) (m : Effect4.Program.NativeMachine)
  (x : Nat × Effect4.Program.NativeDecision),
  Effect4.Api.Author.build (Test.Dogfood.Scenario.Workers.crew total) = Except.ok b →
    Test.Dogfood.Scenario.Workers.Assertions.Holds b cf m →
      Effect4.Run.Accepted b.table (Effect4.Api.HostSession.callTable b.program b.table) m x.snd →
        Test.Dogfood.Scenario.Workers.Assertions.LogDebits (Effect4.Run.stepBy b m x)
