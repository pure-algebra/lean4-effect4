next goals: 1
  goal Effect4.Run.CallTree.request_leads : ∀ (s : Effect4.Run),
  s.Reached →
    Effect4.Program.Denote.StraightRows s.built.table s.built.program = true →
      Effect4.Run.CallTree.NoCauseHandler s.built.program = true →
        Effect4.Run.CallTree.NoClockRead s.built.program = true →
          ∀ (call : Effect4.Api.HostSession.Call) (token : Nat),
            Effect4.Program.requestOf s.machine call.fiber token = some (call.op, call.request) →
              ∃ i row tape frame stores,
                call.op = Effect4.Program.NativeOp.external i ∧
                  Effect4.Program.externalRow s.built.table i = some row ∧
                    (∀ (ex : Effect4.Machine.ExitV),
                        ex ∈ tape →
                          ∃ reply,
                            Effect4.Api.Runner.Command.submit reply ∈ s.journal ∧
                              reply.completion = Effect4.Machine.Completion.ofExit ex) ∧
                      Effect4.Program.Agreement.Leads (Effect4.Run.CallTree.admittedTapeHost s.built.table)
                          s.built.program
                          (Effect4.Program.Agreement.Pos.live
                            (Effect4.Program.Agreement.fiberOf
                              (Effect4.Program.compile s.built.program s.budget.compileFuel) [])
                            Effect4.Machine.Stores.empty)
                          tape (Effect4.Program.Agreement.Pos.live frame stores) [] ∧
                        Effect4.Program.Agreement.IsCall frame.current = true ∧
                          Effect4.Program.Agreement.callOf frame.current = some (i, call.request)
