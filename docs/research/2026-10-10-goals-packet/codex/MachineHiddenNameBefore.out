Effect4.Machine.ProgName.rec.{u} {motive : ProgName → Sort u} (value : (v : Val) → motive (ProgName.value v))
  (failCause : (cause : CauseV) → motive (ProgName.failCause cause))
  (syncOp : (op : SyncOp) → motive (ProgName.syncOp op))
  (yieldNow : (priority : Nat) → motive (ProgName.yieldNow priority))
  (park : (slot : Nat) → motive (ProgName.park slot))
  (awaitDeferred : (cell : DeferredKey) → motive (ProgName.awaitDeferred cell))
  (intoDeferred : (body : ProgName) → (cell : DeferredKey) → motive body → motive (body.intoDeferred cell))
  (intoBody : (body : ProgName) → (cell : DeferredKey) → motive body → motive (body.intoBody cell))
  (maskedPark : (slot : Nat) → motive (ProgName.maskedPark slot))
  (awaitFibers : (targets : List FiberId) → motive (ProgName.awaitFibers targets))
  (finalizerOf : (fin : FinName) → (exit : ExitV) → motive (ProgName.finalizerOf fin exit))
  (interruptDeferred : (cell : DeferredKey) → motive (ProgName.interruptDeferred cell))
  (onExitOf :
    (body : ProgName) →
      (fin : FinName) →
        (finalizerInterruptible : Bool) → motive body → motive (body.onExitOf fin finalizerInterruptible))
  (seqOf : (first second : ProgName) → motive first → motive second → motive (first.seqOf second))
  (forkThen :
    (child : ProgName) →
      (options : Supervision.ForkOptions) →
        (mode : Supervision.ObserverMode) → motive child → motive (child.forkThen options mode))
  (forkOnly : (child : ProgName) → (options : Supervision.ForkOptions) → motive child → motive (child.forkOnly options))
  (forkInScope :
    (child : ProgName) →
      (options : Supervision.ForkOptions) → (scope : Nat) → motive child → motive (child.forkInScope options scope))
  (runInScope : (target : FiberId) → (scope : Nat) → motive (ProgName.runInScope target scope))
  (forkScopedOf :
    (child : ProgName) → (options : Supervision.ForkOptions) → motive child → motive (child.forkScopedOf options))
  (raceOf : (race : RaceName) → motive (ProgName.raceOf race))
  (closeScopeOf : (scope : Nat) → (exit : ExitV) → motive (ProgName.closeScopeOf scope exit))
  (awaitAllNew : (body : ProgName) → motive body → motive body.awaitAllNew)
  (interruptFibers : (targets : List FiberId) → motive (ProgName.interruptFibers targets))
  (cancelRace : (race : Nat) → motive (ProgName.cancelRace race))
  (joinFiber : (target : FiberId) → (mode : Supervision.ObserverMode) → motive (ProgName.joinFiber target mode))
  (closeWalk :
    (strategy : FinalizerStrategy) →
      (order : List FinName) → (exit : ExitV) → motive (ProgName.closeWalk strategy order exit))
  (t : ProgName) : motive t
