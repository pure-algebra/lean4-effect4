def foldMap_ty {M : Type u} (unit : M) (op : M → M → M) (node : ProbeQ.Ty)
    (f_ty : ProbeQ.Ty → M := fun _ => unit) : M :=
  match node with
  | .never =>
    f_ty (.never)
  | .unit =>
    f_ty (.unit)
  | .nat =>
    f_ty (.nat)
  | .int =>
    f_ty (.int)
  | .string =>
    f_ty (.string)
  | .bool =>
    f_ty (.bool)
  | .handle a0 =>
    f_ty (.handle a0)
  | .option a0 =>
    op (f_ty (.option a0)) ((foldMap_ty unit op a0 f_ty))
  | .list a0 =>
    op (f_ty (.list a0)) ((foldMap_ty unit op a0 f_ty))
  | .prod a0 a1 =>
    op (f_ty (.prod a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .except a0 a1 =>
    op (f_ty (.except a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .exitOf a0 a1 =>
