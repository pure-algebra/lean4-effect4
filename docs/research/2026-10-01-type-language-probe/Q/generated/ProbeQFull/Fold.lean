termination_by structural xs
end

mutual
def foldMap_ty {M : Type u} (unit : M) (op : M → M → M) (node : ProbeQFull.Ty)
    (f_ty : ProbeQFull.Ty → M := fun _ => unit) : M :=
  match node with
  | .never =>
    f_ty (.never)
  | .unit =>
    f_ty (.unit)
  | .nat =>
    f_ty (.nat)
  | .int =>
    f_ty (.int)
  | .string =>
    f_ty (.string)
  | .bool =>
    f_ty (.bool)
  | .handle a0 =>
    f_ty (.handle a0)
  | .option a0 =>
    op (f_ty (.option a0)) ((foldMap_ty unit op a0 f_ty))
  | .list a0 =>
    op (f_ty (.list a0)) ((foldMap_ty unit op a0 f_ty))
  | .prod a0 a1 =>
    op (f_ty (.prod a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .except a0 a1 =>
    op (f_ty (.except a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .exitOf a0 a1 =>
    op (f_ty (.exitOf a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .causeOf a0 =>
    op (f_ty (.causeOf a0)) ((foldMap_ty unit op a0 f_ty))
  | .fiberOf a0 a1 =>
    op (f_ty (.fiberOf a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .union a0 a1 =>
    op (f_ty (.union a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .lit a0 =>
    f_ty (.lit a0)
  | .refOf a0 =>
    op (f_ty (.refOf a0)) ((foldMap_ty unit op a0 f_ty))
  | .deferredOf a0 a1 =>
    op (f_ty (.deferredOf a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
  | .var a0 =>
    f_ty (.var a0)
  | .unknown =>
    f_ty (.unknown)
  | .record a0 =>
    op (f_ty (.record a0)) ((foldMap_pos_list_prod_string_prod_ty_bool unit op a0 f_ty))
  | .map a0 a1 =>
    op (f_ty (.map a0 a1)) (op (foldMap_ty unit op a0 f_ty) ((foldMap_ty unit op a1 f_ty)))
termination_by structural node
def foldMap_pos_prod_ty_bool {M : Type u} (unit : M) (op : M → M → M) (x : ProbeQFull.Ty × Bool)
    (f_ty : ProbeQFull.Ty → M := fun _ => unit) : M :=
  match x with
  | (u, _) => (foldMap_ty unit op u f_ty)
termination_by structural x
def foldMap_pos_prod_string_prod_ty_bool {M : Type u} (unit : M) (op : M → M → M) (x : String × ProbeQFull.Ty × Bool)
    (f_ty : ProbeQFull.Ty → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_pos_prod_ty_bool unit op v f_ty)
termination_by structural x
def foldMap_pos_list_prod_string_prod_ty_bool {M : Type u} (unit : M) (op : M → M → M) (xs : List (String × ProbeQFull.Ty × Bool))
    (f_ty : ProbeQFull.Ty → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_string_prod_ty_bool unit op x f_ty) (foldMap_pos_list_prod_string_prod_ty_bool unit op rest f_ty)
termination_by structural xs
end


