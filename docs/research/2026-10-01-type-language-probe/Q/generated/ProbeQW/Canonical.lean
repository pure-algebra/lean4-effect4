theorem fitsP0 (p : @_root_.Prod (_root_.ProbeQW.Ty) (_root_.Bool)) :
    acceptsIn defs (.pair (.named "Ty") ((shape _root_.Bool).root))
      (toValP0 p) = true := by
  match p with
  | (x, y) =>
    exact accepts_pair _ _ _ _ _
      (fitsTy x) (lift_Bool y)
termination_by structural p
theorem fitsP1 (p : @_root_.Prod (_root_.String) (@_root_.Prod (_root_.ProbeQW.Ty) (_root_.Bool))) :
    acceptsIn defs (.pair ((shape _root_.String).root) (.pair (.named "Ty") ((shape _root_.Bool).root)))
      (toValP1 p) = true := by
  match p with
  | (x, y) =>
    exact accepts_pair _ _ _ _ _
      (lift_String x) (fitsP0 y)
termination_by structural p
theorem fitsL2 (xs : @_root_.List (@_root_.Prod (_root_.String) (@_root_.Prod (_root_.ProbeQW.Ty) (_root_.Bool)))) :
    ∀ v ∈ toValL2 xs,
      acceptsIn defs (.pair ((shape _root_.String).root) (.pair (.named "Ty") ((shape _root_.Bool).root))) v = true := by
  match xs with
  | [] =>
    intro v hv
    exact nomatch hv
  | x :: xs =>
    intro v hv
    simp only [toValL2, List.mem_cons] at hv
    rcases hv with rfl | hv
    · exact fitsP1 x
    · exact fitsL2 xs v hv
termination_by structural xs
theorem fitsL3 (xs : @_root_.List (_root_.ProbeQW.Ty)) :
    ∀ v ∈ toValL3 xs,
      acceptsIn defs (.named "Ty") v = true := by
