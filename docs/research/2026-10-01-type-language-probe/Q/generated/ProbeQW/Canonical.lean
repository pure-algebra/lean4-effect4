  | [] =>
    intro v hv
    exact nomatch hv
  | x :: xs =>
    intro v hv
    simp only [toValL3, List.mem_cons] at hv
    rcases hv with rfl | hv
    · exact fitsTy x
    · exact fitsL3 xs v hv
termination_by structural xs
end

