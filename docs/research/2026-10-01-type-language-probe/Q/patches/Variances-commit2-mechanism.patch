+/-! ## The order's exceptional rules
+
+`sub`'s rules beside its congruences, in one list, so the view generator and the core read the
+same rows: the five structural cases in the order `sub`'s arms take them, then the declared leaf
+edges (a cross-head pair a leaf of `Ty` is below). An edge names a pattern on each side, both
+leaves (no `Ty` child), the heads distinct; the edges must be transitively closed, which the view
+proves (`edgeRule_trans`) and this driver checks. The wave's edges are the census's (T §2.3):
+`undefined ⊑ unit` (row 160) and the number tower `nat ⊑ int ⊑ number` (rows 121, 109; seat P's
+question 3); `lit ⊑ string` is today's literal rule, now a row. -/
+
+/-- One rule: a structural case of `sub`, or a leaf edge `left ⊑ right` (patterns on `Ty`). -/
+inductive Rule where
+  | refl | never | unionLeft | unionRight | top
+  | edge (name left right : String)
+
+/-- The one hand list of the order's rules (seat Q's probe of the wave). -/
+def rules : List Rule :=
+  [] -- commit 2: the mechanism only; the rows land with the append (commit 4)
+
+def ruleJson : Rule → Json
+  | .refl => Json.mkObj [("rule", Json.str "refl")]
+  | .never => Json.mkObj [("rule", Json.str "never")]
+  | .unionLeft => Json.mkObj [("rule", Json.str "unionLeft")]
+  | .unionRight => Json.mkObj [("rule", Json.str "unionRight")]
+  | .top => Json.mkObj [("rule", Json.str "top")]
+  | .edge n l r => Json.mkObj [("rule", Json.str "edge"), ("name", Json.str n),
+      ("left", Json.str l), ("right", Json.str r)]
+
+/-- The edges' head names (the pattern's constructor), for the closure check. -/
+def headOf (pat : String) : String :=
+  ((pat.drop 1).toString.splitOn " ").headD ""
+
+/-- The edges are transitively closed: `a ⊑ b` and `b ⊑ c` declare `a ⊑ c`. -/
+def closureGaps : List String := Id.run do
+  let es := rules.filterMap fun r => match r with
+    | .edge _ l rt => some (headOf l, headOf rt)
+    | _ => none
+  let mut gaps : List String := []
+  for (a, b) in es do
+    for (b', c) in es do
+      if b == b' && !es.contains (a, c) then gaps := gaps ++ [s!"{a} ⊑ {b} ⊑ {c} lacks {a} ⊑ {c}"]
+  return gaps
 
