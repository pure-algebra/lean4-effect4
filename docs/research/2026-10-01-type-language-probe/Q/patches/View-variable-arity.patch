+  if b.isAppOfArity ``Prod 2 && b.appFn!.appArg!.isConstOf root then
+    let p ← srcOf b.appArg!
+    if knownElemPayload.contains p then
+      return some (".2.1", [(".1", "String"), (".2.2", p)], "String × {M} × " ++ p)
+  return none
