+/-- The declared variances as a core Lean module (`--lean-out`, `--lean-namespace`): the
+`Variance` the order reads, its two readings, and the table of every declaration read here by
+`Module.Name`, so a `sub` arm over a nominal reference reads variance as data, not as an arm
+written by hand. A parameter with no modifier (`none`) reads invariant, the conservative
+direction. Declared under `<ns>.Ty` so the names the view's consumers use (`Ty.Variance`,
+`Ty.Variance.holds`) do not move. -/
+def leanModule (r : Read) (ns : String) : String := Id.run do
+  let word : Variance → String := fun v => match v with
+    | .co => ".co" | .contra => ".contra" | _ => ".inv"
+  let mut rows : List String := []
+  let mut seen : List String := []
+  for (d, ps, _) in r.resolved do
+    if ps.isEmpty then continue
+    let key := s!"{d.«module»}.{d.name}"
+    if seen.contains key then continue
+    seen := seen ++ [key]
+    rows := rows ++ [s!"  | \"{key}\" => [" ++ String.intercalate ", " (ps.map fun p => word p.variance) ++ "]"]
+  let lines : List String :=
+    [ "-- GENERATED by tools/Tools/Variances.lean from the vendored Effect sources; do not edit",
+      "",
+      "/-!",
+      "# The declared variance of rc.112's generic declarations, as data the core reads",
+      "",
+      s!"Read off `{root}` ({version}) by the variance driver, beside `variances.json`. A",
+      "reference to a declaration (`app name args`) is ordered argument by argument at the",
+      "declared variance, so `sub` reads this table rather than an arm per declaration.",
+      "-/",
+      "",
+      s!"namespace {ns}.Ty",
+      "",
+      "/-- How a relation reads a type argument: rc.112's declaration-site modifier. -/",
+      "inductive Variance where",
+      "  | co",
+      "  | contra",
+      "  | inv",
+      "deriving DecidableEq, Repr",
+      "",
+      "/-- A Boolean relation lifted through a variance. -/",
+      "def Variance.holds {α : Type} (r : α → α → Bool) : Variance → α → α → Bool",
+      "  | .co,     x, y => r x y",
+      "  | .contra, x, y => r y x",
+      "  | .inv,    x, y => r x y && r y x",
+      "",
+      "/-- The same reading with both directions already computed: what a well-founded `sub` calls,",
+      "since it cannot pass itself to `holds` unapplied. -/",
+      "def Variance.select : Variance → Bool → Bool → Bool",
+      "  | .co, xy, _ => xy",
+      "  | .contra, _, yx => yx",
+      "  | .inv, xy, yx => xy && yx",
+      "",
+      "theorem Variance.holds_eq_select {α : Type} (r : α → α → Bool) (v : Variance) (x y : α) :",
+      "    v.holds r x y = v.select (r x y) (r y x) := by",
+      "  cases v <;> rfl",
+      "",
+      "/-- Every generic declaration of the vendored sources, by `Module.Name`, with the variance of",
+      "each parameter; `[]` for a name not declared there. -/",
+      "def declaredVariance : String → List Variance" ] ++ rows ++
+    [ "  | _ => []",
+      "",
+      "/-- Argument `i` of a reference to `name`: its declared variance, invariant where none is",
+      "declared. -/",
+      "def argVariance (name : String) (i : Nat) : Variance := ((declaredVariance name)[i]?).getD .inv",
+      "",
+      s!"end {ns}.Ty",
+      "" ]
+  return String.intercalate "\n" lines
+
 end Tools.Variances
 
