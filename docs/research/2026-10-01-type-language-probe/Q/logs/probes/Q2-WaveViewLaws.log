sub_eq_args : ∀ (a b : Ty),
  a.isMember = true →
    b.isMember = true → a.litRule b = false → a.topRule b = false → a.sub b = (a.sameHead b && argsBelow sub a b)
args : Ty → List (Variance × Ty)
sub_args_record : ∀ (fs gs : List (String × Ty × Bool)),
  (record fs).sameHead (record gs) = true → (record fs).sub (record gs) = argsBelow sub (record fs) (record gs)
sub_args_tuple : ∀ (xs ys : List Ty),
  (tuple xs).sameHead (tuple ys) = true → (tuple xs).sub (tuple ys) = argsBelow sub (tuple xs) (tuple ys)
sub_args_app : ∀ (n1 : String) (xs : List Ty) (n2 : String) (ys : List Ty),
  (app n1 xs).sameHead (app n2 ys) = true → (app n1 xs).sub (app n2 ys) = argsBelow sub (app n1 xs) (app n2 ys)
@eq_of_sameHead : ∀ {a b : Ty},
  a.sameHead b = true →
    List.map Prod.snd a.args = List.map Prod.snd b.args → a.headCanon = true → b.headCanon = true → a = b
