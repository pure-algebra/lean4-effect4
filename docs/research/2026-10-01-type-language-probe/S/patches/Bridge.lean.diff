+def Ty.schemaWf : Ty → Bool
+  | .optKey _ => false
+  | .handle s => !(s = "effect/schema/TypeParameter")
+  | .record fs => (Ty.firstRepeat fs []).isNone && Ty.schemaWfFields fs
+  | .map .string v => Ty.schemaWf v
+  | .map _ _ => false
