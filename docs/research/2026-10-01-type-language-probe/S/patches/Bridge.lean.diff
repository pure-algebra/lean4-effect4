+theorem ofSchemaExact_schema (t : Ty) (hc : t.closed = true) (hw : t.schemaWf = true) :
+    ofSchemaExact (schema t) = .ok t := by
+  unfold ofSchemaExact
+  rw [ofSchemaLocated_schema t hc hw]
+  simp only [↓reduceIte]
