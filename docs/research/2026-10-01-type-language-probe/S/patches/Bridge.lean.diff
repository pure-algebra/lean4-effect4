+    else if id = "effect/schema/Deferred" then do
+      let tv ← under "typeParameters[0]" (ofSchemaLocated x)
+      let te ← under "typeParameters[1]" (ofSchemaLocated y)
+      .ok (.deferredOf tv te)
+    else if id = "effect/schema/Cause" && isDefect y then
