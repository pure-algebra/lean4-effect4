+/-- A struct's properties, in written order; `isOptional` reads as the optional-key modifier. -/
+def readProps : List PropertySignature → Read (List (String × Ty))
+  | [] => .ok []
+  | ⟨.string n, t, opt, isMut, a⟩ :: ps => do
