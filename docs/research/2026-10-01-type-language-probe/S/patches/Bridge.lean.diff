+  | .prod a b | .except a b | .exitOf a b | .fiberOf a b | .union a b | .deferredOf a b =>
+    Ty.schemaWf a && Ty.schemaWf b
+  | _ => true
+def Ty.schemaWfFields : List (String × Ty) → Bool
+  | [] => true
+  | (_, t) :: fs => (match t with | .optKey u => Ty.schemaWf u | t' => Ty.schemaWf t') && Ty.schemaWfFields fs
+end
