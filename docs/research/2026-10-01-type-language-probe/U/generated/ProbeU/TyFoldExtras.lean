      h_ty_fiberOf := fun _ _ => rfl
      h_ty_union := fun _ _ => rfl
      h_ty_lit := fun _ => rfl
      h_ty_refOf := fun _ => rfl
      h_ty_deferredOf := fun _ _ => rfl
      h_ty_var := fun _ => rfl
      h_ty_unknown := rfl } t).symm


