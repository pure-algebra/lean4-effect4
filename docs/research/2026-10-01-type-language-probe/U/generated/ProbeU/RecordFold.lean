    f_recordty (.lit a0)
  | .refOf a0 =>
    op (f_recordty (.refOf a0)) ((foldMap_recordty unit op a0 f_recordty))
  | .deferredOf a0 a1 =>
    op (f_recordty (.deferredOf a0 a1)) (op (foldMap_recordty unit op a0 f_recordty) ((foldMap_recordty unit op a1 f_recordty)))
  | .var a0 =>
    f_recordty (.var a0)
  | .unknown =>
    f_recordty (.unknown)
  | .record a0 =>
    op (f_recordty (.record a0)) ((foldMap_pos_list_prod_string_recordty unit op a0 f_recordty))
termination_by structural node
def foldMap_pos_prod_string_recordty {M : Type u} (unit : M) (op : M → M → M) (x : String × ProbeU.RecordTy)
    (f_recordty : ProbeU.RecordTy → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_recordty unit op v f_recordty)
termination_by structural x
def foldMap_pos_list_prod_string_recordty {M : Type u} (unit : M) (op : M → M → M) (xs : List (String × ProbeU.RecordTy))
    (f_recordty : ProbeU.RecordTy → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_string_recordty unit op x f_recordty) (foldMap_pos_list_prod_string_recordty unit op rest f_recordty)
termination_by structural xs
end


