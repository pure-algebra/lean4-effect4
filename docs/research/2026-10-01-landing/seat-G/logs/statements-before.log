            Effect4.Program.Guard.OuterDriver.Preserved acc.fst
              (List.foldl (Effect4.Machine.fireStep (Effect4.Program.interpOf p table) fuel owner) acc tasks).fst :=
fun p table driver fuel owner tasks acc state keys sites =>
  List.rec (motive := fun tasks =>
    ∀ (acc : Effect4.Program.NativeMachine × Bool),
      Effect4.Program.Guard.GuardState acc.fst →
        Effect4.Program.Guard.ReservedKeys acc.fst (List.flatMap Effect4.Program.Guard.taskKeys tasks) →
          (∀ (task : Effect4.Program.Guard.NTask), task ∈ tasks → Effect4.Program.Guard.taskRaceSites task = []) →
            Effect4.Program.Guard.OuterDriver.Preserved acc.fst
              (List.foldl (Effect4.Machine.fireStep (Effect4.Program.interpOf p table) fuel owner) acc tasks).fst)
    (fun acc state keys sites => Effect4.Program.Guard.OuterDriver.Preserved.refl state)
    (fun task tasks ih acc state keys sites =>
      have head :=
        Effect4.Program.Guard.OuterDriver.fireStep_preserved p table driver fuel owner acc task state
          (Effect4.Program.Guard.reservedKeys_subset keys
            (List.subset_append_left (Effect4.Program.Guard.taskKeys task)
              (List.map Effect4.Program.Guard.taskKeys tasks).flatten))
          (sites task List.mem_cons_self);
      have tail :=
        ih (Effect4.Machine.fireStep (Effect4.Program.interpOf p table) fuel owner acc task) head.state
          (head.reserved (List.flatMap Effect4.Program.Guard.taskKeys tasks)
            (Effect4.Program.Guard.reservedKeys_subset keys
              (List.subset_append_right (Effect4.Program.Guard.taskKeys task)
                (List.flatMap Effect4.Program.Guard.taskKeys tasks))))
          fun t ht => sites t (List.mem_cons_of_mem task ht);
      Effect4.Program.Guard.OuterDriver.Preserved.trans head tail)
