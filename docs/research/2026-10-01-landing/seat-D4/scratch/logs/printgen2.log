def Effect4.Program.Typed.ScopeStateOk : {W : Type} →
  Preds W →
    W →
      Expect →
        Effect4.ScopeState Nat Effect4.Machine.FinName Effect4.Machine.Val Effect4.Machine.Err Effect4.Machine.Defect
            Effect4.FiberId Effect4.Machine.Ann →
          Prop :=
fun {W} P w e x =>
  match x with
  | Effect4.ScopeState.empty => True
  | Effect4.ScopeState.openEmpty => True
  | Effect4.ScopeState.openInline key finalizer => P.FinalizerOk w e finalizer ∧ FinNameOk P w e finalizer
  | Effect4.ScopeState.openMap entries =>
    (∀ (v0 : Nat × Effect4.Machine.FinName), v0 ∈ entries → P.FinalizerOk w e v0.snd) ∧
      ∀ (v0 : Nat × Effect4.Machine.FinName), v0 ∈ entries → FinNameOk P w e v0.snd
  | Effect4.ScopeState.closed exit => P.ScopeExitOk w e exit
def Effect4.Program.Typed.FinNameOk : {W : Type} → Preds W → W → Expect → Effect4.Machine.FinName → Prop :=
fun {W} P w e x =>
  match x with
  | Effect4.Machine.FinName.interruptFiber fiber skipSelf => True
  | Effect4.Machine.FinName.closeChildScope scope => True
  | Effect4.Machine.FinName.detachFromParent parent key => True
  | Effect4.Machine.FinName.release label fails => True
  | Effect4.Machine.FinName.awaitNewChildren snapshot => True
  | Effect4.Machine.FinName.parkThen slot => True
  | Effect4.Machine.FinName.foreign capture => CaptureOk P w e capture
  | Effect4.Machine.FinName.closeChildOnFailure scope => True
  | Effect4.Machine.FinName.memoEntry layer memoMap => True
  | Effect4.Machine.FinName.memoDone layer memoMap => True
