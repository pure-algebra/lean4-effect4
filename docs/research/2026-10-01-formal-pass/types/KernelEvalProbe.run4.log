def Effect4.Machine.RunFiber.make.{u, v} : {ν σ : Type u} →
  {β : Type v} →
    {ε δ ι α χ : Type u} →
      {κ φ : Type (max u v)} →
        [core : Machine.FiberCore ν β ε δ ι α κ φ] →
          FiberId → κ → Bool → Nat × Bool → χ → Machine.RunFiber ν σ β ε δ ι α χ κ φ :=
fun {ν σ} {β} {ε δ ι α χ} {κ φ} [Machine.FiberCore ν β ε δ ι α κ φ] id current interruptible budget context =>
  { id := id, frame := Machine.FiberCore.start ν β ε δ ι α current interruptible, running := false,
    parked := Machine.Parked.notParked, pending := [], finalizing := none, exit := none, currentOpCount := 0,
    maxOpsBeforeYield := budget.fst, preventYield := budget.snd, yieldOverride := none, observers := [], children := [],
    dispatcher := Machine.Dispatcher.empty, context := context }
