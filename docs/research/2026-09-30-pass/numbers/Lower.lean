import OCaml5.Lcnf.Translate
import OCaml5.Ml.Render

/-! # Numbers seat, probe 9: what the project's own LCNF translator makes of three additions

Research evidence, outside the Test root. Base `be15b062`. A reading aid, not a proof: the
translator (`OCaml5.Lcnf.translateClosure`, the one `make gen-lcnf` runs) is applied to three
small Lean functions defined here, and the OCaml it writes is printed (`lower.log`).

* `plainAdd`: the atom's arithmetic as the machine writes it (`a + b`);
* `postAdd`: compute, then check against the bound (blind on OCaml, `mlAdd_postcheck_blind`);
* `preAdd`: check, then compute (`evalIn`'s form; exact on OCaml, `mlAdd_under_check`). -/

set_option autoImplicit false

namespace Research.Pass.Numbers.Lower

def plainAdd (a b : Nat) : Nat := a + b

def postAdd (bound a b : Nat) : Option Nat :=
  let s := a + b
  if s ≤ bound then some s else none

def preAdd (bound a b : Nat) : Option Nat :=
  if a ≤ bound - b then some (a + b) else none

def preMul (bound a b : Nat) : Option Nat :=
  if b = 0 ∨ a ≤ bound / b then some (a * b) else none

open Lean OCaml5 OCaml5.Lcnf in
#eval show CoreM Unit from do
  let c ← translateClosure #[``plainAdd, ``postAdd, ``preAdd, ``preMul] 10
  IO.println s!"translated {c.decls.size}, missing {c.missing}, todos {c.todos}"
  match emit c.decls with
  | .ok ds =>
    let text := Ml.moduleText ds
    IO.println text
    -- The same text plus a driver, compiled and run under the lock (`ocaml/lower.log`).
    IO.FS.writeFile "docs/research/2026-09-30-pass/numbers/ocaml/lower.ml" (
      "(* GENERATED by ../Lower.lean through OCaml5.Lcnf.translateClosure, plus a driver. *)\n" ++
      text ++ "\n" ++
      "let show = function None -> \"None\" | Some n -> \"Some \" ^ string_of_int n\n" ++
      "let () =\n" ++
      "  let a = 2305843009213693952 and b = 2305843009213693957 in\n" ++
      "  Printf.printf \"bound max_int, 2^61 + (2^61 + 5): plain %d, post %s, pre %s\\n\"\n" ++
      "    (research_pass_numbers_lower_plain_add a b)\n" ++
      "    (show (research_pass_numbers_lower_post_add max_int a b))\n" ++
      "    (show (research_pass_numbers_lower_pre_add max_int a b));\n" ++
      "  let bound = 9007199254740991 in\n" ++
      "  Printf.printf \"bound 2^53-1, 2^52 + (2^52 + 1): post %s, pre %s\\n\"\n" ++
      "    (show (research_pass_numbers_lower_post_add bound 4503599627370496 4503599627370497))\n" ++
      "    (show (research_pass_numbers_lower_pre_add bound 4503599627370496 4503599627370497));\n" ++
      "  Printf.printf \"bound max_int, (2^53 + 1) * 512: pre_mul %s; 2^31 * 2^30: pre_mul %s\\n\"\n" ++
      "    (show (research_pass_numbers_lower_pre_mul max_int 9007199254740993 512))\n" ++
      "    (show (research_pass_numbers_lower_pre_mul max_int 2147483648 1073741824))\n")
  | .error e => IO.println s!"emit refused: {e}"

end Research.Pass.Numbers.Lower
