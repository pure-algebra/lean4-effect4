  name : String
  request : Ty
  answer : Ty
  error : Ty := .never
  requires : List ServiceKey := []
  role : DefRole := .plain
deriving DecidableEq, Repr

def DefDecl.effTy (d : DefDecl) : EffTy := ⟨d.answer, d.error, Requirement.ofList d.requires⟩

