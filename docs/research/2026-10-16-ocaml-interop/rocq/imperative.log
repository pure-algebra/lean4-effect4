# An imperative host through rocq-of-ocaml: the record write is refused, and Hashtbl.replace becomes a pure call whose result is dropped.
$ cat table.ml
type t = { mutable next : int; rows : (int, string * bool) Hashtbl.t }
let insert (title : string) (h : t) : int =
  let id = h.next in
  Hashtbl.replace h.rows id (title, false);
  h.next <- id + 1;
  id
$ opam exec --switch=rocq -- rocq-of-ocaml -output Table.v table.ml
