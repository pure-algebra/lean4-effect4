## 8. The declarations todo_gen.ml lowers again (the closures the generator writes)
$ cd ocaml/gen && python3 -c "import sys; n=lambda p: {l.split(chr(9))[0] for l in open(p) if not l.startswith((chr(35),\"lean\"))}; t,a,e=n(\"closure-todo_gen.tsv\"),n(\"closure-api_gen.tsv\"),n(\"closure-api_engine.tsv\"); print(\"todo_gen\",len(t),\"api_gen\",len(a),\"api_engine\",len(e),\"todo_gen and api_gen\",len(t&a),\"todo_gen only\",len(t-a-e))"
