+/-- Where the detector reads no join at a term, the term has a type, and it is no proper union. -/
+theorem properAt_false {sig : Signature Op} {env : TyEnv} {const : Bool} {t : Term}
+    (h : PrintEliminators.properAt sig env const t = false) :
+    ∃ ty, argTy sig env const t = some ty ∧ PrintEliminators.proper ty = false := by
+  unfold PrintEliminators.properAt at h
+  cases hty : argTy sig env const t with
+  | none => rw [hty] at h; cases h
+  | some ty => exact ⟨ty, rfl, by simpa only [hty, Option.map_some, Option.getD_some] using h⟩
+
+mutual
+/-- **Where the join detector finds no join, the typed term is the term's print.** -/
+theorem term_plain (sig : Signature Op) : ∀ (t : Term) (env : TyEnv) (const : Bool) (x : Expr),
+    (cata_term (PrintEliminators.termJoinAlg sig) t).2 env const = false →
+    (cata_term (PrintEliminators.termAlg sig) t).2 env const = .ok x →
+    x = printTerm env.length t
+  | .var index, env, const, x, _, printed => by
+    simp only [cata_term, PrintEliminators.termAlg, Except.ok.injEq] at printed
+    subst x
+    rfl
+  | .lit value, env, const, x, _, printed => by
+    simp only [cata_term, PrintEliminators.termAlg, Except.ok.injEq] at printed
+    subst x
+    rfl
+  | .app name args, env, const, x, noJoin, printed => by
+    have ihArgs := terms_plain sig args env (sig.constAtom name)
+    have hc := typedTerms_original sig args
+    have hj := joinTerms_original sig args
+    simp only [cata_term] at printed noJoin
+    generalize cata_terms (PrintEliminators.termAlg sig) args = c at printed hc ihArgs
+    generalize cata_terms (PrintEliminators.termJoinAlg sig) args = j at noJoin hj ihArgs
+    simp only [PrintEliminators.termAlg] at printed
+    simp only [PrintEliminators.termJoinAlg] at noJoin
+    obtain ⟨values, hvalues, printed⟩ := bind_eq_ok.mp printed
+    rw [hc] at printed
+    rw [hj] at noJoin
+    -- the children carry no join, in every branch of the detector
+    have children : j.snd env (sig.constAtom name) = false := by
+      revert noJoin
+      split
+      · split
+        · intro h
+          exact (Bool.or_eq_false_iff.mp h).1
+        · exact id
+      · split
+        · split
+          · intro h
+            exact (Bool.or_eq_false_iff.mp (Bool.or_eq_false_iff.mp h).1).1
+          · exact id
+        · exact id
+    have hargs := ihArgs values children hvalues
+    show x = Expr.call (.ident name) (printTerms env.length args)
+    rw [← hargs]
+    cases hcause : ["causeIsFail", "causeIsDie", "causeIsInterrupt", "causeError"].contains name with
+    | true =>
+      rw [hcause, if_pos rfl] at printed noJoin
+      rcases args with _ | ⟨input, _ | ⟨second, rest⟩⟩
+      · simp only [pure_eq_ok] at printed
+        exact printed.symm
+      · obtain ⟨ty, hty, plainTy⟩ := properAt_false (Bool.or_eq_false_iff.mp noJoin).2
+        simp only [termTy, hty, PrintEliminators.need, plainTy, Bool.false_eq_true, ↓reduceIte,
+          ok_bind] at printed
+        simp only [pure_eq_ok] at printed
+        exact printed.symm
+      · simp only [pure_eq_ok] at printed
+        exact printed.symm
+    | false =>
+      rw [hcause, if_neg Bool.false_ne_true] at printed noJoin
+      cases hproduct : ["pair", "tuple"].contains name with
+      | true =>
+        rw [hproduct, if_pos rfl] at printed noJoin
+        rcases args with _ | ⟨first, _ | ⟨second, _ | ⟨third, rest⟩⟩⟩
+        · simp only [pure_eq_ok] at printed
+          exact printed.symm
+        · simp only [pure_eq_ok] at printed
+          exact printed.symm
+        · obtain ⟨⟨_, firstPlain⟩, secondPlain⟩ :=
+            (Bool.or_eq_false_iff.mp noJoin).imp_left Bool.or_eq_false_iff.mp
+          obtain ⟨ty1, hty1, plain1⟩ := properAt_false firstPlain
+          obtain ⟨ty2, hty2, plain2⟩ := properAt_false secondPlain
+          simp only [hty1, hty2, PrintEliminators.need, plain1, plain2, Bool.or_self,
+            Bool.false_eq_true, ↓reduceIte, ok_bind] at printed
+          simp only [pure_eq_ok] at printed
+          exact printed.symm
+        · simp only [pure_eq_ok] at printed
+          exact printed.symm
+      | false =>
+        rw [hproduct, if_neg Bool.false_ne_true] at printed
+        simp only [pure_eq_ok] at printed
+        exact printed.symm
+  | .record fields names values, env, const, x, noJoin, printed => by
+    have ihValues := terms_plain sig values env true
+    have hc := typedTerms_original sig values
+    simp only [cata_term] at printed noJoin
+    generalize cata_terms (PrintEliminators.termAlg sig) values = c at printed hc ihValues
+    generalize cata_terms (PrintEliminators.termJoinAlg sig) values = j at noJoin ihValues
+    simp only [PrintEliminators.termAlg] at printed
+    simp only [PrintEliminators.termJoinAlg] at noJoin
+    obtain ⟨children, hchildren, printed⟩ := bind_eq_ok.mp printed
+    have hvalues := ihValues children noJoin hchildren
+    rw [hc] at printed
+    show x = printTerm env.length (.record fields names values)
+    simp only [printTerm]
+    cases htag : Classes.classTag? fields names values with
+    | none =>
+      rw [htag] at printed
+      simp only [pure_eq_ok] at printed
+      rw [← printed, hvalues]
+    | some tag =>
+      rw [htag] at printed
+      simp only [pure_eq_ok] at printed
+      rw [← printed, hvalues]
+  | .field mode receiver name, env, const, x, noJoin, printed => by
+    have ih := term_plain sig receiver env false
+    have hc := typedTerm_original sig receiver
+    have hj := joinTerm_original sig receiver
+    simp only [cata_term] at printed noJoin
+    generalize cata_term (PrintEliminators.termAlg sig) receiver = c at printed hc ih
+    generalize cata_term (PrintEliminators.termJoinAlg sig) receiver = j at noJoin hj ih
+    simp only [PrintEliminators.termAlg] at printed
+    simp only [PrintEliminators.termJoinAlg] at noJoin
+    rw [hj] at noJoin
+    obtain ⟨childPlain, plainTy⟩ := Bool.or_eq_false_iff.mp noJoin
+    obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hv := ih value childPlain hvalue
+    rw [hc] at printed
+    obtain ⟨ty, hty, notProper⟩ := properAt_false plainTy
+    simp only [termTy, hty, PrintEliminators.need, notProper, Bool.false_eq_true, ↓reduceIte,
+      ok_bind] at printed
+    simp only [pure_eq_ok] at printed
+    rw [← printed, hv]
+    rfl
+  | .recordSet receiver name value, env, const, x, noJoin, printed => by
+    have ihReceiver := term_plain sig receiver env false
+    have ihValue := term_plain sig value env true
+    have hcr := typedTerm_original sig receiver
+    have hcv := typedTerm_original sig value
+    have hjr := joinTerm_original sig receiver
+    have hjv := joinTerm_original sig value
+    simp only [cata_term] at printed noJoin
+    generalize cata_term (PrintEliminators.termAlg sig) receiver = cr at printed hcr ihReceiver
+    generalize cata_term (PrintEliminators.termAlg sig) value = cv at printed hcv ihValue
+    generalize cata_term (PrintEliminators.termJoinAlg sig) receiver = jr at noJoin hjr ihReceiver
+    generalize cata_term (PrintEliminators.termJoinAlg sig) value = jv at noJoin hjv ihValue
+    simp only [PrintEliminators.termAlg] at printed
+    simp only [PrintEliminators.termJoinAlg] at noJoin
+    rw [hjr, hjv] at noJoin
+    obtain ⟨⟨⟨receiverPlain, valuePlain⟩, receiverTyPlain⟩, valueTyPlain⟩ :=
+      (Bool.or_eq_false_iff.mp noJoin).imp_left fun h =>
+        (Bool.or_eq_false_iff.mp h).imp_left Bool.or_eq_false_iff.mp
+    obtain ⟨printedReceiver, hreceiver, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨printedValue, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hr := ihReceiver printedReceiver receiverPlain hreceiver
+    have hv := ihValue printedValue valuePlain hvalue
+    rw [hcr, hcv] at printed
+    obtain ⟨ty1, hty1, plain1⟩ := properAt_false receiverTyPlain
+    obtain ⟨ty2, hty2, plain2⟩ := properAt_false valueTyPlain
+    simp only [termTy, hty1, hty2, PrintEliminators.need, plain1, plain2, Bool.or_self,
+      Bool.false_eq_true, ↓reduceIte, ok_bind] at printed
+    simp only [pure_eq_ok] at printed
+    rw [← printed, hr, hv]
+    rfl
+  | .tupleAt receiver index, env, const, x, noJoin, printed => by
+    have ih := term_plain sig receiver env false
+    simp only [cata_term] at printed noJoin
+    generalize cata_term (PrintEliminators.termAlg sig) receiver = c at printed ih
+    generalize cata_term (PrintEliminators.termJoinAlg sig) receiver = j at noJoin ih
+    simp only [PrintEliminators.termAlg] at printed
+    simp only [PrintEliminators.termJoinAlg] at noJoin
+    obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hv := ih value noJoin hvalue
+    simp only [pure_eq_ok] at printed
+    rw [← printed, hv]
+    rfl
+  | .fold stored list init body, env, const, x, noJoin, printed => by
+    have ihList := term_plain sig list env false
+    have ihInit := term_plain sig init env false
+    have ihBody := term_plain sig body
+    have hcl := typedTerm_original sig list
+    have hci := typedTerm_original sig init
+    have hjl := joinTerm_original sig list
+    have hji := joinTerm_original sig init
+    simp only [cata_term] at printed noJoin
+    generalize cata_term (PrintEliminators.termAlg sig) list = cl at printed hcl ihList
+    generalize cata_term (PrintEliminators.termAlg sig) init = ci at printed hci ihInit
+    generalize cata_term (PrintEliminators.termAlg sig) body = cb at printed ihBody
+    generalize cata_term (PrintEliminators.termJoinAlg sig) list = jl at noJoin hjl ihList
+    generalize cata_term (PrintEliminators.termJoinAlg sig) init = ji at noJoin hji ihInit
+    generalize cata_term (PrintEliminators.termJoinAlg sig) body = jb at noJoin ihBody
+    simp only [PrintEliminators.termAlg] at printed
+    simp only [PrintEliminators.termJoinAlg] at noJoin
+    rw [hjl, hji] at noJoin
+    rw [hcl, hci] at printed
+    cases hlistTy : termTy sig env list with
+    | none => rw [hlistTy] at noJoin; cases noJoin
+    | some listTy =>
+      cases hinitTy : termTy sig env init with
+      | none => rw [hlistTy, hinitTy] at noJoin; cases noJoin
+      | some initTy =>
+        cases hitem : Checker.listOf? listTy with
+        | none => rw [hlistTy, hinitTy] at noJoin; dsimp only at noJoin; rw [hitem] at noJoin; cases noJoin
+        | some item =>
+          rw [hlistTy, hinitTy] at noJoin
+          dsimp only at noJoin
+          rw [hitem] at noJoin
+          dsimp only at noJoin
+          simp only [Bool.or_eq_false_iff] at noJoin
+          obtain ⟨⟨⟨⟨⟨listPlain, initPlain⟩, bodyPlain⟩, listTyPlain⟩, accPlain⟩, itemPlain⟩ := noJoin
+          simp only [hlistTy, hinitTy, hitem, PrintEliminators.need, ok_bind] at printed
+          obtain ⟨listExpr, hlistExpr, printed⟩ := bind_eq_ok.mp printed
+          obtain ⟨initExpr, hinitExpr, printed⟩ := bind_eq_ok.mp printed
+          obtain ⟨bodyExpr, hbodyExpr, printed⟩ := bind_eq_ok.mp printed
+          have hl := ihList listExpr listPlain hlistExpr
+          have hi := ihInit initExpr initPlain hinitExpr
+          have hb := ihBody (env ++ [stored.getD initTy, item]) false bodyExpr bodyPlain hbodyExpr
+          simp only [List.length_append, List.length_cons, List.length_nil] at hb
+          simp only [listTyPlain, accPlain, itemPlain, Bool.or_self, Bool.false_eq_true,
+            ↓reduceIte] at printed
+          simp only [pure_eq_ok] at printed
+          rw [← printed, hl, hi, hb]
+          rfl
+termination_by t => sizeOf t
+
+theorem terms_plain (sig : Signature Op) : ∀ (ts : Terms) (env : TyEnv) (const : Bool)
+    (xs : List Expr),
+    (cata_terms (PrintEliminators.termJoinAlg sig) ts).2 env const = false →
+    (cata_terms (PrintEliminators.termAlg sig) ts).2 env const = .ok xs →
+    xs = printTerms env.length ts
+  | .nil, env, const, xs, _, printed => by
+    simp only [cata_terms, PrintEliminators.termAlg, Except.ok.injEq] at printed
+    subst xs
+    rfl
+  | .cons head tail, env, const, xs, noJoin, printed => by
+    simp only [cata_terms, PrintEliminators.termAlg, PrintEliminators.termJoinAlg,
+      Bool.or_eq_false_iff] at printed noJoin
+    obtain ⟨x, hx, rest⟩ := bind_eq_ok.mp printed
+    obtain ⟨tail', htail, done⟩ := bind_eq_ok.mp rest
+    simp only [pure_eq_ok] at done
+    subst xs
+    rw [term_plain sig head env const x noJoin.1 hx, terms_plain sig tail env const tail' noJoin.2 htail]
+    rfl
+termination_by ts => sizeOf ts
+end
+
+/-- **The typed term at an environment where the detector finds no join is the term's print.** -/
+theorem term_eq_printTerm {sig : Signature Op} {env : TyEnv} {const : Bool} {t : Term} {x : Expr}
+    (noJoin : PrintEliminators.termJoin sig env const t = false)
+    (printed : PrintEliminators.term sig env const t = .ok x) : x = printTerm env.length t :=
+  term_plain sig t env const x noJoin printed
+
+/-- **The typed cause where the detector finds no join is the cause's print.** -/
+theorem cause_plain (sig : Signature Op) : ∀ (c : CauseTerm) (env : TyEnv) (x : Expr),
+    cata_cause (PrintEliminators.causeJoinAlg sig) c env = false →
+    cata_cause (PrintEliminators.causeAlg sig) c env = .ok x → x = printCause env.length c
+  | .fail t, env, x, noJoin, printed => by
+    simp only [cata_cause, PrintEliminators.causeAlg, PrintEliminators.causeJoinAlg] at printed noJoin
+    obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hv := term_eq_printTerm noJoin hvalue
+    simp only [pure_eq_ok] at printed
+    rw [← printed, hv]
+    rfl
+  | .die t, env, x, noJoin, printed => by
+    simp only [cata_cause, PrintEliminators.causeAlg, PrintEliminators.causeJoinAlg] at printed noJoin
+    obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hv := term_eq_printTerm noJoin hvalue
+    simp only [pure_eq_ok] at printed
+    rw [← printed, hv]
+    rfl
+  | .interrupt none, env, x, _, printed => by
+    simp only [cata_cause, PrintEliminators.causeAlg, Option.toList, List.mapM_nil, pure_bind,
+      pure_eq_ok] at printed
+    rw [← printed]
+    rfl
+  | .interrupt (some who), env, x, noJoin, printed => by
+    simp only [cata_cause, PrintEliminators.causeAlg, PrintEliminators.causeJoinAlg, Option.toList,
+      List.any_cons, List.any_nil, Bool.or_false] at printed noJoin
+    simp only [List.mapM_cons, List.mapM_nil, pure_bind, bind_assoc] at printed
+    obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hv := term_eq_printTerm noJoin hvalue
+    simp only [pure_eq_ok] at printed
+    rw [← printed, hv]
+    rfl
+  | .both left right, env, x, noJoin, printed => by
+    simp only [cata_cause, PrintEliminators.causeAlg, PrintEliminators.causeJoinAlg,
+      Bool.or_eq_false_iff] at printed noJoin
+    obtain ⟨l, hl, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨r, hr, printed⟩ := bind_eq_ok.mp printed
+    have hlp := cause_plain sig left env l noJoin.1 hl
+    have hrp := cause_plain sig right env r noJoin.2 hr
+    simp only [pure_eq_ok] at printed
+    rw [← printed, hlp, hrp]
+    rfl
+
+end Effect4.Codegen.EraseTermTypes
+
+namespace Effect4.Codegen.PrintEliminators
+
+open TypeScript Effect4.Program Effect4.Laws.Auto Effect4.Codegen.EraseTermTypes
+
+variable {Op : Type}
+
+/-- An optional reading that the detector reads as no join is there, and its test is false. -/
+theorem map_getD_false {α : Type} {o : Option α} {f : α → Bool} (h : (o.map f).getD true = false) :
+    ∃ a, o = some a ∧ f a = false := by
+  cases o with
+  | none => cases h
+  | some a => exact ⟨a, rfl, h⟩
+
+/-- **Where the detector finds no join at a node, its decoration is the plain node.** -/
+theorem decorate_plain {sig : Signature Op} {ctx : Context Op} {plain x : Expr}
+    (noJoin : nodeJoin sig ctx = false) (printed : decorate sig ctx plain = .ok x) : x = plain := by
+  unfold decorate at printed
+  unfold nodeJoin at noJoin
+  split at printed
+  case h_1 =>
+    simp only [Laws.Auto.pure_eq_ok] at printed
+    exact printed.symm
+  case h_2 scrutinee decision arm0 arm1 notBool heq =>
+    rw [heq] at noJoin
+    cases decision with
+    | bool => exact absurd rfl notBool
+    | option =>
+      simp only [Bool.or_eq_false_iff] at noJoin
+      obtain ⟨⟨scrutineePlain, leftPlain⟩, rightPlain⟩ := noJoin
+      obtain ⟨ty, hty, plainTy⟩ := properAt_false scrutineePlain
+      obtain ⟨left, hleft, plainLeft⟩ := map_getD_false leftPlain
+      obtain ⟨right, hright, plainRight⟩ := map_getD_false rightPlain
+      simp only [termTy, hty, hleft, hright, need, ok_bind, plainTy, plainLeft, plainRight,
+        Bool.or_self, Bool.false_eq_true, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+      exact printed.symm
+    | tag tag =>
+      simp only [Bool.or_eq_false_iff] at noJoin
+      obtain ⟨⟨scrutineePlain, leftPlain⟩, rightPlain⟩ := noJoin
+      obtain ⟨ty, hty, plainTy⟩ := properAt_false scrutineePlain
+      obtain ⟨left, hleft, plainLeft⟩ := map_getD_false leftPlain
+      obtain ⟨right, hright, plainRight⟩ := map_getD_false rightPlain
+      simp only [termTy, hty, hleft, hright, need, ok_bind, plainTy, plainLeft, plainRight,
+        Bool.or_self, Bool.false_eq_true, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+      exact printed.symm
+    | recordTag tag =>
+      simp only [Bool.or_eq_false_iff] at noJoin
+      obtain ⟨⟨scrutineePlain, leftPlain⟩, rightPlain⟩ := noJoin
+      obtain ⟨ty, hty, plainTy⟩ := properAt_false scrutineePlain
+      obtain ⟨left, hleft, plainLeft⟩ := map_getD_false leftPlain
+      obtain ⟨right, hright, plainRight⟩ := map_getD_false rightPlain
+      simp only [termTy, hty, hleft, hright, need, ok_bind, plainTy, plainLeft, plainRight,
+        Bool.or_self, Bool.false_eq_true, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+      exact printed.symm
+  case h_3 receiver mode heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := properAt_false noJoin
+    simp only [termTy, hty, need, ok_bind] at printed
+    cases hpair : fiberTy ty with
+    | none => simp only [hpair] at printed; cases printed
+    | some pair =>
+      simp only [hpair, ok_bind, pure, Except.pure, plainTy, Bool.false_eq_true, ↓reduceIte,
+        Except.ok.injEq] at printed
+      exact printed.symm
+  case h_6 program options heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := map_getD_false noJoin
+    simp only [hty, need, ok_bind, plainTy, Bool.false_eq_true, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+    exact printed.symm
+  case h_7 program options heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := map_getD_false noJoin
+    simp only [hty, need, ok_bind, plainTy, Bool.false_eq_true, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+    exact printed.symm
+  case h_8 program options scope heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := map_getD_false noJoin
+    simp only [hty, need, ok_bind, plainTy, Bool.false_eq_true, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+    exact printed.symm
+  case h_9 receiver heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := properAt_false noJoin
+    simp only [termTy, hty, need, ok_bind] at printed
+    cases hpair : fiberTy ty with
+    | none => simp only [hpair] at printed; cases printed
+    | some pair =>
+      simp only [hpair, ok_bind, pure, Except.pure, plainTy, Bool.false_eq_true, ↓reduceIte,
+        Except.ok.injEq] at printed
+      exact printed.symm
+  case h_10 receiver scope heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := properAt_false noJoin
+    simp only [termTy, hty, need, ok_bind] at printed
+    cases hpair : fiberTy ty with
+    | none => simp only [hpair] at printed; cases printed
+    | some pair =>
+      simp only [hpair, ok_bind, pure, Except.pure, plainTy, Bool.false_eq_true, ↓reduceIte,
+        Except.ok.injEq] at printed
+      exact printed.symm
+  case h_11 receivers interruptor heq =>
+    rw [heq] at noJoin
+    cases hsource : termTy sig ctx.env receivers with
+    | none => simp only [hsource] at noJoin; cases noJoin
+    | some source =>
+      simp only [hsource, Bool.or_eq_false_iff] at noJoin
+      obtain ⟨plainSource, itemPlain⟩ := noJoin
+      obtain ⟨item, hitem, plainItem⟩ := map_getD_false itemPlain
+      simp only [hsource, hitem, need, ok_bind] at printed
+      cases hpair : fiberTy item with
+      | none => simp only [hpair] at printed; cases printed
+      | some pair =>
+        simp only [hpair, ok_bind, plainSource, plainItem, Bool.or_self, Bool.false_eq_true,
+          ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+        exact printed.symm
+  case h_12 receivers heq =>
+    rw [heq] at noJoin
+    cases hsource : termTy sig ctx.env receivers with
+    | none => simp only [hsource] at noJoin; cases noJoin
+    | some source =>
+      simp only [hsource, Bool.or_eq_false_iff] at noJoin
+      obtain ⟨plainSource, itemPlain⟩ := noJoin
+      obtain ⟨item, hitem, plainItem⟩ := map_getD_false itemPlain
+      simp only [hsource, hitem, need, ok_bind] at printed
+      cases hpair : fiberTy item with
+      | none => simp only [hpair] at printed; cases printed
+      | some pair =>
+        simp only [hpair, ok_bind, plainSource, plainItem, Bool.or_self, Bool.false_eq_true,
+          ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+        exact printed.symm
+  case h_13 scope exit heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := properAt_false noJoin
+    simp only [termTy, hty, need, ok_bind] at printed
+    cases hpair : Checker.exitOf? ty with
+    | none => simp only [hpair] at printed; cases printed
+    | some pair =>
+      simp only [hpair, ok_bind, plainTy, Bool.false_eq_true, ↓reduceIte,
+        Laws.Auto.pure_eq_ok] at printed
+      exact printed.symm
+  case h_14 =>
+    simp only [Laws.Auto.pure_eq_ok] at printed
+    exact printed.symm
+  case h_4 body heq =>
+    rw [heq] at noJoin
+    obtain ⟨ty, hty, plainTy⟩ := map_getD_false noJoin
+    simp only [hty, need, ok_bind, plainTy, Bool.false_eq_true, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+    exact printed.symm
+  case h_5 acquire release heq =>
+    rw [heq] at noJoin
+    simp only [Bool.or_eq_false_iff] at noJoin
+    obtain ⟨⟨a, ha, plainA⟩, ⟨r, hr, plainR⟩⟩ := And.intro (map_getD_false noJoin.1) (map_getD_false noJoin.2)
+    simp only [ha, hr, need, ok_bind, plainA, plainR, Bool.or_self, Bool.false_eq_true, ↓reduceIte,
+      Laws.Auto.pure_eq_ok] at printed
+    exact printed.symm
+
+/-- The detector reads no literal flag at a term's own node: each node's reading ignores it.
+A step of `printTyped_eq_print`: the row call prints a pair's parts at the flag `false`. -/
+theorem termJoin_const (sig : Signature Op) (env : TyEnv) (c c' : Bool) (t : Term) :
+    termJoin sig env c t = termJoin sig env c' t := by
+  cases t <;> rfl
+
+/-- Where the detector finds no join at an application, it finds none at its arguments. -/
+theorem termJoin_app_args {sig : Signature Op} {env : TyEnv} {c : Bool} {name : String}
+    {args : Terms} (h : termJoin sig env c (.app name args) = false) :
+    (cata_terms (termJoinAlg sig) args).2 env (sig.constAtom name) = false := by
+  unfold termJoin at h
+  simp only [cata_term] at h
+  generalize cata_terms (termJoinAlg sig) args = j at h ⊢
+  simp only [termJoinAlg] at h
+  revert h
+  split
+  · split
+    · intro h
+      exact (Bool.or_eq_false_iff.mp h).1
+    · exact id
+  · split
+    · split
+      · intro h
+        exact (Bool.or_eq_false_iff.mp (Bool.or_eq_false_iff.mp h).1).1
+      · exact id
+    · exact id
+
+/-- The detector at an argument list is the detector at each argument. -/
+theorem termJoin_cons {sig : Signature Op} {env : TyEnv} {c : Bool} {a : Term} {rest : Terms}
+    (h : (cata_terms (termJoinAlg sig) (.cons a rest)).2 env c = false) :
+    termJoin sig env c a = false ∧ (cata_terms (termJoinAlg sig) rest).2 env c = false := by
+  simp only [cata_terms, termJoinAlg, Bool.or_eq_false_iff] at h
+  exact h
+
+/-- The detector at a pair's parts, where it finds no join at the pair. -/
+theorem termJoin_pair {sig : Signature Op} {env : TyEnv} {c : Bool} {a b : Term}
+    (h : termJoin sig env c (.app "pair" (.cons a (.cons b .nil))) = false) :
+    termJoin sig env false a = false ∧ termJoin sig env false b = false := by
+  obtain ⟨aPlain, rest⟩ := termJoin_cons (termJoin_app_args h)
+  obtain ⟨bPlain, _⟩ := termJoin_cons rest
+  exact ⟨(termJoin_const sig env _ _ a).trans aPlain, (termJoin_const sig env _ _ b).trans bPlain⟩
+
+/-- The detector at a one-argument application that no eliminator reads, `fst` or `snd`, is
+the detector at its argument. -/
+theorem termJoin_unary (sig : Signature Op) (env : TyEnv) (c : Bool) (name : String) (q : Term)
+    (notCause : (["causeIsFail", "causeIsDie", "causeIsInterrupt", "causeError"] : List String).contains
+      name = false)
+    (notProduct : (["pair", "tuple"] : List String).contains name = false) :
+    termJoin sig env c (.app name (.cons q .nil)) = termJoin sig env false q := by
+  unfold termJoin
+  simp only [cata_term, cata_terms, termJoinAlg, notCause, notProduct, Bool.false_eq_true,
+    ↓reduceIte, Bool.or_false]
+  exact termJoin_const sig env _ _ q
+
+/-- **A tuple call's arguments where the detector finds no join are their print.** -/
+theorem tupleArgs_plain {sig : Signature Op} {env : TyEnv} {q : Term} {xs : List Expr}
+    (noJoin : termJoin sig env false q = false)
+    (printed : P2bRowSupport.tupleArgs sig env q = .ok xs) : xs = printTupleArgs env.length q := by
+  unfold P2bRowSupport.tupleArgs at printed
+  cases pair : pairArgs? q with
+  | some ab =>
+    rcases ab with ⟨a, b⟩
+    rw [pair] at printed
+    have hq := pairArgs?_some pair
+    subst hq
+    obtain ⟨aPlain, bPlain⟩ := termJoin_pair noJoin
+    obtain ⟨x, hx, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨y, hy, printed⟩ := bind_eq_ok.mp printed
+    simp only [Laws.Auto.pure_eq_ok] at printed
+    subst xs
+    rw [term_eq_printTerm aPlain hx, term_eq_printTerm bPlain hy]
+    simp only [printTupleArgs, pair]
+  | none =>
+    rw [pair] at printed
+    obtain ⟨x, hx, printed⟩ := bind_eq_ok.mp printed
+    simp only [Laws.Auto.pure_eq_ok] at printed
+    subst xs
+    rw [term_eq_printTerm noJoin hx]
+    simp only [printTupleArgs, pair]
+
+/-- A method's arguments where the detector finds no join are their print. -/
+theorem methodArgs_plain {sig : Signature Op} {env : TyEnv} {r : Effect4.Program.Row} {args : Term}
+    {xs : List Expr} (argsPlain : termJoin sig env false args = false)
+    (printed : (if (methodArgsRow r).shape = .tupleCall then P2bRowSupport.tupleArgs sig env args
+      else if (methodArgsRow r).request = .unit then pure []
+      else do pure [← term sig env false args]) = .ok xs) :
+    xs ++ r.trailing.map RowArg.print = printMethodArgs env.length r args := by
+  unfold printMethodArgs
+  split at printed
+  · rename_i hs
+    rw [if_pos hs, tupleArgs_plain argsPlain printed]
+  · rename_i hs
+    rw [if_neg hs]
+    split at printed
+    · rename_i hu
+      rw [if_pos hu]
+      simp only [Laws.Auto.pure_eq_ok] at printed
+      subst xs
+      rfl
+    · rename_i hu
+      rw [if_neg hu]
+      obtain ⟨x, hx, printed⟩ := bind_eq_ok.mp printed
+      simp only [Laws.Auto.pure_eq_ok] at printed
+      subst xs
+      rw [term_eq_printTerm argsPlain hx]
+      rfl
+
+/-- A method call where the detector finds no join at its receiver and arguments is its print. -/
+theorem method_plain {sig : Signature Op} {env : TyEnv} {r : Effect4.Program.Row}
+    {receiver args : Term} {x : Expr} (receiverPlain : termJoin sig env false receiver = false)
+    (argsPlain : termJoin sig env false args = false)
+    (printed : P2bRowSupport.method sig env r receiver args = .ok x) :
+    printMethod env.length r receiver args = .ok x := by
+  rw [P2bRowSupport.method_as_bind] at printed
+  obtain ⟨receiverExpr, hr, printed⟩ := bind_eq_ok.mp printed
+  obtain ⟨argsExpr, ha, printed⟩ := bind_eq_ok.mp printed
+  obtain ⟨declared, hd, printed⟩ := bind_eq_ok.mp printed
+  have hr' := term_eq_printTerm receiverPlain hr
+  have ha' := methodArgs_plain argsPlain ha
+  have hd' := P2bRowSupport.need_some hd
+  subst hr'
+  cases declared with
+  | nil =>
+    simp only [List.isEmpty_nil, ↓reduceIte, Except.ok.injEq] at printed
+    subst x
+    simp only [printMethod, hd', ha']
+  | cons ty tys =>
+    simp only [List.isEmpty_cons, Bool.false_eq_true, ↓reduceIte, Except.ok.injEq] at printed
+    subst x
+    simp only [printMethod, hd', ha']
+
+/-- **A row's call where the detector finds no join at its request is its print.** -/
+theorem row_plain {sig : Signature Op} {env : TyEnv} {r : Effect4.Program.Row} {request : Term}
+    {x : Expr} (noJoin : termJoin sig env false request = false)
+    (printed : row sig env r request = .ok x) : printRow env.length r request = .ok x := by
+  cases shape : r.shape with
+  | value =>
+    simp only [row, shape, Laws.Auto.pure_eq_ok] at printed
+    subst x
+    simp only [printRow, shape]
+  | call =>
+    simp only [row, shape] at printed
+    obtain ⟨head, hh, printed⟩ := bind_eq_ok.mp printed
+    split at printed
+    · rename_i hu
+      simp only [Laws.Auto.pure_eq_ok] at printed
+      subst x
+      simp only [printRow, shape, hh, bind, Except.bind, hu, ↓reduceIte]
+    · rename_i hu
+      obtain ⟨value, hv, printed⟩ := bind_eq_ok.mp printed
+      simp only [Laws.Auto.pure_eq_ok] at printed
+      subst x
+      simp only [printRow, shape, hh, bind, Except.bind, hu, ↓reduceIte, term_eq_printTerm noJoin hv]
+  | tupleCall =>
+    simp only [row, shape] at printed
+    obtain ⟨head, hh, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨values, hv, printed⟩ := bind_eq_ok.mp printed
+    change P2bRowSupport.tupleArgs sig env request = .ok values at hv
+    simp only [Laws.Auto.pure_eq_ok] at printed
+    subst x
+    simp only [printRow, shape, hh, bind, Except.bind, tupleArgs_plain noJoin hv]
+  | method =>
+    cases pair : pairArgs? request with
+    | none =>
+      simp only [row, shape, pair, Option.getD_none] at printed
+      change P2bRowSupport.method sig env r (.app "fst" (.cons request .nil))
+        (.app "snd" (.cons request .nil)) = .ok x at printed
+      simp only [printRow, shape, pair]
+      exact method_plain
+        ((termJoin_unary sig env false "fst" request (by decide) (by decide)).trans noJoin)
+        ((termJoin_unary sig env false "snd" request (by decide) (by decide)).trans noJoin) printed
+    | some ab =>
+      rcases ab with ⟨receiver, args⟩
+      have hq := pairArgs?_some pair
+      rw [hq] at noJoin
+      obtain ⟨receiverPlain, argsPlain⟩ := termJoin_pair noJoin
+      simp only [row, shape, pair, Option.getD_some] at printed
+      change P2bRowSupport.method sig env r receiver args = .ok x at printed
+      simp only [printRow, shape, pair]
+      exact method_plain receiverPlain argsPlain printed
+
+/-- A row call with its operation's own type arguments, where the detector finds no join at its
+request, is its print. -/
+theorem call_plain {sig : Signature Op} {env : TyEnv} {op : Op} {request : Term} {base : Expr}
+    (noJoin : termJoin sig env false request = false)
+    (printed : P2bRowSupport.call sig env op request none = .ok base) :
+    printCall sig env.length op request = .ok base := by
+  unfold P2bRowSupport.call at printed
+  obtain ⟨plain, hb, printed⟩ := bind_eq_ok.mp printed
+  have hb' := row_plain noJoin hb
+  dsimp only at printed
+  cases owned : sig.typeArgsOf op with
+  | nil =>
+    simp only [owned, List.isEmpty_nil, ↓reduceIte, Laws.Auto.pure_eq_ok] at printed
+    subst base
+    simp only [printCall, owned]
+    exact hb'
+  | cons ty tys =>
+    simp only [owned, List.isEmpty_cons, Bool.false_eq_true, ↓reduceIte] at printed
+    obtain ⟨targets, ht, printed⟩ := bind_eq_ok.mp printed
+    have hw := P2bRowSupport.targets_writeTys (ty :: tys) ht
+    simp only [printCall, owned, hw, hb', Except.bind]
+    exact printed
+
+/-- **A row call with no type arguments to insert, where the detector finds no join at its
+request and at its operation's binder term, is its print.** A step of `printTyped_eq_print`. -/
+theorem perform_plain {sig : Signature Op} {ctx : Context Op} {op : Op} {request : Term} {x : Expr}
+    (hn : ctx.node = .eff (.perform op request))
+    (requestPlain : termJoin sig ctx.env false request = false)
+    (binderPlain : ∀ b, sig.termOf op = some b →
+      ((ctx.node.extSlotEnv sig ctx.env .opTerm).map fun env => termJoin sig env false b.term).getD
+        true = false)
+    (printed : perform sig ctx op request none = .ok x) :
+    printPerform sig ctx.env.length op request = .ok x := by
+  rw [P2bRowSupport.perform_as_call] at printed
+  obtain ⟨base, hb, printed⟩ := bind_eq_ok.mp printed
+  have hcall := call_plain requestPlain hb
+  unfold printPerform
+  cases hterm : sig.termOf op with
+  | none =>
+    simp only [hterm, Except.ok.injEq] at printed
+    subst x
+    exact hcall
+  | some b =>
+    rw [hterm] at printed
+    obtain ⟨env, he, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨value, hv, printed⟩ := bind_eq_ok.mp printed
+    have he' := P2bRowSupport.need_some he
+    have hlen := P2bRowSupport.opTerm_env_length sig ctx op request hn he'
+    have bPlain := binderPlain b hterm
+    rw [he'] at bPlain
+    simp only [Option.map_some, Option.getD_some] at bPlain
+    have hval := term_eq_printTerm bPlain hv
+    rw [hlen] at hval
+    rw [hcall]
+    simp only [Except.bind]
+    rw [← hval]
+    exact printed
+
+/-- A slot's checked environment fitted to its own length is the environment. -/
+theorem atDepth_self (env : TyEnv) : atDepth env env.length = env := by
+  simp only [atDepth, Nat.sub_self, List.replicate_zero, List.append_nil, List.take_length]
+
+/-- The node view of a source node is its family and its view. -/
+theorem nodeView_nodeOfFamily (fam : EffFam) (source : EffSelfCarrier Op fam) :
+    nodeView (Codegen.nodeOfFamily fam source) = (fam, view fam source) := by
+  cases fam <;> rfl
+
+/-- At a focused node the detector reads the node's own arguments. -/
+theorem nodeArgs_eq {ctx : Context Op} {fam : EffFam} {source : EffSelfCarrier Op fam}
+    {ctor : String} {args : List (ArgF Op (EffSelfCarrier Op))}
+    (hnode : ctx.node = Codegen.nodeOfFamily fam source) (viewed : view fam source = (ctor, args)) :
+    nodeArgs ctx.node = args := by
+  unfold nodeArgs
+  rw [hnode, nodeView_nodeOfFamily, viewed]
+
+/-- At a focused node the detector reads a slot at the depth the selected row prints it at. -/
+theorem slotDepth_eq {ctx : Context Op} {fam : EffFam} {source : EffSelfCarrier Op fam}
+    {ctor : String} {args : List (ArgF Op (EffSelfCarrier Op))} {row : Templates.Row} {n : Nat}
+    (hnode : ctx.node = Codegen.nodeOfFamily fam source) (hlen : ctx.env.length = n)
+    (viewed : view fam source = (ctor, args))
+    (selected : Templates.table.find? (fun row => row.selects fam ctor args) = some row)
+    (k : Nat) (arg : ArgF Op (EffSelfCarrier Op)) :
+    slotDepth ctx k arg = Templates.argDepth fam (Templates.argSortOf arg) n (row.out.levelAt k) := by
+  unfold slotDepth
+  rw [hnode, nodeView_nodeOfFamily, viewed]
+  simp only [selected, hlen]
+
+/-- The detector at a term slot of the node, where it finds no join at the node's slots. -/
+theorem slotsJoin_term {sig : Signature Op} {ctx : Context Op} (h : slotsJoin sig ctx = false)
+    {k : Nat} {t : Term} (member : (nodeArgs ctx.node)[k]? = some (.term t)) :
+    ((slotEnv sig ctx k).map fun env =>
+      termJoin sig (atDepth env (slotDepth ctx k (.term t))) false t).getD true = false := by
+  unfold slotsJoin at h
+  exact Bool.eq_false_iff.mpr
+    (List.any_eq_false.mp h (.term t, k) (List.mem_zipIdx_iff_getElem?.mpr member))
+
+theorem slotsJoin_optTerm {sig : Signature Op} {ctx : Context Op} (h : slotsJoin sig ctx = false)
+    {k : Nat} {t : Term} (member : (nodeArgs ctx.node)[k]? = some (.optTerm (some t))) :
+    ((slotEnv sig ctx k).map fun env =>
+      termJoin sig (atDepth env (slotDepth ctx k (.optTerm (some t)))) false t).getD true = false := by
+  unfold slotsJoin at h
+  exact Bool.eq_false_iff.mpr
+    (List.any_eq_false.mp h (.optTerm (some t), k) (List.mem_zipIdx_iff_getElem?.mpr member))
+
+theorem slotsJoin_cause {sig : Signature Op} {ctx : Context Op} (h : slotsJoin sig ctx = false)
+    {k : Nat} {c : CauseTerm} (member : (nodeArgs ctx.node)[k]? = some (.cause c)) :
+    cata_cause (causeJoinAlg sig) c (atDepth ctx.env (slotDepth ctx k (.cause c))) = false := by
+  unfold slotsJoin at h
+  exact Bool.eq_false_iff.mpr
+    (List.any_eq_false.mp h (.cause c, k) (List.mem_zipIdx_iff_getElem?.mpr member))
+
+theorem slotsJoin_op {sig : Signature Op} {ctx : Context Op} (h : slotsJoin sig ctx = false)
+    {k : Nat} {op : Op} (member : (nodeArgs ctx.node)[k]? = some (.op op)) (b : BinderTerm)
+    (hb : sig.termOf op = some b) :
+    ((ctx.node.extSlotEnv sig ctx.env .opTerm).map fun env =>
+      termJoin sig env false b.term).getD true = false := by
+  unfold slotsJoin at h
+  have reading := List.any_eq_false.mp h (.op op, k) (List.mem_zipIdx_iff_getElem?.mpr member)
+  simp only [hb] at reading
+  exact Bool.eq_false_iff.mpr reading
+
+/-- **A leaf argument where the detector finds no join at the node's slots prints as the plain
+print prints it.** A step of `printTyped_eq_print`. -/
+theorem printArg_leaf_plain {sig : Signature Op} {ctx : Context Op} {k depth : Nat}
+    {arg : ArgF Op (EffSelfCarrier Op)} (leaf : ∀ fam child, arg ≠ .child fam child)
+    (slots : slotsJoin sig ctx = false) (member : (nodeArgs ctx.node)[k]? = some arg)
+    (hdepth : slotDepth ctx k arg = depth) {capture : Option Template.Arg}
+    (printed : printArg sig ctx k depth (ArgF.fold (Templates.printAlg sig) arg) = .ok capture) :
+    Templates.printArg sig depth (ArgF.fold (Templates.printAlg sig) arg) = .ok capture := by
+  cases arg with
+  | child fam child => exact absurd rfl (leaf fam child)
+  | term t =>
+    obtain ⟨env, henv, plainT⟩ := map_getD_false (slotsJoin_term slots member)
+    rw [hdepth] at plainT
+    simp only [ArgF.fold, printArg, henv, need, ok_bind] at printed
+    obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hv := term_eq_printTerm plainT hvalue
+    rw [atDepth_length] at hv
+    simp only [Laws.Auto.pure_eq_ok] at printed
+    subst hv printed
+    rfl
+  | optTerm o =>
+    cases o with
+    | none => exact printed
+    | some t =>
+      obtain ⟨env, henv, plainT⟩ := map_getD_false (slotsJoin_optTerm slots member)
+      rw [hdepth] at plainT
+      simp only [ArgF.fold, printArg, henv, need, ok_bind] at printed
+      obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+      have hv := term_eq_printTerm plainT hvalue
+      rw [atDepth_length] at hv
+      simp only [Laws.Auto.pure_eq_ok] at printed
+      subst hv printed
+      rfl
+  | cause c =>
+    have plainC := slotsJoin_cause slots member
+    rw [hdepth] at plainC
+    simp only [ArgF.fold, printArg] at printed
+    obtain ⟨value, hvalue, printed⟩ := bind_eq_ok.mp printed
+    have hv := cause_plain sig c _ value plainC hvalue
+    rw [atDepth_length] at hv
+    simp only [Laws.Auto.pure_eq_ok] at printed
+    subst hv printed
+    rfl
+  | _ => exact printed
+
+/-- A child argument whose typed print, where it succeeds, is its print prints as the plain print
+prints it. -/
+theorem printArg_child_plain {sig : Signature Op} {depth : Nat} {fam : EffFam}
+    {typed plain : Templates.Carrier fam}
+    (agrees : ∀ out, typed depth = .ok out → plain depth = .ok out) {capture : Option Template.Arg}
+    (printed : Templates.printArg sig depth (.child fam typed : ArgF Op Templates.Carrier) =
+      .ok capture) :
+    Templates.printArg sig depth (.child fam plain : ArgF Op Templates.Carrier) = .ok capture := by
+  cases fam with
+  | stmt => exact printed
+  | eff | action | layer | effs | layers | stmts =>
+    simp only [Templates.printArg] at printed ⊢
+    obtain ⟨y, hy, printed⟩ := bind_eq_ok.mp printed
+    rw [agrees y hy]
+    exact printed
+
+/-- **The typed arguments print as the plain arguments print** where each argument does. -/
+theorem printArgs_plain {sig : Signature Op} {ctx : Context Op} {fam : EffFam} {n : Nat}
+    {out : Templates.RowOut} :
+    ∀ (typed plain : List (ArgF Op Templates.Carrier)) (i : Nat) (τ : Template.Subst),
+      typed.length = plain.length →
+      (∀ k a b c, typed[k]? = some a → plain[k]? = some b →
+        printArg sig ctx (i + k)
+          (Templates.argDepth fam (Templates.argSortOf a) n (out.levelAt (i + k))) a = .ok c →
+        Templates.printArg sig
+          (Templates.argDepth fam (Templates.argSortOf b) n (out.levelAt (i + k))) b = .ok c) →
+      printArgs sig ctx fam n out typed i = .ok τ → Templates.printArgs sig fam n out plain i = .ok τ
+  | [], [], i, τ, _, _, printed => by
+    simp only [printArgs] at printed
+    simpa only [Templates.printArgs] using printed
+  | a :: typed, b :: plain, i, τ, hlen, pointwise, printed => by
+    simp only [printArgs] at printed
+    obtain ⟨c, hc, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨rest, hrest, printed⟩ := bind_eq_ok.mp printed
+    have hb := pointwise 0 a b c rfl rfl (by simpa only [Nat.add_zero] using hc)
+    rw [Nat.add_zero] at hb
+    have ih := printArgs_plain typed plain (i + 1) rest
+      (by simpa only [List.length_cons, Nat.add_right_cancel_iff] using hlen)
+      (fun k a' b' c' ha hb' hp => by
+        have shift : i + (k + 1) = i + 1 + k := by omega
+        have step := pointwise (k + 1) a' b' c' (by simpa only [List.getElem?_cons_succ] using ha)
+          (by simpa only [List.getElem?_cons_succ] using hb') (by rw [shift]; exact hp)
+        rwa [shift] at step) hrest
+    simp only [Templates.printArgs, hb, ih, ok_bind]
+    exact printed
+  | [], _ :: _, _, _, hlen, _, _ => by cases hlen
+  | _ :: _, [], _, _, hlen, _, _ => by cases hlen
+
+end Effect4.Codegen.PrintEliminators
+
+namespace Effect4.Codegen
+
+open TypeScript Effect4.Program Template Templates
+open Effect4.Laws.Auto (bind_eq_ok)
+
+variable {Op : Type} {sig : Signature Op} {root : Eff Op} {env0 : TyEnv}
+
+/-- Where the detector finds no join at an address of the program, it finds none at the node
+there and none at its slots. -/
+theorem joins_plain {path : List Nat} {ctx : PrintEliminators.Context Op}
+    (noSites : ∀ path, PrintEliminators.joinsAtTable sig (annotate sig env0 root) root path = false)
+    (found : PrintEliminators.contextAtTable (annotate sig env0 root) root path = some ctx) :
+    PrintEliminators.nodeJoin sig ctx = false ∧ PrintEliminators.slotsJoin sig ctx = false := by
+  have joins := noSites path
+  unfold PrintEliminators.joinsAtTable at joins
+  rw [found] at joins
+  simp only [Option.map_some, Option.getD_some, Bool.or_eq_false_iff] at joins
+  exact joins
+
+/-- **The arguments of a focused node print as the plain print prints them**, where the detector
+finds no join at the node's slots and each captured child's successful typed print is its
+print. A step of `printTyped_eq_print`. -/
+theorem printArgs_site_plain {alg : EffAlgebra Op TCarrier} {ctx : PrintEliminators.Context Op}
+    {fam : EffFam} {source : EffSelfCarrier Op fam} {ctor : String}
+    {args : List (ArgF Op (EffSelfCarrier Op))} {row : Templates.Row} {n : Nat} {path : List Nat}
+    {τ : Subst}
+    (hnode : ctx.node = nodeOfFamily fam source) (hlen : ctx.env.length = n)
+    (viewed : view fam source = (ctor, args))
+    (selected : Templates.table.find? (fun row => row.selects fam ctor args) = some row)
+    (slots : PrintEliminators.slotsJoin sig ctx = false)
+    (childPlain : ∀ i fam' (c : EffSelfCarrier Op fam'), args[i]? = some (.child fam' c) →
+      ∀ out, cataFam alg fam' c (path ++ [(args.take i).countP isChildArg])
+          (argDepth fam (.child fam') n (row.out.levelAt i)) = .ok out →
+        cataFam (printAlg sig) fam' c (argDepth fam (.child fam') n (row.out.levelAt i)) = .ok out)
+    (printed : PrintEliminators.printArgs sig ctx fam n row.out
+      (atAddress path (args.map (ArgF.fold alg)) 0) 0 = .ok τ) :
+    Templates.printArgs sig fam n row.out (args.map (ArgF.fold (printAlg sig))) 0 = .ok τ := by
+  refine PrintEliminators.printArgs_plain _ _ 0 τ ?_ ?_ printed
+  · rw [length_atAddress, List.length_map, List.length_map]
+  · intro k a b c ha hb hc
+    rw [Nat.zero_add] at hc ⊢
+    rw [List.getElem?_map] at hb
+    obtain ⟨src, hsrc, rfl⟩ := Option.map_eq_some_iff.mp hb
+    cases src with
+    | child fam' c' =>
+      have atTyped := atAddress_fold_child_for alg path args k fam' c' hsrc
+      rw [atTyped, Option.some.injEq] at ha
+      subst ha
+      exact PrintEliminators.printArg_child_plain (childPlain k fam' c' hsrc) hc
+    | _ =>
+      have atTyped := atAddress_fold_leaf_for alg sig path args k _
+        (fun fam child eq => by cases eq) hsrc
+      rw [atTyped, Option.some.injEq] at ha
+      subst ha
+      have member : (PrintEliminators.nodeArgs ctx.node)[k]? = args[k]? := by
+        rw [PrintEliminators.nodeArgs_eq hnode viewed]
+      rw [hsrc] at member
+      exact PrintEliminators.printArg_leaf_plain (fun fam child eq => by cases eq) slots member
+        (PrintEliminators.slotDepth_eq hnode hlen viewed selected k _) hc
+
+/-- A typed node of an expression family is printed by a row that prints: a template, the row
+call or an invocation. -/
+theorem site_row_found {ann : List Nat → Option (List Ty)}
+    {contexts : List Nat → Option (PrintEliminators.Context Op)} {fam : EffFam}
+    {source : EffSelfCarrier Op fam} {path : List Nat} {n : Nat} {x : Expr} {ctor : String}
+    {args : List (ArgF Op (EffSelfCarrier Op))}
+    (family : fam = .eff ∨ fam = .action ∨ fam = .layer)
+    (built : build fam ctor args = some source)
+    (printed : PrintedCaptureAt (typedSitesAlg sig ann contexts) path n fam source (.expr x)) :
+    ∃ row, Templates.table.find? (fun row => row.selects fam ctor args) = some row ∧
+      ((∃ t, row.out = .tpl t) ∨ row.out = .rowCall ∨ row.out = .invoke) := by
+  obtain ⟨ctx, found⟩ := printedCaptureAt_context family printed
+  have equation := typedSites_cata_build sig ann contexts fam ctor args source built path
+  have selectTyped : Templates.table.find? (fun row => row.selects fam ctor
+      (atAddress path (args.map (ArgF.fold (typedSitesAlg sig ann contexts))) 0)) =
+      Templates.table.find? (fun row => row.selects fam ctor args) := by
+    simp only [selects_atAddress, selects_fold]
+  cases hfind : Templates.table.find? (fun row => row.selects fam ctor args) with
+  | none =>
+    rw [hfind] at selectTyped
+    exfalso
+    rcases family with rfl | rfl | rfl <;>
+      (simp only [PrintedCaptureAt] at printed
+       simp only [cataFam] at equation
+       rw [equation, found] at printed
+       simp only [PrintEliminators.layer, selectTyped] at printed
+       cases printed)
+  | some row =>
+    refine ⟨row, rfl, ?_⟩
+    rw [hfind] at selectTyped
+    cases hout : row.out with
+    | tpl t => exact .inl ⟨t, rfl⟩
+    | rowCall => exact .inr (.inl rfl)
+    | invoke => exact .inr (.inr rfl)
+    | refuse name =>
+      exfalso
+      rcases family with rfl | rfl | rfl <;>
+        (simp only [PrintedCaptureAt] at printed
+         simp only [cataFam] at equation
+         rw [equation, found] at printed
+         simp only [PrintEliminators.layer, selectTyped, hout] at printed
+         cases printed)
+    | stmt t =>
+      exfalso
+      rcases family with rfl | rfl | rfl <;>
+        (simp only [PrintedCaptureAt] at printed
+         simp only [cataFam] at equation
+         rw [equation, found] at printed
+         simp only [PrintEliminators.layer, selectTyped, hout] at printed
+         cases printed)
+
+/-- What the typed print did at a row call: it found the address's context and printed the
+call there. -/
+theorem site_perform_inv {ann : List Nat → Option (List Ty)}
+    {contexts : List Nat → Option (PrintEliminators.Context Op)}
+    {path : List Nat} {n : Nat} {x : Expr} {op : Op} {request : Term} {row : Templates.Row}
+    (selected : Templates.table.find? (fun row => row.selects .eff "perform"
+      ([.op op, .term request] : List (ArgF Op (EffSelfCarrier Op)))) = some row)
+    (output : row.out = .rowCall)
+    (printed : PrintedCaptureAt (typedSitesAlg sig ann contexts) path n .eff
+      (Eff.perform op request) (.expr x)) :
+    ∃ ctx, contexts path = some ctx ∧ PrintEliminators.perform sig ctx op request (ann path) = .ok x := by
+  obtain ⟨ctx, found⟩ := printedCaptureAt_context (.inl rfl) printed
+  have haddr : atAddress path (([.op op, .term request] : List (ArgF Op (EffSelfCarrier Op))).map
+      (ArgF.fold (typedSitesAlg sig ann contexts))) 0 = [.op op, .term request] := rfl
+  have selectTyped : Templates.table.find? (fun row => row.selects .eff "perform"
+      ([.op op, .term request] : List (ArgF Op Carrier))) = some row := by
+    rw [← haddr]
+    simpa only [selects_atAddress, selects_fold] using selected
+  have equation := typedSites_cata_build sig ann contexts .eff "perform"
+    [.op op, .term request] (Eff.perform op request) rfl path
+  simp only [PrintedCaptureAt] at printed
+  simp only [cataFam] at equation
+  rw [equation, found] at printed
+  simp only [List.map_cons, List.map_nil, ArgF.fold, atAddress, PrintEliminators.layer, selectTyped,
+    output] at printed
+  exact ⟨ctx, found, printed⟩
+
+/-- The table's row calls are `perform`'s. -/
+def rowCallNamed (row : Templates.Row) : Bool :=
+  match row.out with
+  | .rowCall => row.fam == .eff && row.ctor == "perform"
+  | _ => true
+
+theorem table_rowCallNamed : Templates.table.all rowCallNamed = true := by decide
+
+/-- A program whose view names `perform` is a row call. -/
+theorem eff_of_view_perform {e : Eff Op} {args : List (ArgF Op (EffSelfCarrier Op))}
+    (h : view .eff e = ("perform", args)) : ∃ op r, e = .perform op r ∧ args = [.op op, .term r] := by
+  cases e <;> simp only [view, view_eff, Prod.mk.injEq] at h
+  case perform op r => exact ⟨op, r, rfl, h.2.symm⟩
+  all_goals exact absurd h.1 (by decide)
+
+/-- A program whose view names `invoke` is an invocation. -/
+theorem eff_of_view_invoke {e : Eff Op} {args : List (ArgF Op (EffSelfCarrier Op))}
+    (h : view .eff e = ("invoke", args)) :
+    ∃ k r progs, e = .invoke k r progs ∧ args = [.nat k, .term r, .child .effs progs] := by
+  cases e <;> simp only [view, view_eff, Prod.mk.injEq] at h
+  case invoke k r progs => exact ⟨k, r, progs, rfl, h.2.symm⟩
+  all_goals exact absurd h.1 (by decide)
+
+/-- The typed print's algebra at the program's address table, with no type arguments to insert:
+the algebra the connector reads. -/
+abbrev plainSitesAlg (sig : Signature Op) (env0 : TyEnv) (root : Eff Op) : EffAlgebra Op TCarrier :=
+  typedSitesAlg sig (fun _ => none) (PrintEliminators.contextAtTable (annotate sig env0 root) root)
+
+/-- What the connector's induction knows of a node's children: where a child's typed print at a
+focused address succeeds, it is its print. -/
+def ChildrenPlain (sig : Signature Op) (env0 : TyEnv) (root : Eff Op) (fam : EffFam)
+    (source : EffSelfCarrier Op fam) : Prop :=
+  ∀ fam' (c : EffSelfCarrier Op fam') path d (out : Out fam'), ArgF.child fam' c ∈ (view fam source).2 →
+    SiteFocused root sig env0 path fam' c d →
+    cataFam (plainSitesAlg sig env0 root) fam' c path d = .ok out →
+    cataFam (printAlg sig) fam' c d = .ok out
+
+/-- **A node of an expression family**, where no join needs a type: its successful typed print
+is its print, given its children's. A step of `printTyped_eq_print`. -/
+theorem plain_node
+    (noSites : ∀ path, PrintEliminators.joinsAtTable sig (annotate sig env0 root) root path = false)
+    {fam : EffFam} (family : fam = .eff ∨ fam = .action ∨ fam = .layer)
+    {source : EffSelfCarrier Op fam} {ctor : String} {args : List (ArgF Op (EffSelfCarrier Op))}
+    {path : List Nat} {n : Nat} {x : Expr}
+    (focus : SiteFocused root sig env0 path fam source n) (viewed : view fam source = (ctor, args))
+    (children : ChildrenPlain sig env0 root fam source)
+    (typed : PrintedCaptureAt (plainSitesAlg sig env0 root) path n fam source (.expr x)) :
+    tableLayer.rowPrint sig fam ctor (args.map (ArgF.fold (printAlg sig))) n = .ok x := by
+  have built : build fam ctor args = some source := by
+    have h := build_view fam source
+    rwa [viewed] at h
+  obtain ⟨ctx, found⟩ := printedCaptureAt_context family typed
+  obtain ⟨hnode, hlen⟩ := site_context_matches focus (notNilSpine_of_family family) found
+  obtain ⟨nodePlain, slotsPlain⟩ := joins_plain noSites found
+  obtain ⟨row, hfind, hcase⟩ := site_row_found family built typed
+  have hfindPlain : Templates.table.find?
+      (fun r => r.selects fam ctor (args.map (ArgF.fold (printAlg sig)))) = some row := by
+    simpa only [selects_fold] using hfind
+  have childPlain : ∀ i fam' (c : EffSelfCarrier Op fam'), args[i]? = some (.child fam' c) →
+      ∀ out, cataFam (plainSitesAlg sig env0 root) fam' c (path ++ [(args.take i).countP isChildArg])
+          (argDepth fam (.child fam') n (row.out.levelAt i)) = .ok out →
+        cataFam (printAlg sig) fam' c (argDepth fam (.child fam') n (row.out.levelAt i)) = .ok out := by
+    intro i fam' c captured out printedChild
+    have focus' := siteFocused_child_typed focus viewed hfind captured printedChild
+    exact children fam' c _ _ out (by rw [viewed]; exact List.mem_of_getElem? captured) focus'
+      printedChild
+  rcases hcase with ⟨t, hout⟩ | hout | hout
+  · obtain ⟨ctx', τ, y, hctx', hτ, hinst, hdecorate⟩ := site_template_inv family built hfind hout typed
+    have sameCtx : ctx' = ctx := Option.some.inj (hctx'.symm.trans found)
+    subst ctx'
+    have decorated := PrintEliminators.decorate_plain nodePlain hdecorate
+    subst decorated
+    have hτPlain := printArgs_site_plain hnode hlen viewed hfind slotsPlain childPlain
+      (by rw [hout]; exact hτ)
+    rw [hout] at hτPlain
+    simp only [tableLayer.rowPrint, hfindPlain, hout, hτPlain, ok_bind, hinst]
+  · have named := List.all_eq_true.mp table_rowCallNamed row (List.mem_of_find?_eq_some hfind)
+    simp only [rowCallNamed, hout, Bool.and_eq_true, beq_iff_eq] at named
+    have selectedRow := List.find?_some hfind
+    obtain ⟨hfam, hctor⟩ := selects_fam_ctor selectedRow
+    rw [named.1] at hfam
+    rw [named.2] at hctor
+    subst hfam hctor
+    obtain ⟨op, request, rfl, rfl⟩ := eff_of_view_perform viewed
+    obtain ⟨ctx', hctx', hperform⟩ := site_perform_inv hfind hout typed
+    have sameCtx : ctx' = ctx := Option.some.inj (hctx'.symm.trans found)
+    subst ctx'
+    have member1 : (PrintEliminators.nodeArgs ctx.node)[1]? = some (.term request) := by
+      rw [PrintEliminators.nodeArgs_eq hnode rfl]
+      rfl
+    have member0 : (PrintEliminators.nodeArgs ctx.node)[0]? = some (.op op) := by
+      rw [PrintEliminators.nodeArgs_eq hnode rfl]
+      rfl
+    have henv : PrintEliminators.slotEnv sig ctx 1 = some ctx.env := by
+      unfold PrintEliminators.slotEnv
+      rw [hnode]
+      rfl
+    have reading := PrintEliminators.slotsJoin_term slotsPlain member1
+    rw [henv, PrintEliminators.slotDepth_eq hnode hlen rfl hfind 1 (.term request), hout] at reading
+    simp only [Option.map_some, Option.getD_some] at reading
+    have depth : argDepth .eff (argSortOf (.term request : ArgF Op (EffSelfCarrier Op))) n
+        (RowOut.rowCall.levelAt 1) = ctx.env.length := by
+      rw [hlen]
+      rfl
+    rw [depth, PrintEliminators.atDepth_self] at reading
+    have hplain := PrintEliminators.perform_plain hnode reading
+      (fun b hb => PrintEliminators.slotsJoin_op slotsPlain member0 b hb) hperform
+    rw [hlen] at hplain
+    unfold tableLayer.rowPrint
+    rw [hfindPlain]
+    simp only [hout, List.map_cons, List.map_nil, ArgF.fold]
+    exact hplain
+  · have named := List.all_eq_true.mp table_invokeNamed row (List.mem_of_find?_eq_some hfind)
+    simp only [rowInvokeNamed, hout, Bool.and_eq_true, beq_iff_eq] at named
+    have selectedRow := List.find?_some hfind
+    obtain ⟨hfam, hctor⟩ := selects_fam_ctor selectedRow
+    rw [named.1] at hfam
+    rw [named.2] at hctor
+    subst hfam hctor
+    obtain ⟨k, request, progs, rfl, rfl⟩ := eff_of_view_invoke viewed
+    obtain ⟨ctx', bodies, hctx', hbodies, hinvoke⟩ := site_invoke_inv hfind hout typed
+    have hprogs := childPlain 2 .effs progs rfl bodies (by rw [hout]; exact hbodies)
+    rw [hout] at hprogs
+    change cataFam (printAlg sig) .effs progs (n + 1) = .ok bodies at hprogs
+    unfold tableLayer.rowPrint
+    rw [hfindPlain]
+    simp only [hout, List.map_cons, List.map_nil, ArgF.fold, hprogs, ok_bind]
+    exact hinvoke
+
+/-- **A statement**, where no join needs a type: its successful typed print is its print,
+given its children's. A step of `printTyped_eq_print`. -/
+theorem plain_stmt
+    (noSites : ∀ path, PrintEliminators.joinsAtTable sig (annotate sig env0 root) root path = false)
+    {st : Program.Stmt Op} {path : List Nat} {n : Nat} {target : TypeScript.Stmt} {declared : Nat}
+    (focus : SiteFocused root sig env0 path .stmt st n)
+    (children : ChildrenPlain sig env0 root .stmt st)
+    (printed : cata_stmt (plainSitesAlg sig env0 root) st path n = .ok (target, declared)) :
+    cata_stmt (printAlg sig) st n = .ok (target, declared) := by
+  obtain ⟨ctor, args, viewed⟩ : ∃ ctor args, view .stmt st = (ctor, args) := ⟨_, _, rfl⟩
+  have built : build .stmt ctor args = some st := by
+    have h := build_view .stmt st
+    rwa [viewed] at h
+  obtain ⟨ctx, found⟩ := typed_context (fam := .stmt) (.inr (.inr (.inr rfl))) printed
+  obtain ⟨hnode, hlen⟩ := site_context_matches focus notNilSpine_stmt found
+  obtain ⟨_, slotsPlain⟩ := joins_plain noSites found
+  have equation := typedSites_cata_build sig (fun _ => none)
+    (PrintEliminators.contextAtTable (annotate sig env0 root) root) .stmt ctor args st built path
+  simp only [cataFam] at equation
+  rw [equation, found] at printed
+  obtain ⟨row, t, τ, hfindTyped, hout, hτ, hinst, hdeclared⟩ :=
+    site_stmtPrint_inv printed
+  have hfind : Templates.table.find? (fun r => r.selects .stmt ctor args) = some row := by
+    simpa only [selects_atAddress, selects_fold] using hfindTyped
+  have childPlain : ∀ i fam' (c : EffSelfCarrier Op fam'), args[i]? = some (.child fam' c) →
+      ∀ out, cataFam (plainSitesAlg sig env0 root) fam' c (path ++ [(args.take i).countP isChildArg])
+          (argDepth .stmt (.child fam') n (row.out.levelAt i)) = .ok out →
+        cataFam (printAlg sig) fam' c (argDepth .stmt (.child fam') n (row.out.levelAt i)) = .ok out := by
+    intro i fam' c captured out printedChild
+    have focus' := siteFocused_child_typed focus viewed hfind captured printedChild
+    exact children fam' c _ _ out (by rw [viewed]; exact List.mem_of_getElem? captured) focus'
+      printedChild
+  have hτPlain := printArgs_site_plain hnode hlen viewed hfind slotsPlain childPlain
+    (by rw [hout]; exact hτ)
+  rw [hout] at hτPlain
+  have hfindPlain : Templates.table.find?
+      (fun r => r.selects .stmt ctor (args.map (ArgF.fold (printAlg sig)))) = some row := by
+    simpa only [selects_fold] using hfind
+  have hcata : cataFam (printAlg sig) .stmt st =
+      tableLayer sig .stmt ctor (args.map (ArgF.fold (printAlg sig))) :=
+    cata_build (tableLayer sig) .stmt ctor args st built
+  simp only [cataFam] at hcata
+  rw [hcata]
+  obtain ⟨rfam, rctor, rfixed, rout⟩ := row
+  simp only at hout
+  subst hout hdeclared
+  simp only [tableLayer, hfindPlain, hτPlain, ok_bind, hinst]
+
+/-- **A spine of programs**, where no join needs a type: its successful typed print is its print,
+given its items'. A step of `printTyped_eq_print`. -/
+theorem plain_effs {es : Effs Op} {path : List Nat} {n : Nat} {ys : List Expr}
+    (focus : SiteFocused root sig env0 path .effs es n)
+    (children : ChildrenPlain sig env0 root .effs es)
+    (printed : cata_effs (plainSitesAlg sig env0 root) es path n = .ok ys) :
+    cata_effs (printAlg sig) es n = .ok ys := by
+  cases es with
+  | nil =>
+    rw [typedSites_effs_nil, Except.ok.injEq] at printed
+    subst ys
+    rfl
+  | cons head tail =>
+    rw [typedSites_effs_cons] at printed
+    obtain ⟨y, hy, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨rest, hrest, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨_, foundHead⟩ := typed_context (fam := .eff) (.inl rfl) hy
+    have hy' := children .eff head (path ++ [0]) n y List.mem_cons_self
+      (siteFocused_effs_head focus foundHead) hy
+    have hrest' := children .effs tail (path ++ [1]) n rest
+      (List.mem_cons_of_mem _ List.mem_cons_self) (siteFocused_effs_tail_typed focus hrest) hrest
+    simp only [Except.ok.injEq] at printed
+    subst ys
+    simp only [cataFam] at hy' hrest'
+    rw [cata_effs_cons, hy', hrest']
+    rfl
+
+/-- **A spine of layers**, where no join needs a type: its successful typed print is its print,
+given its items'. A step of `printTyped_eq_print`. -/
+theorem plain_layers {ls : LayerTerms Op} {path : List Nat} {n : Nat} {ys : List Expr}
+    (focus : SiteFocused root sig env0 path .layers ls n)
+    (children : ChildrenPlain sig env0 root .layers ls)
+    (printed : cata_layers (plainSitesAlg sig env0 root) ls path n = .ok ys) :
+    cata_layers (printAlg sig) ls n = .ok ys := by
+  cases ls with
+  | nil =>
+    rw [typedSites_layers_nil, Except.ok.injEq] at printed
+    subst ys
+    rfl
+  | cons head tail =>
+    rw [typedSites_layers_cons] at printed
+    obtain ⟨y, hy, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨rest, hrest, printed⟩ := bind_eq_ok.mp printed
+    have hy' := children .layer head (path ++ [0]) n y List.mem_cons_self
+      (siteFocused_layers_head focus) hy
+    have hrest' := children .layers tail (path ++ [1]) n rest
+      (List.mem_cons_of_mem _ List.mem_cons_self) (siteFocused_layers_tail focus) hrest
+    simp only [Except.ok.injEq] at printed
+    subst ys
+    simp only [cataFam] at hy' hrest'
+    rw [cata_layers_cons, hy', hrest']
+    rfl
+
+/-- **A spine of statements**, where no join needs a type: its successful typed print is its
+print, given its items'. A step of `printTyped_eq_print`. -/
+theorem plain_stmts {ss : Stmts Op} {path : List Nat} {n : Nat} {ys : List TypeScript.Stmt}
+    (focus : SiteFocused root sig env0 path .stmts ss n)
+    (children : ChildrenPlain sig env0 root .stmts ss)
+    (printed : cata_stmts (plainSitesAlg sig env0 root) ss path n = .ok ys) :
+    cata_stmts (printAlg sig) ss n = .ok ys := by
+  cases ss with
+  | nil =>
+    rw [typedSites_stmts_nil, Except.ok.injEq] at printed
+    subst ys
+    rfl
+  | cons st rest =>
+    rw [typedSites_stmts_cons] at printed
+    obtain ⟨head, hhead, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨tail, htail, printed⟩ := bind_eq_ok.mp printed
+    obtain ⟨target, declared⟩ := head
+    have hhead' := children .stmt st (path ++ [0]) n (target, declared) List.mem_cons_self
+      (siteFocused_stmts_head focus) hhead
+    simp only [cataFam] at hhead'
+    have htail' := children .stmts rest (path ++ [1]) (n + declared) tail
+      (List.mem_cons_of_mem _ List.mem_cons_self) (siteFocused_stmts_tail_typed focus hhead' htail)
+      htail
+    simp only [Except.ok.injEq] at printed
+    subst ys
+    simp only [cataFam] at htail'
+    rw [cata_stmts_cons, hhead']
+    simp only [ok_bind]
+    rw [htail']
+    rfl
+
+/-- **Where no join needs a type, every focused node's successful typed print is its print**, by
+strong induction on the node's size (`size_child_lt`). Placement: concept `exact-codecs`, a step
+of the claim `typed-print-connector` (R8); its consumer is `printTyped_eq_print`. -/
+@[semantics "exact-codecs" (requirement := R8)]
+theorem plain_upTo
+    (noSites : ∀ path, PrintEliminators.joinsAtTable sig (annotate sig env0 root) root path = false)
+    (m : Nat) : ∀ fam (source : EffSelfCarrier Op fam) path n (out : Out fam),
+      cataFam sizeAlg fam source ≤ m → SiteFocused root sig env0 path fam source n →
+      cataFam (plainSitesAlg sig env0 root) fam source path n = .ok out →
+      cataFam (printAlg sig) fam source n = .ok out := by
+  induction m using Nat.strongRecOn with
+  | _ m ih =>
+    intro fam source path n out hsize focus printed
+    have children : ChildrenPlain sig env0 root fam source :=
+      fun fam' c path' d out' member focus' printed' =>
+        ih (cataFam sizeAlg fam' c) (by have := size_child_lt fam source fam' c member; omega)
+          fam' c path' d out' (Nat.le_refl _) focus' printed'
+    obtain ⟨ctor, args, viewed⟩ : ∃ ctor args, view fam source = (ctor, args) := ⟨_, _, rfl⟩
+    have built : build fam ctor args = some source := by
+      have h := build_view fam source
+      rwa [viewed] at h
+    have hcata : cataFam (printAlg sig) fam source =
+        tableLayer sig fam ctor (args.map (ArgF.fold (printAlg sig))) :=
+      cata_build (tableLayer sig) fam ctor args source built
+    cases fam with
+    | eff =>
+      simp only [cataFam] at hcata ⊢
+      rw [hcata]
+      exact plain_node noSites (.inl rfl) focus viewed children printed
+    | action =>
+      simp only [cataFam] at hcata ⊢
+      rw [hcata]
+      exact plain_node noSites (.inr (.inl rfl)) focus viewed children printed
+    | layer =>
+      simp only [cataFam] at hcata ⊢
+      rw [hcata]
+      exact plain_node noSites (.inr (.inr rfl)) focus viewed children printed
+    | stmt => exact plain_stmt noSites focus children printed
+    | effs => exact plain_effs focus children printed
+    | layers => exact plain_layers focus children printed
+    | stmts => exact plain_stmts focus children printed
+
+end Effect4.Codegen
+
+namespace Effect4.Program
+
+variable {Op : Type}
+
+/-- **Where no join needs a type and the typed print succeeds, it is the print**, byte for byte.
+The pointer of the claim `typed-print-connector` (exact-codecs, R8). The typed print is the site
+printer at the address table (`printTyped`). Under `NoJoin` the annotation answers nothing
+(`focusAtTable_annotate`), and no node or slot of the program needs a type, so each focused
+node's successful typed print is its print (`plain_upTo`). The typed print can refuse where the
+print succeeds: an address with no checked environment has no context (`E4-PRINT-CE-005`). It
+makes no TypeScript typing or execution claim. -/
+@[semantics "exact-codecs" (requirement := R8)]
+theorem printTyped_eq_print (s : Signature Op) (env0 : TyEnv) (p : Eff Op)
+    (noJoin : NoJoin s env0 p) {x : TypeScript.Expr} (printed : printTyped s env0 p = .ok x) :
+    print s env0.length p = .ok x := by
+  obtain ⟨noRows, noSites⟩ := noJoin
+  have annotation : typeArgsAt s (annotate s env0 p) p = fun _ => none := by
+    funext path
+    have absent := noRows path
+    unfold typeArgsAt
+    rw [focusAtTable_annotate]
+    unfold PrintedJoin.at_ at absent
+    cases hf : focusAt s env0 p path with
+    | none => rfl
+    | some focus =>
+      rw [hf] at absent
+      obtain ⟨program, env, ty⟩ := focus
+      cases program with
+      | perform op request =>
+        cases ht : termTy s env request with
+        | none => simp only [Option.bind_some, Focus.joinArgs, ht, Option.bind_none]
+        | some requestTy =>
+          simp only [Option.bind_some, ht, Option.map_some, Option.getD_some] at absent
+          simp only [Option.bind_some, Focus.joinArgs, ht, absent, Bool.false_eq_true, ↓reduceIte]
+      | _ => rfl
+  change Effect4.Codegen.Templates.printTypedSitesAt s (typeArgsAt s (annotate s env0 p) p)
+    (Effect4.Codegen.PrintEliminators.contextAtTable (annotate s env0 p) p) env0.length p = .ok x
+    at printed
+  rw [annotation] at printed
+  exact Effect4.Codegen.plain_upTo (fun path => noSites path) (cataFam sizeAlg .eff p) .eff p []
+    env0.length x (Nat.le_refl _) (Effect4.Codegen.siteFocused_root p s env0) printed
+
+end Effect4.Program
