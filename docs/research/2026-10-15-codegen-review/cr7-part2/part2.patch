+/-!
+## The connector: where no join needs a type, the typed print is the print
+
+Placement: concept `exact-codecs`, the claim `typed-print-connector` (R8). Every declaration
+below is a step of `printTyped_eq_print`, its consumer. The typed print is the site printer
+alone since the codegen refactor's CR-7. Under `NoJoin` its term leaves print as the term printer
+prints (`term_eq_printTerm`), its node decorations add nothing (`decorate_plain`), and its row
+calls insert no type argument (`perform_plain`). The induction runs over the node's size
+(`plain_upTo`). The typed print can refuse where the print succeeds, at an address with no
+checked environment (`E4-PRINT-CE-005`), so the theorem reads a successful typed print.
+-/
+
+set_option autoImplicit false
+
+namespace Effect4.Codegen.EraseTermTypes
+
+open TypeScript Effect4.Program Effect4.Laws.Auto
+
+variable {Op : Type}
+
+/-- The typed term fold keeps the original terms of an argument list. A step of
+`printTyped_eq_print`. -/
+theorem typedTerms_original (sig : Signature Op) (ts : Terms) :
+    (cata_terms (PrintEliminators.termAlg sig) ts).1 = ts :=
+  (hom_eq_cata_terms (typedOriginalHom sig) ts).trans (cata_id_terms ts)
+
+/-- The join detector's fold keeps the original term: each field is its constructor. -/
+def joinOriginalHom (sig : Signature Op) : TermHom TermAlgebra.id where
+  f_term t := (cata_term (PrintEliminators.termJoinAlg sig) t).1
+  f_terms ts := (cata_terms (PrintEliminators.termJoinAlg sig) ts).1
+  h_term_var _ := rfl
+  h_term_lit _ := rfl
+  h_term_app _ _ := rfl
+  h_term_record _ _ _ := rfl
+  h_term_field _ _ _ := rfl
+  h_term_recordSet _ _ _ := rfl
+  h_term_tupleAt _ _ := rfl
+  h_term_fold _ _ _ _ := rfl
+  h_terms_nil := rfl
+  h_terms_cons _ _ := rfl
+
+theorem joinTerm_original (sig : Signature Op) (t : Term) :
+    (cata_term (PrintEliminators.termJoinAlg sig) t).1 = t :=
+  (hom_eq_cata_term (joinOriginalHom sig) t).trans (cata_id_term t)
+
+theorem joinTerms_original (sig : Signature Op) (ts : Terms) :
+    (cata_terms (PrintEliminators.termJoinAlg sig) ts).1 = ts :=
+  (hom_eq_cata_terms (joinOriginalHom sig) ts).trans (cata_id_terms ts)
