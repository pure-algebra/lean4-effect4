R01 e4_trace.ml: emit appends one batch in reverse order

--- a/ocaml/engine/e4_trace.ml
+++ b/ocaml/engine/e4_trace.ml
@@ -13,7 +13,7 @@
 let emit (evs : 'e list) (t : 'e t) : 'e t =
   match evs with
   | [] -> t
-  | _ -> List.fold_left Lcnf_array.push t evs
+  | _ -> List.fold_left Lcnf_array.push t (List.rev evs)
 ;;
 
 let to_list (t : 'e t) : 'e list = Lcnf_array.to_list t
