Y04 e4_memo.ml: compare_path puts a prefix last (still a total order)

--- a/ocaml/engine/e4_memo.ml
+++ b/ocaml/engine/e4_memo.ml
@@ -7,8 +7,8 @@
 let rec compare_path (a : int list) (b : int list) : int =
   match a, b with
   | [], [] -> 0
-  | [], _ :: _ -> -1
-  | _ :: _, [] -> 1
+  | [], _ :: _ -> 1
+  | _ :: _, [] -> -1
   | x :: xs, y :: ys -> if x < y then -1 else if x > y then 1 else compare_path xs ys
