  h [] = Effect4.Api.Runner.Play.id →
    (∀ (c : Effect4.Api.Runner.Command), h [c] = Effect4.Api.Runner.stepPlay c) →
      (∀ (a b : List Effect4.Api.Runner.Command), h (a ++ b) = (h a).comp (h b)) →
        ∀ (journal : List Effect4.Api.Runner.Command), h journal = Effect4.Api.Runner.replayPlay journal
