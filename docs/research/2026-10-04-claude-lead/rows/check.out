@Effect4.Scope.closeOrder_eq : ∀ {κ φ : Type u_1} {β : Type u_2} {ε δ ι α : Type u_1}
  (self : Effect4.Scope κ φ β ε δ ι α), self.closeOrder = (List.map Prod.snd self.finalizers).reverse
