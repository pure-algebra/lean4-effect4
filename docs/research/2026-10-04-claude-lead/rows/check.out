  (env : Effect4.Program.TyEnv) (body finalizer : Effect4.Program.Eff Effect4.Program.NativeOp)
  (a b : Effect4.Program.EffTy),
  Effect4.Program.effTy sig env body = some a →
    Effect4.Program.effTy sig env finalizer = some b →
      ((List.find? (fun f => f.id == "ensuring") Effect4.Codegen.Forms.all).bind fun f =>
              Effect4.Codegen.Forms.Template.expand (List.length env) { effects := [body, finalizer] } f.expansion).bind
          (Effect4.Program.effTy sig env) =
        some { answer := a.answer, error := a.error.join b.error, requires := a.requires.union b.requires }
