@Effect4.Scope.close_idempotent : ∀ {κ φ : Type u_1} {β : Type u_2} {ε δ ι α : Type u_1}
  (run : φ → Effect4.Exit β ε δ ι α → Effect4.Exit Unit ε δ ι α) (self : Effect4.Scope κ φ β ε δ ι α)
  (exit : Effect4.Exit β ε δ ι α), self.isClosed = true → Effect4.Scope.close run self exit = (self, Effect4.Exit.void)
