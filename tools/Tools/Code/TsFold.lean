    cata_stmt alg (.scopedGen a0 a1 a2) =
      alg.stmt_scopedGen a0 (a1.map (cata_stmt alg)) (cata_expr alg a2) := by
  simp only [cata_stmt, cata_pos_list_stmt_eq]

@[simp] theorem cata_stmt_scopedGenMasked {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (a0 : String) (a1 : List TypeScript.Stmt) (a2 : TypeScript.Expr) :
    cata_stmt alg (.scopedGenMasked a0 a1 a2) =
      alg.stmt_scopedGenMasked a0 (a1.map (cata_stmt alg)) (cata_expr alg a2) := by
  simp only [cata_stmt, cata_pos_list_stmt_eq]

@[simp] theorem cata_stmt_breakTo {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (a0 : Option String) :
    cata_stmt alg (.breakTo a0) =
      alg.stmt_breakTo a0 := rfl

@[simp] theorem cata_stmt_continueTo {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (a0 : Option String) :
    cata_stmt alg (.continueTo a0) =
      alg.stmt_continueTo a0 := rfl

@[simp] theorem cata_stmt_exprStmt {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (a0 : TypeScript.Expr) :
    cata_stmt alg (.exprStmt a0) =
      alg.stmt_exprStmt (cata_expr alg a0) := rfl

@[simp] theorem cata_objectentry_property {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (a0 : String) (a1 : TypeScript.Expr) :
    cata_objectentry alg (.property a0 a1) =
      alg.objectentry_property a0 (cata_expr alg a1) := rfl

@[simp] theorem cata_objectentry_spread {R : ExprFam → Type u}
    (alg : ExprAlgebra R) (a0 : TypeScript.Expr) :
    cata_objectentry alg (.spread a0) =
      alg.objectentry_spread (cata_expr alg a0) := rfl

structure ExprHom {R : ExprFam → Type u} (alg : ExprAlgebra R) where
  f_expr : TypeScript.Expr → R .expr
  f_stmt : TypeScript.Stmt → R .stmt
  f_objectentry : TypeScript.ObjectEntry → R .objectentry
  h_expr_ident : ∀ a0, f_expr (.ident a0) =
    alg.expr_ident a0
  h_expr_str : ∀ a0, f_expr (.str a0) =
    alg.expr_str a0
  h_expr_int : ∀ a0, f_expr (.int a0) =
    alg.expr_int a0
  h_expr_float64Bits : ∀ a0, f_expr (.float64Bits a0) =
    alg.expr_float64Bits a0
  h_expr_bool : ∀ a0, f_expr (.bool a0) =
    alg.expr_bool a0
  h_expr_jsNull : f_expr (.jsNull) =
    alg.expr_jsNull
  h_expr_call : ∀ a0 a1, f_expr (.call a0 a1) =
    alg.expr_call (f_expr a0) (a1.map f_expr)
  h_expr_object : ∀ a0, f_expr (.object a0) =
    alg.expr_object (a0.map (prodMapSnd f_expr))
  h_expr_objectML : ∀ a0, f_expr (.objectML a0) =
    alg.expr_objectML (a0.map (prodMapSnd f_expr))
  h_expr_objectQuoted : ∀ a0, f_expr (.objectQuoted a0) =
    alg.expr_objectQuoted (a0.map (prodMapSnd f_expr))
  h_expr_objectQuotedML : ∀ a0, f_expr (.objectQuotedML a0) =
    alg.expr_objectQuotedML (a0.map (prodMapSnd f_expr))
  h_expr_objectFromEntries : ∀ a0, f_expr (.objectFromEntries a0) =
    alg.expr_objectFromEntries (a0.map (prodMapSnd f_expr))
  h_expr_arr : ∀ a0, f_expr (.arr a0) =
    alg.expr_arr (a0.map f_expr)
  h_expr_arrow : ∀ a0 a1, f_expr (.arrow a0 a1) =
    alg.expr_arrow a0 (f_expr a1)
  h_expr_generic : ∀ a0 a1, f_expr (.generic a0 a1) =
    alg.expr_generic (f_expr a0) a1
  h_expr_lambda : ∀ a0 a1 a2, f_expr (.lambda a0 a1 a2) =
    alg.expr_lambda a0 (f_expr a1) a2
  h_expr_method : ∀ a0 a1 a2, f_expr (.method a0 a1 a2) =
    alg.expr_method (f_expr a0) a1 (a2.map f_expr)
  h_expr_member : ∀ a0 a1, f_expr (.member a0 a1) =
    alg.expr_member (f_expr a0) a1
  h_expr_generator : ∀ a0, f_expr (.generator a0) =
    alg.expr_generator (a0.map f_stmt)
  h_expr_cond : ∀ a0 a1 a2, f_expr (.cond a0 a1 a2) =
    alg.expr_cond (f_expr a0) (f_expr a1) (f_expr a2)
  h_expr_arrowBlock : ∀ a0 a1 a2, f_expr (.arrowBlock a0 a1 a2) =
    alg.expr_arrowBlock a0 (a1.map f_stmt) a2
  h_expr_index : ∀ a0 a1, f_expr (.index a0 a1) =
    alg.expr_index (f_expr a0) (f_expr a1)
  h_expr_new : ∀ a0 a1, f_expr (.new a0 a1) =
    alg.expr_new (f_expr a0) (a1.map f_expr)
  h_expr_objectWith : ∀ a0 a1, f_expr (.objectWith a0 a1) =
    alg.expr_objectWith a0 (a1.map f_objectentry)
  h_stmt_constYield : ∀ a0 a1 a2, f_stmt (.constYield a0 a1 a2) =
    alg.stmt_constYield a0 (f_expr a1) a2
  h_stmt_ret : ∀ a0, f_stmt (.ret a0) =
    alg.stmt_ret (f_expr a0)
  h_stmt_yieldDiscard : ∀ a0, f_stmt (.yieldDiscard a0) =
    alg.stmt_yieldDiscard (f_expr a0)
  h_stmt_letDefinite : ∀ a0 a1, f_stmt (.letDefinite a0 a1) =
    alg.stmt_letDefinite a0 a1
  h_stmt_letInit : ∀ a0 a1 a2, f_stmt (.letInit a0 a1 a2) =
    alg.stmt_letInit a0 (f_expr a1) a2
  h_stmt_assign : ∀ a0 a1, f_stmt (.assign a0 a1) =
    alg.stmt_assign a0 (f_expr a1)
  h_stmt_whileTrue : ∀ a0 a1, f_stmt (.whileTrue a0 a1) =
    alg.stmt_whileTrue a0 (a1.map f_stmt)
  h_stmt_switch : ∀ a0 a1, f_stmt (.switch a0 a1) =
    alg.stmt_switch (f_expr a0) (a1.map (prodMapSnd (List.map f_stmt)))
  h_stmt_ifElse : ∀ a0 a1 a2, f_stmt (.ifElse a0 a1 a2) =
    alg.stmt_ifElse (f_expr a0) (a1.map f_stmt) (a2.map f_stmt)
  h_stmt_labelled : ∀ a0 a1, f_stmt (.labelled a0 a1) =
    alg.stmt_labelled a0 (a1.map f_stmt)
  h_stmt_scopedGen : ∀ a0 a1 a2, f_stmt (.scopedGen a0 a1 a2) =
    alg.stmt_scopedGen a0 (a1.map f_stmt) (f_expr a2)
  h_stmt_scopedGenMasked : ∀ a0 a1 a2, f_stmt (.scopedGenMasked a0 a1 a2) =
    alg.stmt_scopedGenMasked a0 (a1.map f_stmt) (f_expr a2)
  h_stmt_breakTo : ∀ a0, f_stmt (.breakTo a0) =
    alg.stmt_breakTo a0
  h_stmt_continueTo : ∀ a0, f_stmt (.continueTo a0) =
    alg.stmt_continueTo a0
  h_stmt_exprStmt : ∀ a0, f_stmt (.exprStmt a0) =
    alg.stmt_exprStmt (f_expr a0)
  h_objectentry_property : ∀ a0 a1, f_objectentry (.property a0 a1) =
    alg.objectentry_property a0 (f_expr a1)
  h_objectentry_spread : ∀ a0, f_objectentry (.spread a0) =
    alg.objectentry_spread (f_expr a0)

mutual
theorem hom_eq_cata_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (node : TypeScript.Expr) :
    hom.f_expr node = cata_expr alg node := by
  match node with
  | .ident a0 =>
    simp only [cata_expr, hom.h_expr_ident a0]
  | .str a0 =>
    simp only [cata_expr, hom.h_expr_str a0]
  | .int a0 =>
    simp only [cata_expr, hom.h_expr_int a0]
  | .float64Bits a0 =>
    simp only [cata_expr, hom.h_expr_float64Bits a0]
  | .bool a0 =>
    simp only [cata_expr, hom.h_expr_bool a0]
  | .jsNull =>
    simp only [cata_expr, hom.h_expr_jsNull]
  | .call a0 a1 =>
    simp only [cata_expr, hom.h_expr_call a0 a1, hom_eq_cata_expr hom a0, hom_pos_list_expr hom a1]
  | .object a0 =>
    simp only [cata_expr, hom.h_expr_object a0, hom_pos_list_prod_string_expr hom a0]
  | .objectML a0 =>
    simp only [cata_expr, hom.h_expr_objectML a0, hom_pos_list_prod_string_expr hom a0]
  | .objectQuoted a0 =>
    simp only [cata_expr, hom.h_expr_objectQuoted a0, hom_pos_list_prod_string_expr hom a0]
  | .objectQuotedML a0 =>
    simp only [cata_expr, hom.h_expr_objectQuotedML a0, hom_pos_list_prod_string_expr hom a0]
  | .objectFromEntries a0 =>
    simp only [cata_expr, hom.h_expr_objectFromEntries a0, hom_pos_list_prod_string_expr hom a0]
  | .arr a0 =>
    simp only [cata_expr, hom.h_expr_arr a0, hom_pos_list_expr hom a0]
  | .arrow a0 a1 =>
    simp only [cata_expr, hom.h_expr_arrow a0 a1, hom_eq_cata_expr hom a1]
  | .generic a0 a1 =>
    simp only [cata_expr, hom.h_expr_generic a0 a1, hom_eq_cata_expr hom a0]
  | .lambda a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_lambda a0 a1 a2, hom_eq_cata_expr hom a1]
  | .method a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_method a0 a1 a2, hom_eq_cata_expr hom a0, hom_pos_list_expr hom a2]
  | .member a0 a1 =>
    simp only [cata_expr, hom.h_expr_member a0 a1, hom_eq_cata_expr hom a0]
  | .generator a0 =>
    simp only [cata_expr, hom.h_expr_generator a0, hom_pos_list_stmt hom a0]
  | .cond a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_cond a0 a1 a2, hom_eq_cata_expr hom a0, hom_eq_cata_expr hom a1, hom_eq_cata_expr hom a2]
  | .arrowBlock a0 a1 a2 =>
    simp only [cata_expr, hom.h_expr_arrowBlock a0 a1 a2, hom_pos_list_stmt hom a1]
  | .index a0 a1 =>
    simp only [cata_expr, hom.h_expr_index a0 a1, hom_eq_cata_expr hom a0, hom_eq_cata_expr hom a1]
  | .new a0 a1 =>
    simp only [cata_expr, hom.h_expr_new a0 a1, hom_eq_cata_expr hom a0, hom_pos_list_expr hom a1]
  | .objectWith a0 a1 =>
    simp only [cata_expr, hom.h_expr_objectWith a0 a1, hom_pos_list_objectentry hom a1]
termination_by structural node
theorem hom_eq_cata_stmt {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (node : TypeScript.Stmt) :
    hom.f_stmt node = cata_stmt alg node := by
  match node with
  | .constYield a0 a1 a2 =>
    simp only [cata_stmt, hom.h_stmt_constYield a0 a1 a2, hom_eq_cata_expr hom a1]
  | .ret a0 =>
    simp only [cata_stmt, hom.h_stmt_ret a0, hom_eq_cata_expr hom a0]
  | .yieldDiscard a0 =>
    simp only [cata_stmt, hom.h_stmt_yieldDiscard a0, hom_eq_cata_expr hom a0]
  | .letDefinite a0 a1 =>
    simp only [cata_stmt, hom.h_stmt_letDefinite a0 a1]
  | .letInit a0 a1 a2 =>
    simp only [cata_stmt, hom.h_stmt_letInit a0 a1 a2, hom_eq_cata_expr hom a1]
  | .assign a0 a1 =>
    simp only [cata_stmt, hom.h_stmt_assign a0 a1, hom_eq_cata_expr hom a1]
  | .whileTrue a0 a1 =>
    simp only [cata_stmt, hom.h_stmt_whileTrue a0 a1, hom_pos_list_stmt hom a1]
  | .switch a0 a1 =>
    simp only [cata_stmt, hom.h_stmt_switch a0 a1, hom_eq_cata_expr hom a0, hom_pos_list_prod_nat_list_stmt hom a1]
  | .ifElse a0 a1 a2 =>
    simp only [cata_stmt, hom.h_stmt_ifElse a0 a1 a2, hom_eq_cata_expr hom a0, hom_pos_list_stmt hom a1, hom_pos_list_stmt hom a2]
  | .labelled a0 a1 =>
    simp only [cata_stmt, hom.h_stmt_labelled a0 a1, hom_pos_list_stmt hom a1]
  | .scopedGen a0 a1 a2 =>
    simp only [cata_stmt, hom.h_stmt_scopedGen a0 a1 a2, hom_pos_list_stmt hom a1, hom_eq_cata_expr hom a2]
  | .scopedGenMasked a0 a1 a2 =>
    simp only [cata_stmt, hom.h_stmt_scopedGenMasked a0 a1 a2, hom_pos_list_stmt hom a1, hom_eq_cata_expr hom a2]
  | .breakTo a0 =>
    simp only [cata_stmt, hom.h_stmt_breakTo a0]
  | .continueTo a0 =>
    simp only [cata_stmt, hom.h_stmt_continueTo a0]
  | .exprStmt a0 =>
    simp only [cata_stmt, hom.h_stmt_exprStmt a0, hom_eq_cata_expr hom a0]
termination_by structural node
theorem hom_eq_cata_objectentry {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (node : TypeScript.ObjectEntry) :
    hom.f_objectentry node = cata_objectentry alg node := by
  match node with
  | .property a0 a1 =>
    simp only [cata_objectentry, hom.h_objectentry_property a0 a1, hom_eq_cata_expr hom a1]
  | .spread a0 =>
    simp only [cata_objectentry, hom.h_objectentry_spread a0, hom_eq_cata_expr hom a0]
termination_by structural node
theorem hom_pos_list_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (xs : List TypeScript.Expr) :
    xs.map hom.f_expr = cata_pos_list_expr alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_expr, List.map_nil]
  | x :: rest => simp only [cata_pos_list_expr, List.map_cons, hom_eq_cata_expr hom x, hom_pos_list_expr hom rest]
termination_by structural xs
theorem hom_pos_prod_string_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (x : String × TypeScript.Expr) :
    prodMapSnd hom.f_expr x = cata_pos_prod_string_expr alg x := by
  match x with
  | (u, v) => simp only [cata_pos_prod_string_expr, prodMapSnd_mk, hom_eq_cata_expr hom v]
termination_by structural x
theorem hom_pos_list_prod_string_expr {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (xs : List (String × TypeScript.Expr)) :
    xs.map (prodMapSnd hom.f_expr) = cata_pos_list_prod_string_expr alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_prod_string_expr, List.map_nil]
  | x :: rest => simp only [cata_pos_list_prod_string_expr, List.map_cons, hom_pos_prod_string_expr hom x, hom_pos_list_prod_string_expr hom rest]
termination_by structural xs
theorem hom_pos_list_stmt {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (xs : List TypeScript.Stmt) :
    xs.map hom.f_stmt = cata_pos_list_stmt alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_stmt, List.map_nil]
  | x :: rest => simp only [cata_pos_list_stmt, List.map_cons, hom_eq_cata_stmt hom x, hom_pos_list_stmt hom rest]
termination_by structural xs
theorem hom_pos_list_objectentry {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (xs : List TypeScript.ObjectEntry) :
    xs.map hom.f_objectentry = cata_pos_list_objectentry alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_objectentry, List.map_nil]
  | x :: rest => simp only [cata_pos_list_objectentry, List.map_cons, hom_eq_cata_objectentry hom x, hom_pos_list_objectentry hom rest]
termination_by structural xs
theorem hom_pos_prod_nat_list_stmt {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (x : Nat × List TypeScript.Stmt) :
    prodMapSnd (List.map hom.f_stmt) x = cata_pos_prod_nat_list_stmt alg x := by
  match x with
  | (u, v) => simp only [cata_pos_prod_nat_list_stmt, prodMapSnd_mk, hom_pos_list_stmt hom v]
termination_by structural x
theorem hom_pos_list_prod_nat_list_stmt {R : ExprFam → Type u}
    {alg : ExprAlgebra R} (hom : ExprHom alg) (xs : List (Nat × List TypeScript.Stmt)) :
    xs.map (prodMapSnd (List.map hom.f_stmt)) = cata_pos_list_prod_nat_list_stmt alg xs := by
  match xs with
  | [] => simp only [cata_pos_list_prod_nat_list_stmt, List.map_nil]
  | x :: rest => simp only [cata_pos_list_prod_nat_list_stmt, List.map_cons, hom_pos_prod_nat_list_stmt hom x, hom_pos_list_prod_nat_list_stmt hom rest]
termination_by structural xs
end

abbrev ExprSelfCarrier : ExprFam → Type
  | .expr => TypeScript.Expr
  | .stmt => TypeScript.Stmt
  | .objectentry => TypeScript.ObjectEntry

def ExprAlgebra.id : ExprAlgebra (ExprSelfCarrier) where
  expr_ident a0 := TypeScript.Expr.ident a0
  expr_str a0 := TypeScript.Expr.str a0
  expr_int a0 := TypeScript.Expr.int a0
  expr_float64Bits a0 := TypeScript.Expr.float64Bits a0
  expr_bool a0 := TypeScript.Expr.bool a0
  expr_jsNull := TypeScript.Expr.jsNull
  expr_call a0 a1 := TypeScript.Expr.call a0 a1
  expr_object a0 := TypeScript.Expr.object a0
  expr_objectML a0 := TypeScript.Expr.objectML a0
  expr_objectQuoted a0 := TypeScript.Expr.objectQuoted a0
  expr_objectQuotedML a0 := TypeScript.Expr.objectQuotedML a0
  expr_objectFromEntries a0 := TypeScript.Expr.objectFromEntries a0
  expr_arr a0 := TypeScript.Expr.arr a0
  expr_arrow a0 a1 := TypeScript.Expr.arrow a0 a1
  expr_generic a0 a1 := TypeScript.Expr.generic a0 a1
  expr_lambda a0 a1 a2 := TypeScript.Expr.lambda a0 a1 a2
  expr_method a0 a1 a2 := TypeScript.Expr.method a0 a1 a2
  expr_member a0 a1 := TypeScript.Expr.member a0 a1
  expr_generator a0 := TypeScript.Expr.generator a0
  expr_cond a0 a1 a2 := TypeScript.Expr.cond a0 a1 a2
  expr_arrowBlock a0 a1 a2 := TypeScript.Expr.arrowBlock a0 a1 a2
  expr_index a0 a1 := TypeScript.Expr.index a0 a1
  expr_new a0 a1 := TypeScript.Expr.new a0 a1
  expr_objectWith a0 a1 := TypeScript.Expr.objectWith a0 a1
  stmt_constYield a0 a1 a2 := TypeScript.Stmt.constYield a0 a1 a2
  stmt_ret a0 := TypeScript.Stmt.ret a0
  stmt_yieldDiscard a0 := TypeScript.Stmt.yieldDiscard a0
  stmt_letDefinite a0 a1 := TypeScript.Stmt.letDefinite a0 a1
  stmt_letInit a0 a1 a2 := TypeScript.Stmt.letInit a0 a1 a2
  stmt_assign a0 a1 := TypeScript.Stmt.assign a0 a1
  stmt_whileTrue a0 a1 := TypeScript.Stmt.whileTrue a0 a1
  stmt_switch a0 a1 := TypeScript.Stmt.switch a0 a1
  stmt_ifElse a0 a1 a2 := TypeScript.Stmt.ifElse a0 a1 a2
  stmt_labelled a0 a1 := TypeScript.Stmt.labelled a0 a1
  stmt_scopedGen a0 a1 a2 := TypeScript.Stmt.scopedGen a0 a1 a2
  stmt_scopedGenMasked a0 a1 a2 := TypeScript.Stmt.scopedGenMasked a0 a1 a2
  stmt_breakTo a0 := TypeScript.Stmt.breakTo a0
  stmt_continueTo a0 := TypeScript.Stmt.continueTo a0
  stmt_exprStmt a0 := TypeScript.Stmt.exprStmt a0
  objectentry_property a0 a1 := TypeScript.ObjectEntry.property a0 a1
  objectentry_spread a0 := TypeScript.ObjectEntry.spread a0

mutual
@[simp] theorem cata_id_expr (node : TypeScript.Expr) :
    cata_expr (ExprAlgebra.id) node = node := by
  match node with
  | .ident a0 =>
    simp only [cata_expr]
    rfl
  | .str a0 =>
    simp only [cata_expr]
    rfl
  | .int a0 =>
    simp only [cata_expr]
    rfl
  | .float64Bits a0 =>
    simp only [cata_expr]
    rfl
  | .bool a0 =>
    simp only [cata_expr]
    rfl
  | .jsNull =>
    simp only [cata_expr]
    rfl
  | .call a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_pos_list_expr a1]
    rfl
  | .object a0 =>
    simp only [cata_expr, cata_id_pos_list_prod_string_expr a0]
    rfl
  | .objectML a0 =>
    simp only [cata_expr, cata_id_pos_list_prod_string_expr a0]
    rfl
  | .objectQuoted a0 =>
    simp only [cata_expr, cata_id_pos_list_prod_string_expr a0]
    rfl
  | .objectQuotedML a0 =>
    simp only [cata_expr, cata_id_pos_list_prod_string_expr a0]
    rfl
  | .objectFromEntries a0 =>
    simp only [cata_expr, cata_id_pos_list_prod_string_expr a0]
    rfl
  | .arr a0 =>
    simp only [cata_expr, cata_id_pos_list_expr a0]
    rfl
  | .arrow a0 a1 =>
    simp only [cata_expr, cata_id_expr a1]
    rfl
  | .generic a0 a1 =>
    simp only [cata_expr, cata_id_expr a0]
    rfl
  | .lambda a0 a1 a2 =>
    simp only [cata_expr, cata_id_expr a1]
    rfl
  | .method a0 a1 a2 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_pos_list_expr a2]
    rfl
  | .member a0 a1 =>
    simp only [cata_expr, cata_id_expr a0]
    rfl
  | .generator a0 =>
    simp only [cata_expr, cata_id_pos_list_stmt a0]
    rfl
  | .cond a0 a1 a2 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_expr a1, cata_id_expr a2]
    rfl
  | .arrowBlock a0 a1 a2 =>
    simp only [cata_expr, cata_id_pos_list_stmt a1]
    rfl
  | .index a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_expr a1]
    rfl
  | .new a0 a1 =>
    simp only [cata_expr, cata_id_expr a0, cata_id_pos_list_expr a1]
    rfl
  | .objectWith a0 a1 =>
    simp only [cata_expr, cata_id_pos_list_objectentry a1]
    rfl
termination_by structural node
@[simp] theorem cata_id_stmt (node : TypeScript.Stmt) :
    cata_stmt (ExprAlgebra.id) node = node := by
  match node with
  | .constYield a0 a1 a2 =>
    simp only [cata_stmt, cata_id_expr a1]
    rfl
  | .ret a0 =>
    simp only [cata_stmt, cata_id_expr a0]
    rfl
  | .yieldDiscard a0 =>
    simp only [cata_stmt, cata_id_expr a0]
    rfl
  | .letDefinite a0 a1 =>
    simp only [cata_stmt]
    rfl
  | .letInit a0 a1 a2 =>
    simp only [cata_stmt, cata_id_expr a1]
    rfl
  | .assign a0 a1 =>
    simp only [cata_stmt, cata_id_expr a1]
    rfl
  | .whileTrue a0 a1 =>
    simp only [cata_stmt, cata_id_pos_list_stmt a1]
    rfl
  | .switch a0 a1 =>
    simp only [cata_stmt, cata_id_expr a0, cata_id_pos_list_prod_nat_list_stmt a1]
    rfl
  | .ifElse a0 a1 a2 =>
    simp only [cata_stmt, cata_id_expr a0, cata_id_pos_list_stmt a1, cata_id_pos_list_stmt a2]
    rfl
  | .labelled a0 a1 =>
    simp only [cata_stmt, cata_id_pos_list_stmt a1]
    rfl
  | .scopedGen a0 a1 a2 =>
    simp only [cata_stmt, cata_id_pos_list_stmt a1, cata_id_expr a2]
    rfl
  | .scopedGenMasked a0 a1 a2 =>
    simp only [cata_stmt, cata_id_pos_list_stmt a1, cata_id_expr a2]
    rfl
  | .breakTo a0 =>
    simp only [cata_stmt]
    rfl
  | .continueTo a0 =>
    simp only [cata_stmt]
    rfl
  | .exprStmt a0 =>
    simp only [cata_stmt, cata_id_expr a0]
    rfl
termination_by structural node
@[simp] theorem cata_id_objectentry (node : TypeScript.ObjectEntry) :
    cata_objectentry (ExprAlgebra.id) node = node := by
  match node with
  | .property a0 a1 =>
    simp only [cata_objectentry, cata_id_expr a1]
    rfl
  | .spread a0 =>
    simp only [cata_objectentry, cata_id_expr a0]
    rfl
termination_by structural node
theorem cata_id_pos_list_expr (xs : List TypeScript.Expr) :
    cata_pos_list_expr (ExprAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_expr]
  | x :: rest => simp only [cata_pos_list_expr, cata_id_expr x, cata_id_pos_list_expr rest]
termination_by structural xs
theorem cata_id_pos_prod_string_expr (x : String × TypeScript.Expr) :
    cata_pos_prod_string_expr (ExprAlgebra.id) x = x := by
  match x with
  | (u, v) => simp only [cata_pos_prod_string_expr, cata_id_expr v]
termination_by structural x
theorem cata_id_pos_list_prod_string_expr (xs : List (String × TypeScript.Expr)) :
    cata_pos_list_prod_string_expr (ExprAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_prod_string_expr]
  | x :: rest => simp only [cata_pos_list_prod_string_expr, cata_id_pos_prod_string_expr x, cata_id_pos_list_prod_string_expr rest]
termination_by structural xs
theorem cata_id_pos_list_stmt (xs : List TypeScript.Stmt) :
    cata_pos_list_stmt (ExprAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_stmt]
  | x :: rest => simp only [cata_pos_list_stmt, cata_id_stmt x, cata_id_pos_list_stmt rest]
termination_by structural xs
theorem cata_id_pos_list_objectentry (xs : List TypeScript.ObjectEntry) :
    cata_pos_list_objectentry (ExprAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_objectentry]
  | x :: rest => simp only [cata_pos_list_objectentry, cata_id_objectentry x, cata_id_pos_list_objectentry rest]
termination_by structural xs
theorem cata_id_pos_prod_nat_list_stmt (x : Nat × List TypeScript.Stmt) :
    cata_pos_prod_nat_list_stmt (ExprAlgebra.id) x = x := by
  match x with
  | (u, v) => simp only [cata_pos_prod_nat_list_stmt, cata_id_pos_list_stmt v]
termination_by structural x
theorem cata_id_pos_list_prod_nat_list_stmt (xs : List (Nat × List TypeScript.Stmt)) :
    cata_pos_list_prod_nat_list_stmt (ExprAlgebra.id) xs = xs := by
  match xs with
  | [] => simp only [cata_pos_list_prod_nat_list_stmt]
  | x :: rest => simp only [cata_pos_list_prod_nat_list_stmt, cata_id_pos_prod_nat_list_stmt x, cata_id_pos_list_prod_nat_list_stmt rest]
termination_by structural xs
end

mutual
def foldMap_expr {M : Type u} (unit : M) (op : M → M → M) (node : TypeScript.Expr)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match node with
  | .ident a0 =>
    f_expr (.ident a0)
  | .str a0 =>
    f_expr (.str a0)
  | .int a0 =>
    f_expr (.int a0)
  | .float64Bits a0 =>
    f_expr (.float64Bits a0)
  | .bool a0 =>
    f_expr (.bool a0)
  | .jsNull =>
    f_expr (.jsNull)
  | .call a0 a1 =>
    op (f_expr (.call a0 a1)) (op (foldMap_expr unit op a0 f_expr f_stmt f_objectentry) ((foldMap_pos_list_expr unit op a1 f_expr f_stmt f_objectentry)))
  | .object a0 =>
    op (f_expr (.object a0)) ((foldMap_pos_list_prod_string_expr unit op a0 f_expr f_stmt f_objectentry))
  | .objectML a0 =>
    op (f_expr (.objectML a0)) ((foldMap_pos_list_prod_string_expr unit op a0 f_expr f_stmt f_objectentry))
  | .objectQuoted a0 =>
    op (f_expr (.objectQuoted a0)) ((foldMap_pos_list_prod_string_expr unit op a0 f_expr f_stmt f_objectentry))
  | .objectQuotedML a0 =>
    op (f_expr (.objectQuotedML a0)) ((foldMap_pos_list_prod_string_expr unit op a0 f_expr f_stmt f_objectentry))
  | .objectFromEntries a0 =>
    op (f_expr (.objectFromEntries a0)) ((foldMap_pos_list_prod_string_expr unit op a0 f_expr f_stmt f_objectentry))
  | .arr a0 =>
    op (f_expr (.arr a0)) ((foldMap_pos_list_expr unit op a0 f_expr f_stmt f_objectentry))
  | .arrow a0 a1 =>
    op (f_expr (.arrow a0 a1)) ((foldMap_expr unit op a1 f_expr f_stmt f_objectentry))
  | .generic a0 a1 =>
    op (f_expr (.generic a0 a1)) ((foldMap_expr unit op a0 f_expr f_stmt f_objectentry))
  | .lambda a0 a1 a2 =>
    op (f_expr (.lambda a0 a1 a2)) ((foldMap_expr unit op a1 f_expr f_stmt f_objectentry))
  | .method a0 a1 a2 =>
    op (f_expr (.method a0 a1 a2)) (op (foldMap_expr unit op a0 f_expr f_stmt f_objectentry) ((foldMap_pos_list_expr unit op a2 f_expr f_stmt f_objectentry)))
  | .member a0 a1 =>
    op (f_expr (.member a0 a1)) ((foldMap_expr unit op a0 f_expr f_stmt f_objectentry))
  | .generator a0 =>
    op (f_expr (.generator a0)) ((foldMap_pos_list_stmt unit op a0 f_expr f_stmt f_objectentry))
  | .cond a0 a1 a2 =>
    op (f_expr (.cond a0 a1 a2)) (op (foldMap_expr unit op a0 f_expr f_stmt f_objectentry) (op (foldMap_expr unit op a1 f_expr f_stmt f_objectentry) ((foldMap_expr unit op a2 f_expr f_stmt f_objectentry))))
  | .arrowBlock a0 a1 a2 =>
    op (f_expr (.arrowBlock a0 a1 a2)) ((foldMap_pos_list_stmt unit op a1 f_expr f_stmt f_objectentry))
  | .index a0 a1 =>
    op (f_expr (.index a0 a1)) (op (foldMap_expr unit op a0 f_expr f_stmt f_objectentry) ((foldMap_expr unit op a1 f_expr f_stmt f_objectentry)))
  | .new a0 a1 =>
    op (f_expr (.new a0 a1)) (op (foldMap_expr unit op a0 f_expr f_stmt f_objectentry) ((foldMap_pos_list_expr unit op a1 f_expr f_stmt f_objectentry)))
  | .objectWith a0 a1 =>
    op (f_expr (.objectWith a0 a1)) ((foldMap_pos_list_objectentry unit op a1 f_expr f_stmt f_objectentry))
termination_by structural node
def foldMap_stmt {M : Type u} (unit : M) (op : M → M → M) (node : TypeScript.Stmt)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match node with
  | .constYield a0 a1 a2 =>
    op (f_stmt (.constYield a0 a1 a2)) ((foldMap_expr unit op a1 f_expr f_stmt f_objectentry))
  | .ret a0 =>
    op (f_stmt (.ret a0)) ((foldMap_expr unit op a0 f_expr f_stmt f_objectentry))
  | .yieldDiscard a0 =>
    op (f_stmt (.yieldDiscard a0)) ((foldMap_expr unit op a0 f_expr f_stmt f_objectentry))
  | .letDefinite a0 a1 =>
    f_stmt (.letDefinite a0 a1)
  | .letInit a0 a1 a2 =>
    op (f_stmt (.letInit a0 a1 a2)) ((foldMap_expr unit op a1 f_expr f_stmt f_objectentry))
  | .assign a0 a1 =>
    op (f_stmt (.assign a0 a1)) ((foldMap_expr unit op a1 f_expr f_stmt f_objectentry))
  | .whileTrue a0 a1 =>
    op (f_stmt (.whileTrue a0 a1)) ((foldMap_pos_list_stmt unit op a1 f_expr f_stmt f_objectentry))
  | .switch a0 a1 =>
    op (f_stmt (.switch a0 a1)) (op (foldMap_expr unit op a0 f_expr f_stmt f_objectentry) ((foldMap_pos_list_prod_nat_list_stmt unit op a1 f_expr f_stmt f_objectentry)))
  | .ifElse a0 a1 a2 =>
    op (f_stmt (.ifElse a0 a1 a2)) (op (foldMap_expr unit op a0 f_expr f_stmt f_objectentry) (op (foldMap_pos_list_stmt unit op a1 f_expr f_stmt f_objectentry) ((foldMap_pos_list_stmt unit op a2 f_expr f_stmt f_objectentry))))
  | .labelled a0 a1 =>
    op (f_stmt (.labelled a0 a1)) ((foldMap_pos_list_stmt unit op a1 f_expr f_stmt f_objectentry))
  | .scopedGen a0 a1 a2 =>
    op (f_stmt (.scopedGen a0 a1 a2)) (op (foldMap_pos_list_stmt unit op a1 f_expr f_stmt f_objectentry) ((foldMap_expr unit op a2 f_expr f_stmt f_objectentry)))
  | .scopedGenMasked a0 a1 a2 =>
    op (f_stmt (.scopedGenMasked a0 a1 a2)) (op (foldMap_pos_list_stmt unit op a1 f_expr f_stmt f_objectentry) ((foldMap_expr unit op a2 f_expr f_stmt f_objectentry)))
  | .breakTo a0 =>
    f_stmt (.breakTo a0)
  | .continueTo a0 =>
    f_stmt (.continueTo a0)
  | .exprStmt a0 =>
    op (f_stmt (.exprStmt a0)) ((foldMap_expr unit op a0 f_expr f_stmt f_objectentry))
termination_by structural node
def foldMap_objectentry {M : Type u} (unit : M) (op : M → M → M) (node : TypeScript.ObjectEntry)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match node with
  | .property a0 a1 =>
    op (f_objectentry (.property a0 a1)) ((foldMap_expr unit op a1 f_expr f_stmt f_objectentry))
  | .spread a0 =>
    op (f_objectentry (.spread a0)) ((foldMap_expr unit op a0 f_expr f_stmt f_objectentry))
termination_by structural node
def foldMap_pos_list_expr {M : Type u} (unit : M) (op : M → M → M) (xs : List TypeScript.Expr)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_expr unit op x f_expr f_stmt f_objectentry) (foldMap_pos_list_expr unit op rest f_expr f_stmt f_objectentry)
termination_by structural xs
def foldMap_pos_prod_string_expr {M : Type u} (unit : M) (op : M → M → M) (x : String × TypeScript.Expr)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_expr unit op v f_expr f_stmt f_objectentry)
termination_by structural x
def foldMap_pos_list_prod_string_expr {M : Type u} (unit : M) (op : M → M → M) (xs : List (String × TypeScript.Expr))
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_string_expr unit op x f_expr f_stmt f_objectentry) (foldMap_pos_list_prod_string_expr unit op rest f_expr f_stmt f_objectentry)
termination_by structural xs
def foldMap_pos_list_stmt {M : Type u} (unit : M) (op : M → M → M) (xs : List TypeScript.Stmt)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_stmt unit op x f_expr f_stmt f_objectentry) (foldMap_pos_list_stmt unit op rest f_expr f_stmt f_objectentry)
termination_by structural xs
def foldMap_pos_list_objectentry {M : Type u} (unit : M) (op : M → M → M) (xs : List TypeScript.ObjectEntry)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_objectentry unit op x f_expr f_stmt f_objectentry) (foldMap_pos_list_objectentry unit op rest f_expr f_stmt f_objectentry)
termination_by structural xs
def foldMap_pos_prod_nat_list_stmt {M : Type u} (unit : M) (op : M → M → M) (x : Nat × List TypeScript.Stmt)
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match x with
  | (_, v) => (foldMap_pos_list_stmt unit op v f_expr f_stmt f_objectentry)
termination_by structural x
def foldMap_pos_list_prod_nat_list_stmt {M : Type u} (unit : M) (op : M → M → M) (xs : List (Nat × List TypeScript.Stmt))
    (f_expr : TypeScript.Expr → M := fun _ => unit) (f_stmt : TypeScript.Stmt → M := fun _ => unit) (f_objectentry : TypeScript.ObjectEntry → M := fun _ => unit) : M :=
  match xs with
  | [] => unit
  | x :: rest => op (foldMap_pos_prod_nat_list_stmt unit op x f_expr f_stmt f_objectentry) (foldMap_pos_list_prod_nat_list_stmt unit op rest f_expr f_stmt f_objectentry)
termination_by structural xs
end

end TypeScript
