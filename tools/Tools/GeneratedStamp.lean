/-!
The one header line every generator writes into a file it produces. It names the
producer and nothing else: staleness is the build graph's business (the Makefile's
`gen-*` rules, keyed on the generator's sources and the Lake traces of the compiled
core they read), and drift is `make check-gen`, which regenerates every group and
refuses any change to a committed file. Until 2026-09-13 this line carried a git
revision and a fingerprint of the generator's whole import closure, so almost any
edit to the core rewrote about three hundred label files per commit.
-/

namespace Tools.GeneratedStamp

/-- `GENERATED by <source>; do not edit`, for the producer at `source`. -/
def note (source : String) : String :=
  s!"GENERATED by {source}; do not edit"

/-- A produced file's text with exactly one final newline: trailing empty lines are dropped and
nothing else changes, so no literal inside the file can change value. Every generator writes
through it. -/
def endWithOneNewline (text : String) : String :=
  String.ofList (text.toList.reverse.dropWhile (· == '\n')).reverse ++ "\n"

/-- The generator-assembled lines before a closing line (`end X`): trailing empty lines and the
last line's trailing newlines removed, so a closing written as `["", "end X"]` follows exactly
one empty line whichever optional blocks came before it. A layout step at a boundary the
generator owns; never applied inside a fragment copied verbatim. -/
def trimBlankTail (lines : Array String) : Array String := Id.run do
  let mut out := lines
  while (out.back?.map fun line => line.all (· == '\n')).getD false do
    out := out.pop
  if let some last := out.back? then
    out := out.set! (out.size - 1) (String.ofList (last.toList.reverse.dropWhile (· == '\n')).reverse)
  return out

end Tools.GeneratedStamp
