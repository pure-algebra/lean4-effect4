#!/bin/sh
# v: the frames of a program built by edits, in a window, a console or PNG files
# (docs/research/2026-10-09-visual-pipeline.md).
#
#   v NAME           build a corpus program top-down and play its frames in a window
#   v -r NAME        run a corpus program step by step: the program and its graph of fibers
#   v -g             the graph specimen: a graph built one edge at a time, cycles included
#   v -F             the program graph's specimen: fork and join, cross edges, regions, loops
#   v -f FILE        the frames of a session request file (tools/Drivers/Session.lean's input)
#   v -t NAME        the frames in this console, as characters
#   v -p NAME        write a PNG of every frame and every picture of motion
#   v -k NAME        the frames inline in this terminal (Ghostty, kitty), drawn by draw --kitty
#   v -H NAME        the run's page in the browser: its frames as SVG, stepped like the window
#   v -G             every kept run in the browser, newest first: tools/view/out/index.html
#   v -d             the document specimen, dark beside paper, in the studio (tools/Drivers/DocSpecimen.lean)
#   v -V [cells]     the vocabulary of marks, or the Queue's cell drawn by its type (row 367), in the viewer
#                    (tools/Drivers/GlyphSheet.lean writes both)
#   v -m N ...       N pictures of motion between two frames (default 20; 1 draws none)
#   v -P ...         no marks: the plain page (the marks wait for the owner's ruling)
#   v -l LOOK ...    in a look: a name of tools/view/looks (paper, hue, sans, ...) or a token file
#   v -L             every look side by side: tools/view/out/looks/index.html and a PNG of each
#   v -w NAME        the live loop in a window: each edit of NAME's build (or of -f FILE) answered
#                    by a patch, which a retained store applies (tools/Drivers/Live.lean, play --live)
#   v -c NAME        check the retained store: every frame of NAME's build (or of -f FILE) patched
#                    in C equals Lean's whole stream, byte for byte, under two sanitizers
#
# NAME is a program of the wire corpus: p42 pBind pFork pAwait pGen pLoop pCatch pScope.
# Every run is kept in tools/view/out/runs/TIME-NAME-MODE, with its page, index.html, and the
# gallery tools/view/out/index.html lists them all. In the window and on a page: Right or Space
# plays to the next frame, Left steps back, Home and End; Q quits the window, P plays a page.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
# lake comes from elan; a shell whose profile does not add it still finds it here
command -v lake > /dev/null 2>&1 || PATH="$HOME/.elan/bin:$PATH"
root=$(cd "$here/../.." && pwd)
# a driver runs against built modules: build the ones it imports first (lake skips the fresh)
build_driver() {
  (cd "$root" && LEAN_NUM_THREADS=3 lake build -q $(sed -n 's/^import //p' "tools/Drivers/$1.lean"))
}
mode=window; motion=20; file=""; plain=""; look=""; cmd=build
while [ $# -gt 0 ]; do
  case "$1" in
    -t) mode=text ;;
    -p) mode=png ;;
    -k) mode=kitty; motion=1 ;;
    -H) mode=html ;;
    -G) cmd=gallery ;;
    -d) cmd=docs ;;
    -V) cmd=vocabulary ;;
    -w) mode=live ;;
    -c) mode=check ;;
    -f) shift; file=$1 ;;
    -m) shift; motion=$1 ;;
    -P) plain=--plain ;;
    -l) shift; look=$1 ;;
    -L) cmd=looks ;;
    -r) cmd=run ;;
    -g) cmd=specimen ;;
    -F) cmd=flows ;;
    -h|--help) sed -n 2,30p "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) break ;;
  esac
  shift
done
# a page opens in the default browser when a person runs v at a terminal; otherwise v names it,
# and the studio (http://localhost:8783/tools/view/out/index.html, .claude/launch.json) shows it
browse() {
  if [ ! -t 1 ]; then echo "$1"; elif command -v open > /dev/null 2>&1; then open "$1"; else xdg-open "$1"; fi
}
# a studio page in the Hammerspoon viewer (~/.hammerspoon/init.lua, effect4.show) when it answers,
# and as browse does otherwise. The IPC now and then drops a first message, so a second try follows.
show() {
  # a quote in the url or the title is escaped for Lua's string
  u=$(printf %s "$1" | sed "s/'/\\\\'/g"); t=$(printf %s "$2" | sed "s/'/\\\\'/g")
  for _ in 1 2; do
    if command -v hs > /dev/null 2>&1 && timeout 6 hs -q -c "return effect4.show('$u', '$t')" 2> /dev/null; then return 0; fi
  done
  browse "$root/${1#http://localhost:8783/}"
}
if [ "$cmd" = vocabulary ]; then
  build_driver GlyphSheet
  (cd "$root" && LEAN_NUM_THREADS=3 lake env lean --run tools/Drivers/GlyphSheet.lean "$here/out/docs")
  if [ "${1:-}" = cells ]; then
    show "http://localhost:8783/tools/view/out/docs/cells.html" "Effect4 · the Queue's cell"
  else
    show "http://localhost:8783/tools/view/out/docs/glyphs.html" "Effect4 · the vocabulary of marks"
  fi
  exit 0
fi
if [ "$cmd" = docs ]; then
  build_driver DocSpecimen
  (cd "$root" && LEAN_NUM_THREADS=3 lake env lean --run tools/Drivers/DocSpecimen.lean "$here/out/docs")
  browse "$here/out/index.html"
  exit 0
fi
if [ "$cmd" = gallery ]; then
  build_driver View
  (cd "$root" && LEAN_NUM_THREADS=3 lake env lean --run tools/Drivers/View.lean gallery "$here/out")
  browse "$here/out/index.html"
  exit 0
fi
if [ "$cmd" = looks ]; then
  out="$here/out/looks"
  rm -rf "$out"
  build_driver View
  (cd "$root" && LEAN_NUM_THREADS=3 lake env lean --run tools/Drivers/View.lean looks tools/view/looks "$out")
  "$here/build.sh" draw
  for f in "$out"/*/*.draw; do "$here/draw" "$f" --png "${f%.draw}.png"; done
  echo "$out/index.html"
  exit 0
fi
case $look in
  ''|*/*) ;;
  *) [ -f "$here/looks/$look.tokens.json" ] || [ "$look" = dark ] || { echo "v: no look $look in $here/looks" >&2; exit 2; } ;;
esac
case $look in
  */*) look=$(cd "$(dirname "$look")" && pwd)/$(basename "$look") ;;
esac
if [ "$mode" = live ] || [ "$mode" = check ]; then
  # the live driver reads the requests of a file on its input, or builds a corpus program
  input=/dev/null
  if [ -n "$file" ]; then
    input=$(cd "$(dirname "$file")" && pwd)/$(basename "$file"); name=$(basename "$file" .jsonl)
    set --
  else
    name=${1:?usage: v (-w | -c) (NAME | -f FILE)}
    set -- build "$name"
  fi
  if [ -n "$look" ]; then set -- --look "$look" "$@"; fi
  build_driver Live
  if [ "$mode" = check ]; then
    out="$here/out/$name-live"
    rm -rf "$out"; mkdir -p "$out"
    (cd "$root" && LEAN_NUM_THREADS=3 lake env lean --run tools/Drivers/Live.lean --check "$out" "$@" \
      < "$input" > "$out/rows.txt" 2> "$out/answers.jsonl")
    "$here/build.sh" scene_test
    exec "$here/scene_test" "$out"
  fi
  "$here/build.sh" play
  (cd "$root" && LEAN_NUM_THREADS=3 lake env lean --run tools/Drivers/Live.lean "$@" < "$input" 2> /dev/null) |
    "$here/play" --live
  exit
fi
# a run is kept under its time, its name and its look; its label is the commit and the time
runs="$here/out/runs"; stamp=$(date +%Y%m%d-%H%M%S)
rev=$(cd "$root" && git rev-parse --short HEAD 2>/dev/null || echo "no commit")
(cd "$root" && git diff --quiet HEAD -- 2>/dev/null) || rev="$rev, edited"
suffix=""
if [ -n "$look" ]; then suffix="-$(basename "$look" .tokens.json)"; fi
if [ "$cmd" = specimen ] || [ "$cmd" = flows ]; then
  name=$cmd; out="$runs/$stamp-$cmd$suffix"
  set -- "$cmd" "$out"
elif [ -n "$file" ]; then
  name=$(basename "$file" .jsonl); out="$runs/$stamp-$name$suffix"
  file=$(cd "$(dirname "$file")" && pwd)/$(basename "$file")
  set -- session "$file" "$out"
else
  name=${1:?usage: v [-t | -p | -H] [-r] [-m N] (NAME | -f FILE)}; out="$runs/$stamp-$name-$cmd$suffix"
  set -- "$cmd" "$name" "$out"
fi
rm -rf "$out"
set -- --label "$rev, $(date '+%Y-%m-%d %H:%M')" --gallery "$here/out" "$@"
if [ -n "$look" ]; then set -- --look "$look" "$@"; fi
build_driver View
(cd "$root" && LEAN_NUM_THREADS=3 lake env lean --run tools/Drivers/View.lean --motion "$motion" $plain "$@")
# each mode builds only the program it runs: the console none, PNG files draw, the window play
case $mode in
  text) cat "$out/frames.txt" ;;
  png)
    "$here/build.sh" draw
    for f in "$out"/*.draw; do "$here/draw" "$f" --png "${f%.draw}.png"; done; echo "$out" ;;
  kitty)
    "$here/build.sh" draw
    for f in "$out"/[0-9][0-9][0-9].draw; do echo "${f##*/}"; "$here/draw" "$f" --kitty; done ;;
  html) browse "$out/index.html" ;;
  window) "$here/build.sh" play; exec "$here/play" "$out" ;;
esac
