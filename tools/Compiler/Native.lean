import Compiler.Inputs

/-!
# Compiler.Native — an application's named roots through the existing LCNF producer

`Lowered` names imports and roots once. The project recipe opens the library's type owner;
`lcnfgen --project-recipe` derives its type closure with the ordinary recipe reader.
The producer runs in a temporary folder before the compiler publishes any artifact.
The manifest records the source inputs, tool versions, checks and canonical producer command.
`--check` compiles the module against the native packages. Neither mode runs the program.
The readers and refusal controls live in `Test.Codegen.CompilerEmit`.
-/

namespace Compiler

open Effect4 Effect4.Program Effect4.Store

/-- The declarations a project lowers: their import modules, their names and the closure bound. -/
structure Lowered where
  imports : List Lean.Name := []
  roots : List Lean.Name := []
  cap : Nat := 4000

/-- The native target needs named declarations, since the compiler never evaluates a loaded name. -/
def Lowered.validate (r : Lowered) : Except String Unit := do
  if r.roots.isEmpty then
    throw "no lowered roots: declare a Compiler.Lowered value and pass it to Compiler.main (lowered := …)"
  if r.imports.isEmpty then throw "the lowered recipe names no import modules"
  if r.cap == 0 then throw "the lowered recipe's closure bound must be positive"

/-- A file stem whose capitalization is an OCaml compilation unit name. -/
def Lowered.validName (name : String) : Bool :=
  match name.toList with
  | [] => false
  | first :: rest => first.isAlpha && rest.all (fun c => c.isAlphanum || c == '_')

/-- The v3 project recipe. Its type owner comes from the library's existing recipe. -/
def Lowered.recipe (r : Lowered) (name : String) : NatJson :=
  let names (ns : List Lean.Name) := NatJson.arr (ns.map fun n => .str (n.toString (escape := false)))
  .obj [("format", .str "effect4-lcnf-roots-v3"), ("facade", .obj [("module", .str "Project")]),
    ("artifacts", .arr [.obj [("out", .str (name ++ "_gen.ml")),
      ("import", names r.imports), ("cap", .nat r.cap), ("linkage", names r.roots),
      ("open", .obj [("module", .str "Eff_types"), ("artifact", .str "ocaml/eff/eff_types.ml")])]])]

namespace Native

/-- The canonical producer command. The temporary destination is staging, as in `make gen-lcnf`. -/
def command (recipe : String) : List String := ["lake", "exe", "lcnfgen", "--project-recipe", recipe]

/-- The application's address and compiler command above the lowering producer's own header. -/
def stamp (spec : Spec) (b : Api.Built) (text : String) : String :=
  let lines := header (spec.name ++ ": GENERATED by the Effect4 compiler; do not edit")
    (Tools.Code.addressOf b.program) ([("command", [commandLine spec.command])] ++ manifestRow spec)
  let indented := lines.map fun line => if line.isEmpty then "" else "   " ++ line
  let note := ("\n".intercalate indented).replace "(*" "( *" |>.replace "*)" "* )"
  "(*\n" ++ note ++ "\n*)\n\n" ++ text

/-- The checks of a native emission. Their scope is translation and optional compilation, never a run. -/
def checks (compiled : Bool) : List Check :=
  [⟨.certificate, "admission", `Compiler.check,
    "The compiler builds the application's service module and records its certificate.",
    "It does not run the application or its host."⟩,
   ⟨.module, "closure", `OCaml5.Lcnf.Gen.run,
    "The LCNF closure has no missing declaration, unfinished translation or exhausted closure bound.",
    "This finite translation check is no correctness theorem for the lowering."⟩,
   ⟨.module, "bindings", `OCaml5.Ml.checkModule,
    "The generated OCaml syntax passes the module checker with the type owner's interface.",
    "This check is not OCaml type checking."⟩,
   ⟨.module, "hygiene", `OCaml5.Lcnf.hygieneProblems,
    "The translated declarations have no detected name capture.",
    "It establishes no runtime observation."⟩] ++
  (if compiled then [⟨.module, "ocamlopt", `Compiler.Native.compile,
    "ocamlopt compiles the generated module against the installed native packages with warning 55 fatal.",
    "It does not link an executable or run the program."⟩] else [])

/-- A native target's inputs, with the versions read from the selected opam switch. -/
def inputsJson (inputs : Inputs) (commit ocaml zarith : String) (recipe : NatJson) : NatJson :=
  .obj [("lean", .str inputs.lean), ("library", (inputs.library.map NatJson.str).getD .null),
    ("address", .str inputs.address.hex),
    ("modules", .obj (inputs.modules.map fun (m, d) => (m, .str d.hex))),
    ("lcnfgen", .str commit), ("ocaml", .str ocaml), ("zarith", .str zarith),
    ("typeOwners", recipe)]

/-- Assemble the native artifacts through the compiler's existing manifest and file mechanics. -/
def emission (spec : Spec) (b : Api.Built) (recipe : NatJson) (moduleText closureText : String)
    (inputs : NatJson) (compiled : Bool) (producer : List String) (directory : String := ".") : Emission :=
  let files : List Artifact :=
    [⟨spec.name ++ "_gen.ml", .module, moduleText.toUTF8⟩,
     ⟨"closure-" ++ spec.name ++ "_gen.tsv", .closure, closureText.toUTF8⟩,
     ⟨"lowering.json", .recipe, jsonBytes recipe⟩,
     ⟨spec.name ++ ".eff", .canonical, ⟨(Api.bytesOf b.program).toArray⟩⟩,
     ⟨spec.name ++ ".eff.json", .canonical, programJson b.program⟩,
     ⟨"certificate.json", .certificate, jsonBytes (certificate b)⟩]
  let written := files.filter fun a => spec.kinds.contains a.kind.selector
  let omitted := (if compiled then [] else ["ocamlopt has not compiled the module"]) ++
    ["no executable has been linked", "no program or host has run"]
  let manifest := .obj ([("program", .obj [("module", .str spec.name),
      ("address", .str (Tools.Code.addressOf b.program))]),
    ("certificate", certificate b), ("loweringCommand", .arr (producer.map NatJson.str)),
    ("loweringDirectory", .str directory)] ++
    manifestFields spec written "ocaml" (checks compiled) omitted (some inputs))
  ⟨written, manifest⟩

/-- Run a tool and retain its diagnostic on a nonzero exit. No shell interprets the arguments. -/
def output (args : IO.Process.SpawnArgs) : IO String := do
  let result ← IO.Process.output args
  unless result.exitCode == 0 do
    throw (IO.userError s!"{args.cmd} exited {result.exitCode}:\n{result.stdout}{result.stderr}")
  return result.stdout.trimAscii.copy

/-- Compile the staged module alone. The library's install layout supplies the native packages. -/
def compile (root folder : System.FilePath) (name : String) : IO Unit := do
  let installed := (root / "ocaml/_build/install/default/lib").toString
  let inherited ← IO.getEnv "OCAMLPATH"
  let path := installed ++ (inherited.map (":" ++ ·)).getD ""
  let _ ← output
    { cmd := "opam", cwd := some folder, env := #[("OCAMLPATH", some path)],
      args := #["exec", "--switch=effect4", "--", "ocamlfind", "ocamlopt", "-w", "@55",
      "-package", "effect4_eff,effect4_lcnf", "-c", name ++ "_gen.ml"] }

/-- Lower in a temporary folder, then return the checked files. Publication belongs to `emit`. -/
def emit (name : String) (b : Api.Built) (lowered : Lowered) (modules : List String)
    (given : List String) (kinds : List Kind) (compiled : Bool) (out : System.FilePath) :
    IO Emission := do
  let root ← IO.FS.realPath (← libraryRoot)
  let project ← IO.currentDir
  let destination := if out.isAbsolute then out else project / out
  let inputs ← readInputs root modules
  let recipe := lowered.recipe name
  let libraryRecipe ← readJson (root / "ocaml/gen/roots.json")
  let owners := match libraryRecipe.at? [.key "artifacts"] with
    | some (.arr entries) => entries.filter fun e =>
      match e.at? [.key "modules"] with | some (.bool true) => true | _ => false
    | _ => []
  let commit ← output { cmd := "git", args := #["-C", root.toString, "rev-parse", "HEAD"] }
  let ocaml ← output { cmd := "opam", args := #["exec", "--switch=effect4", "--", "ocamlc", "-version"] }
  let zarith ← output { cmd := "opam", args := #["exec", "--switch=effect4", "--", "ocamlfind", "query", "-format", "%v", "zarith"] }
  let spec : Spec := { name, command := given, kinds, prelude := [], inputs }
  IO.FS.withTempDir fun stage => do
    let input := stage / "lowering.json"
    IO.FS.writeBinFile input (jsonBytes recipe)
    let _ ← output
      { cmd := "lake", cwd := some root,
        args := #["exe", "lcnfgen", "--stage", stage.toString, "--project-recipe", input.toString] }
    let text := stamp spec b (← IO.FS.readFile (stage / (name ++ "_gen.ml")))
    if compiled then
      IO.FS.writeFile (stage / (name ++ "_gen.ml")) text
      compile root stage name
    let closure ← IO.FS.readFile (stage / ("closure-" ++ name ++ "_gen.tsv"))
    return emission spec b recipe text closure (inputsJson inputs commit ocaml zarith (.arr owners))
      compiled (command (destination / "lowering.json").toString) root.toString

end Native
end Compiler
